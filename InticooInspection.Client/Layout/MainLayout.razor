@inherits LocalizedLayoutBase
@inject IAuthService AuthService
@inject NavigationManager Navigation
@inject WaitingService Waiting
@inject PageAccessService PageAccess
@using InticooInspection.Client.Services

<div class="app-layout @(_collapsed ? "nav-collapsed" : "")">

    <!-- ═══ MOBILE TOP BAR (chỉ hiện trên điện thoại / tablet) ═══ -->
    <header class="mobile-topbar">
        <NavLink href="@HomeUrl" class="mobile-topbar-logo"><img src="logo.png" height="34" alt="Inticoo" /></NavLink>
        <button class="hamburger" @onclick="ToggleMobileMenu" aria-label="@T("Layout.Menu")">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
            </svg>
        </button>
        <AuthorizeView>
            <span class="mobile-topbar-avatar">@GetInitials(context.User.Identity?.Name ?? "")</span>
        </AuthorizeView>
    </header>

    @if (_mobileMenuOpen)
    {
        <div class="side-overlay" @onclick="CloseMobileMenu"></div>
    }

    <!-- ═══ SIDEBAR (menu dọc) ═══ -->
    <aside class="side-nav @(_mobileMenuOpen ? "open" : "")">
        <div class="side-logo">
            <NavLink href="@HomeUrl" @onclick="CloseMobileMenu" class="side-logo-link" title="Inticoo">
                @if (_collapsed)
                {
                    <img src="favicon.png" alt="Inticoo" class="side-logo-mini" />
                }
                else
                {
                    <img src="logo.png" alt="Inticoo" class="side-logo-img" />
                }
            </NavLink>
        </div>

        <nav class="side-menu">
            <AuthorizeView>
                @foreach (var g in VisibleGroups())
                {
                    var grp = g;
                    @if (grp.Items.Count == 1)
                    {
                        var it = grp.Items[0];
                        <NavLink href="@it.Href" class="side-link" Match="@(it.Href == "/inspections" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                                 title="@T(grp.Title)" @onclick="CloseMobileMenu">
                            <span class="side-ico">@((MarkupString)grp.Icon)</span>
                            <span class="side-text">@T(grp.Title)</span>
                        </NavLink>
                    }
                    else
                    {
                        var open = IsGroupOpen(grp);
                        <button class="side-link side-group-btn @(open ? "open" : "") @(GroupActive(grp) ? "group-active" : "")"
                                title="@T(grp.Title)" @onclick="() => ToggleGroup(grp.Title)">
                            <span class="side-ico">@((MarkupString)grp.Icon)</span>
                            <span class="side-text">@T(grp.Title)</span>
                            <svg class="side-caret" width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M7 5l5 5-5 5"/></svg>
                        </button>
                        @if (open)
                        {
                            <div class="side-sub">
                                @foreach (var it in grp.Items.Where(ItemVisible))
                                {
                                    <NavLink href="@it.Href" Match="NavLinkMatch.All" class="@("side-sublink" + (ItemActive(it) ? " active" : ""))" title="@T(it.Title)" @onclick="CloseMobileMenu">@T(it.Title)</NavLink>
                                }
                            </div>
                        }
                    }
                }
            </AuthorizeView>
        </nav>

        <!-- Ngôn ngữ (ẩn khi thu gọn menu) -->
        <div class="side-lang">
            <LanguagePicker Variant="dark" SaveToAccount="true" />
        </div>

        <!-- User block -->
        <AuthorizeView>
            <div class="side-user">
                <button class="side-user-btn" @onclick="() => _userMenuOpen = !_userMenuOpen" title="@context.User.Identity?.Name">
                    <span class="side-avatar">@GetInitials(context.User.Identity?.Name ?? "")</span>
                    <span class="side-user-info">
                        <span class="side-user-name">@context.User.Identity?.Name</span>
                        <span class="side-user-role">@RoleLabel(context.User)</span>
                    </span>
                    <svg class="side-caret" width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="@(_userMenuOpen ? "M5 12l5-5 5 5" : "M5 8l5 5 5-5")"/></svg>
                </button>
                @if (_userMenuOpen)
                {
                    <div class="side-user-menu">
                        <NavLink href="/change-password" class="side-sublink" @onclick="CloseMobileMenu">@T("Layout.ChangePassword")</NavLink>
                        <button class="side-sublink side-logout" @onclick="Logout">@T("Layout.SignOut")</button>
                    </div>
                }
            </div>
        </AuthorizeView>

        <button class="side-collapse" @onclick="() => { _collapsed = !_collapsed; _userMenuOpen = false; }" title="@(_collapsed ? T("Layout.ExpandMenu") : T("Layout.CollapseMenu"))">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="@(_collapsed ? "M8 5l5 5-5 5" : "M12 5l-5 5 5 5")"/></svg>
            <span class="side-text">@T("Layout.Collapse")</span>
        </button>
    </aside>

    <!-- ═══ MAIN ═══ -->
    <div class="main-wrap">
        <main class="main-content">
            @if (IsDirectoryPath)
            {
                <div class="m-dirtabs">
                    @foreach (var it in _menu.First(g => g.PageKey == "Directory").Items)
                    {
                        <NavLink href="@it.Href" class="m-dirtab" Match="NavLinkMatch.Prefix">@T(it.Title)</NavLink>
                    }
                </div>
            }
            @Body
        </main>

        @if (!CurrentPath.StartsWith("/inspection-qc", StringComparison.OrdinalIgnoreCase))
        {
        <footer class="bottom-footer">
            <div class="footer-inner">
                <div class="footer-copy">
                    <span>@T("Layout.Copyright")</span>
                </div>
            </div>
        </footer>
        }
    </div>

    <!-- ═══ MOBILE BOTTOM NAV (chỉ hiện trên điện thoại) ═══ -->
    @if (!CurrentPath.StartsWith("/inspection-qc", StringComparison.OrdinalIgnoreCase))
    {
        <nav class="m-bottomnav">
            <AuthorizeView>
                @foreach (var b in BottomEntries())
                {
                    <NavLink href="@b.Href" class="@("m-bn-item" + (b.Active ? " active" : ""))" Match="NavLinkMatch.Prefix">
                        <span class="m-bn-ico">@((MarkupString)b.Icon)</span>
                        <span class="m-bn-txt">@b.Label</span>
                    </NavLink>
                }
            </AuthorizeView>
        </nav>
    }
</div>

<WaitingOverlay />

@code {

    private bool _mobileMenuOpen = false;

    private void ToggleMobileMenu() => _mobileMenuOpen = !_mobileMenuOpen;
    private void CloseMobileMenu() => _mobileMenuOpen = false;

    protected override async Task OnInitializedAsync()
    {
        PageAccess.OnChange += OnPageAccessChanged;
        Navigation.LocationChanged += OnLocationChanged;
        await PageAccess.EnsureLoadedAsync();
    }

    private void OnPageAccessChanged() => InvokeAsync(StateHasChanged);

    protected override void Dispose(bool disposing)
    {
        base.Dispose(disposing);
        PageAccess.OnChange -= OnPageAccessChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }

    /// <summary>
    /// Returns true if the menu item should show. Admin always sees everything.
    /// For Customer/Inticoo users, the page key must be in their PageAccess list.
    /// </summary>
    private bool CanSee(string pageKey) => PageAccess.IsAdmin || PageAccess.HasAccess(pageKey);

    /// <summary>
    /// Used INSIDE the non-admin menu block.
    /// Admin uses the dedicated admin block below, so they must NOT see
    /// the non-admin block (otherwise menu items would render twice).
    /// </summary>
    private bool CanSeeForNonAdmin(string pageKey) => !PageAccess.IsAdmin && PageAccess.HasAccess(pageKey);

    // ── Sidebar menu ─────────────────────────────────────────────────
    // PageKey = null → chỉ Admin; ngược lại Admin luôn thấy, role khác theo Page Access.
    // Title là key đa ngôn ngữ (i18n/*.json), hiển thị qua T(); đồng thời làm định danh nhóm khi mở/đóng.
    private record MenuItem(string Title, string Href);
    private record MenuGroup(string Title, string? PageKey, string Icon, List<MenuItem> Items);

    private static readonly List<MenuGroup> _menu = new()
    {
        new("Menu.Dashboard", "Dashboard",
            "<svg viewBox='0 0 20 20'><rect x='2' y='2' width='7' height='7' rx='1'/><rect x='11' y='2' width='7' height='7' rx='1'/><rect x='2' y='11' width='7' height='7' rx='1'/><rect x='11' y='11' width='7' height='7' rx='1'/></svg>",
            new() { new("Menu.Dashboard", "/dashboard") }),
        new("Menu.JobRequest", "JobRequest",
            "<svg viewBox='0 0 20 20'><path d='M10 4v12M4 10h12'/></svg>",
            new() { new("Menu.ProductInspection", "/inspections/new"), new("Menu.ContainerLoadingCheck", "/clc/new") }),
        new("Menu.InspectionSchedule", "InspectionSchedule",
            "<svg viewBox='0 0 20 20'><rect x='3' y='4' width='14' height='13' rx='2'/><path d='M3 8h14M7 2v4M13 2v4'/></svg>",
            new() { new("Menu.InspectionSchedule", "/inspection-schedule") }),
        new("Menu.SummaryInspections", "SummaryInspections",
            "<svg viewBox='0 0 20 20'><rect x='4' y='3' width='12' height='15' rx='2'/><path d='M7 8h6M7 11h6M7 14h3'/></svg>",
            new() { new("Menu.InspectionReports", "/inspections"), new("Menu.ClcReports", "/clc") }),
        new("Menu.Directory", "Directory",
            "<svg viewBox='0 0 20 20'><path d='M3 5h14M3 10h14M3 15h9'/></svg>",
            new() { new("Menu.CustomerProfile", "/customers"), new("Menu.VendorsProfile", "/suppliers"),
                    new("Menu.InspectorProfile", "/inspectors"), new("Menu.ProductsProfile", "/products") }),
        new("Menu.PerformanceReview", "PerformanceReview",
            "<svg viewBox='0 0 20 20'><path d='M2 16l4-8 4 4 3-5 5 9H2z'/></svg>",
            new() { new("Menu.VendorPerformance", "/vendor-reviews"), new("Menu.InspectorPerformance", "/inspector-reviews") }),
        new("Menu.DefectManagement", "DefectManagement",
            "<svg viewBox='0 0 20 20'><path d='M10 2l7 3v5c0 4-3 7-7 8-4-1-7-4-7-8V5z'/><path d='M10 7v4M10 13.5v.5'/></svg>",
            new() { new("Menu.DefectManagement", "/defects") }),
        new("Menu.PerformanceTest", "PerformanceTest",
            "<svg viewBox='0 0 20 20'><path d='M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2'/><rect x='9' y='3' width='6' height='4' rx='1'/><path d='M9 12h6M9 15h4'/></svg>",
            new() { new("Menu.PerformanceTest", "/admin/performance-test-master") }),
        new("Menu.Settings", null,
            "<svg viewBox='0 0 20 20'><circle cx='10' cy='10' r='2.6'/><path d='M10 2.5v2M10 15.5v2M2.5 10h2M15.5 10h2M4.7 4.7l1.4 1.4M13.9 13.9l1.4 1.4M4.7 15.3l1.4-1.4M13.9 6.1l1.4-1.4'/></svg>",
            new() { new("Menu.InspectionDefectSettings", "/settings/inspection-defect"), new("Menu.BillingInvoices", "/settings/billing"), new("Menu.SystemSettings", "/settings/system") }),
        new("Menu.LoginAccount", null,
            "<svg viewBox='0 0 20 20'><rect x='4' y='9' width='12' height='8' rx='1.5'/><path d='M7 9V6a3 3 0 0 1 6 0v3'/></svg>",
            new() { new("Menu.LoginAccount", "/users") }),
    };

    private bool _collapsed, _userMenuOpen;
    private readonly HashSet<string> _openGroups = new();
    private readonly HashSet<string> _closedGroups = new();

    // Job Request chỉ có trang "New Inspection" → cần quyền Create
    // Mục CLC trong menu theo quyền module Container Loading Check (xem / tạo job)
    private bool ItemVisible(MenuItem it) =>
        PageAccess.IsAdmin
        || (it.Href == "/clc"     ? PageAccess.HasAccess("ContainerLoadingCheck")
          : it.Href == "/clc/new" ? PageAccess.Can("ContainerLoadingCheck", "Create")
          : true);

    private IEnumerable<MenuGroup> VisibleGroups() =>
        _menu.Where(g => PageAccess.IsAdmin || (g.PageKey != null && PageAccess.HasAccess(g.PageKey)
                         && (g.PageKey != "JobRequest" || PageAccess.Can("JobRequest", "Create"))));

    // Thanh menu dưới (điện thoại): Directory chuyển vào menu ☰, thay bằng Performance Test; thêm Container Loading Check.
    private record BottomEntry(string Href, string Label, string Icon, bool Active);

    private IEnumerable<BottomEntry> BottomEntries()
    {
        var vis = VisibleGroups().Where(g => g.PageKey != null).ToDictionary(g => g.PageKey!, g => g);
        foreach (var key in new[] { "Dashboard", "InspectionSchedule", "SummaryInspections", "DefectManagement", "PerformanceTest" })
        {
            if (key == "CLC")
            {
                if (!vis.ContainsKey("SummaryInspections")) continue;
                yield return new("/clc", T("Menu.BottomClc"), BottomIcon("CLC"),
                    CurrentPath.Equals("/clc", StringComparison.OrdinalIgnoreCase) || CurrentPath.StartsWith("/clc/", StringComparison.OrdinalIgnoreCase));
                continue;
            }
            if (!vis.TryGetValue(key, out var g)) continue;
            // Summary không còn "ăn" luôn trang /clc (đã có nút riêng)
            var active = key == "SummaryInspections"
                ? g.Items.Any(i => i.Href != "/clc" && ItemActive(i))
                : GroupActive(g);
            yield return new(g.Items[0].Href, BottomLabel(g), BottomIcon(key), active);
        }
    }

    private string BottomLabel(MenuGroup g) => g.PageKey switch
    {
        "SummaryInspections" => T("Menu.BottomSummary"),
        "DefectManagement"   => T("Menu.BottomDefects"),
        "PerformanceTest"    => T("Menu.BottomPerformanceTest"),
        _                    => T(g.Title)
    };

    private static string BottomIcon(string? key) => key switch
    {
        "Dashboard"          => "<svg viewBox='0 0 24 24'><path d='M3 11l9-8 9 8'/><path d='M5 10v10h5v-6h4v6h5V10'/></svg>",
        "InspectionSchedule" => "<svg viewBox='0 0 24 24'><rect x='3.5' y='5' width='17' height='15' rx='2.5'/><path d='M3.5 10h17M8 3v4M16 3v4'/><path d='M8 14h.01M12 14h.01M16 14h.01M8 17h.01M12 17h.01'/></svg>",
        "SummaryInspections" => "<svg viewBox='0 0 24 24'><path d='M6 20V11M12 20V5M18 20v-6'/></svg>",
        "DefectManagement"   => "<svg viewBox='0 0 24 24'><path d='M12 3.5l9.5 16.5h-19z'/><path d='M12 10v4.5M12 17.2v.1'/></svg>",
        "CLC"                => "<svg viewBox='0 0 24 24'><rect x='3' y='7' width='18' height='10' rx='1.5'/><path d='M7 7v10M11 7v10M15 7v10M19 7v10'/></svg>",
        "PerformanceTest"    => "<svg viewBox='0 0 24 24'><path d='M9 3h6M10 3v6l-5 9a2 2 0 0 0 1.8 3h10.4a2 2 0 0 0 1.8-3l-5-9V3'/><path d='M8 15h8'/></svg>",
        "Directory"          => "<svg viewBox='0 0 24 24'><rect x='3.5' y='3.5' width='7' height='7' rx='1.5'/><rect x='13.5' y='3.5' width='7' height='7' rx='1.5'/><rect x='3.5' y='13.5' width='7' height='7' rx='1.5'/><rect x='13.5' y='13.5' width='7' height='7' rx='1.5'/></svg>",
        _                    => ""
    };

    private bool IsDirectoryPath =>
        _menu.First(g => g.PageKey == "Directory").Items.Any(i => CurrentPath.Equals(i.Href, StringComparison.OrdinalIgnoreCase)
                                                             || CurrentPath.StartsWith(i.Href + "/", StringComparison.OrdinalIgnoreCase));

    private string CurrentPath => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].TrimEnd('/');

    private bool GroupActive(MenuGroup g) => g.Items.Any(ItemActive);

    private bool InPath(string root) =>
        CurrentPath.Equals(root, StringComparison.OrdinalIgnoreCase) || CurrentPath.StartsWith(root + "/", StringComparison.OrdinalIgnoreCase);

    private bool Is(string path) => CurrentPath.Equals(path, StringComparison.OrdinalIgnoreCase);

    // Mỗi lúc chỉ 1 mục sáng (khách báo 17/11/2026: bấm Product Inspection thì Inspection Reports cũng sáng).
    // Job Requests: trang tạo/sửa job. Summary: danh sách, chi tiết, báo cáo.
    private bool ItemActive(MenuItem it) => it.Href switch
    {
        "/inspections/new" => Is("/inspections/new")
                              || (InPath("/inspections") && CurrentPath.EndsWith("/edit", StringComparison.OrdinalIgnoreCase)),
        "/inspections"     => (InPath("/inspections") && !Is("/inspections/new") && !CurrentPath.EndsWith("/edit", StringComparison.OrdinalIgnoreCase))
                              || InPath("/inspection-report"),
        "/clc/new"         => Is("/clc/new"),
        "/clc"             => InPath("/clc") && !Is("/clc/new"),
        _                  => InPath(it.Href)
    };

    // Nhóm đang chứa trang hiện tại tự mở; người dùng có thể đóng/mở tay
    private bool IsGroupOpen(MenuGroup g) =>
        !_collapsed && (_openGroups.Contains(g.Title) || (GroupActive(g) && !_closedGroups.Contains(g.Title)));

    private void ToggleGroup(string title)
    {
        if (_collapsed) { _collapsed = false; _openGroups.Add(title); _closedGroups.Remove(title); return; }
        var g = _menu.First(x => x.Title == title);
        if (IsGroupOpen(g)) { _openGroups.Remove(title); _closedGroups.Add(title); }
        else { _openGroups.Add(title); _closedGroups.Remove(title); }
    }

    private string HomeUrl => PageAccess.IsAdmin || (PageAccess.HasAccess("Dashboard") && !PageAccess.HasAccess("InspectionSchedule"))
        ? "/dashboard" : "/inspection-schedule";

    private string RoleLabel(System.Security.Claims.ClaimsPrincipal u) =>
        T(u.IsInRole("Admin") ? "Role.Admin" : u.IsInRole("Inspector") ? "Role.Inspector" : u.IsInRole("Customer") ? "Role.Customer" : "Role.User");

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _mobileMenuOpen = false;
        _closedGroups.Clear();
        InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        Waiting.Show(T("Layout.LoggingOut"));
        PageAccess.Clear();
        await AuthService.LogoutAsync();
        Waiting.Hide();
        Navigation.NavigateTo("/login");
    }

    private string GetInitials(string name)
        => string.Concat(name.Split(" ").Take(2).Select(w => w.Length > 0 ? w[0].ToString().ToUpper() : ""));
}

<style>
    @@import url("https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@300;400;500&display=swap");

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
        background: linear-gradient(160deg, #1a3a6b 0%, #1565c0 40%, #1976d2 70%, #1e88e5 100%);
        min-height: 100vh;
        color: #fff;
        font-family: "DM Sans", sans-serif;
        position: relative;
    }

    .app-layout {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        isolation: auto;
    }

    /* ─── TOP NAVBAR ─── */
    .top-navbar {
        background: rgba(255, 255, 255, 0.96);
        border-bottom: 1px solid rgba(255,255,255,0.2);
        position: sticky;
        top: 0;
        z-index: 40;
        box-shadow: 0 2px 12px rgba(0,0,0,0.15);
    }

    .navbar-inner {
        max-width: 1800px;
        margin: 0 auto;
        padding: 0 24px;
        height: 60px;
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }

    .navbar-logo {
        display: flex;
        align-items: center;
        flex-shrink: 0;
        margin-right: 8px;
    }

    .navbar-links {
        display: flex;
        align-items: center;
        gap: 0;
        flex: 1 1 auto;
        min-width: 0;
        /* NOTE: do NOT use overflow:hidden here — it clips dropdown menus and
           silently hides nav items that don't fit. Breakpoints below switch
           to hamburger before the bar actually overflows. */
    }

    .nav-link {
        color: #1a3a6b;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        padding: 6px 18px;
        transition: color .2s;
        white-space: nowrap;
        font-family: "DM Sans", sans-serif;
    }

    .nav-link:hover { color: #1565c0; }
    .nav-link.active { color: #1565c0; font-weight: 600; }

    .nav-divider {
        width: 1px;
        height: 18px;
        background: rgba(26, 58, 107, 0.25);
        flex-shrink: 0;
    }

    /* Right section */
    .navbar-right {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-shrink: 0;
        margin-left: auto;
    }

    .welcome-text {
        font-size: 14px;
        font-weight: 500;
        color: #1a3a6b;
        white-space: nowrap;
    }

    /* User avatar + dropdown */
    .user-dropdown { position: relative; }

    .user-avatar-btn {
        display: flex;
        align-items: center;
        gap: 5px;
        cursor: pointer;
        padding: 4px;
        border-radius: 8px;
        transition: background .2s;
    }

    .user-avatar-btn:hover { background: rgba(26,58,107,0.08); }

    .user-avatar {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: linear-gradient(135deg, #1565c0, #42a5f5);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        color: #fff;
        border: 2px solid #1565c0;
    }

    .chevron { color: #1a3a6b; }

    .dropdown-menu {
        display: none;
        position: absolute;
        right: 0;
        top: calc(100% + 0px);
        background: #fff;
        border: 1px solid rgba(0,0,0,0.1);
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        min-width: 140px;
        overflow: hidden;
        z-index: 41;
    }

    .user-dropdown:hover .dropdown-menu { display: block; }

    .dropdown-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        font-size: 13px;
        color: #1a3a6b;
        background: none;
        border: none;
        cursor: pointer;
        width: 100%;
        text-align: left;
        text-decoration: none;
        transition: background .15s;
        font-family: "DM Sans", sans-serif;
    }

    .dropdown-item:hover { background: #f0f5ff; }
    .dropdown-item.active { background: #e6f1fb; color: #1565c0; }
    .logout-item:hover { color: #c62828; background: #fff5f5; }
    .dropdown-divider { height: 1px; background: rgba(0,0,0,.08); margin: 4px 0; }

    /* ─── NAV DROPDOWN (desktop) ─── */
    .nav-dropdown {
        position: relative;
        padding-bottom: 8px;
        margin-bottom: -8px;
    }

    .nav-dropdown-btn {
        display: flex;
        align-items: center;
        gap: 4px;
        background: none;
        border: none;
        cursor: pointer;
        color: #1a3a6b;
        font-size: 14px;
        font-weight: 500;
        padding: 6px 18px;
        font-family: "DM Sans", sans-serif;
        transition: color .2s;
    }

    .nav-dropdown-btn:hover { color: #1565c0; }

    .nav-dropdown-menu {
        display: none;
        position: absolute;
        left: 0;
        top: 100%;
