@page "/defects/{Id:int}/report"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PageAccessService PageAccess
@inject IJSRuntime JS
@inherits LocalizedComponentBase

<PageTitle>@T("DefectClosureReport.DefectClosureReport", ReportNo)</PageTitle>

<div class="dcr-toolbar no-print">
    <button class="dcr-tb-btn" @onclick='() => Navigation.NavigateTo(Id > 0 ? $"/defects/{Id}/edit" : "/defects")'>@T("DefectClosureReport.Back")</button>
    @if (PageAccess.CanDownload)
    {
        <button class="dcr-tb-btn primary" @onclick="Print">@T("DefectClosureReport.PrintSavePDF")</button>
    }
</div>

@if (_m == null)
{
    <div class="dcr-loading">@(_err ?? T("DefectClosureReport.Loading"))</div>
}
else
{
    var closed = _m.Status == "Closed";
    <div class="dcr-doc">

        <!-- ═════ PAGE 1 ═════ -->
        <section class="dcr-page">
            <div class="dcr-brand">
                <div><img src="/logo.png" class="dcr-logo" alt="inticoo" /><div class="dcr-tag">@T("DefectClosureReport.INSPECTIMPROVETOGETHER")</div></div>
                <div class="dcr-slogan">@T("DefectClosureReport.BetterQuality")<br />@T("DefectClosureReport.SaferTomorrow")</div>
            </div>
            <div class="dcr-titlerow">
                <h1>@T("DefectClosureReport.DEFECTCLOSUREREPORT")</h1>
                <div class="dcr-reportno">@T("DefectClosureReport.ReportNo", ReportNo)</div>
            </div>

            <div class="dcr-top">
                <table class="dcr-kv">
                    <tr><td>@T("DefectClosureReport.InspectionNo")</td><td>: @_m.JobNumber</td></tr>
                    <tr><td>@T("DefectClosureReport.PONumber")</td><td>: @(_m.PoNumber ?? "—")</td></tr>
                    <tr><td>@T("Common.Factory")</td><td>: @_m.VendorName</td></tr>
                    <tr><td>@T("Common.Product")</td><td>: @_m.ProductName @(string.IsNullOrEmpty(_m.ItemNumber) ? "" : $"({_m.ItemNumber})")</td></tr>
                    <tr><td>@T("Common.InspectionDate")</td><td>: @D(_m.InspectionDate)</td></tr>
                    <tr><td>@T("DefectClosureReport.ClosureDate")</td><td>: @D(_m.CloseDate)</td></tr>
                </table>
                <div>
                    <table class="dcr-kv">
                        <tr><td>@T("Common.DefectID")</td><td>: @_m.DefectNo</td></tr>
                        <tr><td>@T("Common.CARNo")</td><td>: @_m.CarNo</td></tr>
                        <tr><td>@T("Common.Inspector")</td><td>: @(_m.InspectorName ?? "—")</td></tr>
                        <tr><td>@T("DefectClosureReport.ReportDate")</td><td>: @L.Date(DateTime.Now, "dd MMM yyyy")</td></tr>
                    </table>
                    <div class="dcr-stamp @(closed ? "ok" : "pending")">
                        <div class="dcr-stamp-t">@(closed ? T("DefectClosureReport.DEFECTCLOSED") : _m.Status == "In Progress" ? T("DefectClosureReport.CAPAINPROGRESS") : T("DefectClosureReport.CAPAOPEN"))</div>
                        <div class="dcr-stamp-s">@(closed ? T("DefectClosureReport.CorrectiveAndPreventiveActionsHaveBeen") : T("DefectClosureReport.DueDate", D(_m.DueDate)))</div>
                    </div>
                </div>
            </div>

            <div class="dcr-h"><span>1.</span> @T("DefectClosureReport.ExecutiveSummary")</div>
            <table class="dcr-tbl center">
                <tr><th>@T("Common.DefectType")</th><th>@T("DefectClosureReport.DefectCategory")</th><th>@T("Common.Severity")</th><th>@T("DefectClosureReport.DefectQuantity")</th><th>@T("Common.Status")</th><th>@T("DefectClosureReport.VerificationResult")</th><th>@T("DefectClosureReport.RiskLevel")</th></tr>
                <tr>
                    <td>@(_m.DefectCode is null or "OTH" ? "" : _m.DefectCode + " ")@TE("Opt", _m.DefectType)</td>
                    <td>@TE("Opt", _m.DefectCategory)</td>
                    <td><span class="dcr-badge sev-@(_m.Severity?.ToLower())">@TE("Status", _m.Severity)</span></td>
                    <td>@_m.Quantity pcs</td>
                    <td><span class="dcr-badge st-@DefectOptions.StatusCss(_m.Status)">@TE("Status", _m.Status)</span></td>
                    <td>@if (!string.IsNullOrEmpty(_m.EffectivenessResult)) { <span class="dcr-badge eff-@(_m.EffectivenessResult == "Effective" ? "ok" : _m.EffectivenessResult == "Not Effective" ? "bad" : "mid")">@TE("Status", _m.EffectivenessResult)</span> } else { <span>—</span> }</td>
                    <td>@RiskLevel</td>
                </tr>
            </table>

            <div class="dcr-h"><span>2.</span> @T("DefectClosureReport.DefectDetails")</div>
            <div class="dcr-2col">
                <table class="dcr-tbl left">
                    <tr><th>@T("DefectClosureReport.DefectDescription")</th></tr>
                    <tr><td class="dcr-pre">@(_m.Description ?? "—")</td></tr>
                    <tr><th>@T("DefectClosureReport.DefectLocation")</th></tr>
                    <tr><td>
                        @if (_m.Locations.Any())
                        {
                            @for (int li = 0; li < _m.Locations.Count; li++)
                            { <div><b>@(li + 1).</b> @(_m.Locations[li].Label ?? "—")</div> }
                        }
                        else { @(_m.LocationLabel ?? _m.InspectionArea ?? "—") }
                    </td></tr>
                    <tr><th>@T("DefectClosureReport.AQLClassification")</th></tr>
                    <tr><td>@(_m.AqlClassification ?? "—")</td></tr>
                    <tr><th>@T("DefectClosureReport.ProductQuantityChecked")</th></tr>
                    <tr><td>@(_m.ProductQtyChecked?.ToString("N0") ?? "—") pcs</td></tr>
                </table>
                <div class="dcr-imgbox">
                    <div class="dcr-imgbox-t">@T("DefectClosureReport.ProductReferenceImage")</div>
                    @if (!string.IsNullOrEmpty(_m.LocationImageUrl))
                    {
                        <div class="dcr-loc">
                            <img src="@Img(_m.LocationImageUrl)" />
                            @for (int li = 0; li < _m.Locations.Count; li++)
                            {
                                var pt = _m.Locations[li];
                                <span class="dcr-pin" style="left:@Inv(pt.X)%;top:@Inv(pt.Y)%">@(li + 1)</span>
                                @if (!string.IsNullOrEmpty(pt.Label)) { <span class="dcr-pin-lbl" style="left:@Inv(pt.X)%;top:@Inv(pt.Y)%">@pt.Label</span> }
                            }
                        </div>
                    }
                    else { <div class="dcr-noimg">@T("DefectClosureReport.NoImage")</div> }
                </div>
            </div>
            @Footer(1)
        </section>

        <!-- ═════ PAGE 2 ═════ -->
        <section class="dcr-page">
            @Header()
            <div class="dcr-h"><span>3.</span> @T("DefectClosureReport.PhotoEvidence")</div>
            <div class="dcr-2col">
                <div>
                    <div class="dcr-sub">@T("DefectClosureReport.BeforeCorrectiveActionDuringInspection")</div>
                    <div class="dcr-photos">
                        @foreach (var (p, i) in _m.Photos.Take(4).Select((p, i) => (p, i)))
                        { <figure><img src="@Img(p)" /><figcaption>@T("DefectClosureReport.Photo", i + 1)</figcaption></figure> }
                        @if (!_m.Photos.Any()) { <div class="dcr-noimg">@T("DefectClosureReport.NoPhoto")</div> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_m.PhotoNotes)) { <div class="dcr-note">@_m.PhotoNotes</div> }
                </div>
                <div>
                    <div class="dcr-sub">@T("DefectClosureReport.AfterCorrectiveActionDuringReInspection")</div>
                    <div class="dcr-photos">
                        @foreach (var (p, i) in _m.AfterPhotos.Take(4).Select((p, i) => (p, i)))
                        { <figure><img src="@Img(p)" /><figcaption>@T("DefectClosureReport.Photo", _m.Photos.Take(4).Count() + i + 1)</figcaption></figure> }
                        @if (!_m.AfterPhotos.Any()) { <div class="dcr-noimg">@T("DefectClosureReport.NoPhoto")</div> }
                    </div>
                </div>
            </div>

            <div class="dcr-h"><span>4.</span> @T("DefectClosureReport.RootCauseAnalysis")</div>
            <div class="dcr-2col">
                <div>
                    <div class="dcr-sub">@T("DefectClosureReport.RootCauseType")</div>
                    <div class="dcr-checks">
                        @foreach (var r in DefectOptions.RootCauses)
                        { <div><span class="dcr-cb @(_m.RootCauseType == r ? "on" : "")">@(_m.RootCauseType == r ? "✓" : "")</span>@TE("Opt", r)</div> }
                    </div>
                </div>
                <table class="dcr-tbl left">
                    <tr><th>@T("DefectClosureReport.FinalRootCause")</th></tr>
                    <tr><td class="dcr-pre">@(_m.FinalRootCause ?? "—")</td></tr>
                </table>
            </div>
            <table class="dcr-tbl left" style="margin-top:10px">
                <tr><th colspan="2">@T("DefectClosureReport.N5WhyAnalysis")</th></tr>
                <tr class="dcr-th2"><td style="width:80px">@T("DefectClosureReport.Why2")</td><td>@T("DefectClosureReport.Findings")</td></tr>
                @foreach (var (w, i) in new[] { _m.Why1, _m.Why2, _m.Why3, _m.Why4, _m.Why5 }.Select((w, i) => (w, i)))
                { <tr><td class="center">@T("DefectClosureReport.Why", i + 1)</td><td>@(w ?? "")</td></tr> }
            </table>
            @Footer(2)
        </section>

        <!-- ═════ PAGE 3 ═════ -->
        <section class="dcr-page">
            @Header()
            <div class="dcr-h"><span>5.</span> @T("DefectClosureReport.CorrectiveActionRequestCAR")</div>
            <table class="dcr-tbl left">
                <tr><th style="width:24%">@T("Common.CARNo")</th><td style="width:26%">@_m.CarNo</td><th style="width:24%">@T("DefectClosureReport.Priority")</th><td><span class="dcr-badge pri-@(_m.Priority?.ToLower())">@TE("Status", _m.Priority)</span></td></tr>
                <tr><th>@T("DefectClosureReport.ResponsibleDepartment")</th><td>@TE("Opt", _m.ResponsibleDepartment)</td><th>@T("DefectClosureReport.TargetCompletionDate")</th><td>@D(_m.TargetDate)</td></tr>
                <tr><th>@T("DefectClosureReport.ResponsiblePerson")</th><td>@_m.ResponsiblePerson</td><th>@T("DefectClosureReport.OpenDueDate")</th><td>@D(_m.OpenDate) / @D(_m.DueDate)</td></tr>
                <tr><th colspan="4">@T("DefectClosureReport.CorrectiveAction")</th></tr>
                <tr><td colspan="4">
                    <ul class="dcr-ul">
                        @foreach (var line in Lines(_m.CorrectiveAction)) { <li>@line</li> }
                    </ul>
                </td></tr>
            </table>

            <div class="dcr-h"><span>6.</span> @T("DefectClosureReport.CAPATracking")</div>
            <div class="dcr-sub">@T("DefectClosureReport.CorrectiveActionsProgress", _m.Progress)</div>
            <table class="dcr-tbl">
                <tr><th style="width:40px">No.</th><th class="l">@T("Common.Action")</th><th>@T("DefectClosureReport.TargetDate")</th><th>@T("Common.Status")</th><th>@T("DefectClosureReport.CompletionDate")</th></tr>
                @foreach (var (a, i) in _m.CorrectiveActions.Where(a => !string.IsNullOrWhiteSpace(a.Action)).Select((a, i) => (a, i)))
                {
                    <tr><td class="center">@(i + 1)</td><td>@a.Action</td><td class="center">@D(a.TargetDate)</td>
                        <td class="center"><span class="dcr-badge @(a.Done ? "eff-ok" : "eff-mid")">@(a.Done ? T("DefectClosureReport.Completed") : T("DefectClosureReport.Pending"))</span></td>
                        <td class="center">@D(a.CompletionDate)</td></tr>
                }
                @if (!_m.CorrectiveActions.Any(a => !string.IsNullOrWhiteSpace(a.Action))) { <tr><td colspan="5" class="center dcr-mute">@T("DefectClosureReport.NoCorrectiveActionRecorded")</td></tr> }
            </table>
            <div class="dcr-sub" style="margin-top:12px">@T("DefectClosureReport.PreventiveActions")</div>
            <table class="dcr-tbl">
                <tr><th style="width:40px">No.</th><th class="l">@T("Common.Action")</th><th>@T("DefectClosureReport.Frequency")</th><th>@T("Common.Status")</th></tr>
                @foreach (var (a, i) in _m.PreventiveActions.Where(a => !string.IsNullOrWhiteSpace(a.Action)).Select((a, i) => (a, i)))
                {
                    <tr><td class="center">@(i + 1)</td><td>@a.Action</td><td class="center">@TE("Opt", a.Frequency)</td>
                        <td class="center"><span class="dcr-badge @(a.Active ? "act" : "eff-mid")">@(a.Active ? T("Common.Active") : T("Common.Inactive"))</span></td></tr>
                }
                @if (!_m.PreventiveActions.Any(a => !string.IsNullOrWhiteSpace(a.Action))) { <tr><td colspan="4" class="center dcr-mute">@T("DefectClosureReport.NoPreventiveActionRecorded")</td></tr> }
            </table>
            @if (!string.IsNullOrWhiteSpace(_m.CapaRemarks)) { <div class="dcr-note">@T("DefectClosureReport.Remarks", _m.CapaRemarks)</div> }
            @Footer(3)
        </section>

        <!-- ═════ PAGE 4 ═════ -->
        <section class="dcr-page">
            @Header()
            <div class="dcr-h"><span>7.</span> @T("DefectClosureReport.EffectivenessVerification")</div>
            <table class="dcr-tbl center">
                <tr><th>@T("DefectClosureReport.VerificationDate")</th><th>@T("DefectClosureReport.VerifiedBy")</th><th>@T("DefectClosureReport.EffectivenessResult")</th><th>@T("Common.Status")</th></tr>
                <tr><td>@D(_m.VerificationDate)</td><td>@(_m.VerifiedBy ?? "—")</td>
                    <td>@if (!string.IsNullOrEmpty(_m.EffectivenessResult)) { <span class="dcr-badge eff-@(_m.EffectivenessResult == "Effective" ? "ok" : _m.EffectivenessResult == "Not Effective" ? "bad" : "mid")">@TE("Status", _m.EffectivenessResult)</span> } else { <span>—</span> }</td>
                    <td><span class="dcr-badge st-@DefectOptions.StatusCss(_m.Status)">@TE("Status", _m.Status)</span></td></tr>
                <tr><th colspan="4" class="l">@T("DefectClosureReport.VerificationFindings")</th></tr>
                <tr><td colspan="4" class="l"><ul class="dcr-ul">@foreach (var line in Lines(_m.VerificationComments)) { <li>@line</li> }</ul></td></tr>
            </table>

            <div class="dcr-h"><span>8.</span> @T("Common.Reference")</div>
            <table class="dcr-tbl">
                <tr><th style="width:50px">No</th><th class="l">@T("Common.Reference")</th><th class="l">@T("DefectClosureReport.Attached")</th><th class="l">@T("Common.Remark")</th></tr>
                @foreach (var (r, i) in _m.References.Select((r, i) => (r, i)))
                {
                    <tr><td class="center">@(i + 1)</td><td>@r.Reference</td>
                        <td>@if (!string.IsNullOrEmpty(r.FileUrl)) { <a href="@Img(r.FileUrl)" target="_blank">@(r.FileName ?? T("DefectClosureReport.File"))</a> }</td>
                        <td>@r.Remark</td></tr>
                }
                @if (!_m.References.Any()) { <tr><td colspan="4" class="center dcr-mute">@T("DefectClosureReport.NoReference")</td></tr> }
            </table>

            <div class="dcr-h"><span>9.</span> @T("Common.Approval")</div>
            <div class="dcr-approve">
                @foreach (var (title, name, position, sig, signedAt) in new[] {
                    (T("DefectClosureReport.FactoryRepresentative"), _m.FactoryRepName, _m.FactoryRepPosition, _m.FactoryRepSignatureUrl, _m.FactoryRepSignedAt),
                    (T("DefectClosureReport.QAVerification"), _m.QaVerifierName, _m.QaPosition, _m.QaSignatureUrl, _m.QaSignedAt),
                    (T("DefectClosureReport.CustomerApproval"), _m.CustomerApproverName, _m.CustomerPosition, _m.CustomerSignatureUrl, _m.CustomerSignedAt) })
                {
                    <div class="dcr-sign">
                        <div class="dcr-sign-t">@title</div>
                        <div>@T("DefectClosureReport.Name") <b>@(name ?? "")</b></div>
                        <div>@T("DefectClosureReport.Position") <b>@(position ?? "")</b></div>
                        <div class="dcr-sign-box">
                            <span>@T("DefectClosureReport.Signature")</span>
                            @if (!string.IsNullOrEmpty(sig)) { <img src="@Img(sig)" alt="signature" /> }
                        </div>
                        <div>@T("DefectClosureReport.Date", signedAt.HasValue ? L.Date(signedAt.Value.ToLocalTime(), "dd MMM yyyy, HH:mm") : "")</div>
                    </div>
                }
            </div>

            @if (closed)
            {
                <div class="dcr-closed">
                    <div class="dcr-closed-t">@T("DefectClosureReport.DEFECTCLOSED")</div>
                    <div>@T("DefectClosureReport.CorrectiveAndPreventiveActionsHaveBeen")<br />@T("DefectClosureReport.NoRecurrenceWasObservedDuringFollow")</div>
                </div>
            }
            <div class="dcr-thanks">@T("DefectClosureReport.ThankYouForPartneringWithInticoo") <span>@T("DefectClosureReport.QualityPeopleReliableResultsSustainableSupply")</span></div>
            @Footer(4)
        </section>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    DefectCapaModel? _m;
    string? _err;

    protected override async Task OnParametersSetAsync()
    {
        await PageAccess.EnsureLoadedAsync();
        if (!PageAccess.HasAccess("DefectManagement")) { Navigation.NavigateTo("/", replace: true); return; }
        try
        {
            _m = await Http.GetFromJsonAsync<DefectCapaModel>($"api/defects/{Id}",
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (_m != null && string.IsNullOrEmpty(_m.LocationImageUrl))
                _m.LocationImageUrl = _m.ProductPhotoUrl ?? _m.Photos.FirstOrDefault();
        }
        catch (Exception ex) { _err = ex.Message; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_m == null) return;
        // Safari (Mac/iOS) in khổ Letter + header/footer riêng → trang in thấp hơn (xem CSS html.dcr-safari)
        try { await JS.InvokeVoidAsync("eval", "if (/^((?!chrome|chromium|crios|fxios|edg|android).)*safari/i.test(navigator.userAgent)) document.documentElement.classList.add('dcr-safari');"); }
        catch { }
    }

    string ReportNo =>_m?.CarNo?.Replace("CAR-", "DCR-") ?? "DCR";
    string RiskLevel => _m!.Status == "Closed" && _m.EffectivenessResult == "Effective" ? T("DefectClosureReport.Low")
        : _m.Severity == "Critical" ? T("DefectClosureReport.High") : _m.Severity == "Major" ? T("DefectClosureReport.Medium") : T("DefectClosureReport.Low");

    string Img(string? url) => MediaUrl.Resolve(url, Http.BaseAddress?.ToString());
    static string Inv(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string D(DateTime? d) => d.HasValue ? L.Date(d.Value, "dd MMM yyyy") : "—";
    static IEnumerable<string> Lines(string? s) =>
        (s ?? "").Split(new[] { '\n', ';' }, StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim().TrimStart('-', '•', '*').Trim()).Where(x => x != "")
                 .DefaultIfEmpty("—");

    async Task Print() { try { await JS.InvokeVoidAsync("print"); } catch { } }

    RenderFragment Header() => __builder =>
    {
        <div class="dcr-mini">
            <img src="/logo.png" class="dcr-logo sm" alt="inticoo" />
            <div class="dcr-mini-r"><b>@T("DefectClosureReport.DefectClosureReport2")</b><br />@ReportNo</div>
        </div>
    };

    RenderFragment Footer(int pageNo) => __builder =>
    {
        <div class="dcr-foot"><span>@T("DefectClosureReport.QualityToday")<br />@T("DefectClosureReport.BetterTomorrow")</span><span>@T("DefectClosureReport.PageOf4", pageNo)</span></div>
    };
}

<style>
    .dcr-toolbar { max-width:820px; margin:0 auto 12px; display:flex; justify-content:space-between; }
    .dcr-tb-btn { border:none; border-radius:9px; padding:9px 16px; font-size:13px; font-weight:700; cursor:pointer; background:rgba(255,255,255,.18); color:#fff; font-family:inherit; }
    .dcr-tb-btn.primary { background:#fff; color:#1d4ed8; }
    .dcr-loading { color:#fff; text-align:center; padding:40px; }
    .dcr-doc { font-family:"DM Sans",Arial,sans-serif; color:#1a2d5a; }
    .dcr-page { background:#fff; width:794px; max-width:100%; min-height:1100px; margin:0 auto 18px; padding:36px 40px 26px; box-sizing:border-box; position:relative; display:flex; flex-direction:column; box-shadow:0 4px 18px rgba(0,0,0,.15); }
    .dcr-brand { display:flex; justify-content:space-between; align-items:flex-start; }
    .dcr-logo { height:46px; } .dcr-logo.sm { height:30px; }
    .dcr-tag { font-size:8.5px; letter-spacing:.12em; color:#1e40af; margin-top:2px; }
    .dcr-slogan { text-align:right; color:#1d4ed8; font-size:12px; }
    .dcr-titlerow { display:flex; justify-content:space-between; align-items:flex-end; margin:16px 0 14px; }
    .dcr-titlerow h1 { font-size:27px; font-weight:900; margin:0; letter-spacing:-.01em; color:#0f1f47; }
    .dcr-reportno { font-size:11.5px; }
    .dcr-top { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:14px; }
    .dcr-kv { font-size:12px; border-collapse:collapse; } .dcr-kv td { padding:3px 6px 3px 0; } .dcr-kv td:first-child { color:#334155; width:110px; }
    .dcr-stamp { margin-top:10px; border:2px solid #22c55e; border-radius:10px; padding:10px 14px; background:#f0fdf4; }
    .dcr-stamp.pending { border-color:#f59e0b; background:#fffbeb; }
    .dcr-stamp-t { font-size:18px; font-weight:900; color:#15803d; } .dcr-stamp.pending .dcr-stamp-t { color:#b45309; }
    .dcr-stamp-s { font-size:10.5px; color:#15803d; } .dcr-stamp.pending .dcr-stamp-s { color:#92400e; }
    .dcr-h { display:flex; align-items:center; gap:10px; background:#dbe8fb; color:#0f2b6b; font-weight:800; font-size:14px; padding:6px 10px; margin:14px 0 8px; }
    .dcr-h span { background:#1e3a8a; color:#fff; padding:2px 8px; font-size:12px; }
    .dcr-sub { font-size:11.5px; font-weight:800; color:#0f2b6b; margin:4px 0 6px; }
    .dcr-tbl { width:100%; border-collapse:collapse; font-size:11.5px; }
    .dcr-tbl th { background:#f1f5fb; color:#0f2b6b; font-weight:700; padding:6px 8px; border:1px solid #dbe3ef; }
    .dcr-tbl td { padding:6px 8px; border:1px solid #e5eaf2; vertical-align:top; }
    .dcr-tbl.center th, .dcr-tbl.center td, .dcr-tbl .center { text-align:center; }
    .dcr-tbl.left th, .dcr-tbl .l { text-align:left; }
    .dcr-th2 td { background:#f8fafc; font-weight:700; }
    .dcr-pre { white-space:pre-wrap; }
    .dcr-mute { color:#94a3b8; }
