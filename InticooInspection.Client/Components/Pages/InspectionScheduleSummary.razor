    private IEnumerable<JobItem> YearJobs() =>
        _allJobs.Where(j => j.InspectionDate != DateTime.MinValue && j.InspectionDate.Year == _currentYear);

    /// <summary>Job năm hiện tại chưa hoàn thành (New/Delay; không tính Completed, Cancel) — dùng cho hàng KPI trên cùng.</summary>
    private IEnumerable<JobItem> OpenJobs() => YearJobs().Where(IsTodo);

    private int CountOpenType(string t) => OpenJobs().Count(j => string.Equals(j.InspectionType, t, StringComparison.OrdinalIgnoreCase));

    /// <summary>CLC chưa Submitted của năm hiện tại.</summary>
    private int ClcOpenCount() => ClcScoped().Count(c => c.Date.Year == _currentYear);

    private int CountType(string t) => YearJobs().Count(j => string.Equals(j.InspectionType, t, StringComparison.OrdinalIgnoreCase));

    private int ClcMonth(int month) => ClcAllScoped().Count(c => c.Date.Year == _currentYear && c.Date.Month == month);

    /// <summary>CLC còn chờ (chưa Submitted, có ngày), theo inspector đang chọn.</summary>
    private IEnumerable<ClcRow> ClcAllScoped() =>
        string.IsNullOrEmpty(_selInspectorId) || SelectedInspector is null
            ? _clcRows.Concat(_clcDone)
            : _clcRows.Concat(_clcDone).Where(c => string.Equals(c.Inspector, SelectedInspector.FullName, StringComparison.OrdinalIgnoreCase));

    private IEnumerable<ClcRow> ClcScoped() =>
        string.IsNullOrEmpty(_selInspectorId) || SelectedInspector is null
            ? _clcRows
            : _clcRows.Where(c => string.Equals(c.Inspector, SelectedInspector.FullName, StringComparison.OrdinalIgnoreCase));

