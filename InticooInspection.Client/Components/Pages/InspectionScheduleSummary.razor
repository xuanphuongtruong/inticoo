    // ────────────────────────────────────────────
    //  DANH SÁCH LỊCH DÙNG CHUNG: Today / 7 days / 14 days (cùng một format, gộp cả CLC)
    // ────────────────────────────────────────────
    private class SchedItem
    {
        public JobItem? Job; public ClcRow? Clc; public DateTime Date;
        public string No = "", Type = "", Customer = "", Category = "", Vendor = "", Country = "", Inspector = "", Status = "", Po = "";
    }
    private string _slSearch = "", _slVendor = "", _slCategory = "", _slCountry = "", _slStatus = "";
    private int _slPage = 1, _slSize = 10;
    private bool _slFOpen;
    private bool _hideCustomer;   // Inspector không được xem thông tin khách hàng

    private List<SchedItem> BuildSchedItems(List<JobItem> jobs)
    {
        var today = DateTime.Today;
        var list = jobs.Select(j => new SchedItem
        {
            Job = j, Date = j.InspectionDate.Date, No = j.JobNumber ?? $"#{j.Id}", Type = j.InspectionType,
            Customer = _hideCustomer ? "" : j.CustomerName, Category = j.ProductCategory ?? "", Vendor = j.VendorName,
            Country = j.VendorCountry ?? "", Inspector = j.InspectorName ?? "", Status = j.Status, Po = j.PoNumber ?? ""
        }).ToList();
        if (_statusFilter == "todo")
            list.AddRange(ClcForFilter().Select(c => new SchedItem
            {
                Clc = c, Date = c.Date, No = c.JobNumber, Type = "CLC", Customer = _hideCustomer ? "" : c.Customer,
                Category = T("Menu.ContainerLoadingCheck"), Vendor = c.Vendor, Country = "", Inspector = c.Inspector,
                Status = c.Date < today ? "Delay" : "New", Po = ""
            }));
        return list.OrderBy(i => i.Date).ThenBy(i => i.No).ToList();
    }

    private void SlResetPage() => _slPage = 1;
    private void SlSetPage(int p) => _slPage = p;
    private void SlSetSize(int n) { _slSize = n; _slPage = 1; }

    private static MarkupString SlIcon(string key)
    {
        const string a = "<svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" stroke-linecap=\"round\" stroke-linejoin=\"round\">";
        var p = key switch
        {
            "date"     => "<rect x=\"3\" y=\"5\" width=\"18\" height=\"16\" rx=\"2\"/><path d=\"M3 10h18M8 3v4M16 3v4\"/>",
            "po"       => "<path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5M9 13h6M9 17h4\"/>",
            "customer" => "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/>",
            "category" => "<path d=\"M12 3l9 5-9 5-9-5z\"/><path d=\"M3 13l9 5 9-5\"/>",
            "vendor"   => "<path d=\"M4 21V8l8-5 8 5v13\"/><path d=\"M9 21v-6h6v6M9 11h.01M15 11h.01\"/>",
            "country"  => "<path d=\"M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/>",
            _          => "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/>"
        };
        return new MarkupString(a + p + "</svg>");
    }

    // Ô Inspector trong thẻ lịch: ảnh đại diện (hoặc chữ cái đầu) thay cho icon người
    private RenderFragment SlInspectorField(string label, string value, SchedItem item) => __builder =>
