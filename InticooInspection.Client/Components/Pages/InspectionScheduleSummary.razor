    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user      = authState.User;

        // Only Inspector and Admin can start/execute an inspection — và phải có quyền Create/Edit của Inspection Summary
        await PageAccess.EnsureLoadedAsync();
        // Bắt đầu kiểm hàng: Admin, hoặc tài khoản (không phải Customer) có mức "Edit (Use Module)" ở Inspection Schedule
        // — hoặc quyền Create/Edit của Inspection Summary như trước.
        _canStartInspection = user.IsInRole("Admin")
            || (!user.IsInRole("Customer")
                && (PageAccess.Level("InspectionSchedule") >= PermLevel.Edit
                    || ((user.IsInRole("Inspector"))
                        && (PageAccess.Can("SummaryInspections", "Create") || PageAccess.Can("SummaryInspections", "Edit")))));
        _isAdmin = user.IsInRole("Admin");
        _hideCustomer = !_isAdmin && user.IsInRole("Inspector");   // Inspector không được xem thông tin khách hàng

        if (user.IsInRole("Inspector") || user.IsInRole("Customer"))
        {
            var username = user.Identity?.Name
                        ?? user.FindFirst("name")?.Value
                        ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                        ?? "";

            Console.WriteLine($"[Schedule] Role filter — username={username}, isInspector={user.IsInRole("Inspector")}, isCustomer={user.IsInRole("Customer")}");

            if (!string.IsNullOrEmpty(username))
            {
                try
                {
                    var token = await SessionStorage.GetItemAsync<string>("auth_token");
                    if (!string.IsNullOrEmpty(token))
                        Http.DefaultRequestHeaders.Authorization =
                            new AuthenticationHeaderValue("Bearer", token);

                    var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    var json = await Http.GetStringAsync(
                        $"api/users?search={Uri.EscapeDataString(username)}&pageSize=5");

                    Console.WriteLine($"[Schedule] api/users response: {json}");

                    var result = JsonSerializer.Deserialize<UserPageResult>(json, opts);
                    var me = result?.Items?.FirstOrDefault(u =>
                        string.Equals(u.Username, username, StringComparison.OrdinalIgnoreCase));

                    Console.WriteLine($"[Schedule] me={me?.Username}, InspectorId={me?.InspectorId}, CustomerId={me?.CustomerId}");

                    if (me != null)
                    {
                        if (user.IsInRole("Inspector"))
                        {
                            _filterInspectorId = me.InspectorId ?? "";
                            _me = me;
                        }
                        else if (user.IsInRole("Customer"))
                            _filterCustomerId = ""; // khách hàng: API lọc theo danh sách KH được phép (PageAccess.CustomerScope)
                    }

                    Console.WriteLine($"[Schedule] _filterInspectorId={_filterInspectorId}, _filterCustomerId={_filterCustomerId}");
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[InspectionSchedule] Error resolving user filter: {ex.Message}");
                }
            }
        }
        // Admin: không filter, load hết

        // Tải song song: CLC và danh sách inspector không phụ thuộc danh sách job
        var clcTask   = LoadClcNext14();
        var usersTask = FetchInspectorUsers();
        await LoadAllJobs();

        // Fallback: nếu backend không filter được, filter client-side theo customerId/inspectorId
        if (PageAccess.CustomerScope != null)
        {
            _allJobs = _allJobs.Where(j => PageAccess.AllowsCustomer(j.CustomerId)).ToList();
            Console.WriteLine($"[Schedule] After client filter by customer scope: {_allJobs.Count} jobs");
        }
        else if (!string.IsNullOrEmpty(_filterInspectorId))
        {
            _allJobs = _allJobs.Where(j =>
                !string.IsNullOrEmpty(j.InspectorId) &&
                j.InspectorId.Equals(_filterInspectorId, StringComparison.OrdinalIgnoreCase)
            ).ToList();
            Console.WriteLine($"[Schedule] After client filter by inspectorId={_filterInspectorId}: {_allJobs.Count} jobs");
        }

        _allJobsRaw = _allJobs.ToList();
        await LoadInspectorOptions(usersTask);   // Admin: danh sách chọn; mọi role: ảnh QC trên thẻ job

        BuildMonthSummary();

        // Không gọi chi tiết từng job để lấy References nữa: api/inspections (danh sách) đã trả đúng
        // ProductReferences như api/inspections/{id}; trước đây job nào sản phẩm không có reference
        // sẽ bị gọi chi tiết (tối đa 50 request nặng) → màn Inspection Schedule mở rất chậm.
        await clcTask;

        _loading = false;
    }

    /// <summary>
    /// Đảm bảo các job trong khoảng Today → +7 ngày có References.
    /// Nếu backend (GetAll) đã trả references thì không làm gì.
    /// Ngược lại sẽ gọi GET /api/inspections/{id} song song để lấy references.
    /// </summary>
    private async Task EnsureReferencesForUpcomingJobs()
    {
        try
        {
            var today = DateTime.Today;
            var horizon = today.AddDays(14);

            // Chỉ load cho các job trong 14 ngày tới (+ quá hạn) để tránh tốn request
            var targets = _allJobs
                .Where(j => IsTodo(j) &&
                            j.InspectionDate != DateTime.MinValue &&
                            j.InspectionDate.Date <= horizon &&
                            (j.InspectionDate.Date <= today || j.InspectionDate.Date >= today)) // overdue + today + next 7
                .Where(j => j.References.Count == 0) // chỉ fetch nếu chưa có
                .Take(50) // safety cap
                .ToList();

            if (targets.Count == 0)
            {
                Console.WriteLine("[Schedule] EnsureReferences: nothing to load (refs already present or no upcoming jobs)");
                return;
            }

            Console.WriteLine($"[Schedule] EnsureReferences: fetching details for {targets.Count} jobs");

            var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
            var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            // Gọi song song để nhanh hơn
            var tasks = targets.Select(async job =>
            {
                try
                {
                    var json = await Http.GetStringAsync($"api/inspections/{job.Id}");
                    using var doc = JsonDocument.Parse(json);
                    var root = doc.RootElement;
                    if (root.TryGetProperty("references", out var refs) &&
                        refs.ValueKind == JsonValueKind.Array)
                    {
                        int no = 1;
                        var list = new List<JobReference>();
                        foreach (var r in refs.EnumerateArray())
                        {
                            var rawUrl = r.TryGetProperty("fileUrl", out var fu) ? fu.GetString() ?? "" : "";
                            var fullUrl = MediaUrl.Resolve(rawUrl, baseUrl);
                            list.Add(new JobReference
                            {
                                No            = no++,
                                ReferenceName = r.TryGetProperty("referenceName", out var rn) ? rn.GetString() ?? "" : "",
                                FileName      = r.TryGetProperty("fileName",      out var fn) ? fn.GetString() : null,
                                FileUrl       = string.IsNullOrEmpty(fullUrl) ? null : fullUrl,
                            });
                        }
                        job.References = list;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Schedule] EnsureReferences error for job {job.Id}: {ex.Message}");
                }
            });

            await Task.WhenAll(tasks);

            var withRefs = targets.Count(j => j.References.Count > 0);
            Console.WriteLine($"[Schedule] EnsureReferences: {withRefs}/{targets.Count} jobs got references");
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Schedule] EnsureReferences fatal: {ex.Message}");
        }
    }

    private async Task<InspectorPageResult?> FetchInspectorUsers()
    {
        try
        {
            var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            return await Http.GetFromJsonAsync<InspectorPageResult>("api/users?isActive=true&pageSize=500", opts);
        }
        catch (Exception ex) { Console.WriteLine($"[Schedule] Load inspectors error: {ex.Message}"); return null; }
    }

    private async Task LoadAllJobs()
    {
        try
        {
            // Build filter suffix theo role
            var filterSuffix = "";
            if (!string.IsNullOrEmpty(_filterInspectorId))
                filterSuffix = $"&inspectorId={Uri.EscapeDataString(_filterInspectorId)}";
            else if (!string.IsNullOrEmpty(_filterCustomerId))
                filterSuffix = $"&customerId={Uri.EscapeDataString(_filterCustomerId)}";

            var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            // DEBUG: lấy raw JSON để xem chính xác API trả về cái gì
            const int PageSize = 1000;   // ít vòng gọi hơn (mỗi lần gọi API đều nạp lại toàn bộ bảng lookup)
            var rawJson = await Http.GetStringAsync($"api/inspections?page=1&pageSize={PageSize}{filterSuffix}");

            var r1 = JsonSerializer.Deserialize<ApiPageResponse>(rawJson, opts);

            if (r1?.Items == null) return;
            _allJobs = r1.Items.Select(MapToJobItem).ToList();

            // DEBUG: in chi tiết item đầu tiên xem References có không
            if (r1.Items.Count > 0)
            {
                var first = r1.Items[0];
                Console.WriteLine($"[Schedule] First item: id={first.Id}, jobNumber={first.JobNumber}, References={(first.References == null ? "NULL" : first.References.Count.ToString())}");
            }

            int totalPages = (int)Math.Ceiling((double)r1.Total / PageSize);
            for (int p = 2; p <= totalPages; p++)
            {
                var rp = await Http.GetFromJsonAsync<ApiPageResponse>(
                    $"api/inspections?page={p}&pageSize={PageSize}{filterSuffix}", opts);
                if (rp?.Items != null)
                    _allJobs.AddRange(rp.Items.Select(MapToJobItem));
            }

            // Job request còn nháp (Draft) chưa giao inspector → không hiện trên lịch
            _allJobs.RemoveAll(j => string.Equals(j.Status, "Draft", StringComparison.OrdinalIgnoreCase));

            // Debug: kiểm tra references có được API trả về không
            var jobsWithRefs = _allJobs.Count(j => j.References.Count > 0);
            Console.WriteLine($"[Schedule] Loaded {_allJobs.Count} jobs, {jobsWithRefs} have references");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[InspectionScheduleSummary] Error: {ex.Message}");
        }
    }

    private JobItem MapToJobItem(ApiItem i)
    {
        var baseUrl = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";

        var refs = (i.References ?? new())
            .Select((r, idx) =>
            {
                var rawUrl  = r.FileUrl ?? "";
                var fullUrl = MediaUrl.Resolve(rawUrl, baseUrl);
                return new JobReference
                {
                    No            = idx + 1,
                    ReferenceName = r.ReferenceName ?? "",
                    FileName      = r.FileName,
                    FileUrl       = string.IsNullOrEmpty(fullUrl) ? null : fullUrl,
                };
            })
            .ToList();

        return new JobItem
        {
            Id              = i.Id,
            JobNumber       = i.JobNumber ?? i.Title,
            Title           = i.Title      ?? "",
            CustomerName    = _hideCustomer ? "" : (i.CustomerName ?? ""),
            CustomerId      = i.CustomerId,
            ProductCategory = string.IsNullOrEmpty(i.ProductCategory) ? null : i.ProductCategory,
            ProductType     = string.IsNullOrEmpty(i.ProductType)     ? null : i.ProductType,
            InspectionType  = i.InspectionType ?? "DPI",
            VendorName      = i.VendorName  ?? "",
            VendorAddress   = string.IsNullOrEmpty(i.VendorAddress)   ? null : i.VendorAddress,
            VendorAddress1  = string.IsNullOrEmpty(i.VendorAddress1)  ? null : i.VendorAddress1,
            VendorAddress2  = string.IsNullOrEmpty(i.VendorAddress2)  ? null : i.VendorAddress2,
            VendorCity      = string.IsNullOrEmpty(i.VendorCity)      ? null : i.VendorCity,
            VendorState     = string.IsNullOrEmpty(i.VendorState)     ? null : i.VendorState,
            VendorCountry   = string.IsNullOrEmpty(i.VendorCountry)   ? null : i.VendorCountry,
            VendorContactName     = i.VendorContactName,
            VendorContactPosition = i.VendorContactPosition,
            VendorContactMobile   = i.VendorContactMobile,
            VendorContactOffice   = i.VendorContactOffice,
            VendorContactEmail    = i.VendorContactEmail,
            InspectorName   = i.InspectorName,
            InspectorId     = i.InspectorId,
            InspectorMobile = i.InspectorMobile,
            Status          = i.Status      ?? "New",
            InspectionDate  = i.InspectionDate ?? DateTime.MinValue,
            CreatedAt       = i.CreatedAt,
            CompletedAt     = i.CompletedAt,
            OverallResult   = null,
            FinalResult     = i.FinalResult,
            ReportUrl       = null,
            PoNumber        = i.PoNumber,
            ItemNumber      = i.ItemNumber,
            ProductName     = i.ProductName,
            References      = refs,
        };
    }

    private void BuildMonthSummary()
    {
        // Monthly grid: đếm job chờ + trễ (không đếm Completed) theo từng tháng trong năm hiện tại
        var year = _currentYear;
        _monthSummary = Enumerable.Range(1, 12).Select(m =>
        {
            var cnt  = _allJobs.Count(j =>
                j.InspectionDate != DateTime.MinValue &&
                j.InspectionDate.Year  == year &&
                j.InspectionDate.Month == m);
            return new MonthStat(m, cnt);
        }).ToList();
    }

