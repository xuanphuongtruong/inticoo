        flex: 1 1 auto;
        min-width: 0;
        overflow-wrap: anywhere;   /* break các từ siêu dài như email/url */
        word-break: break-word;    /* fallback cho Safari cũ */
    }
    .iss-chevron { flex-shrink: 0; margin-left: 6px; }

    @@media (min-width: 768px) {
        .iss-ll { font-size: 12px; min-width: 120px; }
        .iss-lv { font-size: 13px; }
    }

    /* ══════════ 14-DAY TABLE (≥ 600px) ══════════ */
    .iss-cal-table-wrap { display: none; }

    .iss-cal-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 10px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,.06);
    }
    .iss-cal-cell {
        width: 50%; vertical-align: top;
        border: 1px solid #e4eaf4;
        padding: 10px 12px;
    }
    .iss-cal-cell.cell-has { background: #fafcff; }
    .iss-cal-date {
        font-size: 12px; font-weight: 700; color: #1a1a2e;
        margin-bottom: 6px; padding-bottom: 4px;
        border-bottom: 1px solid #f0f3f8;
    }
    .iss-cal-job {
        padding: 5px 0; cursor: pointer;
        border-top: 1px dashed #eee; margin-top: 4px;
        transition: color .15s;
    }
    .iss-cal-job:first-of-type { border-top: none; margin-top: 0; }
    .iss-cal-job:hover .iss-cj-cat { color: #1565c0; }
    .iss-cj-cat { font-size: 11px; color: #333; display: block; margin-top: 2px; }
    .iss-cj-vendor { font-size: 10px; color: #999; }

    /* ══════════ 14-DAY MOBILE CARDS ══════════ */
    .iss-cal-mobile { display: block; }

    .iss-cal-day {
        background: white;
        border-radius: 10px;
        margin-bottom: 8px;
        overflow: hidden;
        border: 1px solid #e4eaf4;
        box-shadow: 0 1px 4px rgba(0,0,0,.05);
    }
    .iss-cal-day.cday-empty { opacity: .75; }
    .iss-cal-day-hdr {
        display: flex; align-items: center; justify-content: space-between;
        padding: 9px 14px;
        background: #f6f8fc;
        border-bottom: 1px solid #eef1f7;
    }
    .iss-cal-day-name { font-size: 13px; font-weight: 700; color: #1a1a2e; }
    .iss-cal-day-cnt  { font-size: 11px; font-weight: 700; color: #1565c0; background: #e8f0fe; padding: 2px 8px; border-radius: 10px; }
    .iss-cal-day-empty { font-size: 12px; color: #ccc; padding: 10px 14px; }

    .iss-cal-row {
        display: flex; align-items: center; gap: 8px;
        padding: 9px 14px;
        cursor: pointer;
        border-bottom: 1px solid #f5f7fa;
        transition: background .15s;
    }
    .iss-cal-row:last-child { border-bottom: none; }
    .iss-cal-row:hover { background: #f0f8ff; }
    .iss-cal-info { flex: 1; font-size: 12px; color: #444; }

    /* ══════════ DETAIL PAGE ══════════ */
    .iss-detail-wrap {
        max-width: none; width: 100%; margin: 0;   /* trải hết bề ngang vùng nội dung (mẫu của khách là bố cục 2 cột) */
        padding: 20px 16px;
    }
    @@media (min-width: 640px)  { .iss-detail-wrap { padding: 24px 24px; } }
    @@media (min-width: 1024px) { .iss-detail-wrap { padding: 24px 28px; } }

    .iss-back-btn {
        display: flex; align-items: center; gap: 4px;
        background: none; border: none;
        font-size: 14px; color: #2D7DD2; font-weight: 600;
        cursor: pointer; padding: 0 0 18px 0;
        transition: color .2s;
    }
    .iss-back-btn:hover { color: #1565c0; }

    .iss-detail-card {
        background: white; border-radius: 14px;
        padding: 20px 20px 16px;
        box-shadow: 0 3px 14px rgba(0,0,0,.09);
    }
    .iss-detail-badge {
        display: inline-block;
        font-size: 11px; font-weight: 700;
        padding: 4px 12px; border-radius: 12px;
        margin-bottom: 14px;
    }

    .iss-field-group { margin-bottom: 12px; }
    .iss-field {
        display: flex; gap: 10px;
        padding: 8px 0;
        border-bottom: 1px solid #f5f7fa;
        align-items: baseline;
    }
    .iss-field:last-child { border-bottom: none; }
    .iss-fl { font-size: 13px; font-weight: 600; color: #2D7DD2; min-width: 130px; flex-shrink: 0; }
    .iss-fv { font-size: 13px; color: #1a1a2e; word-break: break-word; }
    /* Job Number — luôn tô đậm để dễ nhận biết */
    .iss-fv-strong { font-weight: 800; color: #1565c0; letter-spacing: -.2px; }
    .iss-lv-strong { font-weight: 800; color: #1565c0; letter-spacing: -.2px; }

    .iss-vendor-section { background: #f7f9fc; border-radius: 8px; padding: 12px 14px; margin-top: 4px; }
    .iss-vendor-title { font-size: 11px; font-weight: 700; color: #2D7DD2; margin-bottom: 8px; text-transform: uppercase; letter-spacing: .04em; }
    .iss-vi-row { display: flex; align-items: baseline; gap: 6px; margin-bottom: 5px; }
    .iss-vi-dot { color: #bbb; }
    .iss-vi-label { font-size: 12px; color: #888; min-width: 70px; flex-shrink: 0; }
    .iss-vi-val { font-size: 13px; color: #333; }

    .iss-start-btn {
        display: flex; align-items: center; justify-content: center; gap: 8px;
        background: linear-gradient(135deg, #27ae60, #1e8449);
        color: white; border: none; border-radius: 12px;
        padding: 14px 0; font-size: 15px; font-weight: 700;
        cursor: pointer; width: 100%; margin-top: 20px;
        transition: all .2s;
        box-shadow: 0 4px 14px rgba(39,174,96,.35);
    }
    .iss-start-btn:hover { box-shadow: 0 6px 20px rgba(39,174,96,.45); transform: translateY(-1px); }

    /* ══════════ COMPLETED — CARD GRID ══════════ */
    .iss-section-title {
        display: flex; align-items: center; gap: 10px;
    }
    .iss-section-count {
        font-size: 12px; font-weight: 600;
        color: #2D7DD2; background: #e8f0fe;
        padding: 2px 9px; border-radius: 10px;
        margin-left: auto;
    }

    .iss-comp-card {
        background: white;
        border-radius: 14px;
        margin-bottom: 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.07);
        border: 1px solid #e8edf6;
        overflow: hidden;
        transition: box-shadow .2s, transform .15s;
    }
    .iss-comp-card:hover {
        box-shadow: 0 6px 20px rgba(0,0,0,.11);
        transform: translateY(-2px);
    }

    /* Card header */
    .iss-comp-card-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 12px 16px 10px;
        border-bottom: 1px solid #f0f3f8;
        background: #fafbfe;
    }
    .iss-comp-card-left  { display: flex; align-items: center; gap: 8px; }
    .iss-comp-card-right { display: flex; align-items: center; }
    .iss-comp-jobno {
        font-size: 13px; font-weight: 800;
        color: #1565c0; letter-spacing: -.2px;
    }

    /* Card body */
    .iss-comp-card-body {
        padding: 10px 16px 6px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2px 16px;
    }
    @@media (max-width: 480px) {
        .iss-comp-card-body { grid-template-columns: 1fr; }
    }

    .iss-comp-field {
        display: flex; flex-direction: column;
        padding: 6px 0;
        border-bottom: 1px solid #f5f7fa;
    }
    .iss-comp-field:nth-last-child(-n+2) { border-bottom: none; }
    @@media (max-width: 480px) {
        .iss-comp-field:last-child { border-bottom: none; }
        .iss-comp-field:nth-last-child(2) { border-bottom: 1px solid #f5f7fa; }
    }

    .iss-comp-label {
        font-size: 10px; font-weight: 600;
        color: #aab; text-transform: uppercase;
        letter-spacing: .06em;
        display: flex; align-items: center; gap: 4px;
        margin-bottom: 2px;
    }
    .iss-comp-val {
        font-size: 13px; color: #1a1a2e;
        font-weight: 500;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* Card footer */
    .iss-comp-card-footer {
        padding: 10px 16px 12px;
        border-top: 1px solid #f0f3f8;
        display: flex; justify-content: flex-end;
        background: #fafbfe;
    }

    .iss-report-btn {
        display: inline-flex; align-items: center; gap: 6px;
        background: linear-gradient(135deg, #2D7DD2, #1a5fa8);
        color: white; border: none; border-radius: 9px;
        padding: 8px 18px;
        font-size: 13px; font-weight: 700;
        cursor: pointer;
        transition: all .2s;
        box-shadow: 0 3px 10px rgba(45,125,210,.35);
        letter-spacing: .01em;
    }
    .iss-report-btn:hover {
        background: linear-gradient(135deg, #1a5fa8, #134d8f);
        box-shadow: 0 5px 16px rgba(45,125,210,.45);
        transform: translateY(-1px);
    }
    .iss-report-btn:active { transform: translateY(0); }

    /* Result badge */
    .iss-result-badge {
        display: inline-flex; align-items: center; gap: 4px;
        font-size: 11px; font-weight: 700;
        padding: 3px 10px; border-radius: 10px;
        text-transform: uppercase; letter-spacing: .04em;
    }
    .res-pass, .res-passed { background: #e8f5e9; color: #2e7d32; }
    .res-fail, .res-failed { background: #fce4ec; color: #c62828; }
    .res-na   { background: #f5f5f5; color: #999; }

    .iss-comp-na { color: #bbb; }

    /* ── 14 days: Export PDF button ── */
    .iss-14days-header {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; flex-wrap: wrap; margin-bottom: 10px;
    }
    .iss-14days-header .iss-section-title { margin: 0; }
    .iss-export-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 16px;
        background: linear-gradient(135deg, #2d7dd2, #1565c0);
        color: #fff; border: none; border-radius: 8px;
        font-family: "DM Sans", sans-serif; font-size: 13px; font-weight: 600;
        cursor: pointer; white-space: nowrap;
        box-shadow: 0 3px 10px rgba(30,144,214,.3);
        transition: background .2s, transform .1s, box-shadow .2s;
    }
    .iss-export-btn:hover { background: linear-gradient(135deg, #1a5fa8, #134d8f); box-shadow: 0 5px 16px rgba(30,144,214,.4); transform: translateY(-1px); }
    .iss-export-btn:active { transform: translateY(0); }

    /* Print-only header cho PDF */
    .iss-print-header { margin-bottom: 14px; padding-bottom: 10px; border-bottom: 2px solid #1a2d5a; }
    .iss-print-header h2 { font-family: "Sora", sans-serif; font-size: 18px; font-weight: 700; color: #1a2d5a; margin: 0 0 4px; }
    .iss-print-sub { font-size: 12px; color: #6b7a90; }

    /* Mặc định ẩn trên màn hình */
    .print-only { display: none; }

    /* ═════════ PRINT STYLES — chỉ in vùng 14 days ═════════ */
    @@media print {
        /* Ẩn toàn bộ trang */
        body * { visibility: hidden !important; }

        /* Chỉ hiện nội dung trong vùng print-area và con cháu của nó */
        #iss-print-area-14days, #iss-print-area-14days * { visibility: visible !important; }

        /* Đưa vùng print lên đầu trang in */
        #iss-print-area-14days {
            position: absolute !important;
            left: 0; top: 0;
            width: 100%;
            padding: 10mm;
            background: #fff !important;
            color: #000 !important;
        }

        /* Hiện print-only header */
        .print-only { display: block !important; }

        /* Ẩn các element đánh dấu no-print (nút Export, tabs, v.v.) */
        .no-print { display: none !important; }

        /* Ẩn mobile view — in chỉ dạng bảng 2 cột */
        .iss-cal-mobile { display: none !important; }
        .iss-cal-table-wrap { display: block !important; }

        /* Khung bảng dễ đọc khi in */
        .iss-cal-table { border-collapse: collapse; width: 100%; font-size: 11px; }
        .iss-cal-table td { border: 1px solid #444; padding: 6px; vertical-align: top; }
        .iss-cal-cell { min-height: 80px; }
        .iss-cal-date { font-weight: 700; font-size: 12px; margin-bottom: 4px; color: #000; }
        .iss-cal-job { margin-bottom: 4px; padding: 4px 6px; border-left: 3px solid #1565c0; background: #f5f5f5 !important; page-break-inside: avoid; }
        .iss-it-badge { display: inline-block; padding: 1px 6px; border: 1px solid #555; border-radius: 3px; font-size: 10px; font-weight: 700; background: #fff !important; color: #000 !important; margin-bottom: 2px; }
        .iss-cj-cat { font-size: 11px; color: #000; }
        .iss-cj-vendor { font-size: 10px; color: #555; }

        /* Ẩn chevron / icon không cần thiết */
        .iss-chevron { display: none !important; }

        /* Trang giấy */
        @@page { size: A4 landscape; margin: 10mm; }
    }

    /* ══════════ Product References — collapsed header + popup ══════════ */
    .iss-refs-collapsed .iss-refs-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
    }
    .iss-refs-count {
        font-size: 12px;
        color: #6b7c93;
        font-weight: 500;
        margin-right: auto;
        margin-left: 8px;
    }
    .iss-refs-view-all-btn {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        background: #fff;
        color: #2D7DD2;
        border: 1px solid #2D7DD2;
        border-radius: 7px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s, color .15s;
        -webkit-tap-highlight-color: transparent;
        -webkit-appearance: none;
        appearance: none;
        font-family: inherit;
        white-space: nowrap;
    }
    .iss-refs-view-all-btn:hover,
    .iss-refs-view-all-btn:active {
        background: #2D7DD2;
        color: #fff;
    }

    /* Popup modal */
    .iss-refs-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 25, 50, .55);
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        -webkit-backdrop-filter: blur(2px);
        backdrop-filter: blur(2px);
    }
    .iss-refs-modal {
        background: #fff;
        border-radius: 12px;
        width: 100%;
        max-width: 640px;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 20px 60px rgba(0,0,0,.3);
        overflow: hidden;
    }
    .iss-refs-modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 18px;
        border-bottom: 1px solid #e8eef5;
        background: #f8faff;
    }
    .iss-refs-modal-title {
        font-size: 15px;
        font-weight: 700;
        color: #2D7DD2;
    }
    .iss-refs-modal-close {
        background: transparent;
        border: none;
        font-size: 20px;
        line-height: 1;
        color: #6b7c93;
        cursor: pointer;
        padding: 4px 8px;
        border-radius: 6px;
        -webkit-tap-highlight-color: transparent;
        -webkit-appearance: none;
        appearance: none;
    }
    .iss-refs-modal-close:hover {
        background: #e8eef5;
        color: #1a1a2e;
    }
    .iss-refs-modal-body {
        padding: 14px 18px;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        flex: 1 1 auto;
    }
    .iss-refs-modal-footer {
        padding: 12px 18px;
        border-top: 1px solid #e8eef5;
        text-align: right;
        background: #fafbfd;
    }
    .iss-refs-modal-ok {
        background: #2D7DD2;
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: 7px 18px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        -webkit-tap-highlight-color: transparent;
        -webkit-appearance: none;
        appearance: none;
        font-family: inherit;
    }
    .iss-refs-modal-ok:hover {
        background: #1a5fa8;
    }

    @@media (max-width: 480px) {
        .iss-refs-collapsed .iss-refs-header { gap: 8px; }
        .iss-refs-count { width: 100%; margin: 0; order: 3; }
        .iss-refs-view-all-btn { padding: 6px 14px; }
    }

    /* ── Inspector Schedule header / chọn inspector ── */
    .iss-page-head { display:flex; justify-content:space-between; align-items:flex-end; gap:16px; flex-wrap:wrap; padding:20px 16px 14px; }
    @@media (min-width:640px) { .iss-page-head { padding:24px 32px 16px; } }
    @@media (min-width:1024px) { .iss-page-head { padding:26px 40px 16px; } }
    .iss-page-title { font-size:30px; font-weight:800; color:#0f1f47; margin:0; letter-spacing:-.01em; }
    .iss-page-sub { font-size:14px; color:#64748b; margin-top:2px; }
    .iss-insp-picker { display:flex; align-items:flex-end; gap:14px; }
    .iss-clear-filter { background:none; border:none; color:#1d4ed8; text-decoration:underline; font-size:13.5px; font-weight:600; cursor:pointer; padding:10px 0; font-family:inherit; }
    .iss-dd-wrap { position:relative; }
    .iss-dd-label { font-size:12.5px; font-weight:600; color:#1a2d5a; margin-bottom:4px; }
    .iss-dd-btn { display:flex; align-items:center; gap:10px; min-width:300px; background:#fff; border:2px solid #dbe5f3; border-radius:12px;
        padding:6px 12px; cursor:pointer; font-family:inherit; color:#1a2d5a; font-size:14px; }
    .iss-dd-btn.open { border-color:#2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.15); }
    .iss-dd-text { flex:1; text-align:left; white-space:normal; overflow-wrap:anywhere; }
    .iss-dd-caret { color:#1a2d5a; flex-shrink:0; }
    .iss-dd-allico { width:30px; height:30px; border-radius:50%; background:#eef4ff; color:#1d4ed8; display:inline-flex; align-items:center; justify-content:center; flex-shrink:0; }
    .iss-dd-allico.sm { width:28px; height:28px; background:none; color:#1a2d5a; }
    .iss-dd-backdrop { position:fixed; inset:0; z-index:40; }
    .iss-dd-menu { position:absolute; right:0; top:calc(100% + 6px); width:100%; min-width:300px; z-index:50; background:#fff; border-radius:12px;
        box-shadow:0 12px 32px rgba(15,40,90,.22); padding:8px; }
    .iss-dd-search { display:flex; align-items:center; gap:8px; background:#f5f7fb; border:1px solid #e5eaf2; border-radius:9px; padding:8px 10px; color:#64748b; margin-bottom:6px; }
    .iss-dd-search input { border:none; background:none; outline:none; flex:1; font-size:13.5px; font-family:inherit; color:#1a2d5a; }
    .iss-dd-list { max-height:320px; overflow-y:auto; }
    .iss-dd-item { display:flex; align-items:center; gap:10px; padding:8px 10px; border-radius:8px; cursor:pointer; font-size:14px; color:#1a2d5a; }
    .iss-dd-item:hover { background:#f5f8ff; }
    .iss-dd-item.sel { background:#eaf2ff; }
    .iss-dd-item.sel .iss-dd-name b { color:#1d4ed8; }
    .iss-dd-check { width:16px; color:#1d4ed8; font-weight:800; flex-shrink:0; }
    .iss-dd-name { flex:1; min-width:0; white-space:normal; overflow-wrap:anywhere; }
    .iss-dd-cnt { font-size:11px; font-weight:700; background:#fff3e6; color:#c2410c; border-radius:10px; padding:1px 8px; }
    .iss-dd-empty { text-align:center; color:#94a3b8; font-size:13px; padding:12px; }
    .iss-avatar { border-radius:50%; background:linear-gradient(135deg,#60a5fa,#2563eb); color:#fff; font-weight:800; display:inline-flex;
        align-items:center; justify-content:center; overflow:hidden; flex-shrink:0; box-shadow:0 0 0 2px #fff; }
    .iss-avatar img { width:100%; height:100%; object-fit:cover; }
    .iss-sched-chip { display:inline-flex; align-items:center; gap:12px; background:#eaf2ff; border-radius:14px; padding:8px 18px 8px 10px; color:#1a2d5a; font-size:14px; }
    .iss-sched-chip b { color:#1d4ed8; font-size:16px; }
    .iss-sc-sep { width:1px; height:24px; background:#c7d7f0; }
    .iss-sc-id { font-weight:600; color:#334155; }
    .iss-sel-title { font-size:17px; font-weight:800; color:#1a2d5a; }
    .iss-today-head { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
    .iss-today-cnt { font-size:13px; color:#64748b; }
    .iss-jc-insp { display:flex; align-items:center; gap:8px; font-size:12.5px; color:#334155; padding:8px 14px; border-top:1px dashed #e5eaf2; }
    .iss-cj-insp { font-size:10.5px; color:#1d4ed8; font-weight:600; margin-top:2px; }
    @@media (max-width:700px) {
        .iss-page-title { font-size:22px; }
        .iss-insp-picker { width:100%; flex-direction:column-reverse; align-items:stretch; gap:4px; }
        .iss-clear-filter { padding:2px 0; text-align:right; }
        .iss-dd-btn, .iss-dd-menu { min-width:0; width:100%; }
        .iss-sched-chip { font-size:13px; padding:6px 12px 6px 8px; }
        .iss-sched-chip b { font-size:14px; }
    }

    /* ── KPI Next 14 days ── */
    /* KPI theo bố cục cũ khách thích (17/11/2026): desktop 5 thẻ đều nhau trải hết hàng;
       điện thoại Total Jobs một hàng riêng, 4 thẻ PPI/DPI/PSI/CLC chia đều 1 hàng — thu nhỏ để không tràn khung. */
