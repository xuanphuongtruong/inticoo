    private RenderFragment SlField(string icon, string label, string value) => @<text>
        <div class="sl-f">
            <span class="sl-ic">@SlIcon(icon)</span>
            <span class="sl-ft"><small>@label</small><b>@(string.IsNullOrWhiteSpace(value) ? "—" : value)</b></span>
        </div>
    </text>;

    private IEnumerable<int> SlPageNumbers(int pages, int cur)
    {
        for (int i = 1; i <= pages; i++)
            if (i == 1 || i == pages || Math.Abs(i - cur) <= 1) yield return i;
            else if (i == 2 || i == pages - 1) yield return 0;
    }

    private RenderFragment ScheduleListFrag(List<JobItem> jobs) => @<text>
        @{
