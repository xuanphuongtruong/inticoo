                    </div>
                }
            </div>
        }
    </text>;

    private async Task LoadClcNext14()
    {
        try
        {
            var json = await Http.GetStringAsync("api/clc?page=1&pageSize=200");
            using var doc = JsonDocument.Parse(json);
            if (!doc.RootElement.TryGetProperty("items", out var items)) return;
            var today = DateTime.Today; var end = today.AddDays(14);
            int n = 0;
            var list = new List<ClcRow>();
            var allInsp = new List<string>();
            var done = new List<ClcRow>();
            string S(JsonElement e, string k) => e.TryGetProperty(k, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";
            foreach (var it in items.EnumerateArray())
            {
                var st = S(it, "status");
                if (st == "Submitted")
                {
                    // Đã hoàn thành: không vào danh sách lịch, nhưng vẫn được đếm trong Total và lưới tháng
                    DateTime dd = default;
                    var okDate = (it.TryGetProperty("plannedLoadingDate", out var pd2) && pd2.ValueKind == JsonValueKind.String && DateTime.TryParse(pd2.GetString(), out dd))
                              || (it.TryGetProperty("inspectionDate", out var id2) && id2.ValueKind == JsonValueKind.String && DateTime.TryParse(id2.GetString(), out dd));
                    if (okDate) done.Add(new ClcRow { Id = it.GetProperty("id").GetInt32(), JobNumber = S(it, "jobNumber"), Status = st,
                        Inspector = S(it, "inspectorName"), Date = dd.Date });
                    continue;
                }
                allInsp.Add(S(it, "inspectorName"));
                if (!(it.TryGetProperty("plannedLoadingDate", out var pd) && pd.ValueKind == JsonValueKind.String
                      && DateTime.TryParse(pd.GetString(), out var d))) continue;
                list.Add(new ClcRow { Id = it.GetProperty("id").GetInt32(), JobNumber = S(it, "jobNumber"), Status = st,
                    Customer = S(it, "customerName"), Vendor = S(it, "vendorName"), ContainerNo = S(it, "containerNo"),
                    ContainerType = S(it, "containerType"), Inspector = S(it, "inspectorName"), Date = d.Date });
                if (d.Date >= today && d.Date < end) n++;
            }
            _clcRows = list;
            _clcDone = done;
            _clcAllInspectors = allInsp;
            _clcNext14 = n;
        }
        catch { _clcNext14 = 0; }
    }

    // KPI tính trên toàn bộ job (đã lọc theo QC đang chọn), không giới hạn 14 ngày
    private int ClcCount() => ClcAllScoped().Count(c => c.Date.Year == _currentYear);
