@page "/inspection-schedule"
@using System.Globalization
@using InticooInspection.Domain.Security
@using System.Net.Http.Json
@using System.Text.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject IJSRuntime JS
@inject PageAccessService PageAccess
@inherits LocalizedComponentBase

<div class="iss-page">

    <!-- ═══════════════════════ LOADING ═══════════════════════ -->
    @if (_loading)
    {
        <div class="iss-loading">
            <div class="iss-spinner"></div>
            <span>@T("InspectionScheduleSummary.LoadingSchedule")</span>
        </div>
    }
    else if (_view == View.JobDetail && _selectedJob != null)
    {
        <!-- ═══════════════════════ JOB DETAIL ═══════════════════════ -->
        <div class="iss-detail-wrap">
            <button class="iss-back-btn" @onclick="GoBack">
                <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 15l-5-5 5-5"/>
                </svg>
                @T("Common.Back")
            </button>

            @if (_detailLoading)
            {
                <div style="display:flex;align-items:center;justify-content:center;padding:32px;gap:12px;color:#888;font-size:14px;">
                    <div class="iss-spinner"></div>
                    <span>@T("InspectionScheduleSummary.LoadingDetails")</span>
                </div>
            }

            <div class="dt-card">
                <div class="dt-crumb">
                    <button type="button" class="dt-back" @onclick="GoBack">&lsaquo; @T("Common.Back")</button>
                    <span>@T("Menu.InspectionSchedule") &rsaquo; <b>@(_selectedJob.JobNumber ?? $"#{_selectedJob.Id}")</b></span>
                </div>
                <div class="dt-head">
                    <h2>@(_selectedJob.JobNumber ?? $"#{_selectedJob.Id}")</h2>
                    <span class="iss-it-badge it-@_selectedJob.InspectionType.ToLower()">@TE("Opt", _selectedJob.InspectionType)</span>
                    <div class="dt-head-r">
                        <span class="iss-st-pill @GetStatusClass(_selectedJob.Status)">@TE("Status", _selectedJob.Status)</span>
                        @if (!_canStartInspection) { <span class="dt-viewonly">&#128065; @T("InspectionScheduleSummary.ViewOnly")</span> }
                    </div>
                </div>
                <div class="dt-facts">
                    <div class="dt-fact"><span class="dt-fi">@SlIcon("date")</span><span><small>@T("Common.InspectionDate")</small><b>@L.Date(_selectedJob.InspectionDate, "ddd, d MMM yyyy")</b></span></div>
                    <div class="dt-fact"><span class="dt-fi">@SlIcon("category")</span><span><small>@T("Common.Category")</small><b>@(_selectedJob.ProductCategory ?? "—")</b></span></div>
                    <div class="dt-fact"><span class="dt-fi">@SlIcon("po")</span><span><small>@T("InspectionScheduleSummary.PONumber")</small><b>@(string.IsNullOrEmpty(_selectedJob.PoNumber) ? "—" : _selectedJob.PoNumber)</b></span></div>
                    <div class="dt-fact"><span class="dt-fi">@SlIcon("category")</span><span><small>@T("Common.ProductCode")</small><b>@(string.IsNullOrEmpty(_selectedJob.ItemNumber) ? "—" : _selectedJob.ItemNumber)</b></span></div>
                </div>

                @if (_detailLoading)
                {
                    <div class="dt-loading"><div class="iss-spinner"></div><span>@T("InspectionScheduleSummary.LoadingDetails")</span></div>
                }

                @{
                    var vParts = new[] { _selectedJob.VendorCity, _selectedJob.VendorCountry }.Where(x => !string.IsNullOrWhiteSpace(x));
                    bool hasContact = !string.IsNullOrEmpty(_selectedJob.VendorContactName) || !string.IsNullOrEmpty(_selectedJob.VendorContactPosition)
                                   || !string.IsNullOrEmpty(_selectedJob.VendorContactMobile) || !string.IsNullOrEmpty(_selectedJob.VendorContactEmail);
                }
                <div class="dt-grid">
                    <div class="dt-left">
                        <div class="dt-prod"><span class="dt-pi">@SlIcon("category")</span><div><small>@T("Common.ProductName")</small><b>@(string.IsNullOrEmpty(_selectedJob.ProductName) ? "—" : _selectedJob.ProductName)</b></div>
                            @if (_selectedJobPhotos.Count > 0)
                            {
                                <a class="dt-pthumb" href="@_selectedJobPhotos[0]" target="_blank" rel="noopener" title="@T("Common.View")">
                                    <img src="@_selectedJobPhotos[0]" alt="" loading="lazy" />
                                    @if (_selectedJobPhotos.Count > 1) { <em>+@(_selectedJobPhotos.Count - 1)</em> }
                                </a>
                            }
                        </div>
                        @if (!_hideCustomer)
                        {
                            <div class="dt-row"><div class="dt-rl">@SlIcon("vendor") @T("Common.Customer")</div><div class="dt-rv"><b>@_selectedJob.CustomerName</b></div></div>
                        }
                        <div class="dt-row"><div class="dt-rl">@SlIcon("po") @T("Common.InspectionType")</div><div class="dt-rv"><span class="iss-it-badge it-@_selectedJob.InspectionType.ToLower()">@TE("Opt", _selectedJob.InspectionType)</span></div></div>
                        <div class="dt-row"><div class="dt-rl">@SlIcon("vendor") @T("Common.Vendor")</div>
                            <div class="dt-rv">
                                <b>@_selectedJob.VendorName</b>
                                @if (vParts.Any()) { <div class="dt-sub">@SlIcon("country") @string.Join(", ", vParts)</div> }
                                @if (hasContact)
                                {
                                    <div class="dt-contact">
                                        @if (!string.IsNullOrEmpty(_selectedJob.VendorContactName)) { <div><span>@T("Common.ContactName")</span><b>@_selectedJob.VendorContactName</b></div> }
                                        @if (!string.IsNullOrEmpty(_selectedJob.VendorContactPosition)) { <div><span>@T("Common.Position")</span><b>@_selectedJob.VendorContactPosition</b></div> }
                                        @if (!string.IsNullOrEmpty(_selectedJob.VendorContactMobile)) { <div><span>@T("Common.Mobile")</span><b>@_selectedJob.VendorContactMobile</b></div> }
                                        @if (!string.IsNullOrEmpty(_selectedJob.VendorContactEmail)) { <div><span>Email</span><b>@_selectedJob.VendorContactEmail</b></div> }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="dt-row"><div class="dt-rl">@SlIcon("inspector") @T("Common.Inspector")</div>
                            <div class="dt-rv">
                                <b>@(string.IsNullOrEmpty(_selectedJob.InspectorName) ? T("InspectionScheduleSummary.Unassigned") : _selectedJob.InspectorName)</b>
                                @if (!string.IsNullOrEmpty(_selectedJob.InspectorId)) { <div class="dt-line"><span>ID</span><b>@_selectedJob.InspectorId</b></div> }
                                @if (!string.IsNullOrEmpty(_selectedJob.InspectorMobile)) { <div class="dt-line"><span>@T("Common.Mobile")</span><b>@_selectedJob.InspectorMobile</b></div> }
                            </div>
                        </div>
                    </div>

                    <div class="dt-right">
                        <div class="dt-refs">
                            <div class="dt-refs-h">
                                <span class="dt-ri">@SlIcon("po")</span>
                                <div><b>@T("InspectionScheduleSummary.ProductReferences") <em>(@_selectedJobRefs.Count)</em></b></div>
                                @if (_selectedJobRefs.Count > 0)
                                {
                                    <button type="button" class="dt-dlall" @onclick="DownloadAllRefs">
                                        <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3v10M6 9l4 4 4-4"/><path d="M3 17h14"/></svg>
                                        @T("InspectionScheduleSummary.DownloadAll")
                                    </button>
                                }
                            </div>
                            @foreach (var ref_ in _selectedJobRefs)
                            {
                                var ext = RefExt(ref_);
                                <div class="dt-ref">
                                    <span class="dt-ext ext-@ext.ToLower()">@ext</span>
                                    <div class="dt-ref-n"><b>@(string.IsNullOrEmpty(ref_.FileName) ? ref_.ReferenceName : ref_.FileName)</b>@if (!string.IsNullOrEmpty(ref_.FileName) && !string.IsNullOrEmpty(ref_.ReferenceName)) { <small>@ref_.ReferenceName</small> }</div>
                                    @if (!string.IsNullOrEmpty(ref_.FileUrl))
                                    {
                                        @if (PageAccess.CanDownload)
                                        {
                                            <a href="@ref_.FileUrl" download="@ref_.FileName" class="dt-ico" title="@T("Common.Download")"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 3v10M6 9l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 17h14" stroke-linecap="round"/></svg></a>
                                        }
                                        <a href="@ref_.FileUrl" target="_blank" rel="noopener" class="dt-ico" title="@T("Common.View")"><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 10s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7z"/><circle cx="10" cy="10" r="3"/></svg></a>
                                    }
                                    else { <span class="dt-nofile">@T("Common.NoFile")</span> }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="dt-foot">
                    <span class="dt-state">@TE("Status", _selectedJob.Status)</span>
                    @if (_canStartInspection)
                    {
                        <button class="dt-start" @onclick="() => StartInspection(_selectedJob)">
                            <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M6 4l12 6-12 6V4z"/></svg>
                            @T("InspectionScheduleSummary.StartInspection")
                        </button>
                    }
                </div>
            </div>

            @* Popup hiển thị toàn bộ Product References *@
            @if (_showRefsPopup && _selectedJobRefs.Count > 0)
            {
                <div class="iss-refs-backdrop" @onclick="() => _showRefsPopup = false">
                    <div class="iss-refs-modal" @onclick:stopPropagation="true">
                        <div class="iss-refs-modal-header">
                            <div class="iss-refs-modal-title">@T("InspectionScheduleSummary.ProductReferences")</div>
                            <button type="button" class="iss-refs-modal-close" @onclick="() => _showRefsPopup = false" aria-label="@T("Common.Close")">✕</button>
                        </div>
                        <div class="iss-refs-modal-body">
                            <div class="iss-ref-table">
                                <div class="iss-ref-header">
                                    <span class="iss-ref-no">No</span>
                                    <span class="iss-ref-name">@T("Common.Reference")</span>
                                    <span class="iss-ref-file">@T("InspectionScheduleSummary.File")</span>
                                </div>
                                @foreach (var ref_ in _selectedJobRefs)
                                {
                                    <div class="iss-ref-row">
                                        <span class="iss-ref-no">@ref_.No</span>
                                        <span class="iss-ref-name">@ref_.ReferenceName</span>
                                        <span class="iss-ref-file">
                                            @if (!string.IsNullOrEmpty(ref_.FileUrl))
                                            {
                                                <a href="@ref_.FileUrl" target="_blank" rel="noopener" class="iss-ref-view-btn" title="@T("Common.View")">
                                                    <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M1 10s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7z"/><circle cx="10" cy="10" r="3"/>
                                                    </svg>
                                                    @T("Common.View")
                                                </a>
                                                @if (PageAccess.CanDownload)
                                                {
                                                <a href="@ref_.FileUrl" download="@ref_.FileName" class="iss-ref-dl-btn" title="@T("Common.Download")">
                                                    <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                                                        <path d="M10 3v10M6 9l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
                                                        <path d="M3 17h14" stroke-linecap="round"/>
                                                    </svg>
                                                    @T("Common.Download")
                                                </a>
                                                }
                                            }
                                            else
                                            {
                                                <span style="color:#bbb;font-size:12px;">@T("Common.NoFile")</span>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="iss-refs-modal-footer">
                            <button type="button" class="iss-refs-modal-ok" @onclick="() => _showRefsPopup = false">@T("Common.Close")</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (_view == View.ClcDetail && _clcSel != null)
    {
        <!-- ═══════════════════════ CLC DETAIL ═══════════════════════ -->
        <div class="iss-detail-wrap">
            @{
                var cm = _clcSel;
                var cinsp = _inspectors.FirstOrDefault(i => string.Equals(i.FullName, cm.InspectorName, StringComparison.OrdinalIgnoreCase));
                var canGo = _canStartInspection && (cm.Status == "Pending" || cm.Status == "InProgress");
                var pointKeys = new[] { "P1", "P2", "P3", "P4", "P5", "P6", "P7" };
                var totalCartons = cm.Products.Sum(x => x.PlannedCartons);
            }
            <div class="dt-card">
                <div class="dt-crumb">
                    <button type="button" class="dt-back" @onclick="GoBack">&lsaquo; @T("Common.Back")</button>
                    <span>@T("Menu.InspectionSchedule") &rsaquo; <b>@cm.JobNumber</b></span>
                </div>
                <div class="dt-head">
                    <h2>@cm.JobNumber</h2>
                    <span class="iss-it-badge it-clc">@T("InspectionScheduleSummary.CLC")</span>
                    <div class="dt-head-r">
                        <span class="iss-st-pill st-pending">@(cm.PlannedLoadingDate.HasValue && cm.PlannedLoadingDate.Value.Date < DateTime.Today && cm.Status is "Pending" or "Draft" ? T("Status.Delay") : cm.Status)</span>
                        @if (!_canStartInspection) { <span class="dt-viewonly">&#128065; @T("InspectionScheduleSummary.ViewOnly")</span> }
                    </div>
                </div>
                <div class="dt-facts">
                    <div class="dt-fact"><span class="dt-fi">@SlIcon("date")</span><span><small>@T("Common.InspectionDate")</small><b>@(cm.PlannedLoadingDate.HasValue ? L.Date(cm.PlannedLoadingDate.Value, "ddd, d MMM yyyy") : "—")</b></span></div>
                    <div class="dt-fact"><span class="dt-fi">@SlIcon("po")</span><span><small>@T("Clc.ContainerNo")</small><b>@(string.IsNullOrEmpty(cm.ContainerNo) ? "—" : cm.ContainerNo)</b></span></div>
                    <div class="dt-fact"><span class="dt-fi">@SlIcon("category")</span><span><small>@T("InspectionScheduleSummary.ContainerSize")</small><b>@(string.IsNullOrEmpty(cm.ContainerType) ? "—" : cm.ContainerType)</b></span></div>
                    <div class="dt-fact"><span class="dt-fi">@SlIcon("country")</span><span><small>@T("Clc.LoadingLocation")</small><b>@(string.IsNullOrEmpty(cm.LoadingLocation) ? "—" : cm.LoadingLocation)</b></span></div>
                </div>

                @if (_clcLoading)
                {
                    <div class="dt-loading"><div class="iss-spinner"></div><span>@T("InspectionScheduleSummary.LoadingDetails")</span></div>
                }

                <div class="dt-banner">
                    <img class="dt-cimg" src="images/container-40ft.png" alt="" />
                    <div class="dt-banner-t"><b>@T("Clc.Title")</b><small>@T("InspectionScheduleSummary.ClcSub")</small></div>
                    <button type="button" class="sl-btn" @onclick='() => Navigation.NavigateTo($"/clc/{cm.Id}")'>@T("InspectionScheduleSummary.ViewChecklist")</button>
                </div>

                <div class="dt-grid">
                    <div class="dt-left">
                        @if (!_hideCustomer)
                        {
                            <div class="dt-row"><div class="dt-rl">@SlIcon("vendor") @T("Common.Customer")</div><div class="dt-rv"><b>@cm.CustomerName</b></div></div>
                        }
                        <div class="dt-row"><div class="dt-rl">@SlIcon("vendor") @T("Common.Vendor")</div>
                            <div class="dt-rv">
                                <b>@cm.VendorName</b>
                                @if (!string.IsNullOrWhiteSpace(cm.VendorAddress)) { <div class="dt-sub">@SlIcon("country") @cm.VendorAddress</div> }
                                @if (!string.IsNullOrEmpty(cm.VendorContact) || !string.IsNullOrEmpty(cm.VendorPhone) || !string.IsNullOrEmpty(cm.VendorEmail))
                                {
                                    <div class="dt-contact">
                                        @if (!string.IsNullOrEmpty(cm.VendorContact)) { <div><span>@T("Common.ContactName")</span><b>@cm.VendorContact</b></div> }
                                        @if (!string.IsNullOrEmpty(cm.VendorPhone)) { <div><span>@T("Common.Mobile")</span><b>@cm.VendorPhone</b></div> }
                                        @if (!string.IsNullOrEmpty(cm.VendorEmail)) { <div><span>Email</span><b>@cm.VendorEmail</b></div> }
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="dt-row"><div class="dt-rl">@SlIcon("inspector") @T("Common.Inspector")</div>
                            <div class="dt-rv">
                                <b>@(string.IsNullOrEmpty(cm.InspectorName) ? T("InspectionScheduleSummary.Unassigned") : cm.InspectorName)</b>
                                @if (!string.IsNullOrEmpty(cinsp?.InspectorId)) { <div class="dt-line"><span>ID</span><b>@cinsp!.InspectorId</b></div> }
                            </div>
                        </div>
                    </div>

                    <div class="dt-right">
                        <div class="dt-refs">
                            <div class="dt-refs-h">
                                <span class="dt-ri">@SlIcon("category")</span>
                                <div><b>@T("Clc.Products") <em>(@cm.Products.Count)</em></b></div>
                            </div>
                            <div style="overflow-x:auto">
                                <table class="dt-table">
                                    <thead><tr><th>@T("Common.No")</th><th>@T("Common.ProductCode")</th><th>@T("Common.ProductName")</th><th class="r">@T("Clc.Cartons")</th></tr></thead>
                                    <tbody>
                                        @{ int pn = 0; }
                                        @foreach (var pr in cm.Products)
                                        {
                                            pn++;
                                            <tr><td>@pn</td><td>@pr.ProductCode</td><td>@pr.Description</td><td class="r">@pr.PlannedCartons.ToString("N0")</td></tr>
                                        }
                                        <tr class="tot"><td colspan="3">@T("Clc.TotalQuantity")</td><td class="r">@totalCartons.ToString("N0")</td></tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="dt-points">
                    <div class="dt-points-h">@SlIcon("po") @T("InspectionScheduleSummary.Clc7Points")</div>
                    <div class="dt-points-row">
                        <div class="dt-points-list">
                            @foreach (var pk in pointKeys) { <span class="dt-point">@T("InspectionScheduleSummary." + pk)</span> }
                        </div>
                        @if (canGo)
                        {
                            <button class="dt-start" @onclick='() => Navigation.NavigateTo($"/clc/{cm.Id}")'>
                                <svg width="18" height="18" viewBox="0 0 20 20" fill="currentColor"><path d="M6 4l12 6-12 6V4z"/></svg>
                                @T("InspectionScheduleSummary.StartClcInspection")
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- ═══════════════════════ SUMMARY ═══════════════════════ -->

        <!-- PAGE HEADER -->
        <div class="iss-page-head">
            <div>
                <h1 class="iss-page-title">@T("InspectionScheduleSummary.InspectorSchedule")</h1>
                <div class="iss-page-sub">@T("InspectionScheduleSummary.ViewAndManageInspectionAssignments")</div>
            </div>
            @if (_isAdmin)
            {
                <div class="iss-insp-picker">
                    @if (!string.IsNullOrEmpty(_selInspectorId))
                    {
                        <button class="iss-clear-filter" @onclick='() => SelectInspector("")'>@T("InspectionScheduleSummary.ClearFilter")</button>
                    }
                    <div class="iss-dd-wrap">
                        <div class="iss-dd-label">@T("InspectionScheduleSummary.SelectInspector")</div>
                        <button class="iss-dd-btn @(_ddOpen ? "open" : "")" @onclick="() => { _ddOpen = !_ddOpen; _ddSearch = string.Empty; }">
                            @if (SelectedInspector is { } si)
                            {
                                @Avatar(si.FullName, si.PhotoUrl, 30)
                                <span class="iss-dd-text"><b>@si.FullName</b> · <b>@si.InspectorId</b></span>
                            }
                            else
                            {
                                <span class="iss-dd-allico">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.5"/><path d="M2 20c0-3.6 3.1-6 7-6s7 2.4 7 6"/><circle cx="17" cy="7" r="2.5"/><path d="M17 13c2.8 0 5 1.8 5 4.5"/></svg>
                                </span>
                                <span class="iss-dd-text"><b>@T("InspectionScheduleSummary.AllInspectors")</b></span>
                            }
                            <svg class="iss-dd-caret" width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="@(_ddOpen ? "M5 12l5-5 5 5" : "M5 8l5 5 5-5")"/></svg>
                        </button>
                        @if (_ddOpen)
                        {
                            <div class="iss-dd-backdrop" @onclick="() => _ddOpen = false"></div>
                            <div class="iss-dd-menu">
                                <div class="iss-dd-search">
                                    <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="9" r="6"/><path d="M14 14l4 4" stroke-linecap="round"/></svg>
                                    <input placeholder="@T("InspectionScheduleSummary.SearchNameOrInspectorID")" @bind="_ddSearch" @bind:event="oninput" />
                                </div>
                                <div class="iss-dd-list">
                                    <div class="iss-dd-item @(string.IsNullOrEmpty(_selInspectorId) ? "sel" : "")" @onclick='() => SelectInspector("")'>
                                        <span class="iss-dd-check">@(string.IsNullOrEmpty(_selInspectorId) ? "✓" : "")</span>
                                        <span class="iss-dd-allico sm"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="8" r="3.5"/><path d="M2 20c0-3.6 3.1-6 7-6s7 2.4 7 6"/><circle cx="17" cy="7" r="2.5"/><path d="M17 13c2.8 0 5 1.8 5 4.5"/></svg></span>
                                        <span>@T("InspectionScheduleSummary.AllInspectors")</span>
                                    </div>
                                    @foreach (var ins in FilteredInspectorOptions())
                                    {
                                        var id = ins.InspectorId!;
                                        <div class="iss-dd-item @(_selInspectorId == id ? "sel" : "")" @onclick="() => SelectInspector(id)">
                                            <span class="iss-dd-check">@(_selInspectorId == id ? "✓" : "")</span>
                                            @Avatar(ins.FullName, ins.PhotoUrl, 28)
                                            <span class="iss-dd-name">@ins.FullName · <b>@ins.InspectorId</b></span>
                                            <span class="iss-dd-cnt">@_allJobsRaw.Count(j => IsTodo(j) && string.Equals(j.InspectorId, id, StringComparison.OrdinalIgnoreCase))</span>
                                        </div>
                                    }
                                    @if (!FilteredInspectorOptions().Any())
                                    {
                                        <div class="iss-dd-empty">@T("InspectionScheduleSummary.NoInspectorFound")</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            else if (_me != null)
            {
                @ScheduleChip(_me.FullName ?? _me.Username, _me.InspectorId, _me.PhotoUrl)
            }
        </div>

        <!-- KPI: job chưa hoàn thành của năm hiện tại (New/Delay; không tính Completed, Cancel), theo inspector đang chọn — khách chốt 17/11/2026 -->
        <div class="iss-kpis">
            <div class="iss-kpi iss-kpi-total">
                <span class="iss-kpi-l">@T("InspectionScheduleSummary.TotalJobs")</span>
                <span class="iss-kpi-v">@(OpenJobs().Count() + ClcOpenCount())</span>
            </div>
            <div class="iss-kpi iss-kpi-ppi"><span class="iss-kpi-l">@T("InspectionScheduleSummary.PPI")</span><span class="iss-kpi-v">@CountOpenType("PPT")</span></div>
            <div class="iss-kpi iss-kpi-dpi"><span class="iss-kpi-l">@T("InspectionScheduleSummary.DPI")</span><span class="iss-kpi-v">@CountOpenType("DPI")</span></div>
            <div class="iss-kpi iss-kpi-psi"><span class="iss-kpi-l">@T("InspectionScheduleSummary.PSI")</span><span class="iss-kpi-v">@CountOpenType("PST")</span></div>
            <div class="iss-kpi iss-kpi-clc"><span class="iss-kpi-l">@T("InspectionScheduleSummary.CLC")</span><span class="iss-kpi-v">@ClcOpenCount()</span></div>
        </div>

        <!-- HEADER -->
        <div class="iss-header-card">
            <div class="iss-header-top">
                <div class="iss-sel-title">@(_isAdmin ? (SelectedInspector != null ? T("InspectionScheduleSummary.SelectedInspector") : T("InspectionScheduleSummary.AllInspectors")) : _me != null ? T("InspectionScheduleSummary.MySchedule") : T("InspectionScheduleSummary.Schedule")) · @DateTime.Now.Year</div>
                <div class="iss-year-badge">@DateTime.Now.Year</div>
            </div>

            <div class="iss-month-header">
                <span class="iss-month-title">@T("InspectionScheduleSummary.TotalJob")</span>
                <span class="iss-month-total">@T("InspectionScheduleSummary.Job", YearJobs().Count() + ClcCount(), YearJobs().Count() + ClcCount() != 1 ? "s" : "")</span>
            </div>
            <div class="iss-month-grid">
                @foreach (var m in _monthSummary)
                {
                    <div class="iss-month-cell @(m.Count + ClcMonth(m.Month) > 0 ? "has-jobs" : "")">
                        <span class="iss-m-name">@L.MonthShort(m.Month)</span>
                        @if (m.Count + ClcMonth(m.Month) > 0)
                        {
                            <span class="iss-m-count">@(m.Count + ClcMonth(m.Month))</span>
                        }
                    </div>
                }
            </div>

            <div class="iss-user-strip">
                <div class="iss-user-info">
                    <span class="iss-u-label">@T("InspectionScheduleSummary.Waiting")</span>
                    <span class="iss-u-val iss-u-todo">@(_waitingCount + ClcScoped().Count(c => c.Date >= DateTime.Today))</span>
                </div>
                <div class="iss-user-info">
                    <span class="iss-u-label">@T("InspectionScheduleSummary.Delayed")</span>
                    <span class="iss-u-val iss-u-delay">@(_delayCount + ClcScoped().Count(c => c.Date < DateTime.Today))</span>
                </div>
            </div>
        </div>

        <!-- STATUS TABS -->
        <div class="iss-status-bar">
            <button class="iss-status-btn @(_statusFilter == "todo" ? "s-active s-todo" : "s-idle")"
                    @onclick='() => _statusFilter = "todo"'>
                <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"><circle cx="10" cy="10" r="8"/><path d="M10 6v4l3 3"/></svg>
                @T("InspectionScheduleSummary.ToDo")
                @if (_todoCount + ClcScoped().Count() > 0) { <span class="iss-cnt-badge">@(_todoCount + ClcScoped().Count())</span> }
            </button>
            <button class="iss-status-btn @(_statusFilter == "completed" ? "s-active s-done" : "s-idle")"
                    @onclick='() => _statusFilter = "completed"'>
                <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round"><path d="M4 10l5 5 7-8"/></svg>
                @T("Common.Completed")
                @{ var doneCnt = _completedCount + ClcAllScoped().Count(c => c.Status == "Submitted" && c.Date.Year == _currentYear); }
                @if (doneCnt > 0) { <span class="iss-cnt-badge">@doneCnt</span> }
            </button>
        </div>

        <!-- TIME TABS — chỉ hiện khi To Do -->
        @if (_statusFilter == "todo")
        {
        <div class="iss-time-bar">
            <button class="iss-time-btn @(_timeFilter == "today" ? "t-active" : "")"
                    @onclick='() => SetTimeFilter("today")'>@T("InspectionScheduleSummary.Today")</button>
            <button class="iss-time-btn @(_timeFilter == "7days" ? "t-active" : "")"
                    @onclick='() => SetTimeFilter("7days")'>@T("InspectionScheduleSummary.N7Days")</button>
            <button class="iss-time-btn @(_timeFilter == "14days" ? "t-active" : "")"
                    @onclick='() => SetTimeFilter("14days")'>@T("InspectionScheduleSummary.N14Days")</button>
            @{ var odCnt = _allJobs.Count(j => IsTodo(j) && j.InspectionDate != DateTime.MinValue && j.InspectionDate.Year == _currentYear && j.InspectionDate.Date < DateTime.Today) + ClcScoped().Count(c => c.Date < DateTime.Today); }
            @if (odCnt > 0)
            {
                <button class="iss-time-btn iss-time-od @(_timeFilter == "overdue" ? "t-active" : "")"
                        @onclick='() => SetTimeFilter("overdue")'>@T("InspectionScheduleSummary.OverdueTab", odCnt)</button>
            }
        </div>
        }

        <!-- CONTENT -->
        <div class="iss-content">
            @{var filtered = FilteredJobs();}

            @if (_statusFilter == "completed")
            {
                <div class="iss-section-title">
                    @T("Common.Completed")
                    <span class="iss-section-count">@T("InspectionScheduleSummary.Job", filtered.Count, filtered.Count != 1 ? "s" : "")</span>
                </div>
                @if (!filtered.Any())
                {
                    <div class="iss-empty">
                        <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="#ccc" stroke-width="1.5">
                            <rect x="8" y="10" width="32" height="32" rx="4"/>
                            <path d="M16 10V6M32 10V6M8 20h32" stroke-linecap="round"/>
                            <circle cx="24" cy="32" r="4"/>
                        </svg>
                        <p>@T("InspectionScheduleSummary.NoCompletedInspectionsThisYear")</p>
                    </div>
                }
                @foreach (var job in filtered.OrderByDescending(j => j.CompletedAt ?? j.InspectionDate))
                {
                    <div class="iss-comp-card">
                        <!-- Card header: Job No + Type badge + Result -->
                        <div class="iss-comp-card-header">
                            <div class="iss-comp-card-left">
                                <span class="iss-comp-jobno">@(job.JobNumber ?? $"#{job.Id}")</span>
                                <span class="iss-it-badge it-@job.InspectionType.ToLower()">@TE("Opt", job.InspectionType)</span>
                            </div>
                            <div class="iss-comp-card-right">
                                @{
                                    var rawResult  = !string.IsNullOrEmpty(job.OverallResult)
                                                     ? job.OverallResult
                                                     : job.FinalResult ?? "";
                                    var resultKey  = rawResult.ToLower();
                                    var isPassed   = resultKey == "pass"   || resultKey == "passed";
                                    var isFailed   = resultKey == "fail"   || resultKey == "failed";
                                    var resultClass = isPassed ? "res-passed"
                                                   : isFailed ? "res-failed"
                                                   : "res-na";
                                }
                                @if (!string.IsNullOrEmpty(rawResult))
                                {
                                    <span class="iss-result-badge @resultClass">
                                        @if (isPassed)
                                        {
                                            <svg width="11" height="11" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M4 10l5 5 7-8"/></svg>
                                        }
                                        else if (isFailed)
                                        {
                                            <svg width="11" height="11" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M6 6l8 8M14 6l-8 8"/></svg>
                                        }
                                        @rawResult.ToUpper()
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Card body: fields -->
                        <div class="iss-comp-card-body">
                            <div class="iss-comp-field">
                                <span class="iss-comp-label">
                                    <svg width="11" height="11" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="4" width="14" height="14" rx="2"/><path d="M3 9h14M7 4V2M13 4V2"/></svg>
                                    @T("InspectionScheduleSummary.CompletedDate")
                                </span>
                                <span class="iss-comp-val">
                                    @(job.CompletedAt.HasValue
                                        ? L.Date(job.CompletedAt.Value, "d MMM yyyy")
                                        : job.InspectionDate != DateTime.MinValue
                                            ? L.Date(job.InspectionDate, "d MMM yyyy")
                                            : "—")
                                </span>
                            </div>
                            @if (!_hideCustomer)
                            {
                            <div class="iss-comp-field">
                                <span class="iss-comp-label">
                                    <svg width="11" height="11" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="10" cy="7" r="4"/><path d="M3 17c0-3.3 3.1-6 7-6s7 2.7 7 6"/></svg>
                                    @T("Common.Customer")
                                </span>
                                <span class="iss-comp-val">@job.CustomerName</span>
                            </div>
                            }
                            <div class="iss-comp-field">
                                <span class="iss-comp-label">
                                    <svg width="11" height="11" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="2" y="7" width="16" height="11" rx="2"/><path d="M6 7V5a4 4 0 018 0v2"/></svg>
                                    @T("Common.Vendor")
                                </span>
                                <span class="iss-comp-val">@job.VendorName</span>
                            </div>
                            <div class="iss-comp-field">
                                <span class="iss-comp-label">
                                    <svg width="11" height="11" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 3h14v14H3z"/><path d="M3 8h14M8 3v14"/></svg>
                                    @T("Common.Category")
                                </span>
                                <span class="iss-comp-val">@(job.ProductCategory ?? "—")</span>
                            </div>
                            <div class="iss-comp-field">
                                <span class="iss-comp-label">
                                    <svg width="11" height="11" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 4h12v12H4z"/><circle cx="10" cy="10" r="3"/></svg>
                                    @T("InspectionScheduleSummary.PONumber")
                                </span>
                                <span class="iss-comp-val">@(job.PoNumber ?? "—")</span>
                            </div>
                        </div>

                        <!-- Card footer: View Report button -->
                        <div class="iss-comp-card-footer">
                            <button class="iss-report-btn" @onclick="() => ViewReport(job)">
                                <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 00-2 2v12a2 2 0 002 2h8a2 2 0 002-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="8" y1="13" x2="12" y2="13"/>
                                    <line x1="8" y1="10" x2="12" y2="10"/>
                                </svg>
                                @T("Common.ViewReport")
                            </button>
                        </div>
                    </div>
                }
            }
            else
            {
                @ScheduleListFrag(filtered)
            }
        </div>
    }

    @* Popup hiển thị toàn bộ Product References (dùng chung cho tab Today) *@
    @if (_showJobRefsPopup && _popupJob != null)
    {
        <div class="iss-refs-backdrop" @onclick="() => _showJobRefsPopup = false">
            <div class="iss-refs-modal" @onclick:stopPropagation="true">
                <div class="iss-refs-modal-header">
                    <div class="iss-refs-modal-title">@T("InspectionScheduleSummary.ProductReferences")</div>
                    <button type="button" class="iss-refs-modal-close" @onclick="() => _showJobRefsPopup = false" aria-label="@T("Common.Close")">✕</button>
                </div>
                <div class="iss-refs-modal-body">
                    <div class="iss-ref-table">
                        <div class="iss-ref-header">
                            <span class="iss-ref-no">No</span>
                            <span class="iss-ref-name">@T("Common.Reference")</span>
                            <span class="iss-ref-file">@T("InspectionScheduleSummary.File")</span>
                        </div>
                        @foreach (var ref_ in _popupJob.References)
                        {
                            <div class="iss-ref-row">
                                <span class="iss-ref-no">@ref_.No</span>
                                <span class="iss-ref-name">@ref_.ReferenceName</span>
                                <span class="iss-ref-file">
                                    @if (!string.IsNullOrEmpty(ref_.FileUrl))
                                    {
                                        <a href="@ref_.FileUrl" target="_blank" rel="noopener" class="iss-ref-view-btn" title="@T("Common.View")">
                                            <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M1 10s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7z"/><circle cx="10" cy="10" r="3"/>
                                            </svg>
                                            @T("Common.View")
                                        </a>
                                        @if (PageAccess.CanDownload)
                                        {
                                        <a href="@ref_.FileUrl" download="@ref_.FileName" class="iss-ref-dl-btn" title="@T("Common.Download")">
                                            <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                                                <path d="M10 3v10M6 9l4 4 4-4" stroke-linecap="round" stroke-linejoin="round"/>
                                                <path d="M3 17h14" stroke-linecap="round"/>
                                            </svg>
                                            @T("Common.Download")
                                        </a>
                                        }
                                    }
                                    else
                                    {
                                        <span style="color:#bbb;font-size:12px;">@T("Common.NoFile")</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                </div>
                <div class="iss-refs-modal-footer">
                    <button type="button" class="iss-refs-modal-ok" @onclick="() => _showJobRefsPopup = false">@T("Common.Close")</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // ────────────────────────────────────────────
    //  STATE
    // ────────────────────────────────────────────
    private enum View { Summary, JobDetail, ClcDetail }
    private View    _view           = View.Summary;
    private string  _timeFilter     = "today";
    private string  _statusFilter   = "todo";
    private string  _prevTimeFilter = "today";
    private bool    _loading        = true;
    private JobItem? _selectedJob;
    private List<JobItem>    _allJobs      = new();
    private List<MonthStat>  _monthSummary = new();

    // Role-based filter
    private string _filterInspectorId = "";

    // Admin: chọn inspector để lập kế hoạch / QC: hiển thị thông tin của chính mình
    private bool   _isAdmin;
    private CurrentUserDto? _me;
    private List<JobItem> _allJobsRaw = new();
    private List<InspectorOption> _inspectors = new();
    private string _selInspectorId = "";
    private bool   _ddOpen;
    private string _ddSearch = "";

    private InspectorOption? SelectedInspector =>
        string.IsNullOrEmpty(_selInspectorId) ? null
        : _inspectors.FirstOrDefault(i => string.Equals(i.InspectorId, _selInspectorId, StringComparison.OrdinalIgnoreCase));

    /// <summary>Lịch đang xem là của ai (QC đăng nhập, hoặc inspector Admin đang chọn).</summary>
    private CurrentUserDto? CurrentScheduleOwner =>
        _isAdmin
            ? (SelectedInspector is { } s ? new CurrentUserDto { FullName = s.FullName, InspectorId = s.InspectorId, PhotoUrl = s.PhotoUrl } : null)
            : _me;

    private IEnumerable<InspectorOption> FilteredInspectorOptions()
    {
        var q = _ddSearch.Trim();
        return _inspectors.Where(i => q == "" ||
            (i.FullName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
            (i.InspectorId ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
    }

    private string? InspectorPhoto(string? inspectorId)
    {
        if (string.IsNullOrEmpty(inspectorId)) return null;
        if (_me != null && string.Equals(_me.InspectorId, inspectorId, StringComparison.OrdinalIgnoreCase)) return _me.PhotoUrl;
        return _inspectors.FirstOrDefault(i => string.Equals(i.InspectorId, inspectorId, StringComparison.OrdinalIgnoreCase))?.PhotoUrl;
    }

    private async Task SelectInspector(string inspectorId)
    {
        _selInspectorId = inspectorId;
        _ddOpen = false;
        _allJobs = string.IsNullOrEmpty(inspectorId)
            ? _allJobsRaw.ToList()
            : _allJobsRaw.Where(j => string.Equals(j.InspectorId, inspectorId, StringComparison.OrdinalIgnoreCase)).ToList();
        BuildMonthSummary();
    }

    private async Task LoadInspectorOptions(Task<InspectorPageResult?>? prefetched = null)
    {
        try
        {
            var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            // Không lọc theo vai trò: người có InspectorId (kể cả vai trò Management) vẫn được giao job
            var res = prefetched != null ? await prefetched
                    : await Http.GetFromJsonAsync<InspectorPageResult>("api/users?isActive=true&pageSize=500", opts);
            var list = (res?.Items ?? new())
                .Where(i => !string.IsNullOrWhiteSpace(i.InspectorId))
                .ToList();
            // Gộp thêm người đang có job nhưng chưa có trong danh sách (user không active / không trả về)
            foreach (var j in _allJobsRaw.Where(j => !string.IsNullOrWhiteSpace(j.InspectorId)))
                if (!list.Any(i => string.Equals(i.InspectorId, j.InspectorId, StringComparison.OrdinalIgnoreCase)))
                    list.Add(new InspectorOption { InspectorId = j.InspectorId, FullName = string.IsNullOrWhiteSpace(j.InspectorName) ? j.InspectorId : j.InspectorName });
            _inspectors = list.OrderBy(i => i.FullName).ToList();
        }
        catch (Exception ex) { Console.WriteLine($"[Schedule] Load inspectors error: {ex.Message}"); }
    }

    private string Img(string? url) => MediaUrl.Resolve(url, Http.BaseAddress?.ToString());

    private static string Initials(string? name) =>
        string.Concat((name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => char.ToUpper(w[0])));

    private RenderFragment Avatar(string? name, string? photoUrl, int size) => __builder =>
    {
        <span class="iss-avatar" style="width:@(size)px;height:@(size)px;font-size:@(size * 0.38)px">
            @if (!string.IsNullOrEmpty(photoUrl)) { <img src="@Img(photoUrl)" alt="" /> }
            else { @Initials(name) }
        </span>
    };

    private RenderFragment ScheduleChip(string? name, string? inspectorId, string? photoUrl) => __builder =>
    {
        <div class="iss-sched-chip">
            @Avatar(name, photoUrl, 36)
            <span class="iss-sc-txt">@T("InspectionScheduleSummary.ScheduleFor") <b>@name</b></span>
            @if (!string.IsNullOrEmpty(inspectorId))
            {
                <span class="iss-sc-sep"></span>
                <span class="iss-sc-id">@inspectorId</span>
            }
        </div>
    };
    // Only users in Inspector or Admin role can start/execute inspections
    private bool   _canStartInspection = false;
    private string _filterCustomerId  = "";

    // Job detail state
    private bool               _detailLoading = false;
    private List<JobReference> _selectedJobRefs = new();
    private List<string>       _selectedJobPhotos = new();   // ảnh sản phẩm (ảnh chính đứng đầu)
    private bool               _showRefsPopup = false;

    // Popup references cho danh sách (tab Today / 7days)
    private bool     _showJobRefsPopup = false;
    private JobItem? _popupJob         = null;

    private void OpenJobRefsPopup(JobItem job)
    {
        _popupJob = job;
        _showJobRefsPopup = true;
    }

    // Culture dùng cho toàn bộ format ngày tháng — ép tiếng Anh để không bị dịch theo OS
    private static readonly System.Globalization.CultureInfo EnUs =
        System.Globalization.CultureInfo.GetCultureInfo("en-US");

    // ────────────────────────────────────────────
    //  VIEW MODELS
    // ────────────────────────────────────────────
    public class JobItem
    {
        public int      Id              { get; set; }
        public string?  JobNumber       { get; set; }
        public string   Title           { get; set; } = "";
        public string   CustomerName    { get; set; } = "";
        public string?  CustomerId      { get; set; }
        public string?  ProductCategory { get; set; }
        public string?  ProductType     { get; set; }
        public string   InspectionType  { get; set; } = "DPI";
        public string   VendorName      { get; set; } = "";
        public string?  VendorAddress   { get; set; }
        public string?  VendorAddress1  { get; set; }
        public string?  VendorAddress2  { get; set; }
        public string?  VendorCity      { get; set; }
        public string?  VendorState     { get; set; }
        public string?  VendorCountry   { get; set; }
        // Vendor Information (contact)
        public string?  VendorContactName     { get; set; }
        public string?  VendorContactPosition { get; set; }
        public string?  VendorContactMobile   { get; set; }
        public string?  VendorContactOffice   { get; set; }
        public string?  VendorContactEmail    { get; set; }
        public string?  PoNumber         { get; set; }
        public string?  ItemNumber       { get; set; }
        public string?  ProductName      { get; set; }
        public string?  InspectorName   { get; set; }
        public string?  InspectorId     { get; set; }
        public string?  InspectorMobile { get; set; }
        public string   Status          { get; set; } = "New";
        public DateTime InspectionDate  { get; set; }
        public DateTime CreatedAt       { get; set; }
        public DateTime? CompletedAt    { get; set; }
        public string?   OverallResult  { get; set; }
        public string?   FinalResult    { get; set; }
        public string?   ReportUrl      { get; set; }
        public List<JobReference> References { get; set; } = new();
    }

    public class JobReference
    {
        public int     No            { get; set; }
        public string  ReferenceName { get; set; } = "";
        public string? FileName      { get; set; }
        public string? FileUrl       { get; set; }
    }

    public record MonthStat(int Month, int Count);   // tên tháng hiển thị qua L.MonthShort

    // ────────────────────────────────────────────
    //  STATUS HELPERS
    //  API trả: "New" | "OnGoing" | "Delay" | "Completed" | "Cancel"
    //  ── "Delay" = New nhưng InspectionDate đã quá hạn (backend tự map)
    //  ── To Do  = New / OnGoing / Delay  (chưa hoàn thành)
    //  ── Done   = Completed
    // ────────────────────────────────────────────
    private static bool IsCompleted(JobItem j) =>
        string.Equals(j.Status, "Completed", StringComparison.OrdinalIgnoreCase);

    private static bool IsTodo(JobItem j) =>
        string.Equals(j.Status, "New",      StringComparison.OrdinalIgnoreCase) ||
        string.Equals(j.Status, "OnGoing",  StringComparison.OrdinalIgnoreCase) ||
        string.Equals(j.Status, "Delay",    StringComparison.OrdinalIgnoreCase);

    // ────────────────────────────────────────────
    //  COMPUTED
    //  _todoCount / _completedCount: chỉ tính job trong năm hiện tại
    // ────────────────────────────────────────────
    private int _currentYear => DateTime.Now.Year;

    private int _todoCount =>
        _allJobs.Count(j => IsTodo(j) && j.InspectionDate.Year == _currentYear);

    private int _delayCount =>
        _allJobs.Count(j => string.Equals(j.Status, "Delay", StringComparison.OrdinalIgnoreCase) && j.InspectionDate.Year == _currentYear);

    private int _waitingCount => _todoCount - _delayCount;

    private int _completedCount =>
        _allJobs.Count(j => IsCompleted(j) && j.InspectionDate.Year == _currentYear);

    // ────────────────────────────────────────────
    //  FILTER JOBS
    //  - Tab "To Do"       → New | OnGoing, lọc theo ngày
    //  - Tab "Completed"   → Completed, lọc theo ngày
    //  - Chỉ job trong năm hiện tại
    // ── KPI "Next 14 days" (Total · PPI · DPI · PSI · CLC) ─────────────
    private int _clcNext14;
    private List<ClcRow> _clcRows = new();
    private class ClcRow { public int Id; public string JobNumber = "", Status = "", Customer = "", Vendor = "", ContainerNo = "", ContainerType = "", Inspector = ""; public DateTime Date; }

    private IEnumerable<ClcRow> ClcForFilter()
    {
        var t = DateTime.Today;
        return (_timeFilter switch
        {
            "today"   => _clcRows.Where(c => c.Date == t),
            "7days"   => _clcRows.Where(c => c.Date >= t && c.Date < t.AddDays(7)),
            "14days"  => _clcRows.Where(c => c.Date >= t && c.Date < t.AddDays(14)),
            "overdue" => _clcRows.Where(c => c.Date < t),
            _         => Enumerable.Empty<ClcRow>()
        }).OrderBy(c => c.Date);
    }

