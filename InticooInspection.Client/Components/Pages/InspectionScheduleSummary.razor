            var all = BuildSchedItems(jobs);
            var q = all.AsEnumerable();
            if (!string.IsNullOrWhiteSpace(_slSearch))
            {
                var t = _slSearch.Trim();
                q = q.Where(i => i.No.Contains(t, StringComparison.OrdinalIgnoreCase) || i.Po.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || i.Vendor.Contains(t, StringComparison.OrdinalIgnoreCase) || i.Customer.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || i.Inspector.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || (i.Job != null && ((i.Job.ProductName ?? "").Contains(t, StringComparison.OrdinalIgnoreCase) || (i.Job.ItemNumber ?? "").Contains(t, StringComparison.OrdinalIgnoreCase))));
            }
            if (_slVendor != "")   q = q.Where(i => i.Vendor == _slVendor);
            if (_slCategory != "") q = q.Where(i => i.Category == _slCategory);
            if (_slCountry != "")  q = q.Where(i => i.Country == _slCountry);
