                </select>
                <select @bind="_slStatus" @bind:after="SlResetPage">
                    <option value="">@T("Common.AllStatus")</option>
                    <option value="New">@T("Status.New")</option>
                    <option value="OnGoing">@TE("Status", "OnGoing")</option>
                    <option value="Delay">@T("Status.Delay")</option>
                </select>
            </div>
        </div>

        @if (rows.Count == 0)
        {
            <div class="iss-empty"><p>@T("InspectionScheduleSummary.NoInspectionsForThisPeriod")</p></div>
        }
        else
        {
            <div id="iss-print-area-14days" class="iss-print-area sl-list">
                @foreach (var it in pageRows)
                {
                    var item = it;
                    var late = item.Date < today;
                    <div class="sl-item @(late ? "late" : "")" @onclick="async () => await SlOpen(item)">
                        <div class="sl-top">
                            <span class="iss-it-badge it-@item.Type.ToLower() sl-type">@TE("Opt", item.Type)</span>
                            <span class="sl-no">@item.No</span>
                            <span class="iss-st-pill @GetStatusClass(item.Status) sl-status">@TE("Status", item.Status)</span>
                        </div>
                        <div class="sl-c1">
                            @SlField("date", T("InspectionScheduleSummary.ScheduledDate"), L.Date(item.Date, "ddd, d MMM yyyy"))
                            @SlField("po", T("InspectionScheduleSummary.PONumber"), item.Po)
                        </div>
                        <div class="sl-mid">
                            <div class="sl-c2">
                                @if (!_hideCustomer) { @SlField("customer", T("Common.Customer"), item.Customer) }
                                @SlField("category", T("Common.Category"), item.Category)
                            </div>
                            <div class="sl-c3">
                                @SlField("vendor", T("Common.Vendor"), item.Vendor)
                                @SlField("country", T("Common.Country"), item.Country)
                            </div>
                        </div>
                        <div class="sl-ci">
                            @SlInspectorField(T("Common.Inspector"), item.Inspector == "" ? T("InspectionScheduleSummary.Unassigned") : item.Inspector, item)
                        </div>
                        <div class="sl-act no-print" @onclick:stopPropagation="true">
                            <button type="button" class="sl-btn" @onclick="async () => await SlOpen(item)">
                                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h4"/></svg>
                                @T("InspectionScheduleSummary.ViewDetails")
                            </button>
                            @if (_canStartInspection)
                            {
                                <button type="button" class="sl-btn primary" @onclick="() => SlStart(item)">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 4 20 12 6 20 6 4"/></svg>
                                    @T("InspectionScheduleSummary.Start")
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
            <div class="sl-foot no-print">
                <span class="sl-total">@T("InspectionScheduleSummary.TotalSchedules", rows.Count, periodLabel)</span>
                <div class="sl-pager">
                    <label class="sl-perpage">@T("InspectionScheduleSummary.RowsPerPage")
                        <select value="@_slSize" @onchange="e => SlSetSize(int.TryParse(e.Value?.ToString(), out var n) ? n : 10)">
                            @foreach (var n in new[] { 10, 20, 50, 100 }) { <option value="@n">@n</option> }
                        </select>
                    </label>
                    <button type="button" class="sl-pg" disabled="@(_slPage <= 1)" @onclick="() => SlSetPage(_slPage - 1)">&lsaquo;</button>
                    <span class="sl-pg-nums">
                        @foreach (var n in SlPageNumbers(pages, _slPage))
                        {
                            var pn = n;
                            @if (pn == 0) { <span class="sl-dots">…</span> }
                            else { <button type="button" class="sl-pg @(pn == _slPage ? "on" : "")" @onclick="() => SlSetPage(pn)">@pn</button> }
                        }
                    </span>
                    <span class="sl-pg-compact">@_slPage / @pages</span>
                    <button type="button" class="sl-pg" disabled="@(_slPage >= pages)" @onclick="() => SlSetPage(_slPage + 1)">&rsaquo;</button>
                </div>
            </div>
        }
    </text>;

    private Task SlSetPageAsync(int p) { SlSetPage(p); return Task.CompletedTask; }
    private Task SlSetSizeAsync(int n) { SlSetSize(n); return Task.CompletedTask; }

    private async Task SlOpen(SchedItem i)
    {
        if (i.Job != null) await OpenJobDetail(i.Job);
        else if (i.Clc != null) await OpenClcDetail(i.Clc.Id);
    }

    private void SlStart(SchedItem i)
    {
        if (i.Job != null) StartInspection(i.Job);
        else if (i.Clc != null) Navigation.NavigateTo($"/clc/{i.Clc.Id}");
    }

    // ────────────────────────────────────────────
    private List<JobItem> FilteredJobs()
    {
        var today = DateTime.Today;

        // Tab Completed: trả về toàn bộ job Completed trong năm, không lọc theo ngày
        if (_statusFilter == "completed")
        {
            return _allJobs
                .Where(j => IsCompleted(j) &&
                            j.InspectionDate != DateTime.MinValue &&
                            j.InspectionDate.Year == _currentYear)
                .OrderByDescending(j => j.CompletedAt ?? j.InspectionDate)
                .ToList();
        }

        // Tab To Do: lọc New | OnGoing, năm hiện tại, theo khoảng thời gian
        IEnumerable<JobItem> q = _allJobs
            .Where(j => IsTodo(j) &&
                        j.InspectionDate != DateTime.MinValue &&
                        j.InspectionDate.Year == _currentYear);

        return _timeFilter switch
        {
            // "today" chỉ gồm job đúng hôm nay (yêu cầu khách 2/11); job quá hạn có tab "Overdue" riêng.
            "today"   => q.Where(j => j.InspectionDate.Date == today).ToList(),
            "overdue" => q.Where(j => j.InspectionDate.Date < today).ToList(),
            "7days"  => q.Where(j => j.InspectionDate.Date >= today &&
                                     j.InspectionDate.Date <  today.AddDays(7)).ToList(),
            "14days" => q.Where(j => j.InspectionDate.Date >= today &&
                                     j.InspectionDate.Date <  today.AddDays(14)).ToList(),
            _ => new()
        };
    }

