            var token = await SessionStorage.GetItemAsync<string>("auth_token");
            if (!string.IsNullOrEmpty(token))
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", token);
            var m = await Http.GetFromJsonAsync<ClcModel>($"api/clc/{id}", new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            if (m != null) _clcSel = m;
        }
        catch (Exception ex) { Console.WriteLine($"[InspectionSchedule] CLC detail load error: {ex.Message}"); }
        finally { _clcLoading = false; StateHasChanged(); }
    }

    private static string RefExt(JobReference r)
    {
        var n = string.IsNullOrEmpty(r.FileName) ? r.FileUrl ?? "" : r.FileName;
        var e = System.IO.Path.GetExtension(n).TrimStart('.').ToUpperInvariant();
        return e switch { "PDF" => "PDF", "XLS" or "XLSX" or "CSV" => "XLS", "DOC" or "DOCX" => "DOC", "" => "FILE", _ => e.Length > 4 ? "FILE" : e };
    }

    private async Task DownloadAllRefs()
    {
        var files = _selectedJobRefs.Where(r => !string.IsNullOrEmpty(r.FileUrl))
            .Select(r => new { url = r.FileUrl, name = string.IsNullOrEmpty(r.FileName) ? r.ReferenceName : r.FileName }).ToList();
        if (files.Count > 0) await JS.InvokeVoidAsync("issDownloadAll", files);
    }

    private void StartInspection(JobItem? job)
    {
        if (job == null) return;
        Navigation.NavigateTo($"/inspection-qc/{job.Id}");
    }

    private void ViewReport(JobItem? job)
    {
        if (job == null) return;
        // Truyền explicit source để nút Back ở InspectionReport biết trả về đâu
        Navigation.NavigateTo($"/inspection-report/{job.Id}/from/schedule");
    }

    private static string GetStatusClass(string status) => status switch
    {
        "Completed" or "completed"   => "st-done",
        "OnGoing"   or "ongoing"     => "st-going",
        "Delay"     or "delay"       => "st-delay",
        "Pending"   or "pending"     => "st-pending",
        "Cancel"    or "cancelled"   => "st-cancel",
        _                            => "st-new"
    };

