@page "/vendor-reviews"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using InticooInspection.Client.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PageAccessService PageAccess
@inherits LocalizedComponentBase

<PageTitle>@T("VendorReviews.VendorReviewsInticoo")</PageTitle>

<ReviewDirectory Title="@T("VendorReviews.VendorReviews")" Subtitle="@T("VendorReviews.PerformanceOverviewVendorQualityMetricsInspectio")"
                 EntityPlural="@T("VendorReviews.Vendors")" SearchPlaceholder="@T("VendorReviews.SearchPlaceholder")"
                 Loading="_loading" Items="_items" OnSelect="GoToReview" />

@code {
    private List<ReviewDirectory.Item> _items = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        // ── Page Access guard ─────────────────────────────────────────
        // Admin tu dong duoc phep (IsAdmin = true). Cac role khac phai
        // co "PerformanceReview" trong cot PageAccess (CSV) thi moi vao.
        await PageAccess.EnsureLoadedAsync();
        if (!PageAccess.HasAccess("PerformanceReview"))
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        try
        {
            var result = await Http.GetFromJsonAsync<VendorListResult>("api/vendors?pageSize=1000",
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            // Status: 0 = Active, 1 = Inactive, 2 = Suspended
            _items = (result?.Items ?? new())
                .Where(v => !string.IsNullOrEmpty(v.Code))
                .Select(v => new ReviewDirectory.Item(v.Code!, v.Name ?? "", v.Country, v.Category, v.Status == 0))
                .ToList();
        }
        catch { }
        _loading = false;
    }

    void GoToReview(string code)
    {
        if (!string.IsNullOrEmpty(code))
            Navigation.NavigateTo($"/vendor-reviews/{code}");
    }

    class VendorListResult
    {
        public List<VendorItem> Items { get; set; } = new();
    }
    class VendorItem
    {
        public string? Code     { get; set; }
        public string? Name     { get; set; }
        public string? Country  { get; set; }
        public string? Category { get; set; }
        public int     Status   { get; set; }
    }
}
