@page "/inspector-reviews"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using InticooInspection.Client.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PageAccessService PageAccess
@inherits LocalizedComponentBase

<PageTitle>@T("InspectorReviews.InspectorReviewsInticoo")</PageTitle>

<ReviewDirectory Title="@T("InspectorReviews.InspectorReviews")" Subtitle="@T("InspectorReviews.ReviewInspectorPerformanceMonthlyYearlyInspectio")"
                 EntityPlural="@T("InspectorReviews.Inspectors")" SearchPlaceholder="@T("InspectorReviews.SearchPlaceholder")"
                 Loading="_loading" Items="_items" OnSelect="GoToReview" />

@code {
    List<ReviewDirectory.Item> _items = new();
    bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        // Page Access guard
        await PageAccess.EnsureLoadedAsync();
        if (!PageAccess.HasAccess("PerformanceReview"))
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }

        try
        {
            var result = await Http.GetFromJsonAsync<UserListResult>("api/users?pageSize=1000",
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            _items = (result?.Items ?? new())
                .Where(u => !string.IsNullOrEmpty(u.InspectorId))
                .OrderBy(u => u.InspectorId)
                .Select(u => new ReviewDirectory.Item(u.InspectorId!, u.FullName ?? "",
                    string.IsNullOrWhiteSpace(u.Nationality) ? u.Country : u.Nationality, u.Category, u.IsActive, u.PhotoUrl))
                .ToList();
        }
        catch { }
        _loading = false;
    }

    void GoToReview(string id)
    {
        if (!string.IsNullOrEmpty(id))
            Navigation.NavigateTo($"/inspector-reviews/{id}");
    }

    class UserListResult { public List<UserItem> Items { get; set; } = new(); }
    class UserItem
    {
        public string? InspectorId { get; set; }
        public string? FullName    { get; set; }
        public string? Nationality { get; set; }
        public string? Country     { get; set; }
        public string? Category    { get; set; }
        public string? PhotoUrl    { get; set; }
        public bool    IsActive    { get; set; } = true;
    }
}
