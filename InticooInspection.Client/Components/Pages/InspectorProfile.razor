                        <ViewRow Label="@T("InspectorProfile.StartYear")" Value="@d.InspectionStartYear?.ToString()" />
                        <ViewRow Label="@T("Common.Language")" Value="@d.Language" />
                        <ViewRow Label="@T("Common.Status")" Value="@(d.IsActive ? T("Common.Active") : T("Common.Inactive"))" />
