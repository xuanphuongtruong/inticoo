                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        @T("Common.Edit")
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    private bool _fOpen;
    private const string INSPECTOR_ROLE = "Inspector";
    // Default login credentials when creating a new Inspector profile.
    // Since Inspector is managed as a profile (no login UI), the account is
    // created under the hood with these defaults. Admin can change them later
    // through the Users page if the inspector ever needs to log in.
    private const string DEFAULT_PASSWORD = "Inspector@123";

    private List<UserDto> _users = new();
    private bool   _loading = true;
    private string _search  = "";
    private string _statusFilter = "";   // "" = tất cả, "true" = Active, "false" = Inactive

    private int _cntActive, _cntInactive;
    private async Task SetStatusChip(string v) { _statusFilter = v; await LoadPage(1); }
    private async Task LoadCounts()
    {
        try
        {
            var a = await Http.GetFromJsonAsync<UserPageResult>($"api/users?page=1&pageSize=1&roles={INSPECTOR_ROLE}&isActive=true");
            var i = await Http.GetFromJsonAsync<UserPageResult>($"api/users?page=1&pageSize=1&roles={INSPECTOR_ROLE}&isActive=false");
            _cntActive = a?.Total ?? 0; _cntInactive = i?.Total ?? 0;
        }
        catch { }
    }

    private async Task OnStatusFilter(ChangeEventArgs e)
    {
        _statusFilter = e.Value?.ToString() ?? "";
        await LoadPage(1);
    }
    private int    _page = 1, _pageSize = 10, _total = 0;
    private string _category = "", _country = "";
    private List<string> _catOpts = new(), _countryOpts = new();
    private readonly HashSet<string> _sel = new();
    private void ToggleAll(bool on) { foreach (var x in _users) { if (on) _sel.Add(x.Id); else _sel.Remove(x.Id); } }
    private void ToggleOne(string id, bool on) { if (on) _sel.Add(id); else _sel.Remove(id); }
    private async Task SetPageSize(int n) { _pageSize = n; await LoadPage(1); }
    private async Task ClearFilters() { _search = _statusFilter = _category = _country = ""; await LoadPage(1); }

    // Modal state
    private bool    _showModal    = false;
    private string? _editId       = null;

    // Detail view state (read-only full detail modal)
    private UserDto? _detailUser = null;
    // Login (filled automatically, NOT shown in UI)
    private string  _formUsername = "";
    // Profile fields
    private string  _formFullName = "", _formShortName = "", _formEmail = "";
    private string  _formInspectorId = "", _formCategory = "", _formMobile = "";
    private DateTime? _formDateOfBirth = null;
    // Text được hiển thị trong input dd/MM/yyyy (đồng bộ 2 chiều với _formDateOfBirth)
    private string _formDateOfBirthText = "";
    private string  _formGender = "", _formNationality = "", _formIdType = "", _formIdNumber = "";
    private int?    _formInspectionStartYear = null;
    private List<string> _formLanguages = new();
    private string  _formAddress1 = "", _formAddress2 = "";
    private string  _formCity = "", _formState = "", _formCountry = "", _formPostalCode = "";

    // Dropdowns
    private List<CountryItem> _countries = new();
    private bool              _loadingCountries = true;

    private bool    _formIsActive = true;
    private bool    _formShowInLoginAccount = true;
    private string  _formError    = "";
    private bool    _saving       = false;

    // CV state
    private IBrowserFile? _cvFile        = null;
    private string        _cvError       = "";
    private bool          _cvDragOver    = false;
    private string?       _existingCvUrl = null;
    private static readonly long MaxCvBytes = 10 * 1024 * 1024;

    // Photo state
    private IBrowserFile? _photoFile        = null;
    private string        _photoError       = "";
    private string?       _existingPhotoUrl = null;
    private static readonly long MaxPhotoBytes = 5 * 1024 * 1024;

    private UserDto? _deleteUser = null;

    protected override async Task OnInitializedAsync()
    {
        await SetAuthHeader();
        await PageAccess.EnsureLoadedAsync();
        // Page Access guard: Admin luon duoc vao, role khac phai co "Directory"
        if (!PageAccess.HasAccess("Directory"))
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }
        await Task.WhenAll(LoadPage(1), LoadCountries());
    }

    private async Task SetAuthHeader()
    {
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("auth_token");
            if (!string.IsNullOrEmpty(token))
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }
        catch { }
    }

    private async Task LoadPage(int page)
    {
        _loading = true; _page = page;
        try
        {
            // Filter: only Inspector role
            var url = $"api/users?page={page}&pageSize={_pageSize}" +
                      $"&search={Uri.EscapeDataString(_search)}" +
                      $"&roles={INSPECTOR_ROLE}" +
                      (_statusFilter == "" ? "" : $"&isActive={_statusFilter}") +
                      $"&category={Uri.EscapeDataString(_category)}&country={Uri.EscapeDataString(_country)}";
            var result = await Http.GetFromJsonAsync<UserPageResult>(url);
            if (result != null) { _users = result.Items; _total = result.Total; _catOpts = result.Categories; _countryOpts = result.Countries; }
            await LoadCounts();
        }
        catch { }
        finally { _loading = false; }
    }

    private async Task OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") await LoadPage(1); }
    private async Task PrevPage() => await LoadPage(_page - 1);
    private async Task NextPage() => await LoadPage(_page + 1);
    private int TotalPages() => (_total + _pageSize - 1) / _pageSize;

    private async Task LoadCountries()
    {
        try
        {
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var json = await Http.GetStringAsync("api/geo/countries");
            _countries = System.Text.Json.JsonSerializer.Deserialize<List<CountryItem>>(json, opts) ?? new();
        }
        catch { }
        finally { _loadingCountries = false; }
    }

    private void ResetForm()
    {
        _formUsername = ""; _formFullName = ""; _formShortName = ""; _formEmail = "";
        _formInspectorId = ""; _formCategory = ""; _formMobile = "";
        _formDateOfBirth = null; _formDateOfBirthText = ""; _formGender = ""; _formNationality = "";
        _formIdType = ""; _formIdNumber = ""; _formInspectionStartYear = null;
        _formLanguages = new();
        _formAddress1 = ""; _formAddress2 = "";
        _formCity = ""; _formState = ""; _formCountry = ""; _formPostalCode = "";
        _formIsActive = true; _formShowInLoginAccount = true; _formError = "";
        _cvFile = null; _cvError = ""; _existingCvUrl = null;
        _photoFile = null; _photoError = ""; _existingPhotoUrl = null;
    }

    // ─── Date of Birth handlers ───
    // Người dùng gõ vào input text: tự chèn '/' và parse khi đủ 10 ký tự
    private void OnDobTextInput(ChangeEventArgs e)
    {
        var raw    = e.Value?.ToString() ?? "";
        var digits = new string(raw.Where(char.IsDigit).ToArray());
        if (digits.Length > 8) digits = digits.Substring(0, 8);

        // Format dần dần: dd, dd/mm, dd/mm/yyyy
        string formatted;
        if (digits.Length <= 2)        formatted = digits;
        else if (digits.Length <= 4)   formatted = $"{digits.Substring(0, 2)}/{digits.Substring(2)}";
        else                            formatted = $"{digits.Substring(0, 2)}/{digits.Substring(2, 2)}/{digits.Substring(4)}";

        _formDateOfBirthText = formatted;

        // Khi đủ ngày hợp lệ thì parse thành DateTime
        if (digits.Length == 8 &&
            DateTime.TryParseExact(formatted, "dd/MM/yyyy",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var d))
        {
            _formDateOfBirth = d;
        }
        else
        {
            _formDateOfBirth = null;
        }
    }

    // Khi blur, nếu text không hợp lệ thì xoá để placeholder hiện lại
    private void OnDobTextBlur(FocusEventArgs e)
    {
        if (string.IsNullOrWhiteSpace(_formDateOfBirthText)) return;

        if (DateTime.TryParseExact(_formDateOfBirthText, "dd/MM/yyyy",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out var d))
        {
            _formDateOfBirth     = d;
            _formDateOfBirthText = d.ToString("dd/MM/yyyy");
        }
        else
        {
            _formDateOfBirth     = null;
            _formDateOfBirthText = "";
        }
    }

    // Khi pick từ native picker (input ẩn), sync vào text
    private void OnDobNativeChange(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var d))
        {
            _formDateOfBirth     = d;
            _formDateOfBirthText = d.ToString("dd/MM/yyyy");
        }
        else
        {
            _formDateOfBirth     = null;
            _formDateOfBirthText = "";
        }
    }

    // Click icon lịch → mở native picker (showPicker khả dụng trên Chrome/Edge/Safari mới)
    private async Task OpenDobPicker()
    {
        const string js = @"(function(){
            var el = document.getElementById('dob-native-input');
            if (!el) return false;
            try {
                if (typeof el.showPicker === 'function') { el.showPicker(); return true; }
            } catch (e) { /* showPicker can throw NotAllowedError on some browsers */ }
            try { el.focus(); el.click(); return true; } catch(e) { return false; }
        })();";
        try { await JS.InvokeVoidAsync("eval", js); } catch { /* ignore */ }
    }

    private async Task OpenCreate()
    {
        _editId = null;
        ResetForm();
        // Auto-generate Inspector ID
        try
        {
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var json = await Http.GetStringAsync("api/users/nextid");
            var res  = System.Text.Json.JsonSerializer.Deserialize<NextIdResult>(json, opts);
            _formInspectorId = res?.InspectorId ?? "";
        }
        catch { _formInspectorId = ""; }
        _showModal = true;
    }

    private class NextIdResult { public string InspectorId { get; set; } = ""; }

    private async Task OpenEdit(UserDto u)
    {
        _editId                  = u.Id;
        _formUsername            = u.Username;
        _formFullName            = u.FullName           ?? "";
        _formShortName           = u.ShortName          ?? "";
        _formEmail               = u.Email              ?? "";
        _formInspectorId         = u.InspectorId        ?? "";
        _formCategory            = u.Category           ?? "";
        _formMobile              = u.Mobile             ?? "";
        _formDateOfBirth         = u.DateOfBirth;
        _formDateOfBirthText     = u.DateOfBirth?.ToString("dd/MM/yyyy") ?? "";
        _formGender              = u.Gender             ?? "";
        _formNationality         = u.Nationality        ?? "";
        _formIdType              = u.IdType             ?? "";
        _formIdNumber            = u.IdNumber           ?? "";
        _formInspectionStartYear = u.InspectionStartYear;
        _formLanguages           = string.IsNullOrEmpty(u.Language)
                                   ? new() : u.Language.Split(',').Select(x => x.Trim()).ToList();
        _formAddress1            = u.Address1           ?? "";
        _formAddress2            = u.Address2           ?? "";
        _formCity                = u.City               ?? "";
        _formState               = u.State              ?? "";
        _formCountry             = u.Country            ?? "";
        _formPostalCode          = u.PostalCode         ?? "";
        _formIsActive            = u.IsActive;
        _formShowInLoginAccount  = u.ShowInLoginAccount;
        _formError               = "";
        _cvFile                  = null; _cvError = ""; _existingCvUrl   = u.CvUrl;
        _photoFile               = null; _photoError = ""; _existingPhotoUrl = u.PhotoUrl;
        _showModal               = true;
        await Task.CompletedTask;
    }

    private void CloseModal() => _showModal = false;

    // ── Full Detail (read-only) ──────────────────────────────────────────────
    private void OpenDetail(UserDto u) => _detailUser = u;
    private void CloseDetail()          => _detailUser = null;

    /// <summary>
    /// When country changes, auto-update the dial-code prefix of Mobile.
    /// Uses CountryDialCodes helper to preserve digits the user already typed.
    /// </summary>
    private void OnCountryChanged(ChangeEventArgs e)
    {
        _formCountry = e.Value?.ToString() ?? "";
        _formMobile  = CountryDialCodes.ApplyDialCode(_formMobile, _formCountry);
    }

    private void ToggleLanguage(string lang)
    {
        if (_formLanguages.Contains(lang)) _formLanguages.Remove(lang);
        else _formLanguages.Add(lang);
    }

    // ── CV ────────────────────────────────────────────────────────────────────

    private void OnCvFileSelected(InputFileChangeEventArgs e)
    {
        _cvError = "";
        var file = e.File;
        if (!ValidateCvFile(file)) return;
        _cvFile = file;
    }

    private void OnCvDrop(DragEventArgs e) => _cvDragOver = false;
    private void RemoveCv() { _cvFile = null; _cvError = ""; }

    private bool ValidateCvFile(IBrowserFile file)
    {
        var allowed = new[] { ".pdf", ".doc", ".docx" };
        var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        if (!allowed.Contains(ext)) { _cvError = T("InspectorProfile.OnlyPDFDOCOrDOCXFiles"); return false; }
        if (file.Size > MaxCvBytes) { _cvError = T("InspectorProfile.FileSizeMustNotExceed10"); return false; }
        return true;
    }

    private async Task<string?> UploadCvAsync()
    {
        if (_cvFile == null) return null;
        try
        {
            using var content = new MultipartFormDataContent();
            var stream      = _cvFile.OpenReadStream(MaxCvBytes);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(_cvFile.ContentType);
            content.Add(fileContent, "file", _cvFile.Name);
            var response = await Http.PostAsync("api/files/upload-cv", content);
            if (!response.IsSuccessStatusCode) { _formError = T("InspectorProfile.CVUploadFailedPleaseTryAgain"); return null; }
            var result = await response.Content.ReadFromJsonAsync<UploadResult>();
            return result?.Url;
        }
        catch { _formError = T("InspectorProfile.CVUploadErrorPleaseTryAgain"); return null; }
    }

    // ── Photo ──────────────────────────────────────────────────────────────────

    private void OnPhotoFileSelected(InputFileChangeEventArgs e)
    {
        _photoError = "";
        var file = e.File;
        if (!ValidatePhotoFile(file)) return;
        _photoFile = file;
    }

    private bool ValidatePhotoFile(IBrowserFile file)
    {
        var allowed = new[] { ".jpg", ".jpeg", ".png", ".webp" };
        var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        if (!allowed.Contains(ext)) { _photoError = T("InspectorProfile.OnlyJPGPNGOrWEBPFiles"); return false; }
        if (file.Size > MaxPhotoBytes) { _photoError = T("InspectorProfile.PhotoSizeMustNotExceed5"); return false; }
        return true;
    }

    private async Task<string?> UploadPhotoAsync()
    {
        if (_photoFile == null) return null;
        try
        {
            using var content = new MultipartFormDataContent();
            var stream      = _photoFile.OpenReadStream(MaxPhotoBytes);
            var fileContent = new StreamContent(stream);
            fileContent.Headers.ContentType = new MediaTypeHeaderValue(_photoFile.ContentType);
            content.Add(fileContent, "file", _photoFile.Name);
            var response = await Http.PostAsync("api/files/upload-photo", content);
            if (!response.IsSuccessStatusCode) { _formError = T("InspectorProfile.PhotoUploadFailedPleaseTryAgain"); return null; }
            var result = await response.Content.ReadFromJsonAsync<UploadResult>();
            return result?.Url;
        }
        catch { _formError = T("InspectorProfile.PhotoUploadErrorPleaseTryAgain"); return null; }
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024)         return $"{bytes} B";
        if (bytes < 1024 * 1024)  return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    // ── Save ──────────────────────────────────────────────────────────────────

    private async Task SaveInspector()
    {
        _formError = ""; _cvError = "";
        if (string.IsNullOrWhiteSpace(_formFullName)) { _formError = T("InspectorProfile.FullNameIsRequired"); return; }
        if (_editId == null && _cvFile == null)       { _cvError   = T("InspectorProfile.CVResumeIsRequiredWhenCreating"); return; }

        _saving = true;
        Waiting.Show(_editId == null ? T("InspectorProfile.CreatingInspector") : T("InspectorProfile.SavingInspector"));
        try
        {
            string? cvUrl = _existingCvUrl;
            if (_cvFile != null)
            {
                Waiting.Show(T("InspectorProfile.UploadingCV"));
                cvUrl = await UploadCvAsync();
                if (cvUrl == null) { _saving = false; Waiting.Hide(); return; }
                Waiting.Show(_editId == null ? T("InspectorProfile.CreatingInspector") : T("InspectorProfile.SavingInspector"));
            }

            string? photoUrl = _existingPhotoUrl;
            if (_photoFile != null)
            {
                Waiting.Show(T("InspectorProfile.UploadingPhoto"));
                photoUrl = await UploadPhotoAsync();
                if (photoUrl == null) { _saving = false; Waiting.Hide(); return; }
                Waiting.Show(_editId == null ? T("InspectorProfile.CreatingInspector") : T("InspectorProfile.SavingInspector"));
            }

            HttpResponseMessage response;
            if (_editId == null)
            {
                // Auto-fill username from Inspector ID when creating
                var autoUsername = string.IsNullOrWhiteSpace(_formInspectorId)
                    ? $"inspector_{Guid.NewGuid().ToString("N").Substring(0, 8)}"
                    : _formInspectorId.ToLowerInvariant();

                var payload = new {
                    username            = autoUsername,
                    password            = DEFAULT_PASSWORD,
                    email               = _formEmail,
                    fullName            = _formFullName,
                    shortName           = _formShortName,
                    dateOfBirth         = _formDateOfBirth,
                    gender              = _formGender,
                    nationality         = _formNationality,
                    idType              = _formIdType,
                    idNumber            = _formIdNumber,
                    category            = _formCategory,
                    inspectionStartYear = _formInspectionStartYear,
                    language            = string.Join(",", _formLanguages),
                    isActive            = _formIsActive,
                    showInLoginAccount  = _formShowInLoginAccount,
                    roles               = new[] { INSPECTOR_ROLE },
                    cvUrl               = cvUrl,
                    photoUrl            = photoUrl,
                    inspectorId         = _formInspectorId,
                    mobile              = _formMobile,
                    address1            = _formAddress1,
                    address2            = _formAddress2,
                    city                = _formCity,
                    state               = _formState,
                    country             = _formCountry,
                    postalCode          = _formPostalCode
                };
                response = await Http.PostAsJsonAsync("api/users", payload);
            }
            else
            {
                var payload = new {
                    username            = _formUsername,
                    newPassword         = (string?)null, // keep current password
                    email               = _formEmail,
                    fullName            = _formFullName,
                    shortName           = _formShortName,
                    dateOfBirth         = _formDateOfBirth,
                    gender              = _formGender,
                    nationality         = _formNationality,
                    idType              = _formIdType,
                    idNumber            = _formIdNumber,
                    category            = _formCategory,
                    inspectionStartYear = _formInspectionStartYear,
                    language            = string.Join(",", _formLanguages),
                    isActive            = _formIsActive,
                    showInLoginAccount  = _formShowInLoginAccount,
                    roles               = new[] { INSPECTOR_ROLE },
                    cvUrl               = cvUrl,
                    photoUrl            = photoUrl,
                    inspectorId         = _formInspectorId,
                    mobile              = _formMobile,
                    address1            = _formAddress1,
                    address2            = _formAddress2,
                    city                = _formCity,
                    state               = _formState,
                    country             = _formCountry,
                    postalCode          = _formPostalCode
                };
                response = await Http.PutAsJsonAsync($"api/users/{_editId}", payload);
            }

            if (response.IsSuccessStatusCode) { _showModal = false; await LoadPage(_page); }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                _formError = TA(err?.Message) ?? T("InspectorProfile.ErrorOccurred");
            }
        }
        catch { _formError = T("InspectorProfile.ConnectionError"); }
        finally { _saving = false; Waiting.Hide(); }
    }

    private async Task ToggleActive(UserDto user)
    {
        var response = await Http.PutAsJsonAsync($"api/users/{user.Id}/toggle-active", new { });
        if (response.IsSuccessStatusCode) { user.IsActive = !user.IsActive; StateHasChanged(); }
    }

    private void ConfirmDelete(UserDto user) => _deleteUser = user;

    private async Task DeleteInspector()
    {
        if (_deleteUser == null) return;
        _saving = true;
        Waiting.Show(T("InspectorProfile.DeletingInspector"));
        var response = await Http.DeleteAsync($"api/users/{_deleteUser.Id}");
        _saving = false;
        Waiting.Hide();
        if (response.IsSuccessStatusCode) { _deleteUser = null; await LoadPage(_page); }
    }

    private string GetInitials(string name)
        => string.Concat(name.Split(" ").Take(2).Select(w => w.Length > 0 ? w[0].ToString().ToUpper() : ""));

    // ── DTOs ──────────────────────────────────────────────────────────────────
    private class UserDto
    {
        public string   Id                  { get; set; } = "";
        public string   Username            { get; set; } = "";
        public string?  FullName            { get; set; }
        public string?  ShortName           { get; set; }
        public string?  Email               { get; set; }
        public DateTime? DateOfBirth        { get; set; }
        public string?  Gender              { get; set; }
        public string?  Nationality         { get; set; }
        public string?  IdType              { get; set; }
        public string?  IdNumber            { get; set; }
        public string?  Category            { get; set; }
        public int?     InspectionStartYear { get; set; }
        public string?  Language            { get; set; }
        public bool     IsActive            { get; set; }
        public bool     ShowInLoginAccount  { get; set; } = true;
        public List<string> Roles           { get; set; } = new();
        public DateTime CreatedAt           { get; set; }
        public string?  CvUrl               { get; set; }
        public string?  PhotoUrl            { get; set; }
        public string?  InspectorId         { get; set; }
        public string?  Address             { get; set; }
        public string?  Address1            { get; set; }
        public string?  Address2            { get; set; }
        public string?  City                { get; set; }
        public string?  State               { get; set; }
        public string?  Country             { get; set; }
        public string?  PostalCode          { get; set; }
        public string?  Mobile              { get; set; }
    }

    private class CountryItem
    {
        public int    Id     { get; set; }
        public string Name   { get; set; } = "";
        public string Code   { get; set; } = "";
        public string Region { get; set; } = "";
    }

    private class UserPageResult { public int Total { get; set; } public List<string> Categories { get; set; } = new(); public List<string> Countries { get; set; } = new(); public List<UserDto> Items { get; set; } = new(); }
    private class ErrorResponse  { public string? Message { get; set; } }
    private class UploadResult   { public string? Url     { get; set; } }
}

