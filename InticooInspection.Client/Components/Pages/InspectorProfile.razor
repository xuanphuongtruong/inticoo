@page "/inspectors"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@using InticooInspection.Client.Services
@using InticooInspection.Client.Helpers
@inject WaitingService Waiting
@inject IJSRuntime JS
@inject PageAccessService PageAccess
@using InticooInspection.Client.Shared
@inherits LocalizedComponentBase

<PageTitle>@T("InspectorProfile.InspectorProfileInticoo")</PageTitle>

<div class="lp-head">
    <div class="title-block">
        <h1 class="page-title">@T("InspectorProfile.InspectorProfile")</h1>
        <span class="page-sub">@T("InspectorProfile.ManageInspectorProfilesAndDetails")</span>
    </div>
</div>
<div class="top-bar lp-filters @(_fOpen ? "fopen" : "")">
    <div class="search-wrap">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="9" cy="9" r="5.5"/><path d="M15 15l-2.5-2.5" stroke-linecap="round"/>
        </svg>
        <input class="search-input" type="text" placeholder="@T("InspectorProfile.SearchByNameInspectorIDEmail")"
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey" />
    </div>
    <button type="button" class="lp-filter-toggle @(_fOpen ? "on" : "")" @onclick="() => _fOpen = !_fOpen" aria-label="@T("Common.Filters")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></svg></button>
    <div class="lp-selects">
        <select class="filter-select" value="@_statusFilter" @onchange="OnStatusFilter" title="@T("InspectorProfile.FilterByStatus")">
            <option value="">@T("Common.AllStatus")</option>
            <option value="true">@T("Common.Active")</option>
            <option value="false">@T("Common.Inactive")</option>
        </select>
        <select class="filter-select" @bind="_category" @bind:after="() => LoadPage(1)">
            <option value="">@T("Common.AllCategories")</option>
            @foreach (var c in _catOpts) { <option value="@c">@TE("Opt", c)</option> }
        </select>
        <select class="filter-select" @bind="_country" @bind:after="() => LoadPage(1)">
            <option value="">@T("Common.AllCountries")</option>
            @foreach (var c in _countryOpts) { <option value="@c">@c</option> }
        </select>
        <button type="button" class="lp-btn-reset" @onclick="ClearFilters">@T("Common.Clear")</button>
    </div>
    <span class="total-count">@T("InspectorProfile.Inspectors", _total)</span>
    @if (PageAccess.IsAdmin)
    {
        <ImportExcelButton ApiBase="api/users" OnImported="() => LoadPage(_page)" />
        <button class="btn-new" @onclick="async () => await OpenCreate()">
            <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M10 4v12M4 10h12"/></svg>
            @T("InspectorProfile.NewInspector")
        </button>
    }
</div>

<div class="m-kpis">
    <div class="m-kpi"><span class="m-kpi-ico k-blue"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 5.5"/></svg></span><b>@(_cntActive + _cntInactive)</b><small>@T("Customers.KpiTotal")</small></div>
    <div class="m-kpi"><span class="m-kpi-ico k-green"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg></span><b>@(_cntActive)</b><small>@T("Common.Active")</small></div>
    <div class="m-kpi"><span class="m-kpi-ico k-orange"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/></svg></span><b class="red">@(_cntInactive)</b><small>@T("Common.Inactive")</small></div>
    <div class="m-kpi lp-kpi-extra"><span class="m-kpi-ico k-blue"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 12l-8 8-9-9V3h8z"/><circle cx="7.5" cy="7.5" r="1.2"/></svg></span><b>@_catOpts.Count</b><small>@T("Vendors.Categories")</small></div>
</div>
<div class="m-chips">
    <button type="button" class="@(_statusFilter == "" ? "on" : "")" @onclick='() => SetStatusChip("")'>@T("Customers.ChipAll") (@(_cntActive + _cntInactive))</button>
    <button type="button" class="@(_statusFilter == "true" ? "on" : "")" @onclick='() => SetStatusChip("true")'>@T("Common.Active") (@_cntActive)</button>
    <button type="button" class="@(_statusFilter == "false" ? "on" : "")" @onclick='() => SetStatusChip("false")'>@T("Common.Inactive") (@_cntInactive)</button>
</div>

@if (_loading)
{
    <div class="loading-wrap"><div class="spinner"></div><span>@T("Common.Loading")</span></div>
}
else if (_users.Count == 0)
{
    <div class="empty-state"><p>@T("InspectorProfile.NoInspectorsFound")</p></div>
}
else
{
    <div class="m-cards">
        @foreach (var mu in _users)
        {
            var u = mu;
            var uname = string.IsNullOrEmpty(u.FullName) ? u.Username : u.FullName;
            <div class="m-card">
                <div class="m-card-top">
                    @if (!string.IsNullOrEmpty(u.PhotoUrl))
                    {
                        <img class="m-thumb round" src="@MediaUrl.Resolve(u.PhotoUrl, Http.BaseAddress?.ToString())" alt="@uname" />
                    }
                    else
                    {
                        <div class="m-thumb round m-initials">@GetInitials(uname)</div>
                    }
                    <div class="m-card-main">
                        <div class="m-card-head">
                            <div class="m-card-name">@uname</div>
                            <span class="m-status @(u.IsActive ? "ok" : "off")">@(u.IsActive ? T("Common.Active") : T("Common.Inactive"))</span>
                        </div>
                        <div class="m-card-code">@(string.IsNullOrEmpty(u.InspectorId) ? "—" : u.InspectorId)</div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(u.Category))
                {
                    <span class="m-cat">@TE("Opt", u.Category)</span>
                }
                <div class="m-card-rows">
                    @if (!string.IsNullOrEmpty(u.City) || !string.IsNullOrEmpty(u.Country))
                    {
                        <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>@string.Join(", ", new[] { u.City, u.Country }.Where(x => !string.IsNullOrEmpty(x)))</div>
                    }
                    @if (!string.IsNullOrEmpty(u.Mobile))
                    {
                        <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>@u.Mobile</div>
                    }
                    <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>@L.Date(u.CreatedAt, "d MMM yyyy")</div>
                </div>
                <div class="m-card-actions">
                    <button type="button" class="m-btn-outline" @onclick="() => OpenDetail(u)">@T("Common.View")</button>
                    @if (PageAccess.IsAdmin)
                    {
                        <button type="button" class="m-btn-fill" @onclick="async () => await OpenEdit(u)">@T("Common.Edit")</button>
                    }
                </div>
            </div>
        }
    </div>

    <div class="table-wrap">
        <table class="ptable">
            <thead>
                <tr>
                    <th class="tc th-y th-chk"><input type="checkbox" checked="@(_users.Count > 0 && _users.All(x => _sel.Contains(x.Id)))" @onchange="e => ToggleAll((bool)(e.Value ?? false))" /></th>
                    <th class="tc th-y th-no">No</th>
                    <th class="tc th-y">@T("InspectorProfile.ProfilePhoto")</th>
                    <th class="tc th-y">@T("Common.InspectorName")</th>
                    <th class="tc th-y">@T("Common.InspectorID")</th>
                    <th class="tc th-y">@T("Common.Category")</th>
                    <th class="tc th-y">@T("InspectorProfile.Location")</th>
                    <th class="tc th-y">@T("Common.Mobile")</th>
                    <th class="tc th-y">@T("InspectorProfile.DateJoined")</th>
                    <th class="tc th-y">@T("Common.Status")</th>
                    <th class="tc th-y">@T("Common.Actions")</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNo = (_page - 1) * _pageSize; }
                @foreach (var user in _users)
                {
                    var u = user;
                    rowNo++;
                    <tr class="table-row @(rowNo % 2 == 0 ? "tr-alt" : "")">
                        <td class="tc"><input type="checkbox" checked="@_sel.Contains(u.Id)" @onchange="e => ToggleOne(u.Id, (bool)(e.Value ?? false))" /></td>
                        <td class="td-c td-no">@rowNo</td>
                        <td class="tc">
                            @if (!string.IsNullOrEmpty(u.PhotoUrl))
                            {
                                var fullPhotoUrl = MediaUrl.Resolve(u.PhotoUrl, Http.BaseAddress?.ToString());
                                <img class="row-avatar" src="@fullPhotoUrl" alt="@u.FullName" />
                            }
                            else
                            {
                                <div class="row-avatar row-avatar-placeholder">
                                    @GetInitials(string.IsNullOrEmpty(u.FullName) ? u.Username : u.FullName)
                                </div>
                            }
                        </td>
                        <td class="tc">
                            <div class="user-cell" style="justify-content:center;">
                                <span class="user-fullname">@(string.IsNullOrEmpty(u.FullName) ? u.Username : u.FullName)</span>
                            </div>
                        </td>
                        <td class="td-c mono-sm">@(string.IsNullOrEmpty(u.InspectorId) ? "—" : u.InspectorId)</td>
                        <td class="tc">
                            @if (!string.IsNullOrEmpty(u.Category))
                            {
                                <span class="cat-badge">@TE("Opt", u.Category)</span>
                            }
                            else { <span class="dim">—</span> }
                        </td>
                        <td class="tc dim sm">@(string.Join(", ", new[] { u.City, u.Country }.Where(x => !string.IsNullOrEmpty(x))) is { Length: > 0 } loc ? loc : "—")</td>
                        <td class="tc dim sm">@(string.IsNullOrEmpty(u.Mobile)  ? "—" : u.Mobile)</td>
                        <td class="td-c dim sm">@L.Date(u.CreatedAt, "dd/MMM/yyyy")</td>
                        <td class="tc">
                            <button class="status-toggle @(u.IsActive ? "s-active" : "s-inactive")"
                                    disabled="@(!PageAccess.IsAdmin)"
                                    @onclick="() => ToggleActive(u)">
                                @(u.IsActive ? T("Common.Active") : T("Common.Inactive"))
                            </button>
                        </td>
                        <td class="tc">
                            <div class="action-btns">
                                <button class="bico bview" @onclick="() => OpenDetail(u)" title="@T("InspectorProfile.ViewFullDetail")">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                </button>
                                @if (PageAccess.IsAdmin)
                                {
                                    <button class="bico bedit" @onclick="async () => await OpenEdit(u)" title="@T("Common.Edit")">
                                        <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2l4 4-10 10H4v-4L14 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </button>
                                    <button class="bico bdel" @onclick="() => ConfirmDelete(u)" title="@T("Common.Delete")">
                                        <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h14M8 6V4h4v2M5 6l1 11h8l1-11" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <ListPager Total="_total" Page="_page" PageSize="_pageSize" Noun="@T("Pager.Inspectors")" OnPage="LoadPage" OnPageSize="SetPageSize" />
}

@* ── Create / Edit Modal ── *@
@if (_showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(_editId == null ? T("InspectorProfile.NewInspector") : T("InspectorProfile.EditInspector"))</h2>
                <button class="modal-close" @onclick="CloseModal">&#x2715;</button>
            </div>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="error-alert">@_formError</div>
            }

            <div class="pf-cols">
            <div class="pf-card2">
            @* ── Status ── *@
            <div class="frow">
                <div class="fcell">
                    <label class="flabel">@T("Common.LoginAccount")</label>
                    <label class="check-label" style="margin-top:6px;">
                        <input type="checkbox" @bind="_formShowInLoginAccount" />
                        <span>@T("InspectorProfile.ShowInLoginAccount")</span>
                    </label>
                </div>
            </div>

            @* ── Section: Inspector Details ── *@
            <div class="fsection-title">@T("InspectorProfile.InspectorDetails")</div>
            <div class="frow">
                <div class="fcell">
                    <label class="flabel">@T("Common.InspectorID")</label>
                    <input class="form-input" type="text" readonly
                           value="@_formInspectorId"
                           placeholder="@T("InspectorProfile.AutoGenerated")" />
                </div>
                <div class="fcell">
                    <label class="flabel">@T("Common.ShortName")</label>
                    <input class="form-input" type="text" placeholder="@T("InspectorProfile.EnterShortName")"
                           @bind="_formShortName" @bind:event="oninput" />
                </div>
            </div>
            <div class="frow">
                <div class="fcell">
                    <label class="flabel">@T("InspectorProfile.FullName") <span class="req">*</span></label>
                    <input class="form-input" type="text" placeholder="@T("InspectorProfile.EnterFullName")"
                           @bind="_formFullName" @bind:event="oninput" />
                </div>
                <div class="fcell">
                    <label class="flabel">@T("InspectorProfile.DateOfBirth")</label>
                    <div class="dob-wrap">
                        <input class="form-input dob-text"
                               type="text"
                               inputmode="numeric"
                               maxlength="10"
                               placeholder="DD/MM/YYYY"
                               value="@_formDateOfBirthText"
                               @oninput="OnDobTextInput"
                               @onblur="OnDobTextBlur" />
                        <button type="button" class="dob-icon-btn" title="@T("InspectorProfile.PickDate")"
                                @onclick="OpenDobPicker">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2"
                                 stroke-linecap="round" stroke-linejoin="round">
                                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                                <line x1="16" y1="2" x2="16" y2="6"/>
                                <line x1="8"  y1="2" x2="8"  y2="6"/>
                                <line x1="3"  y1="10" x2="21" y2="10"/>
                            </svg>
                        </button>
                        <input id="dob-native-input"
                               class="dob-native-hidden"
                               type="date"
                               value="@(_formDateOfBirth?.ToString("yyyy-MM-dd"))"
                               @onchange="OnDobNativeChange" />
                    </div>
                </div>
            </div>
            <div class="frow">
                <div class="fcell">
                    <label class="flabel">@T("InspectorProfile.Gender")</label>
                    <div class="btype-group">
                        @foreach (var g in new[] { "Male", "Female", "Other" })
                        {
                            var gv = g;
                            <label class="btype-label @(_formGender == gv ? "btype-active" : "")"
                                   @onclick="() => _formGender = gv">@TE("Opt", gv)</label>
                        }
                    </div>
                </div>
                <div class="fcell">
                    <label class="flabel">@T("InspectorProfile.Nationality")</label>
                    @if (_loadingCountries)
                    {
                        <div class="form-input" style="color:#9baac8;font-style:italic;">@T("Common.Loading")</div>
                    }
                    else
                    {
                        <select class="form-input" @bind="_formNationality">
                            <option value="">@T("InspectorProfile.SelectNationality")</option>
                            @foreach (var c in _countries)
                            {
                                <option value="@c.Name">@c.Name</option>
                            }
                        </select>
                    }
                </div>
            </div>
            <div class="frow">
                <div class="fcell">
                    <label class="flabel">@T("InspectorProfile.TypeOfIdentification")</label>
                    <div class="frow-inline" style="gap:8px; display:flex;">
                        <div class="btype-group" style="flex:0 0 auto;">
                            @foreach (var t in new[] { "ID", "Passport" })
                            {
                                var tv = t;
                                <label class="btype-label @(_formIdType == tv ? "btype-active" : "")"
                                       @onclick="() => _formIdType = tv">@TE("Opt", tv)</label>
                            }
                        </div>
                        <input class="form-input" type="text" placeholder="@T("InspectorProfile.Number")"
                               style="flex:1;"
                               @bind="_formIdNumber" @bind:event="oninput" />
                    </div>
                </div>
                <div class="fcell">
                    <label class="flabel">@T("Common.Category")</label>
                    <select class="form-input" @bind="_formCategory">
                        <option value="">@T("InspectorProfile.SelectCategory")</option>
                        @foreach (var c in Taxonomy.MainCategories) { <option value="@c">@TE("Opt", c)</option> }
                    </select>
                </div>
            </div>
            <div class="frow">
                <div class="fcell">
                    <label class="flabel">@T("InspectorProfile.InspectionStartYear")</label>
                    <input class="form-input" type="number" placeholder="@T("InspectorProfile.EG2015")" min="1990" max="2099"
                           value="@_formInspectionStartYear"
                           @onchange="e => _formInspectionStartYear = int.TryParse(e.Value?.ToString(), out var y) ? y : null" />
                </div>
                <div class="fcell">
                    <label class="flabel">@T("Common.Mobile")</label>
                    <div class="ip-phone">
                        <select class="form-input ip-dial" value="@(CountryDialCodes.CurrentCode(_formMobile) ?? "")"
                                @onchange="e => _formMobile = CountryDialCodes.ApplyCode(_formMobile, e.Value?.ToString())">
                            <option value="">+?</option>
                            @foreach (var dc in CountryDialCodes.All())
                            {
                                <option value="@dc.Code">@dc.Label</option>
                            }
                        </select>
                        <input class="form-input" type="tel" placeholder="@T("Common.EnterMobileNumber")"
                               @bind="_formMobile" @bind:event="oninput" />
                    </div>
                </div>
            </div>
            <div class="frow">
                <div class="fcell fcell-full">
                    <label class="flabel">Email</label>
                    <input class="form-input" type="email" placeholder="@T("InspectorProfile.EnterEmail")"
                           @bind="_formEmail" @bind:event="oninput" />
                </div>
            </div>
            <div class="frow">
                <div class="fcell fcell-full">
                    <label class="flabel">@T("Common.Language")</label>
                    <div class="btype-group" style="flex-wrap:wrap;">
                        @foreach (var lang in Taxonomy.Languages)
                        {
                            var lv = lang;
                            <label class="btype-label @(_formLanguages.Contains(lv) ? "btype-active" : "")"
                                   @onclick="() => ToggleLanguage(lv)">@(_formLanguages.Contains(lv) ? "✓ " : "")@TE("Opt", lv)</label>
                        }
                    </div>
                </div>
            </div>

            </div>
            <div class="pf-card2">
            @* ── Section: Inspector Address ── *@
            <div class="fsection-title">@T("InspectorProfile.InspectorAddress")</div>
            <div class="frow">
                <div class="fcell fcell-full">
                    <label class="flabel">@T("Common.Address1")</label>
                    <input class="form-input" type="text" placeholder="@T("Common.StreetAddressLine1")"
                           @bind="_formAddress1" @bind:event="oninput" />
                </div>
            </div>
            <div class="frow">
                <div class="fcell fcell-full">
                    <label class="flabel">@T("Common.Address2")</label>
                    <input class="form-input" type="text" placeholder="@T("InspectorProfile.StreetAddressLine2Optional")"
                           @bind="_formAddress2" @bind:event="oninput" />
                </div>
            </div>
            <div class="frow">
                <div class="fcell">
                    <label class="flabel">@T("Common.City")</label>
                    <input class="form-input" type="text" placeholder="@T("Common.EnterCity")"
                           @bind="_formCity" @bind:event="oninput" />
                </div>
                <div class="fcell">
                    <label class="flabel">@T("Common.StateProvince")</label>
                    <input class="form-input" type="text" placeholder="@T("InspectorProfile.StateOrProvince")"
                           @bind="_formState" @bind:event="oninput" />
                </div>
            </div>
            <div class="frow">
                <div class="fcell">
                    <label class="flabel">@T("Common.Country")</label>
                    @if (_loadingCountries)
                    {
                        <div class="form-input" style="color:#9baac8;font-style:italic;">@T("Common.Loading")</div>
                    }
                    else
                    {
                        <select class="form-input"
                                value="@_formCountry"
                                @onchange="OnCountryChanged">
                            <option value="">@T("Common.SelectCountry")</option>
                            @foreach (var c in _countries)
                            {
                                <option value="@c.Name">@c.Name</option>
                            }
                        </select>
                    }
                </div>
                <div class="fcell">
                    <label class="flabel">@T("Common.PostalZIP")</label>
                    <input class="form-input" type="text" placeholder="@T("InspectorProfile.PostalCode2")"
                           @bind="_formPostalCode" @bind:event="oninput" />
                </div>
            </div>

            </div>
            </div>

            <div class="pf-cols">
            <div class="pf-card2">
            @* ── Section: Profile Photo ── *@
            <div class="fsection-title">
                @T("InspectorProfile.ProfilePhoto")
                @if (_editId == null) { <span class="req">*</span> }
                else { <span class="label-hint">@T("InspectorProfile.LeaveBlankToKeepExisting")</span> }
            </div>
            <div class="frow">
                <div class="fcell fcell-full">
                    <div class="photo-upload-area">
                        @if (_photoFile != null)
                        {
                            <div class="photo-preview-wrap">
                                <div class="photo-preview-icon">&#128247;</div>
                                <div class="photo-preview-info">
                                    <span class="photo-file-name">@_photoFile.Name</span>
                                    <span class="photo-file-size">@FormatFileSize(_photoFile.Size)</span>
                                </div>
                                <button class="cv-remove-btn" @onclick="() => _photoFile = null" type="button">&#x2715;</button>
                            </div>
                        }
                        else if (_editId != null && !string.IsNullOrEmpty(_existingPhotoUrl))
                        {
                            var fullPhotoUrl = MediaUrl.Resolve(_existingPhotoUrl, Http.BaseAddress?.ToString());
                            <div class="photo-existing-wrap">
                                <img class="photo-existing-thumb" src="@fullPhotoUrl" alt="@T("InspectorProfile.ProfilePhoto")" />
                                <div class="photo-preview-info">
                                    <span class="photo-file-name">@T("InspectorProfile.CurrentPhotoOnFile")</span>
                                    <label class="cv-replace-btn" for="photoFileInput">@T("InspectorProfile.Replace")</label>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="photo-placeholder">
                                <span class="photo-upload-icon">&#128247;</span>
                                <span class="photo-upload-text">@T("InspectorProfile.DragDropOr") <label class="cv-browse-link" for="photoFileInput">@T("InspectorProfile.Browse")</label></span>
                                <span class="photo-upload-hint">@T("InspectorProfile.JPGPNGWEBPMax5MB")</span>
                            </div>
                        }
                        <InputFile id="photoFileInput" OnChange="OnPhotoFileSelected" accept=".jpg,.jpeg,.png,.webp"
                                   style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;" />
                    </div>
                    @if (!string.IsNullOrEmpty(_photoError))
                    {
                        <div class="cv-error">@_photoError</div>
                    }
                </div>
            </div>

            </div>
            <div class="pf-card2">
            @* ── Section: Personal Profile / CV ── *@
            <div class="fsection-title">
                @T("InspectorProfile.PersonalProfileCV")
                @if (_editId == null) { <span class="req">*</span> }
                else { <span class="label-hint">@T("InspectorProfile.LeaveBlankToKeepExisting")</span> }
            </div>
            <div class="form-group">
                <div class="cv-upload-box @(_cvDragOver ? "drag-over" : "")"
                     @ondragover:preventDefault="true"
                     @ondragover="() => _cvDragOver = true"
                     @ondragleave="() => _cvDragOver = false"
                     @ondrop:preventDefault="true"
                     @ondrop="OnCvDrop">

                    @if (_cvFile != null)
                    {
                        <div class="cv-selected">
                            <span class="cv-file-icon">&#128196;</span>
                            <div class="cv-file-info">
                                <span class="cv-file-name">@_cvFile.Name</span>
                                <span class="cv-file-size">@FormatFileSize(_cvFile.Size)</span>
                            </div>
                            <button class="cv-remove-btn" @onclick="RemoveCv" type="button">&#x2715;</button>
                        </div>
                    }
                    else if (_editId != null && !string.IsNullOrEmpty(_existingCvUrl))
                    {
                        var fullExistingUrl = MediaUrl.Resolve(_existingCvUrl, Http.BaseAddress?.ToString());
                        <div class="cv-existing">
                            <span class="cv-file-icon">&#128196;</span>
                            <div class="cv-file-info">
                                <span class="cv-file-name">@T("InspectorProfile.CurrentCVOnFile")</span>
                                <a class="cv-view-link" href="@fullExistingUrl" target="_blank">@T("InspectorProfile.View")</a>
                            </div>
                            <label class="cv-replace-btn" for="cvFileInput">@T("InspectorProfile.Replace")</label>
                        </div>
                    }
                    else
                    {
                        <div class="cv-placeholder">
                            <span class="cv-upload-icon">&#8613;</span>
                            <span class="cv-upload-text">@T("InspectorProfile.DragDropOr") <label class="cv-browse-link" for="cvFileInput">@T("InspectorProfile.Browse")</label></span>
                            <span class="cv-upload-hint">@T("InspectorProfile.PDFDOCDOCXMax10MB")</span>
                        </div>
                    }

                    <InputFile id="cvFileInput" OnChange="OnCvFileSelected" accept=".pdf,.doc,.docx"
                               style="position:absolute;inset:0;opacity:0;cursor:pointer;width:100%;height:100%;" />
                </div>
                @if (!string.IsNullOrEmpty(_cvError))
                {
                    <div class="cv-error">@_cvError</div>
                }
            </div>

            @* ── Account Status: cùng vị trí (cuối form) ở Customer/Vendor/Inspector/Product ── *@
            <div class="fsection-title" style="margin-top:16px;">@T("Common.AccountStatus")</div>
            <div class="btype-group" style="padding:8px 0 4px;">
                    <label class="btype-label @(_formIsActive ? "btype-active" : "")" @onclick="() => _formIsActive = true">@T("Common.Active")</label>
                    <label class="btype-label @(!_formIsActive ? "btype-active" : "")" @onclick="() => _formIsActive = false">@T("Common.Inactive")</label>
                    </div>

            </div>
            </div>

            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseModal">@T("Common.Cancel")</button>
                <button class="btn-submit" @onclick="SaveInspector" disabled="@_saving">
                    @if (_saving) { <span class="spinner"></span> }
                    else { <span>@(_editId == null ? T("InspectorProfile.CreateInspector") : T("InspectorProfile.SaveChanges"))</span> }
                </button>
            </div>
        </div>
    </div>
}

@if (_deleteUser != null)
{
    <div class="modal-overlay" @onclick="() => _deleteUser = null">
        <div class="modal-card confirm-card" @onclick:stopPropagation="true">
            <div class="confirm-icon">&#9888;</div>
            <h2>@T("InspectorProfile.DeleteInspector")</h2>
            <p>@T("InspectorProfile.AreYouSureYouWantTo") <strong>@(string.IsNullOrEmpty(_deleteUser.FullName) ? _deleteUser.Username : _deleteUser.FullName)</strong>?<br/>@T("InspectorProfile.ThisActionCannotBeUndone")</p>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="() => _deleteUser = null">@T("Common.Cancel")</button>
