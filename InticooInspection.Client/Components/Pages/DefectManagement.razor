@page "/defects"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PageAccessService PageAccess
@inject SettingsClient Settings
@inherits LocalizedComponentBase

<PageTitle>@T("DefectManagement.DefectManagementInticoo")</PageTitle>

<div class="dm-page">
    <div class="dm-top">
        <div>
            <h1 class="dm-title">@T("DefectManagement.DefectManagement")</h1>
            @* Desktop: câu giới thiệu theo mẫu mới, quy tắc CAPA để ở tooltip; điện thoại vẫn hiện quy tắc *@
            <div class="dm-sub dm-d-only" title="@T("DefectManagement.CapaRuleSummary", _thC, _thMa, _thMi)">@T("DefectManagement.Tagline")</div>
            <div class="dm-sub dm-m-blk">@T("DefectManagement.CapaRuleSummary", _thC, _thMa, _thMi)</div>
        </div>
        <div class="dm-actions">
            @if (PageAccess.IsAdmin)
            {
                <button class="dm-btn ghost" @onclick="ScanPreview" disabled="@_scanning">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 8V6a2 2 0 0 1 2-2h2M16 4h2a2 2 0 0 1 2 2v2M20 16v2a2 2 0 0 1-2 2h-2M8 20H6a2 2 0 0 1-2-2v-2M4 12h16M8 8.5h8M8 15.5h8"/></svg>
                    @(_scanning ? T("DefectManagement.Scanning") : T("DefectManagement.ScanInspections"))
                </button>
            }
            @if (PageAccess.Can("DefectManagement", "Create"))
            {
            <button class="dm-btn primary" @onclick="OpenNew">
                <svg class="dm-m-only" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                <span class="dm-d-only">+ </span>@T("DefectManagement.NewDefect")
            </button>
            }
        </div>
    </div>

    <div class="dm-body">
    <!-- Desktop: 4 thẻ thống kê (bấm để lọc theo trạng thái) -->
    <div class="dm-kpis">
        @{ var ky = YearItems().ToList(); var kOver = ky.Count(r => r.Overdue); }
        @foreach (var (key, label, n, cls) in new[] { ("", T("DefectManagement.AllDefects"), ky.Count, "all"), ("Open", T("DefectManagement.Open"), ky.Count(r => r.Status == "Open"), "open"), ("In Progress", T("DefectManagement.InProgress"), ky.Count(r => r.Status == "In Progress"), "prog"), ("Closed", T("DefectManagement.Closed"), ky.Count(r => r.Status == "Closed"), "closed") })
        {
            var k = key;
            <button class="dm-kpi k-@cls @(_status == k ? "active" : "")" @onclick="() => SetStatus(k)">
                <span class="dm-kpi-ic">
                    @switch (cls)
                    {
                        case "all":
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3h6v3H9zM8.5 11l1.5 1.5 3-3M8.5 16h7"/></svg>
                            break;
                        case "open":
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 10h18"/></svg>
                            break;
                        case "prog":
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 0 0-14.6-4.5M4 4v3h3M4 13a8 8 0 0 0 14.6 4.5M20 20v-3h-3"/></svg>
                            break;
                        default:
                            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.5 2.5 5.5-5.5"/></svg>
                            break;
                    }
                </span>
                <span class="dm-kpi-txt">
                    <span class="dm-kpi-lbl">@label</span>
                    <b>@n</b>
                    @if (cls == "open" && kOver > 0) { <small>@T("DefectManagement.NOverdue", kOver)</small> }
                </span>
            </button>
        }
    </div>

    <!-- Summary chips (mobile: 4 ô thống kê màu) -->
    <div class="dm-chips">
        @{ var yr = YearItems().ToList(); var overdue = yr.Count(r => r.Overdue); }
        @foreach (var (key, label, n) in new[] { ("", T("DefectManagement.All"), yr.Count), ("Open", T("DefectManagement.Open"), yr.Count(r => r.Status == "Open")), ("In Progress", T("DefectManagement.InProgress"), yr.Count(r => r.Status == "In Progress")), ("Closed", T("DefectManagement.Closed"), yr.Count(r => r.Status == "Closed")) })
        {
            var k = key;
            <button class="dm-chip st-@(k == "" ? "all" : k.Replace(" ", "").ToLower()) @(_status == k ? "active" : "")" @onclick="() => SetStatus(k)"><span>@label</span> <b>@n</b></button>
        }
        @if (overdue > 0)
        {
            <span class="dm-chip warn">@T("DefectManagement.Overdue") <b>@overdue</b></span>
        }
    </div>

    <!-- Filters (mobile) -->
    <div class="dm-mfilters">
        <div class="dm-msearch">
            <div class="dm-msearch-box">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
                <input placeholder="@T("DefectManagement.SearchDefectCARInspectionProductFactory")" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
            </div>
            <button class="dm-mfbtn @(_showMoreFilters ? "on" : "")" title="@T("DefectManagement.MoreFilters")" @onclick="() => _showMoreFilters = !_showMoreFilters">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12M20 18h0"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg>
                @if (_year != "") { <i></i> }
            </button>
        </div>
        @if (_showMoreFilters)
        {
            <div class="dm-mmore">
                <label>@T("DefectManagement.YearOpenDate")</label>
                <select class="dm-input" @bind="_year" @bind:after="ApplyFilter">
                    <option value="">@T("DefectManagement.AllYears")</option>
                    @foreach (var y in _years) { <option value="@y">@y</option> }
                </select>
                <button class="dm-mreset" @onclick="ResetFilters">@T("DefectManagement.ResetAll")</button>
            </div>
        }
        <div class="dm-msel">
            <select class="dm-input" @bind="_severity" @bind:after="ApplyFilter">
                <option value="">@T("DefectManagement.AllSeverity")</option>
                @foreach (var sv in DefectOptions.Severities) { <option value="@sv">@TE("Opt", sv)</option> }
            </select>
            <select class="dm-input" @bind="_vendor" @bind:after="ApplyFilter">
                <option value="">@T("DefectManagement.AllFactories")</option>
                @foreach (var v in _vendors) { <option value="@v">@v</option> }
            </select>
            <select class="dm-input" value="@_status" @onchange="e => SetStatus(e.Value?.ToString() ?? string.Empty)">
                <option value="">@T("Common.AllStatus")</option>
                <option value="Open">@T("DefectManagement.Open")</option>
                <option value="In Progress">@T("DefectManagement.InProgress")</option>
                <option value="Closed">@T("DefectManagement.Closed")</option>
            </select>
        </div>
    </div>

    <!-- Filters (desktop) -->
    <div class="dm-filters">
        <div class="dm-search">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
            <input placeholder="@T("DefectManagement.SearchDefectCARInspectionProductFactory")" @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
        </div>
        <select class="dm-input dm-year" @bind="_year" @bind:after="ApplyFilter" title="@T("DefectManagement.FilterByOpenDateYear")">
            <option value="">@T("DefectManagement.AllYears")</option>
            @foreach (var y in _years) { <option value="@y">@y</option> }
        </select>
        <select class="dm-input" @bind="_severity" @bind:after="ApplyFilter">
            <option value="">@T("DefectManagement.AllSeverity")</option>
            @foreach (var s in DefectOptions.Severities) { <option value="@s">@TE("Opt", s)</option> }
        </select>
        <select class="dm-input" @bind="_vendor" @bind:after="ApplyFilter">
            <option value="">@T("DefectManagement.AllFactories")</option>
            @foreach (var v in _vendors) { <option value="@v">@v</option> }
        </select>
        @{ var anyFilter = _search != "" || _year != "" || _severity != "" || _vendor != "" || _status != ""; }
        <button class="dm-fbtn @(anyFilter ? "on" : "")" title="@T("DefectManagement.ResetAll")" @onclick="ResetFilters">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 6h10M18 6h2M4 12h4M12 12h8M4 18h12"/><circle cx="16" cy="6" r="2"/><circle cx="10" cy="12" r="2"/><circle cx="18" cy="18" r="2"/></svg>
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="dm-alert @(_msgErr ? "err" : "ok")">@_msg <button @onclick="() => _msg = null">✕</button></div>
    }

    @if (_loading)
    {
        <div class="dm-loading"><div class="dm-spin"></div> @T("DefectManagement.Loading")</div>
    }
    else
    {
        <!-- Mobile: danh sách thẻ -->
        <div class="dm-cards">
            @if (!_rows.Any()) { <div class="dm-empty">@T("DefectManagement.NoDefectsFound")</div> }
            @foreach (var r in _rows)
            {
                var row = r;
                <div class="dm-card" @onclick='() => Navigation.NavigateTo($"/defects/{row.Id}/edit")'>
                    <div class="dm-card-top">
                        <span class="dm-card-no">@row.DefectNo</span>
                        <span class="dm-mpill sev-@((row.Severity ?? "").ToLower())">@TE("Status", row.Severity)</span>
                        <span class="dm-mpill st-@((row.Status ?? "").Replace(" ", "").ToLower()) dm-card-st">@TE("Status", row.Status)</span>
                        <svg class="dm-card-chev" width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M7 4l6 6-6 6"/></svg>
                    </div>
                    <div class="dm-card-desc">@(row.DefectCode is null or "OTH" ? "" : row.DefectCode + " ")@TE("Opt", row.DefectType)</div>
                    <div class="dm-card-grid">
                        <div class="dm-card-col">
                            <div class="dm-kv stack">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v5c0 4.5-3 8-7 9.5C8 19 5 15.5 5 11V6z"/><path d="M9 11.5l2 2 4-4"/></svg>
                                <div><span class="k">@T("Common.CARNo")</span><span class="v">@row.CarNo</span></div>
                            </div>
                            <div class="dm-kv stack">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V9l6 4V9l6 4V5l6 3v13z"/><path d="M7 17h2M12 17h2M17 17h1"/></svg>
                                <div><span class="k">@T("Common.Factory")</span><span class="v" title="@row.Factory">@row.Factory</span></div>
                            </div>
                        </div>
                        <div class="dm-card-col dm-card-col2">
                            <div class="dm-kv stack">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 3h6v3H9zM8.5 11h7M8.5 15h5"/></svg>
                                <div><span class="k">@T("DefectManagement.Inspection")</span><span class="v">@(row.JobNumber ?? "—")</span></div>
                            </div>
                            <div class="dm-kv stack">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg>
                                <div><span class="k">@T("Common.Product")</span><span class="v" title="@row.Product">@row.Product</span></div>
                            </div>
                        </div>
                    </div>
                    @if (row.Overdue) { <div class="dm-card-od">@T("DefectManagement.OverdueDue", L.Date(row.DueDate, "dd-MMM-yy"))</div> }
                </div>
            }
        </div>

        <div class="dm-table-wrap">
            <table class="dm-table">
                <thead>
                    <tr>
                        <th>@T("Common.DefectID")</th><th>@T("Common.CARNo")</th><th>@T("DefectManagement.Inspection")</th><th>@T("Common.Factory")</th><th>@T("Common.Product")</th><th>@T("Common.DefectType")</th>
                        <th>@T("Common.Severity")</th><th class="tc">@T("DefectManagement.Qty")</th><th>@T("DefectManagement.OpenDate")</th><th>@T("DefectManagement.DueDate")</th><th>@T("DefectManagement.ResponsibleName")</th>
                        <th>@T("DefectManagement.CAPAStatus")</th><th>@T("DefectManagement.CloseDate")</th><th class="tc">@T("Common.Action")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_rows.Any())
                    {
                        <tr><td colspan="14" class="dm-empty">@T("DefectManagement.NoDefectsFound")</td></tr>
                    }
                    @foreach (var r in PageRows())
                    {
                        var canEdit = PageAccess.Can("DefectManagement", "Edit");
                        var editTitle = !canEdit ? T("Common.View") : r.Status == "Open" ? T("DefectManagement.Start")
                                      : r.Status == "In Progress" ? T("DefectManagement.Continue") : T("DefectManagement.Details");
                        <tr>
                            <td><a class="dm-link fw" href="/defects/@r.Id/edit">@r.DefectNo</a></td>
                            <td class="mono">@r.CarNo</td>
                            <td>
                                @if (r.InspectionId.HasValue)
                                { <a class="dm-link" href="/defects/inspection/@r.InspectionId">@(r.JobNumber ?? "—")</a> }
                                else { <span>—</span> }
                            </td>
                            <td class="dm-fact" title="@r.Factory">@r.Factory</td>
                            <td title="@r.Product">@r.Product<div class="dm-mute">@r.ItemNumber</div></td>
                            <td>@(r.DefectCode is null or "OTH" ? "" : r.DefectCode + " ")@TE("Opt", r.DefectType)</td>
                            <td><span class="dm-sev @DefectOptions.SeverityCss(r.Severity)">@TE("Status", r.Severity)</span></td>
                            <td class="tc">@r.Quantity</td>
                            <td>@L.Date(r.OpenDate.ToLocalTime(), "dd-MMM-yy")</td>
                            <td class="@(r.Overdue ? "dm-overdue" : "")">@(L.Date(r.DueDate, "dd-MMM-yy") ?? "—")</td>
                            <td>@(string.IsNullOrWhiteSpace(r.ResponsibleName) ? "" : r.ResponsibleName)</td>
                            <td>
                                <span class="dm-status @DefectOptions.StatusCss(r.Status)">@TE("Status", r.Status)</span>
                                @if (r.SignedCount > 0)
                                { <div class="dm-sig @(r.SignedCount == 3 ? "full" : "part")" title="@T("DefectManagement.SignaturesCollected")">✍ @r.SignedCount/3</div> }
                            </td>
                            <td>@(L.Date(r.CloseDate, "dd-MMM-yy") ?? "–")</td>
                            <td class="tc dm-acts">
                                <a class="dm-ico view" href="/defects/@r.Id/report" title="@T("DefectManagement.ViewPrintDefectClosureReport")">
                                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M2 10s3.5-6 8-6 8 6 8 6-3.5 6-8 6-8-6-8-6Z"/><circle cx="10" cy="10" r="2.5"/></svg>
                                </a>
                                <button class="dm-ico edit" title="@editTitle" @onclick="() => OpenRow(r, canEdit)">
                                    <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M13.5 3.5l3 3L7 16H4v-3z"/><path d="M11.5 5.5l3 3"/></svg>
                                </button>
                                @if (PageAccess.Can("DefectManagement", "Delete"))
                                {
                                    <button class="dm-ico del" title="@T("DefectManagement.DeleteDefect2")" @onclick="() => AskDelete(r)">
                                        <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h14M8 6V4h4v2M5 6l1 11h8l1-11"/></svg>
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="dm-pager">
            <div class="dm-pg-size">
                @T("DefectManagement.Show")
                <select class="dm-input" value="@_pageSize" @onchange="SetPageSize">
                    @foreach (var ps in new[] { 10, 20, 50, 100 }) { <option value="@ps">@ps</option> }
                </select>
                @T("DefectManagement.PerPage")
            </div>
            <div class="dm-pg-right">
                <button class="dm-pg-btn" disabled="@(_pageNo <= 1)" @onclick="() => _pageNo--">‹</button>
                @foreach (var pn in PageNumbers())
                {
                    if (pn == 0) { <span class="dm-pg-gap">…</span> }
                    else { var pnn = pn; <button class="dm-pg-btn @(pn == _pageNo ? "on" : "")" @onclick="() => _pageNo = pnn">@pn</button> }
                }
                <button class="dm-pg-btn" disabled="@(_pageNo >= PageCount)" @onclick="() => _pageNo++">›</button>
                <span class="dm-pg-info">@T("DefectManagement.RangeRecords", _rows.Count == 0 ? 0 : (_pageNo - 1) * _pageSize + 1, Math.Min(_pageNo * _pageSize, _rows.Count), _rows.Count)</span>
            </div>
        </div>
    }
    </div>
</div>

<!-- New defect: chọn inspection -->
@if (_showNew)
{
    <div class="dm-overlay" @onclick="() => _showNew = false">
        <div class="dm-modal" @onclick:stopPropagation="true">
            <h3>@T("DefectManagement.NewDefectSelectInspection")</h3>
            <input class="dm-input" placeholder="@T("DefectManagement.SearchJobNumberProductFactory")" @bind="_inspSearch" @bind:event="oninput" />
            <div class="dm-insp-list">
                @foreach (var i in _inspections.Where(MatchInsp).Take(60))
                {
                    <div class="dm-insp" @onclick='() => Navigation.NavigateTo($"/defects/inspection/{i.Id}")'>
                        <div class="fw">@i.JobNumber</div>
                        <div class="dm-mute">@i.Factory · @i.Product · @L.Date(i.InspectionDate, "dd MMM yyyy")</div>
                    </div>
                }
                @if (!_inspections.Any()) { <div class="dm-empty">@T("DefectManagement.NoCompletedInspection")</div> }
            </div>
            <div class="dm-modal-foot"><button class="dm-btn ghost dark" @onclick="() => _showNew = false">@T("Common.Close")</button></div>
        </div>
    </div>
}

<!-- Xác nhận xoá (Admin) -->
@if (_delRow != null)
{
    <div class="dm-overlay" @onclick="() => _delRow = null">
        <div class="dm-modal" @onclick:stopPropagation="true">
            <h3>@T("DefectManagement.DeleteDefect", _delRow.DefectNo)</h3>
            <p>@_delRow.CarNo · @(_delRow.DefectType) · @_delRow.Factory</p>
            <p style="color:#b91c1c">@T("DefectManagement.ThisPermanentlyDeletesDefectItsCAPA")</p>
            <div class="dm-modal-foot">
                <button class="dm-btn ghost dark" @onclick="() => _delRow = null">@T("Common.Cancel")</button>
                <button class="dm-btn danger" @onclick="ConfirmDelete" disabled="@_deleting">@(_deleting ? T("DefectManagement.Deleting") : T("Common.Delete"))</button>
            </div>
        </div>
    </div>
}

<!-- Scan preview -->
@if (_scan != null)
{
    <div class="dm-overlay" @onclick="() => _scan = null">
        <div class="dm-modal" @onclick:stopPropagation="true">
            <h3>@T("DefectManagement.ScanCompletedInspections")</h3>
            <p>@T("DefectManagement.Scanned") <b>@_scan.Scanned</b> @T("DefectManagement.Inspections") <b>@_scan.Opened</b> @T("DefectManagement.NewCAPAWillBeOpened")</p>
            <div class="dm-insp-list">
                @foreach (var it in _scan.Items)
                {
                    <div class="dm-insp"><span class="dm-sev @DefectOptions.SeverityCss(it.Severity)">@TE("Status", it.Severity)</span>
                        <b>@it.JobNumber</b> · @it.DefectCode @it.DefectType · @it.Quantity pcs</div>
                }
            </div>
            <div class="dm-modal-foot">
                <button class="dm-btn ghost dark" @onclick="() => _scan = null">@T("Common.Cancel")</button>
                @if (_scan.Opened > 0)
                {
                    <button class="dm-btn primary" @onclick="ScanConfirm" disabled="@_scanning">@T("DefectManagement.OpenCAPA", _scan.Opened)</button>
                }
            </div>
        </div>
    </div>
}

@code {
    ListRes? _res;
    List<Row> _rows = new();
    List<string> _vendors = new();
    bool _loading = true, _showNew, _scanning, _msgErr;
    string _status = "", _search = "", _severity = "", _vendor = "", _inspSearch = "", _year = "";
    List<int> _years = new();
    bool _showMoreFilters;
    string? _msg;
    List<InspLookup> _inspections = new();
    ScanRes? _scan;
    static readonly System.Text.Json.JsonSerializerOptions _o = new() { PropertyNameCaseInsensitive = true };

    protected override async Task OnInitializedAsync()
    {
        await PageAccess.EnsureLoadedAsync();
        if (!PageAccess.HasAccess("DefectManagement")) { Navigation.NavigateTo("/", replace: true); return; }
        try
        {
            var m = await Settings.LoadAsync<CapaTh>(SettingsClient.InspectionDefect);
            if (m != null) { _thC = Math.Max(1, m.CapaCritical); _thMa = Math.Max(1, m.CapaMajor); _thMi = Math.Max(1, m.CapaMinor); }
        }
        catch { /* giữ mặc định */ }
        await Load();
    }

    int _thC = 1, _thMa = 3, _thMi = 10;
    class CapaTh { public int CapaCritical { get; set; } = 1; public int CapaMajor { get; set; } = 3; public int CapaMinor { get; set; } = 10; }

    async Task Load()
    {
        _loading = true;
        try
        {
            _res = await Http.GetFromJsonAsync<ListRes>("api/defects", _o);
            _vendors = _res?.Items.Select(i => i.Factory ?? "").Where(v => v != "").Distinct().OrderBy(v => v).ToList() ?? new();
            _years = (_res?.Items.Select(i => i.OpenDate.ToLocalTime().Year) ?? Enumerable.Empty<int>())
                .Append(DateTime.Now.Year).Distinct().OrderByDescending(y => y).ToList();
            ApplyFilter();
        }
        catch (Exception ex) { _msg = ex.Message; _msgErr = true; }
        _loading = false;
    }

    void SetStatus(string s) { _status = s; ApplyFilter(); }

    // ── Phân trang bảng desktop (điện thoại vẫn hiện toàn bộ thẻ) ──
    int _pageNo = 1, _pageSize = 10;
    int PageCount => Math.Max(1, (int)Math.Ceiling(_rows.Count / (double)_pageSize));
    IEnumerable<Row> PageRows() { _pageNo = Math.Clamp(_pageNo, 1, PageCount); return _rows.Skip((_pageNo - 1) * _pageSize).Take(_pageSize); }
    void SetPageSize(ChangeEventArgs e) { _pageSize = int.TryParse(e.Value?.ToString(), out var ps) ? ps : 10; _pageNo = 1; }
    /// <summary>Số trang hiển thị; 0 = dấu "…".</summary>
    IEnumerable<int> PageNumbers()
    {
        var n = PageCount;
        for (int i = 1; i <= n; i++)
        {
            if (i == 1 || i == n || Math.Abs(i - _pageNo) <= 1) yield return i;
            else if (i == 2 || i == n - 1) yield return 0;
        }
    }
    async Task OpenRow(Row r, bool canEdit)
    {
        if (canEdit && r.Status == "Open") await Start(r.Id);
        else Navigation.NavigateTo($"/defects/{r.Id}/edit");
    }
    void ResetFilters() { _search = _severity = _vendor = _status = _year = ""; ApplyFilter(); }

    // Lọc theo năm của Open Date (dùng cho cả số đếm trên chip)
    IEnumerable<Row> YearItems() => (_res?.Items ?? new()).Where(r => _year == "" || r.OpenDate.ToLocalTime().Year.ToString() == _year);

    void ApplyFilter()
    {
        var q = _search.Trim();
        bool Has(string? x) => !string.IsNullOrEmpty(x) && x.Contains(q, StringComparison.OrdinalIgnoreCase);
        _pageNo = 1;
        _rows = YearItems().Where(r =>
            (_status == "" || r.Status == _status) &&
            (_severity == "" || r.Severity == _severity) &&
            (_vendor == "" || r.Factory == _vendor) &&
            (q == "" || Has(r.DefectNo) || Has(r.CarNo) || Has(r.JobNumber) || Has(r.Product) || Has(r.ItemNumber) || Has(r.Factory) || Has(r.DefectType)))
            .ToList();
    }

    // ── Xoá defect: chỉ Admin (server cũng kiểm tra quyền) ──
    Row? _delRow;
    bool _deleting;
    void AskDelete(Row r) => _delRow = r;
    async Task ConfirmDelete()
    {
        if (_delRow == null) return;
        _deleting = true;
        var resp = await Http.DeleteAsync($"api/defects/{_delRow.Id}");
        _deleting = false;
        if (resp.IsSuccessStatusCode) { _msg = T("DefectManagement.DefectDeleted", _delRow.DefectNo); _msgErr = false; _delRow = null; await Load(); }
        else
        {
            _msg = (int)resp.StatusCode == 403 ? T("DefectManagement.OnlyAdminCanDeleteDefect") : T("DefectManagement.DeleteFailed", (int)resp.StatusCode);
            _msgErr = true; _delRow = null;
        }
    }

    async Task Start(int id)
    {
        await Http.PostAsync($"api/defects/{id}/start", null);
        Navigation.NavigateTo($"/defects/{id}/edit");
    }

    async Task OpenNew()
    {
        _showNew = true;
        if (!_inspections.Any())
            _inspections = await Http.GetFromJsonAsync<List<InspLookup>>("api/defects/inspections-lookup", _o) ?? new();
    }
    bool MatchInsp(InspLookup i)
    {
        var q = _inspSearch.Trim();
        return q == "" || (i.JobNumber ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
            || (i.Product ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) || (i.Factory ?? "").Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    async Task ScanPreview()
    {
        _scanning = true;
        try
        {
            var r = await Http.PostAsync("api/defects/scan?dryRun=true", null);
            _scan = await r.Content.ReadFromJsonAsync<ScanRes>(_o);
        }
        catch (Exception ex) { _msg = ex.Message; _msgErr = true; }
        _scanning = false;
    }
    async Task ScanConfirm()
    {
        _scanning = true;
        var r = await Http.PostAsync("api/defects/scan", null);
        var res = await r.Content.ReadFromJsonAsync<ScanRes>(_o);
        _scan = null; _scanning = false;
        _msg = T("DefectManagement.CAPAOpened", res?.Opened ?? 0); _msgErr = false;
        await Load();
    }

    class ListRes
    {
        public int Total { get; set; } public int Open { get; set; } public int InProgress { get; set; }
        public int Closed { get; set; } public int Overdue { get; set; }
        public List<Row> Items { get; set; } = new();
    }
    class Row
    {
        public int Id { get; set; } public string? DefectNo { get; set; } public string? CarNo { get; set; }
        public int? InspectionId { get; set; } public string? JobNumber { get; set; }
        public string? Factory { get; set; } public string? Product { get; set; } public string? ItemNumber { get; set; }
        public string? DefectCode { get; set; } public string? DefectType { get; set; } public string? Severity { get; set; }
        public int Quantity { get; set; } public DateTime OpenDate { get; set; } public DateTime? DueDate { get; set; }
        public string? ResponsibleName { get; set; } public string? Status { get; set; } public DateTime? CloseDate { get; set; }
        public bool Overdue { get; set; }
        public int SignedCount { get; set; }
    }
    class InspLookup { public int Id { get; set; } public string? JobNumber { get; set; } public string? Factory { get; set; } public string? Product { get; set; } public DateTime InspectionDate { get; set; } }
    class ScanRes
    {
        public int Scanned { get; set; } public int Opened { get; set; }
        public List<ScanItem> Items { get; set; } = new();
    }
    class ScanItem { public string? JobNumber { get; set; } public string? DefectCode { get; set; } public string? DefectType { get; set; } public string? Severity { get; set; } public int Quantity { get; set; } }
}

