@page "/defects/{Id:int}/edit"
@page "/defects/new/{InspectionId:int}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PageAccessService PageAccess
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthState
@inherits LocalizedComponentBase

<PageTitle>@(_m?.DefectNo ?? T("DefectEdit.Defect")) - Inticoo</PageTitle>

<div class="de-page">
    <div class="de-head">
        <button class="de-back" @onclick="GoBack">‹</button>
        <div class="de-head-t">
            <h1>@(Id == 0 ? T("DefectEdit.AddDefect") : _steps[_step])</h1>
            @if (_m != null)
            {
                <div class="de-head-sub">@_m.DefectNo · @_m.CarNo · @_m.JobNumber
                    <span class="de-st @DefectOptions.StatusCss(_m.Status)">@TE("Status", _m.Status ?? "Open")</span></div>
            }
        </div>
        @if (_m != null && Id > 0)
        {
            <button class="de-report" @onclick="ViewReport" disabled="@_saving">@T("Common.ViewReport")</button>
            @if (_canDelete)
            {
                <button class="de-delete" @onclick="DeleteDefect" title="@T("DefectEdit.DeleteDefect")">@T("Common.Delete")</button>
            }
        }
    </div>

    @if (_m == null)
    {
        <div class="de-loading">@(_err ?? T("DefectEdit.Loading"))</div>
    }
    else
    {
        <!-- Step tabs -->
        <div class="de-steps">
            @for (int i = 0; i < _steps.Length; i++)
            {
                var idx = i;
                <button class="de-step @(idx == _step ? "active" : idx < _step ? "done" : "")"
                        disabled="@(Id == 0 && idx > 0)" @onclick="() => GoStep(idx)">
                    <span>@(idx + 1)</span>@_steps[idx]
                </button>
            }
        </div>

        <div class="de-card">
            @switch (_step)
            {
                case 0:
                    <div class="de-sec">@T("DefectEdit.N1DefectInformation")</div>
                    <div class="de-grid">
                        <div class="de-f"><label>@T("Common.DefectID")</label><div class="de-ro">@_m.DefectNo <small>@T("DefectEdit.AutoGenerated")</small></div></div>
                        <div class="de-f"><label>@T("Common.CARNo")</label><div class="de-ro">@_m.CarNo <small>@T("DefectEdit.AutoGenerated")</small></div></div>
                        <div class="de-f"><label>@T("Common.DefectType") <i>*</i></label>
                            <select value="@_m.DefectCode" @onchange="OnCodeChanged">
                                <option value="">@T("DefectEdit.SelectDefect")</option>
                                @foreach (var c in DefectCodes.All) { <option value="@c.Code">@c.Code @DefectCodes.LocalName(c.Name)</option> }
                                <option value="OTH">@T("DefectEdit.Other")</option>
                            </select>
                        </div>
                        <div class="de-f"><label>@T("DefectEdit.DefectCategory") <i>*</i></label>
                            <select @bind="_m.DefectCategory">
                                <option value="">@T("Common.Select")</option>
                                @foreach (var c in DefectOptions.Categories) { <option value="@c">@TE("Opt", c)</option> }
                            </select>
                        </div>
                        <div class="de-f de-full"><label>@T("Common.Severity") <i>*</i></label>
                            <div class="de-pills">
                                @foreach (var s in DefectOptions.Severities)
                                {
                                    var sv = s;
                                    <button class="de-pill sev-@sv.ToLower() @(_m.Severity == sv ? "on" : "")" @onclick="() => { _m.Severity = sv; _m.AqlClassification ??= sv; }">● @TE("Opt", sv)</button>
                                }
                            </div>
                        </div>
                        <div class="de-f"><label>@T("DefectEdit.QuantityDefective") <i>*</i></label>
                            <div class="de-unit"><input type="number" min="1" @bind="_m.Quantity" /><span>pcs</span></div></div>
                        <div class="de-f"><label>@T("DefectEdit.InspectionArea") <i>*</i></label>
                            <input @bind="_m.InspectionArea" @bind:event="oninput" maxlength="300" placeholder="@T("DefectEdit.EGFrontLegSeat")" />
                            <small class="de-fhint">@T("DefectEdit.WrittenByQASeparateSeveralAreas")</small>
                        </div>
                        <div class="de-f"><label>@T("DefectEdit.AQLClassification")</label>
                            <select @bind="_m.AqlClassification">
                                <option value="">@T("Common.Select")</option>
                                @foreach (var s in DefectOptions.Severities) { <option value="@s">@TE("Opt", s)</option> }
                            </select>
                        </div>
                        <div class="de-f"><label>@T("DefectEdit.ProductQuantityChecked")</label>
                            <div class="de-unit"><input type="number" min="0" @bind="_m.ProductQtyChecked" /><span>pcs</span></div></div>
                    </div>
                    <div class="de-meta">@T("DefectEdit.Factory") <b>@_m.VendorName</b> @T("DefectEdit.Product") <b>@_m.ProductName</b> @(string.IsNullOrEmpty(_m.ItemNumber) ? "" : $"({_m.ItemNumber})") · @T("DefectEdit.InspectionLabel") <b>@_m.JobNumber</b></div>
                    break;

                case 1:
                    <div class="de-sec">@T("DefectEdit.N2DefectDescription")</div>
                    <div class="de-f"><label>@T("Common.Description") <i>*</i></label>
                        <textarea rows="4" maxlength="500" @bind="_m.Description" @bind:event="oninput" placeholder="@T("DefectEdit.EGScratchObservedOnFront")"></textarea>
                        <div class="de-row-between">
                            <button class="de-voice @(_listening ? "on" : "")" @onclick="Voice">🎤 @(_listening ? T("DefectEdit.Listening") : T("DefectEdit.VoiceInput"))</button>
                            <small>@((_m.Description ?? "").Length)/500</small>
                        </div>
                    </div>
                    <div class="de-sec">@T("DefectEdit.N3ProductLocation")</div>
                    <div class="de-hint">@T("DefectEdit.TapOnImageToAddDefect")</div>
                    <div class="de-loc-src">
                        @if (!string.IsNullOrEmpty(_m.ProductPhotoUrl))
                        { <button class="de-chip @(_m.LocationImageUrl == _m.ProductPhotoUrl ? "on" : "")" @onclick="() => SetLocImg(_m.ProductPhotoUrl)">@T("DefectEdit.ProductPhoto")</button> }
                        @foreach (var p in _m.Photos.Take(4))
                        { var pp = p; <button class="de-chip @(_m.LocationImageUrl == pp ? "on" : "")" @onclick="() => SetLocImg(pp)">@T("DefectEdit.DefectPhoto", _m.Photos.IndexOf(pp) + 1)</button> }
                        <label class="de-chip">@T("DefectEdit.Upload")<InputFile OnChange="UploadLocImg" accept="image/*" style="display:none" /></label>
                    </div>
                    @if (!string.IsNullOrEmpty(_m.LocationImageUrl))
                    {
                        <div class="de-loc-wrap">
                            <div class="de-loc">
                                <img id="de-loc-img" src="@Img(_m.LocationImageUrl)" @onclick="OnLocClick" />
                                @for (int pi = 0; pi < _m.Locations.Count; pi++)
                                {
                                    var idx = pi; var pt = _m.Locations[pi];
                                    <span class="de-pin @(idx == _selLoc ? "sel" : "")" style="left:@Inv(pt.X)%;top:@Inv(pt.Y)%"
                                          title="@(pt.Label ?? T("DefectEdit.Point", idx + 1))" @onclick="() => _selLoc = idx" @onclick:stopPropagation="true">@(idx + 1)</span>
                                    @if (!string.IsNullOrEmpty(pt.Label))
                                    { <span class="de-pin-lbl" style="left:@Inv(pt.X)%;top:@Inv(pt.Y)%">@pt.Label</span> }
                                }
                            </div>
                        </div>
                    }
                    @if (_m.Locations.Any())
                    {
                        <div class="de-loc-list">
                            @for (int pi = 0; pi < _m.Locations.Count; pi++)
                            {
                                var idx = pi; var pt = _m.Locations[pi];
                                <div class="de-loc-row @(idx == _selLoc ? "sel" : "")" @onclick="() => _selLoc = idx">
                                    <span class="de-loc-no">@(idx + 1)</span>
                                    <span class="de-loc-name">@(string.IsNullOrEmpty(pt.Label) ? T("DefectEdit.SelectLocationBelow") : pt.Label)</span>
                                    <button class="de-x" title="@T("DefectEdit.RemovePoint")" @onclick="() => RemoveLoc(idx)" @onclick:stopPropagation="true">✕</button>
                                </div>
                            }
                        </div>
                    }
                    @if (!QaAreas.Any())
                    {
                        <div class="de-hint" style="margin-top:10px">@T("DefectEdit.EnterInspectionAreaInStep1")</div>
                    }
                    <div class="de-pills wrap">
                        @foreach (var a in QaAreas)
                        {
                            var av = a;
                            <button class="de-pill @(SelLoc?.Label == av ? "on blue" : "")" disabled="@(SelLoc == null)"
                                    title="@(SelLoc == null ? T("DefectEdit.TapImageToAddPointFirst") : T("DefectEdit.SetPointTo", _selLoc + 1, av))"
                                    @onclick="() => SetLocLabel(av)">@av</button>
                        }
                    </div>
                    break;

                case 2:
                    <div class="de-sec">@T("DefectEdit.N4PhotoEvidence")</div>
                    <div class="de-photos">
                        @foreach (var p in _m.Photos.ToList())
                        {
                            var pp = p;
                            <div class="de-ph"><img src="@Img(pp)" /><button @onclick="() => _m.Photos.Remove(pp)">✕</button></div>
                        }
                        <label class="de-ph add">
                            @if (_uploading) { <span>@T("DefectEdit.Uploading")</span> } else { <span>📷<br/>@T("DefectEdit.AddPhoto")</span> }
                            <InputFile OnChange="e => UploadPhotos(e, _m.Photos)" accept="image/*" multiple style="display:none" />
                        </label>
                    </div>
                    <div class="de-hint">@T("DefectEdit.PhotosAdded", _m.Photos.Count)</div>
                    <div class="de-f"><label>@T("DefectEdit.PhotoNotes")</label>
                        <textarea rows="2" maxlength="200" @bind="_m.PhotoNotes" placeholder="@T("DefectEdit.EGVisibleSurfaceScratch")"></textarea></div>
                    <div class="de-sec">@T("DefectEdit.N5RootCauseAnalysis")</div>
                    <div class="de-f"><label>@T("DefectEdit.RootCauseType") <i>*</i></label>
                        <div class="de-radios">
                            @foreach (var r in DefectOptions.RootCauses)
                            {
                                var rv = r;
                                <label class="de-radio"><input type="radio" name="rct" checked="@(_m.RootCauseType == rv)" @onchange="() => _m.RootCauseType = rv" /> @TE("Opt", rv)</label>
                            }
                        </div>
                    </div>
                    break;

                case 3:
                    <div class="de-sec">@T("DefectEdit.N5WhyAnalysis")</div>
                    @for (int w = 1; w <= 5; w++)
                    {
                        var wi = w;
                        <div class="de-f"><label>@T("DefectEdit.Why", wi, wi == 1 ? "*" : "")</label>
                            <textarea rows="2" value="@GetWhy(wi)" @onchange="e => SetWhy(wi, e.Value?.ToString())"></textarea></div>
                    }
                    <div class="de-f"><label>@T("DefectEdit.FinalRootCause")</label>
                        <textarea rows="3" @bind="_m.FinalRootCause" placeholder="@T("DefectEdit.SummariseFinalRootCause")"></textarea></div>
                    break;

                case 4:
                    <div class="de-sec">@T("DefectEdit.CorrectiveActionRequest")</div>
                    <div class="de-grid">
                        <div class="de-f"><label>@T("Common.CARNo")</label><div class="de-ro">@_m.CarNo <small>@T("DefectEdit.AutoGenerated")</small></div></div>
                        <div class="de-f"><label>@T("DefectEdit.ResponsibleDepartment") <i>*</i></label>
                            <select @bind="_m.ResponsibleDepartment">
                                <option value="">@T("Common.Select")</option>
                                @foreach (var d in DefectOptions.Departments) { <option value="@d">@TE("Opt", d)</option> }
                            </select></div>
                        <div class="de-f"><label>@T("DefectEdit.ResponsiblePerson") <i>*</i></label>
                            <input @bind="_m.ResponsiblePerson" maxlength="150" placeholder="@T("DefectEdit.EnterPersonName")" /></div>
                        <div class="de-f"><label>@T("DefectEdit.TargetCompletionDate") <i>*</i></label>
                            <input type="date" value="@_m.TargetDate?.ToString("yyyy-MM-dd")" @onchange="e => _m.TargetDate = ParseDate(e.Value)" /></div>
                        <div class="de-f de-full"><label>@T("DefectEdit.CorrectiveAction") <i>*</i></label>
                            <textarea rows="3" @bind="_m.CorrectiveAction" placeholder="@T("DefectEdit.EGInstallFoamSheetsBetween")"></textarea></div>
                        <div class="de-f de-full"><label>@T("DefectEdit.Priority") <i>*</i></label>
                            <div class="de-pills">
                                @foreach (var p in DefectOptions.Priorities)
                                {
                                    var pv = p;
                                    <button class="de-pill pri-@pv.ToLower() @(_m.Priority == pv ? "on" : "")" @onclick="() => _m.Priority = pv">● @TE("Opt", pv)</button>
                                }
                            </div></div>
                    </div>
                    break;

                case 5:
                    <div class="de-sec">@T("DefectEdit.CorrectiveActions")</div>
                    <table class="de-tbl">
                        <thead><tr><th></th><th>@T("Common.Action")</th><th>@T("DefectEdit.TargetDate")</th><th>@T("DefectEdit.CompletionDate")</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var a in _m.CorrectiveActions.ToList())
                            {
                                var ca = a;
                                <tr>
                                    <td><input type="checkbox" checked="@ca.Done" @onchange="e => { ca.Done = (bool)(e.Value ?? false); if (ca.Done) ca.CompletionDate ??= DateTime.Today; else ca.CompletionDate = null; }" /></td>
                                    <td><input @bind="ca.Action" placeholder="@T("DefectEdit.EGFoamSeparatorInstalled")" /></td>
                                    <td><input type="date" value="@ca.TargetDate?.ToString("yyyy-MM-dd")" @onchange="e => ca.TargetDate = ParseDate(e.Value)" /></td>
                                    <td><input type="date" value="@ca.CompletionDate?.ToString("yyyy-MM-dd")" @onchange="e => ca.CompletionDate = ParseDate(e.Value)" /></td>
                                    <td><button class="de-x" @onclick="() => _m.CorrectiveActions.Remove(ca)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button class="de-addrow" @onclick="() => _m.CorrectiveActions.Add(new() { TargetDate = _m.TargetDate })">@T("DefectEdit.AddCorrectiveAction")</button>

                    <div class="de-sec">@T("DefectEdit.PreventiveActions")</div>
                    <table class="de-tbl">
                        <thead><tr><th>@T("Common.Active")</th><th>@T("Common.Action")</th><th>@T("DefectEdit.Frequency")</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var a in _m.PreventiveActions.ToList())
                            {
                                var pa = a;
                                <tr>
                                    <td><input type="checkbox" @bind="pa.Active" /></td>
                                    <td><input @bind="pa.Action" placeholder="@T("DefectEdit.EGMonthlyPackagingAudit")" /></td>
                                    <td><select @bind="pa.Frequency">@foreach (var f in DefectOptions.Frequencies) { <option value="@f">@TE("Opt", f)</option> }</select></td>
                                    <td><button class="de-x" @onclick="() => _m.PreventiveActions.Remove(pa)">✕</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button class="de-addrow" @onclick="() => _m.PreventiveActions.Add(new())">@T("DefectEdit.AddPreventiveAction")</button>

                    <div class="de-sec">@T("DefectEdit.CompletionProgress")</div>
                    <div class="de-progress"><div style="width:@(_m.Progress)%"></div></div>
                    <div class="de-hint" style="text-align:right">@_m.Progress%</div>
                    <div class="de-f"><label>@T("DefectEdit.Remarks")</label>
                        <textarea rows="3" @bind="_m.CapaRemarks" placeholder="@T("DefectEdit.EGActionsInProgressRe")"></textarea></div>
                    <div class="de-sec">@T("DefectEdit.PhotosAfterCorrectiveActionReInspection")</div>
                    <div class="de-photos">
                        @foreach (var p in _m.AfterPhotos.ToList())
                        {
                            var pp = p;
                            <div class="de-ph"><img src="@Img(pp)" /><button @onclick="() => _m.AfterPhotos.Remove(pp)">✕</button></div>
                        }
                        <label class="de-ph add">
                            @if (_uploading) { <span>@T("DefectEdit.Uploading")</span> } else { <span>📷<br/>@T("DefectEdit.AddPhoto")</span> }
                            <InputFile OnChange="e => UploadPhotos(e, _m.AfterPhotos)" accept="image/*" multiple style="display:none" />
                        </label>
                    </div>
                    break;

                case 6:
                    <div class="de-sec">@T("DefectEdit.VerificationClosure")</div>
                    <div class="de-grid">
                        <div class="de-f"><label>@T("DefectEdit.VerificationDate") <i>*</i></label>
                            <input type="date" value="@_m.VerificationDate?.ToString("yyyy-MM-dd")" @onchange="e => _m.VerificationDate = ParseDate(e.Value)" /></div>
                        <div class="de-f"><label>@T("DefectEdit.VerifiedBy") <i>*</i></label>
                            <input list="de-verifiers" @bind="_m.VerifiedBy" placeholder="@T("DefectEdit.EGQAManager")" />
                            <datalist id="de-verifiers"><option value="QA Manager" /><option value="QC Inspector" /><option value="Customer QA" /></datalist></div>
                        <div class="de-f de-full"><label>@T("DefectEdit.EffectivenessResult") <i>*</i></label>
                            <div class="de-radios row">
                                @foreach (var r in DefectOptions.Effectiveness)
                                {
                                    var rv = r;
                                    <label class="de-radio"><input type="radio" name="eff" checked="@(_m.EffectivenessResult == rv)" @onchange="() => _m.EffectivenessResult = rv" /> @TE("Opt", rv)</label>
                                }
                            </div></div>
                        <div class="de-f de-full"><label>@T("DefectEdit.VerificationComments")</label>
                            <textarea rows="3" maxlength="500" @bind="_m.VerificationComments" placeholder="@T("DefectEdit.EGNoRecurrenceFoundDuring")"></textarea></div>
                    </div>

                    <div class="de-sec">@T("Common.Reference")</div>
                    <div class="de-hint">@T("DefectEdit.PleaseAddAttachedFilePhotosFor")</div>
                    <table class="de-tbl">
                        <thead><tr><th>No</th><th>@T("Common.Reference")</th><th>@T("DefectEdit.Attached")</th><th>@T("Common.Remark")</th><th>@T("DefectEdit.EditDelete")</th></tr></thead>
                        <tbody>
                            @for (int i = 0; i < _m.References.Count; i++)
                            {
                                var ri = i; var rf = _m.References[i];
                                <tr>
                                    <td class="tc">@(ri + 1)</td>
                                    <td><input @bind="rf.Reference" placeholder="@T("DefectEdit.EGPhotosSOP")" /></td>
                                    <td>
                                        @if (rf.Uploading) { <span class="de-hint">@T("DefectEdit.Uploading")</span> }
                                        else if (!string.IsNullOrEmpty(rf.FileUrl)) { <a href="@Img(rf.FileUrl)" target="_blank">📎 @rf.FileName</a> }
                                        <label class="de-attach">@T("DefectEdit.Attach")<InputFile OnChange="e => UploadRef(e, rf)" style="display:none" /></label>
                                    </td>
                                    <td><input @bind="rf.Remark" placeholder="@T("DefectEdit.EGNewStructure")" /></td>
                                    <td class="tc">
                                        @if (!string.IsNullOrEmpty(rf.FileUrl)) { <button class="de-x" title="@T("DefectEdit.RemoveFile")" @onclick="() => { rf.FileUrl = null; rf.FileName = null; }">⟲</button> }
                                        <button class="de-x" title="@T("DefectEdit.DeleteRow")" @onclick="() => _m.References.RemoveAt(ri)">✕</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <button class="de-addrow" @onclick="() => _m.References.Add(new())">@T("Common.AddRow")</button>

                    <div class="de-sec">@T("Common.Approval")</div>
                    <div class="de-hint">@T("DefectEdit.EachPersonSignsWithTheirOwn")</div>
                    <div class="de-sign-grid">
                        @SignCard("factory", T("DefectEdit.FactoryRepresentative"), _m.FactoryRepName, _m.FactoryRepPosition, _m.FactoryRepSignatureUrl, _m.FactoryRepSignedAt, _m.FactoryRepSignedBy, T("DefectEdit.SignedOnQCAdminDevice"))
                        @SignCard("qa", T("DefectEdit.QAVerification"), _m.QaVerifierName, _m.QaPosition, _m.QaSignatureUrl, _m.QaSignedAt, _m.QaSignedBy, T("DefectEdit.QCInspectorOrAdmin"))
                        @SignCard("customer", T("DefectEdit.CustomerApproval"), _m.CustomerApproverName, _m.CustomerPosition, _m.CustomerSignatureUrl, _m.CustomerSignedAt, _m.CustomerSignedBy, T("DefectEdit.CustomerAccount"))
                    </div>

                    <div class="de-f" style="margin-top:12px"><label>@T("Common.Status")</label>
                        <div class="de-ro">@TE("Status", _m.Status ?? "Open") @(_m.CloseDate.HasValue ? T("DefectEdit.Closed0DdMMMYyyy", _m.CloseDate) : "")</div></div>
                    @if (_readOnly)
                    {
                        <div class="de-hint">@(_isCustomer ? T("DefectEdit.DefectStatusIsManagedByQC") : T("DefectEdit.ViewOnlyYourAccountCannotEdit"))</div>
                    }
                    else if (_m.Status == "Closed")
                    {
                        <button class="de-close reopen" @onclick="Reopen" disabled="@_saving">@T("DefectEdit.ReopenDefect")</button>
                    }
                    else
                    {
                        <button class="de-close" @onclick="CloseDefect" disabled="@_saving">@T("DefectEdit.CloseDefect")</button>
                    }
                    break;
            }

            @if (!string.IsNullOrEmpty(_msg))
            {
                <div class="de-msg @(_msgErr ? "err" : "ok")">@_msg</div>
            }
        </div>

        <SignaturePadModal Visible="@(_signSlot != null)" Title="@($"{(_resign ? T("DefectEdit.ReSignTitle") : T("DefectEdit.SignTitle"))} — {SlotTitle(_signSlot)}")" SignerName="@_signerName" DefaultName="@(_resign ? SignedName(_signSlot) : null)" DefaultPosition="@SignedPosition(_signSlot)"
                           Busy="@_signing" OnConfirm="ConfirmSign" OnCancel="() => _signSlot = null" />

        <div class="de-nav">
            <button class="de-btn ghost" @onclick="Back">@T("Common.Back")</button>
            @if (!_readOnly)
            {
                <button class="de-btn save" @onclick="() => Save(false)" disabled="@_saving">@(_saving ? T("DefectEdit.Saving") : T("Common.Save"))</button>
            }
            @if (_step < _steps.Length - 1)
            {
                <button class="de-btn primary" @onclick="NextOrView" disabled="@_saving">@T("DefectEdit.Next")</button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    [Parameter] public int InspectionId { get; set; }

    string[] _steps => new[] { T("DefectEdit.DefectInformation"), T("DefectEdit.DescriptionLocation"), T("DefectEdit.PhotoRootCause"), T("DefectEdit.RootCauseAnalysis"), T("DefectEdit.CorrectiveActionRequest"), T("DefectEdit.CAPATracking"), T("DefectEdit.VerificationClosure") };
    DefectCapaModel? _m;
    int _step;
    bool _saving, _uploading, _listening, _msgErr;
    string? _msg, _err;
    DotNetObjectReference<DefectEdit>? _ref;
    static readonly System.Text.Json.JsonSerializerOptions _o = new() { PropertyNameCaseInsensitive = true };

    protected override async Task OnParametersSetAsync()
    {
        await PageAccess.EnsureLoadedAsync();
        if (!PageAccess.HasAccess("DefectManagement")) { Navigation.NavigateTo("/", replace: true); return; }
        try
        {
            _m = Id > 0
                ? await Http.GetFromJsonAsync<DefectCapaModel>($"api/defects/{Id}", _o)
                : await Http.GetFromJsonAsync<DefectCapaModel>($"api/defects/new?inspectionId={InspectionId}", _o);
            if (_m != null)
            {

                if (!_m.CorrectiveActions.Any() && !string.IsNullOrWhiteSpace(_m.CorrectiveAction))
                    _m.CorrectiveActions.Add(new() { Action = _m.CorrectiveAction, TargetDate = _m.TargetDate });
                if (!_m.References.Any()) _m.References.Add(new());
                if (string.IsNullOrEmpty(_m.LocationImageUrl))
                    _m.LocationImageUrl = _m.ProductPhotoUrl ?? _m.Photos.FirstOrDefault();
                _m.VerificationDate ??= _m.Status == "Closed" ? _m.CloseDate : null;
            }
        }
        catch (Exception ex) { _err = ex.Message; }
    }

    string Img(string? url) => MediaUrl.Resolve(url, Http.BaseAddress?.ToString());
    static string Inv(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    static DateTime? ParseDate(object? v) => DateTime.TryParse(v?.ToString(), out var d) ? d : null;

    void OnCodeChanged(ChangeEventArgs e)
    {
        _m!.DefectCode = e.Value?.ToString();
        _m.DefectType = _m.DefectCode == "OTH" ? "Other" : DefectCodes.All.FirstOrDefault(c => c.Code == _m.DefectCode).Name;
        _m.DefectCategory = DefectOptions.DefaultCategory(_m.DefectCode);
    }

    string? GetWhy(int i) => i switch { 1 => _m!.Why1, 2 => _m!.Why2, 3 => _m!.Why3, 4 => _m!.Why4, _ => _m!.Why5 };
    void SetWhy(int i, string? v)
    {
        switch (i) { case 1: _m!.Why1 = v; break; case 2: _m!.Why2 = v; break; case 3: _m!.Why3 = v; break; case 4: _m!.Why4 = v; break; default: _m!.Why5 = v; break; }
    }

    string? Validate(int step)
    {
        var m = _m!;
        return step switch
        {
            0 when string.IsNullOrEmpty(m.DefectCode) => T("DefectEdit.PleaseSelectDefectType"),
            0 when string.IsNullOrEmpty(m.DefectCategory) => T("DefectEdit.PleaseSelectDefectCategory"),
            0 when m.Quantity <= 0 => T("DefectEdit.QuantityDefectiveMustBeGreaterThan"),
            0 when string.IsNullOrWhiteSpace(m.InspectionArea) => T("DefectEdit.PleaseEnterInspectionArea"),
            1 when string.IsNullOrWhiteSpace(m.Description) => T("DefectEdit.DescriptionIsRequired"),
            2 when string.IsNullOrEmpty(m.RootCauseType) => T("DefectEdit.PleaseSelectRootCauseType"),
            3 when string.IsNullOrWhiteSpace(m.Why1) => T("DefectEdit.Why1IsRequired"),
            4 when string.IsNullOrEmpty(m.ResponsibleDepartment) || string.IsNullOrWhiteSpace(m.ResponsiblePerson)
                   || string.IsNullOrWhiteSpace(m.CorrectiveAction) || m.TargetDate == null || string.IsNullOrEmpty(m.Priority)
                   => T("DefectEdit.PleaseCompleteAllRequiredFieldsOf"),
            _ => null
        };
    }

    async Task<bool> Save(bool silent)
    {
        _msg = null;
        var err = Validate(_step);
        if (err != null) { _msg = err; _msgErr = true; return false; }
        _saving = true;
        try
        {
            if (_m!.CorrectiveActions.Count == 0 && !string.IsNullOrWhiteSpace(_m.CorrectiveAction) && _step >= 4)
                _m.CorrectiveActions.Add(new() { Action = _m.CorrectiveAction, TargetDate = _m.TargetDate });
            _m.References = _m.References.Where(r => !string.IsNullOrWhiteSpace(r.Reference) || !string.IsNullOrEmpty(r.FileUrl) || !string.IsNullOrWhiteSpace(r.Remark)).ToList();
            if (_m.Status == "Open" && _step >= 1) _m.Status = "In Progress";

            if (Id == 0)
            {
                var resp = await Http.PostAsJsonAsync("api/defects", _m);
                if (!resp.IsSuccessStatusCode) throw new Exception(await resp.Content.ReadAsStringAsync());
                var r = await resp.Content.ReadFromJsonAsync<CreateRes>(_o);
                Id = r!.Id; _m.Id = r.Id; _m.DefectNo = r.DefectNo; _m.CarNo = r.CarNo;
                Navigation.NavigateTo($"/defects/{Id}/edit", replace: false);
            }
            else
            {
                var resp = await Http.PutAsJsonAsync($"api/defects/{Id}", _m);
                if (!resp.IsSuccessStatusCode) throw new Exception(await resp.Content.ReadAsStringAsync());
            }
            if (!_m.References.Any()) _m.References.Add(new());
            if (!silent) { _msg = "Saved."; _msgErr = false; }
            return true;
        }
        catch (Exception ex) { _msg = T("DefectEdit.SaveFailed") + ex.Message; _msgErr = true; return false; }
        finally { _saving = false; }
    }

    async Task Next()
    {
        if (await Save(true) && _step < _steps.Length - 1) { _step++; _msg = null; }
    }
    void Back()
    {
        if (_step > 0) { _step--; _msg = null; } else GoBack();
    }
    async Task GoStep(int i)
    {
        if (i == _step) return;
        if (i > _step && !_readOnly && !await Save(true)) return;
        _step = i; _msg = null;
    }
    void GoBack()
    {
        if (_m?.InspectionId is int iid) Navigation.NavigateTo($"/defects/inspection/{iid}");
        else Navigation.NavigateTo("/defects");
    }

    async Task CloseDefect()
    {
        if (_m!.VerificationDate == null || string.IsNullOrWhiteSpace(_m.VerifiedBy) || string.IsNullOrEmpty(_m.EffectivenessResult))
        { _msg = T("DefectEdit.VerificationDateVerifiedByAndEffectiveness"); _msgErr = true; return; }
        if (_m.EffectivenessResult == "Not Effective")
        { _msg = T("DefectEdit.ActionsAreNotEffectiveUpdateCAPA"); _msgErr = true; return; }
        if (!await Save(true)) return;
        _saving = true;
        var resp = await Http.PostAsJsonAsync($"api/defects/{Id}/close", _m);
        _saving = false;
        if (resp.IsSuccessStatusCode)
        {
            _m.Status = "Closed"; _m.CloseDate = _m.VerificationDate;
            _msg = T("DefectEdit.DefectClosedYouCanNowPrint"); _msgErr = false;
        }
        else { _msg = T("DefectEdit.CloseFailed") + await resp.Content.ReadAsStringAsync(); _msgErr = true; }
    }

    async Task Reopen()
    {
        var resp = await Http.PostAsync($"api/defects/{Id}/reopen", null);
        if (resp.IsSuccessStatusCode) { _m!.Status = "In Progress"; _m.CloseDate = null; _msg = T("DefectEdit.DefectReopened"); _msgErr = false; }
    }

    // ── Upload ──
    async Task<string?> UploadOne(IBrowserFile f, string endpoint)
    {
        f = await ImageShrink.ShrinkAsync(f);   // chỉ thu nhỏ ảnh; PDF... giữ nguyên
        using var content = new MultipartFormDataContent();
        var sc = new StreamContent(f.OpenReadStream(15 * 1024 * 1024));
        sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(string.IsNullOrEmpty(f.ContentType) ? "application/octet-stream" : f.ContentType);
        content.Add(sc, "file", f.Name);
        var resp = await Http.PostAsync(endpoint, content);
        if (!resp.IsSuccessStatusCode) { _msg = T("DefectEdit.UploadFailed", (int)resp.StatusCode); _msgErr = true; return null; }
        return (await resp.Content.ReadFromJsonAsync<UploadRes>(_o))?.Url;
    }

    async Task UploadPhotos(InputFileChangeEventArgs e, List<string> target)
    {
        _uploading = true;
        foreach (var f in e.GetMultipleFiles(10))
        {
            var url = await UploadOne(f, "api/upload/photo");
            if (!string.IsNullOrEmpty(url)) target.Add(url);
        }
        _uploading = false;
    }

    async Task UploadLocImg(InputFileChangeEventArgs e)
    {
        var url = await UploadOne(e.File, "api/upload/photo");
        if (!string.IsNullOrEmpty(url)) SetLocImg(url);
    }

    async Task UploadRef(InputFileChangeEventArgs e, DefectReferenceModel rf)
    {
        rf.Uploading = true; StateHasChanged();
        var url = await UploadOne(e.File, "api/files/upload");
        rf.Uploading = false;
        if (!string.IsNullOrEmpty(url)) { rf.FileUrl = url; rf.FileName = e.File.Name; rf.Reference ??= System.IO.Path.GetFileNameWithoutExtension(e.File.Name); }
    }

    void SetLocImg(string? url)
    {
        if (_m!.LocationImageUrl == url) return;
        _m.LocationImageUrl = url;
        // Toạ độ theo ảnh cũ không còn đúng → xoá các điểm
        _m.Locations.Clear(); _selLoc = -1;
    }

    // ── Nhiều vị trí lỗi trên ảnh ──
    int _selLoc = -1;
    LocationPointModel? SelLoc => _m != null && _selLoc >= 0 && _selLoc < _m.Locations.Count ? _m.Locations[_selLoc] : null;

    void SetLocLabel(string area)
    {
        if (SelLoc == null) return;
        SelLoc.Label = area;
    }

    // Vị trí cho các điểm: chỉ lấy đúng các Inspection Area do QA nhập ở bước 1 (cách nhau dấu phẩy)
    List<string> QaAreas => (_m?.InspectionArea ?? "")
        .Split(new[] { ',', ';', '\n' }, StringSplitOptions.RemoveEmptyEntries)
        .Select(a => a.Trim()).Where(a => a != "")
        .Distinct(StringComparer.OrdinalIgnoreCase).ToList();

    // Xem báo cáo: lưu trước để các điểm vị trí vừa chấm không bị mất
    async Task ViewReport()
    {
        if (!_readOnly && !await Save(true)) return;
        Navigation.NavigateTo($"/defects/{Id}/report");
    }

    void RemoveLoc(int idx)
    {
        _m!.Locations.RemoveAt(idx);
        _selLoc = _m.Locations.Count == 0 ? -1 : Math.Min(_selLoc, _m.Locations.Count - 1);
    }

    // ── Product location: chấm vị trí theo % kích thước ảnh ──
    async Task OnLocClick(MouseEventArgs e)
    {
        try
        {
            var size = await JS.InvokeAsync<double[]>("eval", "(function(){var r=document.getElementById('de-loc-img').getBoundingClientRect();return [r.width,r.height];})()");
            if (size[0] <= 0 || size[1] <= 0) return;
            if (_m!.Locations.Count >= 30) { _msg = T("DefectEdit.Maximum30Points"); _msgErr = true; return; }
            // Chạm vào ảnh = thêm 1 điểm mới; nhãn mặc định = vị trí đang chọn (nếu có)
            _m.Locations.Add(new LocationPointModel
            {
                X = Math.Round(Math.Clamp(e.OffsetX / size[0] * 100, 0, 100), 2),
                Y = Math.Round(Math.Clamp(e.OffsetY / size[1] * 100, 0, 100), 2),
                Label = null
            });
            _selLoc = _m.Locations.Count - 1;
        }
        catch { }
    }

    // ── Voice input (Web Speech API — Chrome / Edge / Safari) ──
    async Task Voice()
    {
        if (_listening) return;
        _ref ??= DotNetObjectReference.Create(this);
        _listening = true;
        await JS.InvokeVoidAsync("eval", @"window.__dfVoice = window.__dfVoice || function(ref){
            var R = window.SpeechRecognition || window.webkitSpeechRecognition;
            if(!R){ ref.invokeMethodAsync('OnVoiceDone', null, 'Voice input is not supported in this browser.'); return; }
            var r = new R(); r.lang = 'en-US'; r.interimResults = false; r.maxAlternatives = 1;
            var got = false;
            r.onresult = function(e){ got = true; ref.invokeMethodAsync('OnVoiceDone', e.results[0][0].transcript, null); };
            r.onerror  = function(e){ got = true; ref.invokeMethodAsync('OnVoiceDone', null, 'Voice input: ' + e.error); };
            r.onend    = function(){ if(!got) ref.invokeMethodAsync('OnVoiceDone', null, null); };
            r.start(); };");
        await JS.InvokeVoidAsync("__dfVoice", _ref);
    }

    [JSInvokable]
    public void OnVoiceDone(string? text, string? error)
    {
        _listening = false;
        if (!string.IsNullOrWhiteSpace(text))
            _m!.Description = string.IsNullOrWhiteSpace(_m.Description) ? text : _m.Description.TrimEnd() + " " + text;
        if (!string.IsNullOrEmpty(error)) { _msg = error; _msgErr = true; }
        StateHasChanged();
    }

    protected override void Dispose(bool disposing) { base.Dispose(disposing); _ref?.Dispose(); }

    // ── Chữ ký điện tử theo từng người ──────────────────────────────
    bool _isAdmin, _isInspector, _isCustomer, _signing;
    // Quyền module Defect Management: không có Edit (hoặc Create khi tạo mới) → chỉ xem, không lưu
    bool _readOnly, _canDelete;
    string _userName = "", _signerName = "";
    string? _signSlot;

    protected override async Task OnInitializedAsync()
    {
        var u = (await AuthState.GetAuthenticationStateAsync()).User;
        _isAdmin = u.IsInRole("Admin"); _isInspector = u.IsInRole("Inspector"); _isCustomer = u.IsInRole("Customer") && !_isAdmin;
        _userName = u.Identity?.Name ?? "";
        _signerName = _userName;
        await PageAccess.EnsureLoadedAsync();
        _readOnly  = _isCustomer || !PageAccess.Can("DefectManagement", Id == 0 ? "Create" : "Edit");
        _canDelete = PageAccess.Can("DefectManagement", "Delete");
        try
        {
            var sg = await Http.GetFromJsonAsync<SignerRes>("api/defects/signer", _o);
            if (!string.IsNullOrWhiteSpace(sg?.FullName)) _signerName = sg!.FullName!;
        }
        catch { /* chưa đăng nhập / mất mạng → dùng username */ }
        if (_isCustomer) _step = _steps.Length - 1;   // khách hàng vào thẳng bước ký duyệt
    }

    // Khách hàng chỉ xem các bước (không lưu); người khác lưu rồi sang bước tiếp
    // Xoá defect — chỉ Admin
    async Task DeleteDefect()
    {
        if (!await JS.InvokeAsync<bool>("confirm", T("DefectEdit.DeleteDefectThisPermanentlyDeletesCAPA", _m?.DefectNo))) return;
        var resp = await Http.DeleteAsync($"api/defects/{Id}");
        if (resp.IsSuccessStatusCode) { Navigation.NavigateTo("/defects"); return; }
        _msg = (int)resp.StatusCode == 403 ? T("DefectEdit.YouDoNotHavePermissionTo") : T("DefectEdit.DeleteFailed", (int)resp.StatusCode);
        _msgErr = true;
    }

    async Task NextOrView()
    {
        if (_readOnly) { if (_step < _steps.Length - 1) _step++; return; }
        await Next();
    }

    bool CanSign(string slot) => slot switch
    {
        "factory" or "qa" => _isAdmin || _isInspector,
        "customer"        => _isAdmin || _isCustomer,
        _ => false
    };

    string SlotTitle(string? slot) => slot switch
    {
        "factory" => T("DefectEdit.FactoryRepresentative"), "qa" => T("DefectEdit.QAVerification"), "customer" => T("DefectEdit.CustomerApproval"), _ => ""
    };

    bool _resign;

    string? SignedName(string? slot) => slot switch
    {
        "factory" => _m?.FactoryRepName, "qa" => _m?.QaVerifierName, "customer" => _m?.CustomerApproverName, _ => null
    };

    string? SignedPosition(string? slot) => slot switch
    {
        "factory" => _m?.FactoryRepPosition, "qa" => _m?.QaPosition, "customer" => _m?.CustomerPosition, _ => null
    };

    void StartResign(string slot)
    {
        StartSign(slot);
        _resign = _signSlot != null;
    }

    void StartSign(string slot)
    {
        _resign = false;
        if (Id == 0) { _msg = T("DefectEdit.PleaseSaveDefectBeforeSigning"); _msgErr = true; return; }
        _msg = null; _signSlot = slot;
    }

    async Task ConfirmSign((string Name, string Position, string DataUrl) s)
    {
        if (_signSlot == null || _m == null) return;
        _signing = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/defects/{Id}/sign", new { slot = _signSlot, name = s.Name, position = s.Position, resign = _resign, signatureDataUrl = s.DataUrl });
            if (!resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadAsStringAsync();
                _msg = (int)resp.StatusCode switch
                {
                    401 => T("DefectEdit.YourSessionHasExpiredPleaseSign"),
                    403 => T("DefectEdit.YourAccountIsNotAllowedTo"),
                    409 => T("DefectEdit.ThisApprovalHasAlreadyBeenSigned"),
                    _ => T("DefectEdit.SigningFailed") + body
                };
                _msgErr = true;
            }
            else
            {
                var r = await resp.Content.ReadFromJsonAsync<SignRes>(_o);
                switch (_signSlot)
                {
                    case "factory":  _m.FactoryRepName = r!.Name;       _m.FactoryRepPosition = r.Position; _m.FactoryRepSignatureUrl = r.Url; _m.FactoryRepSignedAt = r.SignedAt; _m.FactoryRepSignedBy = r.SignedBy; break;
                    case "qa":       _m.QaVerifierName = r!.Name;       _m.QaPosition = r.Position; _m.QaSignatureUrl = r.Url;         _m.QaSignedAt = r.SignedAt;         _m.QaSignedBy = r.SignedBy;         break;
                    default:         _m.CustomerApproverName = r!.Name; _m.CustomerPosition = r.Position; _m.CustomerSignatureUrl = r.Url;   _m.CustomerSignedAt = r.SignedAt;   _m.CustomerSignedBy = r.SignedBy;   break;
                }
                _msg = T("DefectEdit.Signed2", SlotTitle(_signSlot)); _msgErr = false;
            }
        }
        catch (Exception ex) { _msg = T("DefectEdit.SigningFailed") + ex.Message; _msgErr = true; }
        _signing = false;
        _signSlot = null;
    }

    async Task ClearSign(string slot)
    {
        if (!await JS.InvokeAsync<bool>("confirm", T("DefectEdit.ClearSignaturePersonWillNeedTo", SlotTitle(slot)))) return;
        var resp = await Http.DeleteAsync($"api/defects/{Id}/sign/{slot}");
        if (!resp.IsSuccessStatusCode) { _msg = T("DefectEdit.CouldNotClearSignature"); _msgErr = true; return; }
        switch (slot)
        {
            case "factory":  _m!.FactoryRepSignatureUrl = null; _m.FactoryRepSignedAt = null; _m.FactoryRepSignedBy = null; break;
            case "qa":       _m!.QaSignatureUrl = null;         _m.QaSignedAt = null;         _m.QaSignedBy = null;         break;
            default:         _m!.CustomerSignatureUrl = null;   _m.CustomerSignedAt = null;   _m.CustomerSignedBy = null;   break;
        }
    }

    RenderFragment SignCard(string slot, string title, string? name, string? position, string? sigUrl, DateTime? signedAt, string? signedBy, string who) => __builder =>
    {
        var signed = signedAt.HasValue;
        <div class="de-sign @(signed ? "signed" : "")">
            <div class="de-sign-head">
                <span class="de-sign-title">@title</span>
                <span class="de-sign-badge">@(signed ? T("DefectEdit.Signed") : T("DefectEdit.Pending"))</span>
            </div>
            <div class="de-sign-img">
                @if (!string.IsNullOrEmpty(sigUrl)) { <img src="@Img(sigUrl)" alt="@T("DefectEdit.Signature")" /> }
                else { <span>@T("DefectEdit.NoSignatureYet")</span> }
            </div>
            <div class="de-sign-info">
                <div><span>@T("DefectEdit.Name")</span><b>@(signed && !string.IsNullOrWhiteSpace(name) ? name : "—")</b></div>
                <div><span>@T("Common.Position")</span><b>@(signed && !string.IsNullOrWhiteSpace(position) ? position : "—")</b></div>
                <div><span>@T("Common.Date")</span><b>@(signed ? L.Date(signedAt!.Value.ToLocalTime(), "dd MMM yyyy, HH:mm") : "—")</b></div>
            </div>
            @if (signed)
            {
                <div class="de-sign-meta">@T("DefectEdit.SignedByAccount", signedBy)</div>
                @if (CanSign(slot))
                {
                    <button class="de-sign-resign" @onclick="() => StartResign(slot)">@T("DefectEdit.ReSign")</button>
                }
                @if (_isAdmin)
                {
                    <button class="de-sign-clear" @onclick="() => ClearSign(slot)">@T("DefectEdit.ClearSignature")</button>
                }
            }
            else
            {
                @if (CanSign(slot))
                {
                    <button class="de-sign-btn" @onclick="() => StartSign(slot)">@T("DefectEdit.SignNow")</button>
                }
                else
                {
                    <div class="de-sign-wait">@T("DefectEdit.WaitingFor", who)</div>
                }
            }
        </div>
    };

    class SignerRes { public string? Username { get; set; } public string? FullName { get; set; } }
    class SignRes { public string? Url { get; set; } public DateTime SignedAt { get; set; } public string? SignedBy { get; set; } public string? Name { get; set; } public string? Position { get; set; } }

    class CreateRes { public int Id { get; set; } public string? DefectNo { get; set; } public string? CarNo { get; set; } }
    class UploadRes { public string? Url { get; set; } }
}

