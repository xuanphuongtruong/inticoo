@page "/suppliers"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@using InticooInspection.Client.Services
@using InticooInspection.Client.Helpers
@inject WaitingService Waiting
@inject InticooInspection.Client.Services.PageAccessService PageAccess
@using InticooInspection.Client.Shared
@inherits LocalizedComponentBase

<PageTitle>@T("Vendors.VendorsInticoo")</PageTitle>

<div class="lp-head">
    <div class="title-block">
        <h1 class="page-title">@T("Vendors.Vendors2")</h1>
        <span class="page-sub">@T("Vendors.ManageSupplierAndVendorInformation")</span>
    </div>
</div>
<div class="top-bar lp-filters @(_fOpen ? "fopen" : "")">
    <div class="search-wrap">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="9" cy="9" r="5.5"/><path d="M15 15l-2.5-2.5" stroke-linecap="round"/>
        </svg>
        <input class="search-input" type="text" placeholder="@T("Vendors.SearchByCodeNameTaxCode")"
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey" />
    </div>
    <button type="button" class="lp-filter-toggle @(_fOpen ? "on" : "")" @onclick="() => _fOpen = !_fOpen" aria-label="@T("Common.Filters")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></svg></button>
    <div class="lp-selects">
        <select class="filter-select" @bind="_category" @bind:after="() => LoadPage(1)">
            <option value="">@T("Common.AllCategories")</option>
            @foreach (var c in _catOpts) { <option value="@c">@TE("Opt", c)</option> }
        </select>
        <select class="filter-select" @bind="_country" @bind:after="() => LoadPage(1)">
            <option value="">@T("Common.AllCountries")</option>
            @foreach (var c in _countryOpts) { <option value="@c">@c</option> }
        </select>
        <select class="filter-select" @bind="_filterType" @bind:after="() => LoadPage(1)">
            <option value="">@T("Vendors.AllTypes")</option>
            @foreach (var bt in _btOpts) { <option value="@bt">@TE("Opt", bt)</option> }
        </select>
        <select class="filter-select" @bind="_filterStatus" @bind:after="() => LoadPage(1)">
            <option value="">@T("Common.AllStatus")</option>
            <option value="Active">@T("Common.Active")</option>
            <option value="Inactive">@T("Common.Inactive")</option>
            <option value="Suspended">@T("Vendors.Suspended")</option>
        </select>
    </div>
    <div class="lp-dates">
        <span class="lp-lbl">@T("Vendors.DateCreated")</span>
        <DateFilter @bind-Value="_dFrom" @bind-Value:after="() => LoadPage(1)" Placeholder="@T("Common.StartDate")" />
        <span class="lp-arrow">&rarr;</span>
        <DateFilter @bind-Value="_dTo" @bind-Value:after="() => LoadPage(1)" Placeholder="@T("Common.EndDate")" />
        <button type="button" class="lp-btn-reset" @onclick="ClearFilters">@T("Common.Clear")</button>
    </div>
    <span class="total-count">@T("Vendors.Vendors", _total)</span>
    @if (DirCreate)
    {
        <ImportExcelButton ApiBase="api/vendors" OnImported="() => LoadPage(_page)" />
        <button class="btn-new" @onclick="async () => await OpenCreate()">
            <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M10 4v12M4 10h12"/></svg>
            @T("Vendors.NewVendor")
        </button>
    }
</div>

<div class="m-kpis">
    <div class="m-kpi"><span class="m-kpi-ico k-blue"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 5.5"/></svg></span><b>@(_totalAll)</b><small>@T("Customers.KpiTotal")</small></div>
    <div class="m-kpi"><span class="m-kpi-ico k-green"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg></span><b>@(_activeCount)</b><small>@T("Common.Active")</small></div>
    <div class="m-kpi"><span class="m-kpi-ico k-orange"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/></svg></span><b class="red">@(_inactiveCount)</b><small>@T("Common.Inactive")</small></div>
    <div class="m-kpi lp-kpi-extra"><span class="m-kpi-ico k-blue"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 12l-8 8-9-9V3h8z"/><circle cx="7.5" cy="7.5" r="1.2"/></svg></span><b>@_categoryCount</b><small>@T("Vendors.Categories")</small></div>
</div>
<div class="m-chips">
    <button type="button" class="@(_filterStatus == "" ? "on" : "")" @onclick='() => SetStatus("")'>@T("Customers.ChipAll") (@_totalAll)</button>
    <button type="button" class="@(_filterStatus == "Active" ? "on" : "")" @onclick='() => SetStatus("Active")'>@T("Common.Active") (@_activeCount)</button>
    <button type="button" class="@(_filterStatus == "Inactive" ? "on" : "")" @onclick='() => SetStatus("Inactive")'>@T("Common.Inactive") (@_inactiveCount)</button>
</div>

@if (_loading)
{
    <div class="loading-wrap"><div class="spinner"></div><span>@T("Common.Loading")</span></div>
}
else if (_vendors.Count == 0)
{
    <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="rgba(255,255,255,0.2)" stroke-width="1.5">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <p>@T("Vendors.NoVendorsFound")</p>
    </div>
}
else
{
    <div class="m-cards">
        @foreach (var mv in _vendors)
        {
            var item = mv;
            <div class="m-card">
                <div class="m-card-head">
                    <div class="m-card-name">@item.Name</div>
                    <span class="status-badge status-@GetStatusCss(item.Status)">@GetStatusLabel(item.Status)</span>
                </div>
                <div class="m-card-code">@item.Code@(string.IsNullOrEmpty(item.ShortName) ? "" : " · " + item.ShortName)</div>
                @if (!string.IsNullOrEmpty(item.Category))
                {
                    <span class="cat-badge">@TE("Opt", item.Category)</span>
                }
                <div class="m-card-rows">
                    @if (!string.IsNullOrEmpty(item.ContactName))
                    {
                        <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>@item.ContactName@(string.IsNullOrEmpty(item.ContactTitle) ? "" : $" ({item.ContactTitle})")</div>
                    }
                    @if (!string.IsNullOrEmpty(item.ContactPhone ?? item.Phone))
                    {
                        <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z"/></svg>@(item.ContactPhone ?? item.Phone)</div>
                    }
                    @if (!string.IsNullOrEmpty(item.State) || !string.IsNullOrEmpty(item.Country))
                    {
                        <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>@string.Join(", ", new[] { item.State, item.Country }.Where(x => !string.IsNullOrEmpty(x)))</div>
                    }
                    <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>@L.Date(item.CreatedAt, "d MMM yyyy")</div>
                </div>
                <div class="m-card-actions">
                    <button type="button" class="m-btn-outline" @onclick="() => OpenDetail(item)">@T("Common.View")</button>
                    @if (DirEdit)
                    {
                        <button type="button" class="m-btn-fill" @onclick="async () => await OpenEdit(item)">@T("Common.Edit")</button>
                    }
                </div>
            </div>
        }
    </div>

    <div class="table-wrap">
        <table class="ptable">
            <thead>
                <tr>
                    <th class="tc th-y th-chk"><input type="checkbox" checked="@(_vendors.Count > 0 && _vendors.All(x => _sel.Contains(x.Id)))" @onchange="e => ToggleAll((bool)(e.Value ?? false))" /></th>
                    <th class="tc th-y">No</th>
                    <th class="tc th-y">@T("Common.VendorName")</th>
                    <th class="tc th-y">@T("Common.VendorID")</th>
                    <th class="tc th-y">@T("Common.Category")</th>
                    <th class="tc th-y">@T("Common.Country")</th>
                    <th class="tc th-y">@T("Common.ContactName")</th>
                    <th class="tc th-y">@T("Common.Position")</th>
                    <th class="tc th-y">@T("Vendors.FactoryEvaluation")</th>
                    <th class="tc th-y">@T("Common.Status")</th>
                    <th class="tc th-y">@T("Common.Actions")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in _vendors)
                {
                    var item = v;
                    var rowNo = (_page - 1) * _pageSize + _vendors.IndexOf(v) + 1;
                    <tr class="@(rowNo % 2 == 0 ? "table-row tr-alt" : "table-row")">
                        <td class="tc"><input type="checkbox" checked="@_sel.Contains(item.Id)" @onchange="e => ToggleOne(item.Id, (bool)(e.Value ?? false))" /></td>
                        <td class="tc muted">@rowNo</td>
                        <td>
                            <div class="vendor-cell">
                                <div>
                                    <div class="vendor-name">@item.Name</div>
                                    @if (!string.IsNullOrEmpty(item.ShortName))
                                    { <div class="vendor-short">@item.ShortName</div> }
                                </div>
                            </div>
                        </td>
                        <td class="tc mono">@(string.IsNullOrEmpty(item.Code) ? "—" : item.Code)</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Category))
                            { <span class="cat-badge">@TE("Opt", item.Category)</span> }
                            else { <span class="muted">-</span> }
                        </td>
                        <td class="tc muted small-td">@(string.IsNullOrEmpty(item.Country) ? "-" : item.Country)</td>
                        <td class="tc small-td">@(string.IsNullOrEmpty(item.ContactName)  ? "-" : item.ContactName)</td>
                        <td class="tc muted small-td">@(string.IsNullOrEmpty(item.ContactTitle) ? "-" : item.ContactTitle)</td>
                        <td class="tc">
                            @if (item.FactoryEvalFileCount > 0)
                            {
                                <span class="file-count-badge file-count-btn fe-badge"
                                      @onclick="async (e) => await ToggleFePopup(e, item)"
                                      @onclick:stopPropagation="true">
                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                    @item.FactoryEvalFileCount
                                </span>
                            }
                            else
                            {
                                @if (DirEdit)
                                {
                                        <label class="upload-inline-btn" title="@T("Vendors.UploadFactoryEvaluationFile")">
                                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                                            @T("Vendors.Upload")
                                            <InputFile OnChange="(e) => HandleInlineFactoryEvalUpload(e, item)" style="display:none" accept=".pdf,.jpg,.jpeg,.png,.xlsx,.docx" multiple />
                                        </label>
                                }
                                else
                                {
                                        <span class="muted">—</span>
                                }
                            }
                        </td>
                        <td class="tc">
                            <span class="status-badge status-@GetStatusCss(item.Status)">@GetStatusLabel(item.Status)</span>
                        </td>
                        <td class="tc">
                            <div class="action-btns">
                                <button class="bico bview" @onclick="() => OpenDetail(item)" title="@T("Common.View")">
                                    <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 10s3.5-6 8-6 8 6 8 6-3.5 6-8 6-8-6-8-6Z"/><circle cx="10" cy="10" r="2.5"/></svg>
                                </button>
                                @if (DirEdit)
                                {
                                    <button class="bico bedit" @onclick="async () => await OpenEdit(item)" title="@T("Common.Edit")">
                                        <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2l4 4-10 10H4v-4L14 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </button>
                                }
                                @if (DirDelete)
                                {
                                    <button class="bico bdel" @onclick="() => ConfirmDelete(item)" title="@T("Common.Delete")">
                                        <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h14M8 6V4h4v2M5 6l1 11h8l1-11" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <ListPager Total="_total" Page="_page" PageSize="_pageSize" Noun="@T("Pager.Vendors")" OnPage="LoadPage" OnPageSize="SetPageSize" />
}

<!-- File popup -->
@if (_filePopupVendor != null)
{
    <div class="fp-backdrop" @onclick="CloseFilePopup"></div>
    <div class="fp-popup" style="top:@(_filePopupY)px;left:@(_filePopupX)px" @onclick:stopPropagation="true">
        <div class="fp-header">
            <span class="fp-title">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                @T("Vendors.FileS3", _filePopupVendor.Attachments.Count, _filePopupVendor.Name)
            </span>
            <button class="fp-close" @onclick="CloseFilePopup">&#x2715;</button>
        </div>
        <div class="fp-list">
            @foreach (var att in _filePopupVendor.Attachments)
            {
                <div class="fp-item">
                    <div class="fp-icon">@((MarkupString)GetFileIconSvg(att.ContentType))</div>
                    <div class="fp-info">
                        <span class="fp-name">@att.OriginalName</span>
                        <span class="fp-meta">@FormatFileSize(att.FileSize) · @att.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                    </div>
                    <div class="fp-actions">
                        @if (att.ContentType.StartsWith("image/") || att.ContentType == "application/pdf")
                        {
                            <a href="@att.DownloadUrl" target="_blank" class="fp-btn fp-btn-view" title="@T("Common.View")">
                                <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 10s3.5-6 8-6 8 6 8 6-3.5 6-8 6-8-6-8-6Z"/><circle cx="10" cy="10" r="2.5"/></svg>
                                @T("Common.View")
                            </a>
                        }
                        <a href="@att.DownloadUrl" download="@att.OriginalName" class="fp-btn fp-btn-dl" title="@T("Common.Download")">
                            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                            @T("Common.Download")
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- Factory Eval File Popup -->
@if (_fePopupVendor != null)
{
    <div class="fp-backdrop" @onclick="CloseFePopup"></div>
    <div class="fp-popup" style="top:@(_fePopupY)px;left:@(_fePopupX)px;width:420px;" @onclick:stopPropagation="true">
        <div class="fp-header">
            <span class="fp-title">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2"><path d="M9 11l3 3L22 4"/><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
                @T("Vendors.FactoryEval", _fePopupVendor.Name)
            </span>
            <button class="fp-close" @onclick="CloseFePopup">&#x2715;</button>
        </div>
        @if (_fePopupLoading)
        {
            <div style="padding:20px;text-align:center;"><div class="spinner"></div></div>
        }
        else
        {
            <div class="fp-list">
                @foreach (var f in _fePopupFiles)
                {
                    <div class="fp-item">
                        <div class="fp-icon">@((MarkupString)GetFileIconSvg(f.ContentType))</div>
                        <div class="fp-info">
                            <span class="fp-name">@f.OriginalName</span>
                            <span class="fp-meta">@FormatFileSize(f.FileSize) · @f.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
                        </div>
                        <div class="fp-actions">
                            @if (f.ContentType.StartsWith("image/") || f.ContentType == "application/pdf")
                            {
                                <a href="@f.DownloadUrl" target="_blank" class="fp-btn fp-btn-view">
                                    <svg width="12" height="12" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 10s3.5-6 8-6 8 6 8 6-3.5 6-8 6-8-6-8-6Z"/><circle cx="10" cy="10" r="2.5"/></svg>
                                    @T("Common.View")
                                </a>
                            }
                            <a href="@f.DownloadUrl" download="@f.OriginalName" class="fp-btn fp-btn-dl">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                @T("Common.Download")
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}

<!-- ═══════════════════ Modal Create / Edit ═══════════════════ -->
@if (_showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card modal-lg" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div>
                    <h2>@(_editId == null ? T("Vendors.NewVendor") : T("Vendors.EditVendor"))</h2>
                    @if (_editId != null)
                    { <span style="font-size:12px;color:rgba(255,255,255,0.3);margin-top:2px;display:block;">@_f.Code</span> }
                </div>
                <button class="modal-close" @onclick="CloseModal">&#x2715;</button>
            </div>

            <div class="vf-head">
                <div class="vf-avatar">@VendorInitials(_f.Name)</div>
                <div class="vf-head-main">
                    <div class="vf-head-name">@(string.IsNullOrWhiteSpace(_f.Name) ? T("Vendors.NewVendor") : _f.Name)</div>
                    <div class="vf-head-sub">@(string.IsNullOrEmpty(_f.Code) ? "" : _f.Code)@(string.IsNullOrEmpty(_f.Country) ? "" : " · " + _f.Country)</div>
                </div>
                <span class="status-badge status-@GetStatusCss(_f.Status)">@GetStatusLabel(_f.Status)</span>
            </div>

            @if (!string.IsNullOrEmpty(_formError))
            { <div class="error-alert">@_formError</div> }

            <div class="pf-cols">
            <div class="pf-card2">
            <!-- Vendor ID + Status -->
            <div class="fg-row">
                <div class="fg fg-1">
                    <label>@T("Common.VendorID")</label>
                    <input class="form-input input-readonly" type="text" @bind="_f.Code" readonly="true" />
                </div>
            </div>

            <!-- Vendor Profile -->
            <div class="section-title">@T("Vendors.VendorProfile")</div>
            <div class="fg-row">
                <div class="fg fg-2">
                    <label>@T("Common.VendorName") <span class="required">*</span></label>
                    <input class="form-input" type="text" placeholder="@T("Vendors.FullCompanyName")" @bind="_f.Name" @bind:event="oninput" />
                </div>
                <div class="fg fg-1">
                    <label>@T("Common.ShortName")</label>
                    <input class="form-input" type="text" placeholder="@T("Vendors.Abbreviation")" @bind="_f.ShortName" @bind:event="oninput" />
                </div>
                <div class="fg fg-3" style="grid-column:span 3;">
                    <label>@T("Customers.BusinessType")</label>
                    <div class="btype-group">
                        @foreach (var bt in Taxonomy.VendorBusinessTypes)
                        {
                            var btVal = bt;
                            <label class="btype-label @(VbtHas(_f.BusinessType, btVal) ? "btype-active" : "")" @onclick="() => ToggleVendorBt(btVal)">@TE("Opt", btVal)</label>
                        }
                    </div>
                </div>
            </div>
            <div class="fg-row">
                <div class="fg fg-3" style="grid-column:span 3;">
                    <label>@T("Common.ProductCategory") <span style="font-size:11px;color:#9baac8;font-weight:400;">@T("Vendors.MultiSelect")</span></label>
                    <div class="cat-check-list">
                        @foreach (var _catOpt in Taxonomy.MainCategories)
                        {
                            var catVal = _catOpt;
                            var isChecked = _formCategories.Contains(catVal);
                            <label class="cat-check-item @(isChecked ? "cat-check-active" : "")">
                                <input type="checkbox" checked="@isChecked" @onchange="() => ToggleVendorCategory(catVal)" />
                                @TE("Opt", catVal)
                            </label>
                        }
                    </div>
                    @if (_formCategories.Count > 0)
                    {
                        <div style="margin-top:6px;display:flex;flex-wrap:wrap;gap:4px;">
                            @foreach (var _c in _formCategories.ToList())
                            {
                                var _cv = _c;
                                <span class="cat-badge" style="cursor:pointer;" @onclick="() => { _formCategories.Remove(_cv); StateHasChanged(); }">@_cv ✕</span>
                            }
                        </div>
                    }
                </div>
                <div class="fg fg-1">
                    <label>@T("Vendors.TaxCode")</label>
                    <input class="form-input" type="text" placeholder="@T("Vendors.TaxCode2")" @bind="_f.TaxCode" @bind:event="oninput" />
                </div>
                <div class="fg fg-1">
                    <label>@T("Vendors.BusinessRefNo")</label>
                    <input class="form-input" type="text" placeholder="@T("Vendors.BusinessRegNo")" @bind="_f.BusinessRegNo" @bind:event="oninput" />
                </div>
                <div class="fg fg-1">
                    <label>@T("Vendors.Phone")</label>
                    <input class="form-input" type="text" placeholder="@T("Vendors.CompanyMainPhone")" @bind="_f.Phone" @bind:event="oninput" />
                </div>
                <div class="fg fg-1">
                    <label>@T("Vendors.Website")</label>
                    <input class="form-input" type="text" placeholder="https://example.com" @bind="_f.Website" @bind:event="oninput" />
                </div>
            </div>

            </div>
            <div class="pf-card2">
            <!-- Vendor Address -->
            <div class="section-title">@T("Vendors.VendorAddress")</div>
            <div class="fg-row">
                <div class="fg fg-3">
                    <label>@T("Common.Address1")</label>
                    <input class="form-input" type="text" placeholder="@T("Common.StreetAddressLine1")" @bind="_f.Address1" @bind:event="oninput" />
                </div>
                <div class="fg fg-3">
                    <label>@T("Common.Address2")</label>
                    <input class="form-input" type="text" placeholder="@T("Vendors.StreetAddressLine2Optional")" @bind="_f.Address2" @bind:event="oninput" />
                </div>
                <div class="fg fg-1">
                    <label>@T("Common.City")</label>
                    <input class="form-input" type="text" placeholder="@T("Common.EnterCity")" @bind="_f.City" @bind:event="oninput" />
                </div>
                <div class="fg fg-1">
                    <label>@T("Common.StateProvince")</label>
                    <input class="form-input" type="text" placeholder="@T("Vendors.StateOrProvince")" @bind="_f.State" @bind:event="oninput" />
                </div>
                <div class="fg fg-1">
                    <label>@T("Common.Country")</label>
                    @if (_loadingCountries)
                    {
                        <div class="form-input" style="color:#9baac8;font-style:italic;">@T("Common.Loading")</div>
