            <div class="fg-row">
                <div class="fg fg-3">
                    <textarea class="form-input" rows="3" placeholder="@T("Vendors.AdditionalNotes")" @bind="_f.Notes" @bind:event="oninput"></textarea>
                </div>
            </div>

            <!-- Factory Evaluation -->
            <div class="section-title">@T("Vendors.FactoryEvaluation")</div>
            <div class="fg-row">
                <div class="fg fg-3">
                    <label>@T("Vendors.EvaluationNotes")</label>
                    <textarea class="form-input" rows="3" placeholder="@T("Vendors.FactoryEvaluationSummaryAuditFindings")" @bind="_f.FactoryEvaluationNotes" @bind:event="oninput"></textarea>
