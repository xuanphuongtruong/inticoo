            }
            @if (_pendingFiles.Count > 0)
            {
                <div class="att-list">
                    @foreach (var pf in _pendingFiles)
                    {
                        var p = pf;
                        <div class="att-item att-pending">
                            <div class="att-icon">@((MarkupString)GetFileIconSvgByName(p.Name))</div>
                            <div class="att-info">
                                <span class="att-name" style="color:rgba(255,255,255,0.75);cursor:default">@p.Name</span>
                                <span class="att-meta">@FormatFileSize(p.Size) &nbsp;·&nbsp; <span class="pending-badge">@T("Vendors.Pending")</span></span>
                            </div>
                            <button class="att-action-btn att-delete" @onclick="() => RemovePendingFile(p)">
                                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4h6v2"/></svg>
                            </button>
                        </div>
                    }
                </div>
            }

            <div class="upload-zone @(_isDragOver ? "drag-over" : "")"
                 @ondragover:preventDefault="true"
                 @ondragenter="() => _isDragOver = true"
                 @ondragleave="() => _isDragOver = false"
                 @ondrop="HandleDrop">
                @if (_uploadLoading)
                {
                    <div class="upload-zone-inner">
                        <div class="spinner" style="width:24px;height:24px;border-width:3px;"></div>
                        <span>@T("Vendors.UploadingFileS", _uploadingCount)</span>
                    </div>
                }
                else
                {
                    <div class="upload-zone-inner">
                        <div class="upload-icon-wrap">
                            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                        </div>
                        <div class="upload-text">
                            @T("Vendors.DragDropFilesHereOr")
                            <label class="browse-link">
                                @T("Vendors.ChooseFiles")
                                <InputFile OnChange="HandleFileUpload" style="display:none" accept=".pdf,.jpg,.jpeg,.png" multiple disabled="@_uploadLoading" />
                            </label>
                        </div>
                        <span class="upload-hint">@T("Vendors.PDFJPGPNGMax10MB")</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(_uploadError))
            { <div class="error-alert" style="margin-top:8px">@_uploadError</div> }
            <div style="margin-top:14px;">
            @* ── Account Status: cùng vị trí (cuối form) ở Customer/Vendor/Inspector/Product ── *@
            <div class="section-title" style="margin-top:16px;">@T("Common.AccountStatus")</div>
            <div class="btype-group" style="padding:8px 0 4px;">
                    <label class="btype-label @(_f.Status == 0 ? "btype-active" : "")" @onclick="() => _f.Status = 0">@T("Common.Active")</label>
                    <label class="btype-label @(_f.Status == 1 ? "btype-active" : "")" @onclick="() => _f.Status = 1">@T("Common.Inactive")</label>
                    <label class="btype-label @(_f.Status == 2 ? "btype-active" : "")" @onclick="() => _f.Status = 2">@T("Vendors.Suspended")</label>
                    </div>

            </div>
            </div>
            </div>
            <div class="form-section-title" style="margin-top:22px;">@T("Vendors.TabReportSettings")</div>
            <PartyReportSettings PartyType="Vendor" Settings="_reportSettings"

                                     PartyName="@_f.Name" PartyCode="@_f.Code"

                                     ContactName="@(_contacts.FirstOrDefault(c => c.IsPrimary)?.Name ?? "")"

                                     PreviewTo="@PreviewTo()" OnSaveTemplate="@SaveVendor" />

            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseModal">@T("Common.Cancel")</button>
                <button class="btn-submit" @onclick="SaveVendor" disabled="@_saving">
                    @if (_saving)
                    {
                        <span class="spinner"></span>
                        <span>@(_editId == null && _pendingFiles.Count > 0 ? T("Vendors.CreatingUploading") : "Saving...")</span>
                    }
                    else
                    {
                        <span>@(_editId == null ? T("Vendors.CreateVendor") : T("Vendors.SaveChanges"))</span>
                        @if (_editId == null && _pendingFiles.Count > 0)
                        { <span class="btn-file-hint">@T("Vendors.FileS", _pendingFiles.Count)</span> }
                    }
                </button>
            </div>
        </div>
    </div>
}

<!-- Detail Modal -->
@if (_detailItem != null)
{
    var d = _detailItem;
    <div class="modal-overlay" @onclick="() => _detailItem = null">
        <div class="modal-card modal-lg modal-detail" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@T("Vendors.ViewTitle")</h2>
                <button class="modal-close" @onclick="() => _detailItem = null">&#x2715;</button>
            </div>
            <div class="vc-grid">
                <div class="vc-col">
                    <ViewSection Title="@T("Vendors.ViewSection")" Icon="building">
                        <ViewRow Label="@T("Common.VendorID")" Value="@d.Code" />
                        <ViewRow Label="@T("Common.VendorName")" Value="@d.Name" />
                        <ViewRow Label="@T("Common.ShortName")" Value="@d.ShortName" />
                        <ViewRow Label="@T("Common.Status")"><span class="vc-badge @(GetStatusCss(d.Status) == "active" ? "" : "off")">@GetStatusLabel(d.Status)</span></ViewRow>
                        <ViewRow Label="@T("Common.Category")" Value="@d.Category" />
                        <ViewRow Label="@T("Vendors.TaxCode")" Value="@d.TaxCode" />
                        <ViewRow Label="@T("Vendors.BusinessRef")" Value="@d.BusinessRegNo" />
                        <ViewRow Label="@T("Vendors.Phone")" Value="@d.Phone" />
                        <ViewRow Label="@T("Vendors.Website")" Value="@d.Website" Href="@d.Website" />
                    </ViewSection>
                </div>
                <div class="vc-col">
                    <ViewSection Title="@T("Vendors.VendorAddress")" Icon="pin">
                        <ViewRow Label="@T("Common.Address1")" Value="@d.Address1" />
                        <ViewRow Label="@T("Common.Address2")" Value="@d.Address2" />
                        <ViewRow Label="@T("Common.City")" Value="@d.City" />
                        <ViewRow Label="@T("Common.StateProvince")" Value="@d.State" />
                        <ViewRow Label="@T("Common.Country")" Value="@d.Country" />
                        <ViewRow Label="@T("Common.PostalZIP")" Value="@d.PostalCode" />
                    </ViewSection>
                    <ViewSection Title="@T("Vendors.ContactInformation")" Icon="user">
                        <ViewRow Label="@T("Common.ContactName")" Value="@d.ContactName" />
                        <ViewRow Label="@T("Vendors.TitlePosition")" Value="@d.ContactTitle" />
                        <ViewRow Label="@T("Common.Mobile")" Value="@d.ContactPhone" />
                        <ViewRow Label="Email" Value="@d.ContactEmail" Href="@(string.IsNullOrEmpty(d.ContactEmail) ? null : "mailto:" + d.ContactEmail)" />
                    </ViewSection>
                </div>
                @if (!string.IsNullOrEmpty(d.Notes))
                {
                    <ViewSection Title="@T("Common.Remark")" Icon="doc" Class="vc-wide">
                        <div class="vc-note">@d.Notes</div>
                    </ViewSection>
                }
                @if (d.Attachments.Count > 0)
                {
                    <ViewSection Title="@T("Vendors.ReferenceFileS", d.Attachments.Count)" Icon="doc" Class="vc-wide">
                        <div class="att-list">
                            @foreach (var att in d.Attachments)
                            {
                                <div class="att-item">
                                    <div class="att-icon">@((MarkupString)GetFileIconSvg(att.ContentType))</div>
                                    <div class="att-info">
                                        <a href="@att.DownloadUrl" target="_blank" class="att-name">@att.OriginalName</a>
                                        <span class="att-meta">@FormatFileSize(att.FileSize) · @att.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                    </div>
                                    <a href="@att.DownloadUrl" target="_blank" class="att-action-btn att-download">
                                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                    </a>
                                </div>
                            }
                        </div>
                    </ViewSection>
                }
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="() => _detailItem = null">@T("Common.Close")</button>
                @if (DirEdit)
                {
                    <button class="btn-submit" @onclick="async () => { _detailItem = null; await OpenEdit(d); }">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                        @T("Common.Edit")
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- Confirm Delete -->
@if (_deleteItem != null)
{
    <div class="modal-overlay" @onclick="() => _deleteItem = null">
        <div class="modal-card confirm-card" @onclick:stopPropagation="true">
            <div class="confirm-icon">&#9888;</div>
            <h2>@T("Vendors.DeleteVendor")</h2>
            <p>@T("Vendors.AreYouSureYouWantTo") <strong>@_deleteItem.Name</strong>?<br/>@T("Vendors.ThisActionCannotBeUndone")</p>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="() => _deleteItem = null">@T("Common.Cancel")</button>
                <button class="btn-delete" @onclick="DeleteVendor" disabled="@_saving">
                    @if (_saving) { <span class="spinner"></span> } else { <span>@T("Common.Delete")</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    // Quyền Directory theo Module Permissions (Admin luôn được): Create = thêm/import, Edit = sửa, Delete = xoá
    private bool DirCreate => PageAccess.Can("Directory", "Create");
    private bool DirEdit   => PageAccess.Can("Directory", "Edit");
    private bool DirDelete => PageAccess.Can("Directory", "Delete");

    private bool _fOpen;
    private List<VendorDto> _vendors = new();
    private bool   _loading = true;
    private string _search = "", _filterType = "", _filterStatus = "";
    private int _activeCount, _inactiveCount, _totalAll;
    private async Task SetStatus(string st) { _filterStatus = st; await LoadPage(1); }
    private int    _page = 1, _pageSize = 10, _total = 0;
    private string _category = "", _country = "";
    private DateTime? _dFrom, _dTo;
    private int _categoryCount;
    private List<string> _catOpts = new(), _countryOpts = new(), _btOpts = new();
    private readonly HashSet<int> _sel = new();
    private void ToggleAll(bool on) { foreach (var x in _vendors) { if (on) _sel.Add(x.Id); else _sel.Remove(x.Id); } }
    private void ToggleOne(int id, bool on) { if (on) _sel.Add(id); else _sel.Remove(id); }
    private async Task SetPageSize(int n) { _pageSize = n; await LoadPage(1); }
    private async Task ClearFilters() { _search = _filterType = _filterStatus = _category = _country = ""; _dFrom = _dTo = null; await LoadPage(1); }

    private bool   _showModal = false;
    private int?   _editId   = null;
    private VendorForm _f    = new();
    private string _formError = "";

    // Tab trong modal: 0 = General Information & Contacts, 1 = Report Settings
    private int _modalTab = 0;
    private List<PartyContactVm>       _contacts       = new();
    private List<PartyReportSettingVm> _reportSettings = new();

    private string PreviewTo() => string.Join("; ", _contacts
        .Where(c => c.IsActive && c.ReceiveReports && !string.IsNullOrWhiteSpace(c.Email)).Select(c => c.Email!.Trim()));

    // Country/City dropdowns
    private List<CountryItem> _countries      = new();
    private bool              _loadingCountries = true;
    private bool   _saving   = false;

    private List<AttachmentDto> _attachments  = new();  // saved on server
    private List<PendingFile>   _pendingFiles = new();  // in-memory, not yet uploaded

    private List<AttachmentDto> _factoryEvalFiles   = new();
    private List<PendingFile>   _pendingFactoryFiles = new();
    private bool   _isDragOverFe = false;

    // Multi-select categories
    private List<string> _formCategories = new();

    private bool   _uploadLoading  = false;
    private int    _uploadingCount = 0;
    private string _uploadError    = "";
    private bool   _isDragOver     = false;

    private VendorDto? _detailItem  = null;
    private VendorDto? _deleteItem  = null;

    // File popup
    private VendorDto? _filePopupVendor = null;
    private double _filePopupX = 0, _filePopupY = 0;

    // Factory Eval popup
    private VendorDto? _fePopupVendor  = null;
    private double     _fePopupX = 0, _fePopupY = 0;
    private bool       _fePopupLoading = false;
    private List<AttachmentDto> _fePopupFiles = new();

    private void ToggleFilePopup(MouseEventArgs e, VendorDto vendor)
    {
        if (_filePopupVendor?.Id == vendor.Id) { _filePopupVendor = null; return; }
        _filePopupVendor = vendor;
        // Position popup near the click, keep within viewport roughly
        _filePopupX = Math.Max(10, e.ClientX - 280);
        _filePopupY = e.ClientY + 12;
    }

    private void CloseFilePopup() => _filePopupVendor = null;

    private async Task ToggleFePopup(MouseEventArgs e, VendorDto vendor)
    {
        if (_fePopupVendor?.Id == vendor.Id) { _fePopupVendor = null; return; }
        _fePopupVendor  = vendor;
        _fePopupX       = Math.Max(10, e.ClientX - 340);
        _fePopupY       = e.ClientY + 12;
        _fePopupFiles   = new();
        _fePopupLoading = true;
        try
        {
            var list = await Http.GetFromJsonAsync<List<AttachmentDto>>($"api/vendors/{vendor.Id}/factory-eval/files");
            _fePopupFiles = list ?? new();
        }
        catch { }
        finally { _fePopupLoading = false; }
    }

    private void CloseFePopup() => _fePopupVendor = null;

    protected override async Task OnInitializedAsync()
    {
        await SetAuthHeader();
        await PageAccess.EnsureLoadedAsync();
        // Page Access guard: Admin luon duoc vao, role khac phai co "Directory"
        if (!PageAccess.HasAccess("Directory"))
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }
        await Task.WhenAll(LoadPage(1), LoadCountries());
    }

