    }

    private async Task SetAuthHeader()
    {
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("auth_token");
            if (!string.IsNullOrEmpty(token))
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }
        catch { }
    }

    private async Task LoadPage(int page)
    {
        _loading = true; _page = page;
        try
        {
            var url = $"api/vendors?page={page}&pageSize={_pageSize}&search={Uri.EscapeDataString(_search)}&businessType={Uri.EscapeDataString(_filterType)}&status={_filterStatus}" +
                      $"&category={Uri.EscapeDataString(_category)}&country={Uri.EscapeDataString(_country)}" +
                      (_dFrom.HasValue ? $"&dateFrom={_dFrom.Value:yyyy-MM-dd}" : "") + (_dTo.HasValue ? $"&dateTo={_dTo.Value:yyyy-MM-dd}" : "");
            var result = await Http.GetFromJsonAsync<VendorPageResult>(url);
            if (result != null)
            {
                _vendors = result.Items; _total = result.Total; _activeCount = result.ActiveCount; _inactiveCount = result.InactiveCount; _totalAll = result.AllCount;
                _categoryCount = result.CategoryCount; _catOpts = result.Categories; _btOpts = result.BusinessTypes; _countryOpts = result.Countries;
            }
        }
        catch { }
        finally { _loading = false; }
    }

