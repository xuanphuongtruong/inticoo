@page "/inspection-qc/{InspectionId:int}"
@using System.Net.Http.Json
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.JSInterop
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inherits LocalizedComponentBase

<PageAccessGuard RequiredPage="SummaryInspections" RequiredAction="Create|Edit">
@* ═══════════════════════════════════════════════════════════════
   QC Inspection Wizard — theo giao diện chính PDF
   Route: /inspection-qc/{InspectionId}
   ═══════════════════════════════════════════════════════════════ *@

@if (_loading)
{
    <div class="qc-loading">
        <div class="qc-spinner"></div>
        <span>@T("InspectionQC.LoadingInspection")</span>
    </div>
}
else if (_inspection == null)
{
    <div class="qc-error">
        <p>@(string.IsNullOrEmpty(_saveMsg) ? T("InspectionQC.InspectionNotFound") : _saveMsg)</p>
        <p style="font-size:12px;opacity:.75;margin-top:6px">
            @T("InspectionQC.IDEndpointApiInspections", InspectionId, InspectionId)
        </p>
        <button @onclick="LoadInspection">@T("InspectionQC.Retry")</button>
        <button @onclick="GoBack">@T("Common.Back2")</button>
    </div>
}
else
{
    <!-- PROGRESS BAR -->
    <div class="qc-progress-wrap">
        <div class="qc-progress-bar" style="width:@ProgressPct%"></div>
    </div>

    <!-- HEADER -->
    <div class="qc-header">
        <button class="qc-back-btn" @onclick="HandleBack">
            <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round"><path d="M12 15l-5-5 5-5"/></svg>
        </button>
        <div class="qc-header-center">
            <div class="qc-step-label">@CurrentStep.StepLabel</div>
            <div class="qc-step-title">@CurrentStep.Title</div>
        </div>
        <div class="qc-step-counter">@(_currentStepIdx + 1)/@_steps.Count</div>
    </div>

    <!-- STEP DOTS -->
    <div class="qc-dots">
        @for (int i = 0; i < _steps.Count; i++)
        {
            var idx = i;
            <div class="qc-dot @(idx == _currentStepIdx ? "dot-active" : idx < _currentStepIdx ? "dot-done" : "")"></div>
        }
    </div>

    @if (!string.IsNullOrEmpty(_draftRestoredAt))
    {
        <div class="qc-draft-banner">💾 @_draftRestoredAt</div>
    }

    <!-- ═══════════ STEP CONTENT ═══════════ -->
    <div class="qc-body">

        @* ── STEP 0: Product Overview & General Info ── *@
        @if (_currentStepIdx == 0)
        {
            <div class="qc-card">
                <div class="qc-section-title">@T("InspectionQC.ProductOverview")</div>
                @if ((_inspection.ProductPhotoUrls?.Count ?? 0) > 0)
                {
                    @* Thư viện ảnh sản phẩm: ảnh lớn + ảnh nhỏ, bấm để phóng to / chuyển ảnh *@
                    var gal = _inspection.ProductPhotoUrls!;
                    var gi = Math.Min(_galIdx, gal.Count - 1);
                    <div class="qc-gal">
                        <div class="qc-gal-main" @onclick="() => OpenGallery(gi)">
                            <img src="@GetImageUrl(gal[gi])" class="qc-gal-img"/>
                            <span class="qc-gal-zoom">🔍</span>
                            <span class="qc-gal-count">@(gi + 1) / @gal.Count</span>
                        </div>
                        @if (gal.Count > 1)
                        {
                            <div class="qc-gal-thumbs">
                                @for (int gt = 0; gt < gal.Count; gt++)
                                {
                                    var gtc = gt;
                                    <img src="@GetImageUrl(gal[gt])" class="qc-gal-thumb @(gt == gi ? "on" : "")" @onclick="() => _galIdx = gtc"/>
                                }
                            </div>
                        }
                    </div>
                }
                else
                {
                <div class="qc-photo-row">
                    @if (!string.IsNullOrEmpty(_data.Photo1Url))
                    {
                        <div class="qc-photo-box qc-photo-readonly">
                            <img src="@GetImageUrl(_data.Photo1Url)" class="qc-photo-img"/>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_data.Photo2Url))
                    {
                        <div class="qc-photo-box qc-photo-readonly">
                            <img src="@GetImageUrl(_data.Photo2Url)" class="qc-photo-img"/>
                        </div>
                    }
                    @if (string.IsNullOrEmpty(_data.Photo1Url) && string.IsNullOrEmpty(_data.Photo2Url))
                    {
                        <div class="qc-photo-box qc-photo-readonly">
                            <svg width="36" height="36" viewBox="0 0 24 24" fill="none"
                                 stroke="#ccc" stroke-width="1.5" style="margin-bottom:6px">
                                <rect x="3" y="3" width="18" height="18" rx="2"/>
                                <circle cx="8.5" cy="8.5" r="1.5"/>
                                <polyline points="21 15 16 10 5 21"/>
                            </svg>
                            <span style="font-size:12px;color:#bbb">@T("InspectionQC.NoProductPhotoYet")</span>
                        </div>
                    }
                </div>
                }

                <div class="qc-section-title" style="margin-top:18px">@T("Common.GeneralInformation")</div>
                <div class="qc-info-table">
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.CustomerName")</span><span class="qc-info-val">@_inspection.CustomerName</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.CustomerID")</span><span class="qc-info-val">@(_inspection.CustomerId ?? "—")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.VendorName")</span><span class="qc-info-val">@_inspection.VendorName</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.VendorID")</span><span class="qc-info-val">@(_inspection.VendorId ?? "—")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.InspectionLocation")</span>
                        <span class="qc-info-val">@(!string.IsNullOrEmpty(_data.InspectionLocation) ? _data.InspectionLocation : "—")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("InspectionQC.StartTime")</span>
                        <span class="qc-info-val qc-auto">@L.Date(_inspectionStartTime, "dd MMM yyyy hh:mm tt")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("InspectionQC.EndTime")</span>
                        <span class="qc-info-val qc-auto">@(_inspectionEndTime.HasValue ? L.Date(_inspectionEndTime.Value, "dd MMM yyyy hh:mm tt") : "—")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.InspectionType")</span><span class="qc-info-val">@TE("Opt", _inspection.InspectionType)</span></div>
                    <div class="qc-info-row">
                        <span class="qc-info-lbl">@T("Common.AQLSamplingSimulator")</span>
                        <span class="qc-info-val qc-auto">
                            @T("InspectionQC.InspectionLevel", _data.Aql.InspectionLevel ?? "II", _data.Aql.MajorAql ?? "2.5", _data.Aql.MinorAql ?? "4.0")
                        </span>
                    </div>
                    @if (_inspection.References != null && _inspection.References.Count > 0)
                    {
                        <div class="qc-info-row qc-refs-row">
                            <span class="qc-info-lbl">@T("InspectionQC.ReferenceFiles")</span>
                            <div class="qc-refs-list">
                                @foreach (var refItem in _inspection.References)
                                {
                                    <div class="qc-ref-item">
                                        <div class="qc-ref-info">
                                            <div class="qc-ref-text">
                                                <span class="qc-ref-name">@refItem.ReferenceName</span>
                                                @if (!string.IsNullOrEmpty(refItem.FileName))
                                                {
                                                    <span class="qc-ref-fname">@refItem.FileName</span>
                                                }
                                            </div>
                                        </div>
                                        <div class="qc-ref-actions">
                                            @if (!string.IsNullOrEmpty(refItem.FileUrl))
                                            {
                                                <a href="@GetImageUrl(refItem.FileUrl)" target="_blank" rel="noopener"
                                                   class="qc-ref-btn qc-ref-view" title="@T("Common.View")">
                                                    <svg width="13" height="13" viewBox="0 0 20 20" fill="none"
                                                         stroke="currentColor" stroke-width="2">
                                                        <path d="M1 10s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7z"/>
                                                        <circle cx="10" cy="10" r="3"/>
                                                    </svg>
                                                    <span>@T("Common.View")</span>
                                                </a>
                                                <button type="button" class="qc-ref-btn qc-ref-dl"
                                                        @onclick="async () => await DownloadReferenceAsync(refItem)" title="@T("Common.Download")">
                                                    <svg width="13" height="13" viewBox="0 0 20 20" fill="none"
                                                         stroke="currentColor" stroke-width="2"
                                                         stroke-linecap="round" stroke-linejoin="round">
                                                        <path d="M10 3v10M6 9l4 4 4-4"/>
                                                        <path d="M3 17h14"/>
                                                    </svg>
                                                    <span>@T("Common.Download")</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="qc-ref-nofile">@T("Common.NoFile")</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.ProductCategory")</span><span class="qc-info-val">@(_inspection.ProductCategory ?? "—")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.PONumber")</span><span class="qc-info-val">@(_inspection.PoNumber ?? "—")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.ItemNumber")</span><span class="qc-info-val">@(_inspection.ItemNumber ?? "—")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.ProductName")</span><span class="qc-info-val">@(_inspection.ProductName ?? "—")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("InspectionQC.TotalShipmentQty")</span><span class="qc-info-val">@_inspection.TotalShipmentQty</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.TotalCartonBoxes")</span><span class="qc-info-val">@_inspection.TotalCartonBoxes</span></div>
                    @if (!string.IsNullOrWhiteSpace(_inspection.GeneralRemark))
                    {
                        <div class="qc-info-row qc-remark-row qc-remark-row-full">
                            <span class="qc-info-lbl qc-remark-lbl">@T("Common.Remark")</span>
                            <span class="qc-info-val qc-remark-val qc-remark-val-full">@_inspection.GeneralRemark</span>
                        </div>
                    }
                </div>
            </div>
        }

        @* ── STEP 1: Overall Conclusion ── *@
        else if (_currentStepIdx == 1)
        {
            <div class="qc-card">
                <div class="qc-section-title">@T("InspectionQC.OverallConclusion")</div>
                <table class="qc-table">
                    <thead><tr><th>No</th><th>@T("InspectionQC.OverallConclusion")</th><th>@T("InspectionQC.Compliance")</th></tr></thead>
                    <tbody>
                        @foreach (var oc in _data.OverallConclusions)
                        {
                            <tr>
                                <td class="td-center fw-bold">@oc.Letter</td>
                                <td>
                                    <div class="td-label">@TE("Opt", oc.Label)</div>
                                    <div style="font-size:11px;color:#aaa;font-weight:600;margin-top:4px">@T("InspectionQC.Remark2")</div>
                                    <div style="font-size:12px;color:#555;margin-top:2px;min-height:16px">
                                        @(string.IsNullOrEmpty(oc.Remark) ? "—" : oc.Remark)
                                    </div>
                                </td>
                                <td class="td-center">
                                    @{
                                        // Chuẩn hoá: nhận cả "Pass"/"Yes", "Fail"/"No", "NA"/"N/A" (case-insensitive)
                                        var cv = (oc.Compliance ?? "").Trim();
                                        var (bgColor, label) =
                                            (string.Equals(cv, "Pass", StringComparison.OrdinalIgnoreCase) ||
                                             string.Equals(cv, "Yes",  StringComparison.OrdinalIgnoreCase))
                                                ? ("#27ae60", T("Common.Yes"))
                                          : (string.Equals(cv, "Fail", StringComparison.OrdinalIgnoreCase) ||
                                             string.Equals(cv, "No",   StringComparison.OrdinalIgnoreCase))
                                                ? ("#e74c3c", "No")
                                          : (string.Equals(cv, "N/A", StringComparison.OrdinalIgnoreCase) ||
                                             string.Equals(cv, "NA",  StringComparison.OrdinalIgnoreCase))
                                                ? ("#888888", "N/A")
                                          : ("", "");
                                    }
                                    @if (!string.IsNullOrEmpty(bgColor))
                                    {
                                        <span style="background:@bgColor;color:#fff;padding:3px 12px;border-radius:12px;font-size:11px;font-weight:700;white-space:nowrap">
                                            @label
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color:#bbb;font-size:13px">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* ── STEP 2: A. Quantity Conformity ── *@
        else if (_currentStepIdx == 2)
        {
            <div class="qc-card">
                <div class="qc-section-title">@T("InspectionQC.QuantityConformity")</div>
                <div class="qc-info-table">
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("InspectionQC.PONo")</span><span class="qc-info-val">@(_inspection.PoNumber ?? "—")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.ItemNumber")</span><span class="qc-info-val">@(_inspection.ItemNumber ?? "—")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("InspectionQC.ItemPerCarton")</span>
                        <input class="qc-info-input" type="number" @bind="_data.QuantityConformity.ItemPerCarton" placeholder="0"/></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("InspectionQC.ShipmentQty")</span><span class="qc-info-val">@_inspection.TotalShipmentQty</span></div>
                    <div class="qc-info-row">
                        <span class="qc-info-lbl">@T("InspectionQC.AQLQuantity")</span>
                        <span class="qc-info-val qc-auto">
                            @_data.Aql.MajorSampleSize
                            <span style="color:#888;font-weight:400;font-size:12px;margin-left:6px">
                                @T("InspectionQC.LvlLot", _data.Aql.InspectionLevel ?? "II", _data.Aql.Quantity)
                            </span>
                        </span>
                    </div>
                    <div class="qc-info-row" style="flex-direction:column;align-items:flex-start;gap:6px">
                        <span class="qc-info-lbl" style="padding-top:0">@T("InspectionQC.PresentedQtyForInspection") <span style="color:#e74c3c">*</span></span>
                        <div class="qc-split-val">
                            <div class="qc-split-item">
                                <span class="qc-sub-lbl">@T("InspectionQC.Packed") <span style="color:#e74c3c">*</span></span>
                                <input class="qc-info-input sm @(_qtyValidated && (_data.QuantityConformity.PresentedPacked + _data.QuantityConformity.PresentedNotPacked) <= 0 ? "input-error" : "")"
                                       type="number" @bind="_data.QuantityConformity.PresentedPacked" placeholder="0"/>
                            </div>
                            <div class="qc-split-item">
                                <span class="qc-sub-lbl">@T("InspectionQC.NotPacked") <span style="color:#e74c3c">*</span></span>
                                <input class="qc-info-input sm @(_qtyValidated && (_data.QuantityConformity.PresentedPacked + _data.QuantityConformity.PresentedNotPacked) <= 0 ? "input-error" : "")"
                                       type="number" @bind="_data.QuantityConformity.PresentedNotPacked" placeholder="0"/>
                            </div>
                        </div>
                    </div>
                    <div class="qc-info-row" style="flex-direction:column;align-items:flex-start;gap:6px">
                        <span class="qc-info-lbl" style="padding-top:0">@T("InspectionQC.NumberOfCartons") <span style="color:#e74c3c">*</span></span>
                        <div class="qc-split-val">
                            <div class="qc-split-item">
                                <span class="qc-sub-lbl">@T("InspectionQC.Packed") <span style="color:#e74c3c">*</span></span>
                                <input class="qc-info-input sm @(_qtyValidated && (_data.QuantityConformity.CartonsPacked + _data.QuantityConformity.CartonsNotPacked) <= 0 ? "input-error" : "")"
                                       type="number" @bind="_data.QuantityConformity.CartonsPacked" placeholder="0"/>
                            </div>
                            <div class="qc-split-item">
                                <span class="qc-sub-lbl">@T("InspectionQC.NotPacked") <span style="color:#e74c3c">*</span></span>
                                <input class="qc-info-input sm @(_qtyValidated && (_data.QuantityConformity.CartonsPacked + _data.QuantityConformity.CartonsNotPacked) <= 0 ? "input-error" : "")"
                                       type="number" @bind="_data.QuantityConformity.CartonsNotPacked" placeholder="0"/>
                            </div>
                        </div>
                    </div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("InspectionQC.QtyNotFinished") <span style="color:#e74c3c">*</span></span>
                        <input class="qc-info-input @(_qtyValidated && _data.QuantityConformity.QtyNotFinished < 0 ? "input-error" : "")"
                               type="number" @bind="_data.QuantityConformity.QtyNotFinished" placeholder="0"/></div>
                </div>
                @QxPhotos(_data.QuantityConformity.Photos, "A", 1, _qtyValidated)
            </div>
        }

        @* ── STEP 3: B. Packaging & Identification — READONLY từ DB ── *@
        else if (_currentStepIdx == 3)
        {
            <div class="qc-card">
                <div class="qc-section-title">@T("InspectionQC.BPackagingIdentification")</div>
                <div class="qc-info-table">
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.ItemNumber")</span>
                        <span class="qc-info-val">@(string.IsNullOrEmpty(_data.Packaging.ItemNumber) ? (_inspection.ItemNumber ?? "—") : _data.Packaging.ItemNumber)</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.CartonNumber")</span>
                        <span class="qc-info-val">@(string.IsNullOrEmpty(_data.Packaging.CartonNumber) ? "—" : _data.Packaging.CartonNumber)</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("InspectionQC.TypeOfPackaging")</span>
                        <span class="qc-info-val">@(string.IsNullOrEmpty(_data.Packaging.PackagingType) ? "—" : _data.Packaging.PackagingType)</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.ColorOfCarton")</span>
                        <span class="qc-info-val">@(string.IsNullOrEmpty(_data.Packaging.CartonColor) ? "—" : _data.Packaging.CartonColor)</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.TypeOfCardboard")</span>
                        <span class="qc-info-val">@(string.IsNullOrEmpty(_data.Packaging.CardboardType) ? "—" : _data.Packaging.CardboardType)</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.ShippingMark")</span>
                        <span class="qc-info-val">@(string.IsNullOrEmpty(_data.Packaging.ShippingMark) ? "—" : _data.Packaging.ShippingMark)</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.BarcodeQRCode")</span>
                        <span class="qc-info-val">@(_data.Packaging.HasBarcode ? T("Common.Yes") : "No")</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("InspectionQC.InnerPackingQty")</span>
                        <span class="qc-info-val">@_data.Packaging.InnerPackingQty</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("InspectionQC.InnerPackingRemark")</span>
                        <span class="qc-info-val">@(string.IsNullOrEmpty(_data.Packaging.InnerPackingRemark) ? "—" : _data.Packaging.InnerPackingRemark)</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("InspectionQC.OuterPackingMm")</span>
                        <span class="qc-info-val">L: @_data.Packaging.OuterL <br/>W: @_data.Packaging.OuterW <br/> H: @_data.Packaging.OuterH</span></div>
                    <div class="qc-info-row"><span class="qc-info-lbl">@T("Common.WeightKgs")</span>
                        <span class="qc-info-val">@_data.Packaging.OuterWeight</span></div>
                </div>
            </div>
        }

        @* ── STEPS B-i to B-vi: dynamic per carton ── *@
        else if (GetCurrentCartonStep() is var (cartonIdx, bSub) && cartonIdx >= 0
                 && cartonIdx < _data.Packaging.CartonDataList.Count)
        {
            var cd = _data.Packaging.CartonDataList[cartonIdx];
            var cartonLabel = _cartonCount > 1 ? $" — Carton {cd.CartonIndex}" : "";

            @* B-i: Carton Size — bố cục Spec (xanh) / Actual (xanh lá) theo mẫu khách *@
            @if (bSub == 0)
            {
                <div class="qc-card qx-card">
                    <div class="qc-section-title">@T("InspectionQC.BICartonSize", cartonLabel)</div>

                    <div class="qx-panel spec">
                        <div class="qx-panel-t">@T("InspectionQC.CartonSizeSpecification")</div>
                        <div class="qx-panel-s">@T("InspectionQC.TargetCartonSizePerSpecification")</div>
                        <div class="qx-grid c3">
                            <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.LMM")</span><div class="qx-val">@(_data.Packaging.OuterL > 0 ? _data.Packaging.OuterL.ToString() : "—")</div></div>
                            <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.WMM")</span><div class="qx-val">@(_data.Packaging.OuterW > 0 ? _data.Packaging.OuterW.ToString() : "—")</div></div>
                            <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.HMM")</span><div class="qx-val">@(_data.Packaging.OuterH > 0 ? _data.Packaging.OuterH.ToString() : "—")</div></div>
                        </div>
                    </div>

                    <div class="qx-panel actual">
                        <div class="qx-panel-t">@T("InspectionQC.CartonSizeActual")</div>
                        <div class="qx-panel-s">@T("InspectionQC.MeasuredCartonSizeDuringInspection")</div>
                        <div class="qx-grid c4">
                            <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.CartonNo")</span><div class="qx-val no">@cd.CartonIndex</div></div>
                            <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.LMM")</span><input class="qx-in" type="number" inputmode="decimal" @bind="cd.SizeL" placeholder="0"/></div>
                            <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.WMM")</span><input class="qx-in" type="number" inputmode="decimal" @bind="cd.SizeW" placeholder="0"/></div>
                            <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.HMM")</span><input class="qx-in" type="number" inputmode="decimal" @bind="cd.SizeH" placeholder="0"/></div>
                        </div>
                    </div>

                    @QxPhotos(cd.SizePhotos, $"Bsize:{cartonIdx}", 2, _photoValidatedStep == _currentStepIdx)
                </div>
            }

            @* B-ii: Shipping Mark *@
            else if (bSub == 1)
            {
                <div class="qc-card">
                    <div class="qc-section-title">@T("InspectionQC.BIiShippingMarkLabelingBarcode", cartonLabel)</div>
                    @QxPhotos(cd.ShippingMarkPhotos, $"Bsm:{cartonIdx}", 0, false)
                </div>
            }

            @* B-iii: Carton Weight — Spec (xanh) / Actual (xanh lá) theo mẫu khách *@
            else if (bSub == 2)
            {
                <div class="qc-card qx-card">
                    <div class="qc-section-title">@T("InspectionQC.BIiiCartonWeight", cartonLabel)</div>
                    <div class="qx-row">
                        <span class="qx-lbl spec">@T("InspectionQC.SpecWeightKgs")</span>
                        <div class="qx-val">@(_data.Packaging.OuterWeight > 0 ? _data.Packaging.OuterWeight.ToString() : "—")</div>
                    </div>
                    <div class="qx-row">
                        <span class="qx-lbl actual">@T("InspectionQC.ActualWeightKgs")</span>
                        <input class="qx-in actual" type="number" step="0.1" inputmode="decimal" @bind="cd.Weight" placeholder="0.0"/>
                    </div>
                    @QxPhotos(cd.WeightPhotos, $"Bwt:{cartonIdx}", 1, _photoValidatedStep == _currentStepIdx)
                </div>
            }

            @* B-iv: Packaging & Labeling *@
            else if (bSub == 3)
            {
                <div class="qc-card">
                    <div class="qc-section-title">@T("InspectionQC.BIvPackagingLabelingSpecifications", cartonLabel)</div>
                    @QxPhotos(cd.PkgLabelPhotos, $"Bpkg:{cartonIdx}", 0, false)
                </div>
            }

            @* B-v: Assembly Instruction *@
            else if (bSub == 4)
            {
                <div class="qc-card">
                    <div class="qc-section-title">@T("InspectionQC.BVAssemblyInstructionSpecifications", cartonLabel)</div>
                    @{ var asmNA = cd.AssemblyIncluded == "N/A"; }
                    <div class="qc-info-table" style="margin-bottom:12px">
                        <div class="qc-info-row">
                            <span class="qc-info-lbl">@T("InspectionQC.AssemblyInstructionIncluded")</span>
                            <select class="qc-info-input" @bind="cd.AssemblyIncluded">
                                <option value="">—</option>
                                <option value="Yes">@T("Common.Yes")</option>
                                <option value="N/A">N/A</option>
                            </select>
                        </div>
                        @if (asmNA)
                        {
                            <div class="qc-info-row"><span class="qc-info-val" style="color:#888;font-size:12px">@T("InspectionQC.AssemblyAllNA")</span></div>
                        }
                        else
                        {
                            <div class="qc-info-row">
                                <span class="qc-info-lbl">@T("InspectionQC.InstructionType")</span>
                                <select class="qc-info-input" @bind="cd.AssemblyType">
                                    <option value="">—</option>
                                    @foreach (var o in AssemblyTypeOptions) { <option value="@o">@TE("Opt", o)</option> }
                                </select>
                            </div>
                            <div class="qc-info-row">
                                <span class="qc-info-lbl">@T("InspectionQC.Language")</span>
                                <input class="qc-info-input" @bind="cd.AssemblyLanguage"/>
                            </div>
                            <div class="qc-info-row">
                                <span class="qc-info-lbl">@T("InspectionQC.Pages")</span>
                                <input class="qc-info-input" @bind="cd.AssemblyPages" placeholder="@T("InspectionQC.PagesHint")"/>
                            </div>
                            <div class="qc-info-row">
                                <span class="qc-info-lbl">@T("InspectionQC.PrintingQuality")</span>
                                <select class="qc-info-input" @bind="cd.AssemblyPrintQuality">
                                    <option value="">—</option>
                                    @foreach (var o in PrintQualityOptions) { <option value="@o">@TE("Opt", o)</option> }
                                </select>
                            </div>
                            <div class="qc-info-row qc-sub-row" style="flex-direction:column;align-items:flex-start;gap:6px">
                                <span class="qc-info-lbl" style="padding-top:0">@T("Common.Remark")</span>
                                <textarea class="qc-info-textarea qc-remark-textarea" @bind="cd.AssemblyRemark" rows="2" placeholder="@T("InspectionQC.EnterRemark")"></textarea>
                            </div>
                        }
                    </div>
                    @if (!asmNA)
                    {
                    @QxPhotos(cd.AssemblyPhotos, $"Basm:{cartonIdx}", 0, false)
                    }
                </div>
            }

            @* B-vi: Hardware Specifications *@
            else if (bSub == 5)
            {
                <div class="qc-card">
                    <div class="qc-section-title">@T("InspectionQC.BViHardwareSpecifications", cartonLabel)</div>
                    @* HardwareResult = "N/A" → sản phẩm không có hardware, report hiện khung Not Applicable *@
                    <div class="qc-info-table" style="margin-bottom:12px">
                        <div class="qc-info-row">
                            <span class="qc-info-lbl">@T("InspectionQC.HardwareIncluded")</span>
                            <select class="qc-info-input" @bind="cd.HardwareResult">
                                <option value="">—</option>
                                <option value="Yes">@T("Common.Yes")</option>
                                <option value="N/A">@T("InspectionQC.NoHardwareNA")</option>
                            </select>
                        </div>
                    </div>
                    @if (cd.HardwareResult != "N/A")
                    {
                    <div class="qc-info-table" style="margin-bottom:12px">
                        <div class="qc-info-row">
                            <span class="qc-info-lbl">@T("InspectionQC.HardwareQuantity")</span>
                            <input class="qc-info-input" @bind="cd.HardwareQuantity" placeholder="@T("InspectionQC.HardwareQuantityHint")"/>
                        </div>
                        <div class="qc-info-row">
                            <span class="qc-info-lbl">@T("InspectionQC.HardwarePackaging")</span>
                            <select class="qc-info-input" @bind="cd.HardwarePackaging">
                                <option value="">—</option>
                                @foreach (var o in HardwarePackagingOptions) { <option value="@o">@TE("Opt", o)</option> }
                            </select>
                        </div>
                        <div class="qc-info-row">
                            <span class="qc-info-lbl">@T("InspectionQC.QualityOfHardware")</span>
                            <select class="qc-info-input" @bind="cd.HardwareQuality">
                                <option value="">—</option>
                                @foreach (var o in PrintQualityOptions) { <option value="@o">@TE("Opt", o)</option> }
                            </select>
                        </div>
                        <div class="qc-info-row qc-sub-row" style="flex-direction:column;align-items:flex-start;gap:6px">
                            <span class="qc-info-lbl" style="padding-top:0">@T("Common.Remark")</span>
                            <textarea class="qc-info-textarea qc-remark-textarea" @bind="cd.HardwareRemark" rows="2" placeholder="@T("InspectionQC.EnterRemark")"></textarea>
                        </div>
                    </div>
                    @QxPhotos(cd.HardwarePhotos, $"Bhw:{cartonIdx}", 2, _photoValidatedStep == _currentStepIdx)
                    }
                </div>
            }

            @* B-vii: Hangtag Specifications *@
            else if (bSub == 6)
            {
                <div class="qc-card">
                    <div class="qc-section-title">@T("InspectionQC.BViiHangtagSpecifications", cartonLabel)</div>
                    @{ var htNA = cd.HangtagIncluded == "N/A"; }
                    <div class="qc-info-table" style="margin-bottom:12px">
                        <div class="qc-info-row">
                            <span class="qc-info-lbl">@T("InspectionQC.HangtagIncluded")</span>
                            <select class="qc-info-input" @bind="cd.HangtagIncluded">
                                <option value="">—</option>
                                <option value="Yes">@T("Common.Yes")</option>
                                <option value="N/A">N/A</option>
                            </select>
                        </div>
                        @if (htNA)
                        {
                            <div class="qc-info-row"><span class="qc-info-val" style="color:#888;font-size:12px">@T("InspectionQC.AssemblyAllNA")</span></div>
                        }
                        else
                        {
                            <div class="qc-info-row">
                                <span class="qc-info-lbl">@T("InspectionQC.HangtagType")</span>
                                <select class="qc-info-input" @bind="cd.HangtagType">
                                    <option value="">—</option>
                                    @foreach (var o in HangtagTypeOptions) { <option value="@o">@TE("Opt", o)</option> }
                                </select>
                            </div>
                            <div class="qc-info-row">
                                <span class="qc-info-lbl">@T("InspectionQC.HangtagShape")</span>
                                <select class="qc-info-input" @bind="cd.HangtagShape">
                                    <option value="">—</option>
                                    @foreach (var o in HangtagShapeOptions) { <option value="@o">@TE("Opt", o)</option> }
                                </select>
                            </div>
                            <div class="qc-info-row">
                                <span class="qc-info-lbl">@T("InspectionQC.HangtagSizeMM")</span>
                                <input class="qc-info-input" style="width:80px" @bind="cd.HangtagSizeL" placeholder="L"/>
                                <input class="qc-info-input" style="width:80px" @bind="cd.HangtagSizeW" placeholder="W"/>
                            </div>
                            <div class="qc-info-row">
                                <span class="qc-info-lbl">@T("InspectionQC.HangtagMaterial")</span>
                                <input class="qc-info-input" @bind="cd.HangtagMaterial"/>
                            </div>
                            <div class="qc-info-row">
                                <span class="qc-info-lbl">@T("InspectionQC.PrintingQuality")</span>
                                <select class="qc-info-input" @bind="cd.HangtagPrintQuality">
                                    <option value="">—</option>
                                    @foreach (var o in PrintQualityOptions) { <option value="@o">@TE("Opt", o)</option> }
                                </select>
                            </div>
                            <div class="qc-info-row">
                                <span class="qc-info-lbl">@T("InspectionQC.Language")</span>
                                <input class="qc-info-input" @bind="cd.HangtagLanguage"/>
                            </div>
                            <div class="qc-info-row">
                                <span class="qc-info-lbl">@T("InspectionQC.HangtagQuantity")</span>
                                <input class="qc-info-input" @bind="cd.HangtagQuantity"/>
                            </div>
                            <div class="qc-info-row qc-sub-row" style="flex-direction:column;align-items:flex-start;gap:6px">
                                <span class="qc-info-lbl" style="padding-top:0">@T("Common.Remark")</span>
                                <textarea class="qc-info-textarea qc-remark-textarea" @bind="cd.HangtagRemark" rows="2" placeholder="@T("InspectionQC.EnterRemark")"></textarea>
                            </div>
                        }
                    </div>
                    @if (!htNA)
                    {
                    @QxPhotos(cd.HangtagPhotos, $"Bht:{cartonIdx}", 2, _photoValidatedStep == _currentStepIdx)
                    }
                </div>
            }
        }

        @* ── C-i Product Size: step index = 4 + cartonCount*7 ── *@
        @* Bố cục theo mẫu khách 17/11/2026 ("Better Design"): Spec (xanh) → Actual (xanh lá) → Result → Remark → Photos *@
        else if (_currentStepIdx == 4 + _cartonCount * B_STEPS_PER_CARTON)
        {
            var psSpec = _inspection?.ProductSpec;
            <div class="qc-card qx-card">
                <div class="qc-section-title">@T("InspectionQC.CIProductSize")</div>

                <div class="qx-panel spec">
                    <div class="qx-panel-t">@T("InspectionQC.ProductSizeSpecification")</div>
                    <div class="qx-panel-s">@T("InspectionQC.TargetSizePerSpecification")</div>
                    <div class="qx-grid c3">
                        <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.LMM")</span><div class="qx-val">@((psSpec?.SizeL ?? 0) > 0 ? psSpec!.SizeL.ToString() : "—")</div></div>
                        <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.WMM")</span><div class="qx-val">@((psSpec?.SizeW ?? 0) > 0 ? psSpec!.SizeW.ToString() : "—")</div></div>
                        <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.HMM")</span><div class="qx-val">@((psSpec?.SizeH ?? 0) > 0 ? psSpec!.SizeH.ToString() : "—")</div></div>
                    </div>
                </div>

                <div class="qx-panel actual">
                    <div class="qx-panel-t">@T("InspectionQC.ProductSizeActual")</div>
                    <div class="qx-panel-s">@T("InspectionQC.MeasuredSizeDuringInspection")</div>
                    <div class="qx-grid c3">
                        <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.LMM")</span><input class="qx-in" type="number" inputmode="decimal" @bind="_data.ProductSpec.SpecL" placeholder="0"/></div>
                        <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.WMM")</span><input class="qx-in" type="number" inputmode="decimal" @bind="_data.ProductSpec.SpecW" placeholder="0"/></div>
                        <div class="qx-cell"><span class="qx-chip">@T("InspectionQC.HMM")</span><input class="qx-in" type="number" inputmode="decimal" @bind="_data.ProductSpec.SpecH" placeholder="0"/></div>
                    </div>
                </div>

                <div class="qx-row">
                    <span class="qx-lbl res">@T("Common.Result")</span>
                    <select class="qx-sel @ResCls(_data.ProductSpec.SizeResult)" @bind="_data.ProductSpec.SizeResult">
                        <option value="">—</option>
                        <option value="Pass">✓ @T("InspectionQC.Pass")</option>
                        <option value="Fail">✕ @T("InspectionQC.Fail")</option>
                    </select>
                </div>

                <div class="qx-field">
                    <span class="qx-field-t">@T("Common.Remark")</span>
                    <textarea class="qx-ta" rows="3" @bind="_data.ProductSpec.SizeRemark" placeholder="@T("InspectionQC.EnterRemark")"></textarea>
                </div>

                @QxPhotos(_data.ProductSpec.SizePhotos, "Csize", 2, _sizeValidated)
            </div>
        }
        else if (_currentStepIdx == 5 + _cartonCount * B_STEPS_PER_CARTON)
        {
            @* ── C-ii Product Weight: step riêng (tách khỏi Product Size) ── *@
            <div class="qc-card qx-card">
                <div class="qc-section-title">@T("InspectionQC.CIiProductWeight")</div>
                <div class="qx-row">
                    <span class="qx-lbl spec">@T("InspectionQC.SpecWeightKgs")</span>
                    <div class="qx-val">@((_inspection?.ProductSpec?.Weight ?? 0) > 0 ? _inspection!.ProductSpec!.Weight.ToString() : "—")</div>
                </div>
                <div class="qx-row">
                    <span class="qx-lbl actual">@T("InspectionQC.ActualWeightKgs")</span>
                    <input class="qx-in actual" type="number" step="0.1" inputmode="decimal" @bind="_data.ProductSpec.ProductWeight" placeholder="0.0"/>
                </div>
                <div class="qx-row">
                    <span class="qx-lbl res">@T("Common.Result")</span>
                    <select class="qx-sel @ResCls(_data.ProductSpec.ProductWeightResult)" @bind="_data.ProductSpec.ProductWeightResult">
                        <option value="">—</option>
                        <option value="Pass">✓ @T("InspectionQC.Pass")</option>
                        <option value="Fail">✕ @T("InspectionQC.Fail")</option>
                        <option value="N/A">N/A</option>
                    </select>
                </div>
                @QxPhotos(_data.ProductSpec.ProductWeightPhotos, "Pwt", 1, _photoValidatedStep == _currentStepIdx)
            </div>
        }

        else if (_currentStepIdx == 6 + _cartonCount * B_STEPS_PER_CARTON)
        {
            <div class="qc-card">
                <div class="qc-section-title">@T("InspectionQC.CIiGoldenSampleCompare")</div>
                <div class="qc-info-table" style="margin-bottom:12px">
                    <div class="qc-info-row">
                        <span class="qc-info-lbl">@T("InspectionQC.InspectionQuantityPcs")</span>
                        <input class="qc-info-input" type="number" min="0" @bind="_data.ProductSpec.GoldenQty" placeholder="0"/>
                    </div>
                    <div class="qc-info-row qc-sub-row" style="flex-direction:column;align-items:flex-start;gap:6px">
                        <span class="qc-info-lbl" style="padding-top:0">@T("Common.Remark")</span>
                        <textarea class="qc-info-textarea qc-remark-textarea" @bind="_data.ProductSpec.GoldenRemark" rows="3" placeholder="@T("InspectionQC.EnterRemark")"></textarea>
                    </div>
                    <div class="qc-info-row">
                        <span class="qc-info-lbl">@T("Common.Result")</span>
                        <select class="qc-info-input" @bind="_data.ProductSpec.GoldenResult">
                            <option value="">—</option>
                            <option value="Pass">@T("InspectionQC.Pass")</option>
                            <option value="Fail">@T("InspectionQC.Fail")</option>
                        </select>
                    </div>
                </div>
                @QxPhotos(_data.ProductSpec.GoldenPhotos, "Gold", 2, _goldenValidated)
            </div>
        }

        else if (_currentStepIdx == 7 + _cartonCount * B_STEPS_PER_CARTON)
        {
            <div class="qc-card">
                <div class="qc-section-title">@T("InspectionQC.CIiiColourSwatchComparison")</div>
                <!-- Material readonly từ DB InspectionColourSwatches -->
                <table class="qc-table qc-stack-swatch">
                    <thead><tr><th>No</th><th>@T("Common.Material")</th><th>@T("Common.Remark")</th><th>@T("Common.Result")</th></tr></thead>
                    <tbody>
                        @foreach (var cs in _data.ProductSpec.ColourSwatches)
                        {
                            <tr>
                                <td class="td-center fw-bold">@cs.No</td>
                                <td>
                                    <span class="qc-info-val" style="font-size:13px">
                                        @(string.IsNullOrEmpty(cs.Material) ? "—" : cs.Material)
                                    </span>
                                </td>
                                <td>
                                    <textarea class="qc-cell-input qc-remark-cell" @bind="cs.Remark" rows="2" placeholder="@T("InspectionQC.Remark")"></textarea>
                                </td>
                                <td>
                                    <select class="qc-select-sm" @bind="cs.Result">
                                        <option value="">—</option>
                                        <option value="Passed">@T("InspectionQC.Passed")</option>
                                        <option value="Failed">@T("Common.Failed")</option>
                                        <option value="N/A">N/A</option>
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <!-- Photos — bắt buộc tối thiểu 2 hình -->
                @QxPhotos(_data.ProductSpec.SwatchPhotos, "Swt", 2, _swatchValidated)
            </div>
        }

        @* ── D. Performance Testing — mỗi test = 1 step ── *@
        else if (_currentStepIdx >= 8 + _cartonCount * B_STEPS_PER_CARTON &&
                 _currentStepIdx <  8 + _cartonCount * B_STEPS_PER_CARTON + Math.Max(1, _data.PerformanceTests.Count))
        {
            var dIdx = _currentStepIdx - (8 + _cartonCount * B_STEPS_PER_CARTON);
            @if (_data.PerformanceTests.Any() && dIdx < _data.PerformanceTests.Count)
            {
                var pt = _data.PerformanceTests[dIdx];
                var ptValidated = dIdx < _perfValidated.Length && _perfValidated[dIdx];
                @* Theo mẫu khách: nhãn dạng chip, thêm ô Result, Remark rộng (textarea) *@
                <div class="qc-card qx-card">
                    <div class="qc-section-title">@T("InspectionQC.DPerformanceTesting")</div>
                    <div class="qx-field">
                        <span class="qx-chip blk">@T("Common.TestItem")</span>
                        <div class="qx-text strong">@pt.TestItem</div>
                    </div>
                    <div class="qx-field">
                        <span class="qx-chip blk">@T("Common.TestProtocol")</span>
                        <div class="qx-text">
                            @if (string.IsNullOrEmpty(pt.TestProtocol))
                            {
                                <span style="color:#bbb">—</span>
                            }
                            else
                            {
                                <button class="proto-view-btn" @onclick="() => ShowProtocolPopup(pt.TestProtocol)">
                                    <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                        <path d="M1 10s3.5-7 9-7 9 7 9 7-3.5 7-9 7-9-7-9-7z"/><circle cx="10" cy="10" r="3"/>
                                    </svg>
                                    @T("Common.View")
                                </button>
                            }
                        </div>
                    </div>
                    <div class="qx-field">
                        <span class="qx-chip blk">@T("Common.TestRequirement")</span>
                        <div class="qx-text">@pt.TestRequirement</div>
                    </div>
                    <div class="qx-field">
                        <span class="qx-chip blk">@T("InspectionQC.TestQuantity")</span>
                        <input class="qx-in left qty" type="number" inputmode="numeric" @bind="pt.TestQuantity" placeholder="0"/>
                    </div>
                    <div class="qx-row">
                        <span class="qx-lbl res">@T("Common.Result")</span>
                        <select class="qx-sel @ResCls(pt.Result)" @bind="pt.Result">
                            <option value="">—</option>
                            <option value="Pass">✓ @T("InspectionQC.Pass")</option>
                            <option value="Fail">✕ @T("InspectionQC.Fail")</option>
                            <option value="N/A">N/A</option>
                        </select>
                    </div>
                    <div class="qx-field">
                        <span class="qx-chip blk">@T("Common.Remark")</span>
                        <textarea class="qx-ta" rows="5" @bind="pt.Remark" placeholder="@T("InspectionQC.EnterRemark")"></textarea>
                    </div>
                    @QxPhotos(pt.Photos, $"Perf:{dIdx}", 2, ptValidated)
                </div>
            }
            else
            {
                <div class="qc-card">
                    <div class="qc-section-title">@T("InspectionQC.DPerformanceTesting")</div>
                    <div class="qc-empty-msg">@T("InspectionQC.NoPerformanceTestsConfigured")</div>
                </div>
            }
        }

        @* ── E. Appearance & Craftsmanship (AQL) ── *@
        else if (_currentStepIdx == 8 + _cartonCount * B_STEPS_PER_CARTON + Math.Max(1, _data.PerformanceTests.Count))
        {
            <div class="qc-card">
                <div class="qc-section-title">@T("InspectionQC.EAppearanceCraftsmanship")</div>
                <div class="qc-aql-header">@T("Common.AQLSamplingSimulator")</div>
                <div class="qc-aql-row">
                    <div class="qc-aql-item">
                        <label class="qc-aql-lbl">@T("Common.Quantity")</label>
                        <input class="qc-aql-input" type="number" @bind="_data.Aql.Quantity"
                               @bind:event="oninput" @bind:after="() => { RecalcAql(); return Task.CompletedTask; }"/>
                    </div>
                    <div class="qc-aql-item">
                        <label class="qc-aql-lbl">@T("Common.InspectionLevel")</label>
                        <select class="qc-aql-input" @bind="_data.Aql.InspectionLevel"
                                @bind:after="() => { RecalcAql(); return Task.CompletedTask; }">
                            <option value="I">I</option>
                            <option value="II">@T("InspectionQC.II")</option>
                            <option value="III">@T("InspectionQC.III")</option>
                            <option value="S1">@T("Common.S1")</option>
                            <option value="S2">@T("Common.S2")</option>
                            <option value="S3">@T("Common.S3")</option>
                            <option value="S4">@T("Common.S4")</option>
                        </select>
                    </div>
                </div>
                <div class="qc-aql-cols">
                    @foreach (var dc in new[]{ ("Critical", "aql-critical"), ("Major", "aql-major"), ("Minor", "aql-minor") })
                    {
                        var (label, cls) = dc;
                        var aqlSel = label == "Critical" ? _data.Aql.CriticalAql : label == "Major" ? _data.Aql.MajorAql : _data.Aql.MinorAql;
                        var sample = label == "Critical" ? _data.Aql.CriticalSampleSize : label == "Major" ? _data.Aql.MajorSampleSize : _data.Aql.MinorSampleSize;
                        var accept = label == "Critical" ? _data.Aql.CriticalAccept : label == "Major" ? _data.Aql.MajorAccept : _data.Aql.MinorAccept;
                        var reject = label == "Critical" ? _data.Aql.CriticalReject : label == "Major" ? _data.Aql.MajorReject : _data.Aql.MinorReject;
                        <div class="qc-aql-col @cls">
                            <div class="qc-aql-col-title">@T("InspectionQC.Defects", label)</div>
                            <div class="qc-aql-field">
                                <label>@T("Common.SelectAQL")</label>
                                <select class="qc-aql-sm" value="@aqlSel" @onchange="e => SetAql(label, e.Value?.ToString() ?? string.Empty)">
                                    <option value="Not Allowed">@T("Common.NotAllowed")</option>
                                    <option value="0.065">0.065</option>
                                    <option value="0.1">0.1</option>
                                    <option value="0.15">0.15</option>
                                    <option value="0.25">0.25</option>
                                    <option value="0.40">0.40</option>
                                    <option value="0.65">0.65</option>
                                    <option value="1.0">1.0</option>
                                    <option value="1.5">1.5</option>
                                    <option value="2.5">2.5</option>
                                    <option value="4.0">4.0</option>
                                    <option value="6.5">6.5</option>
                                </select>
                            </div>
                            <div class="qc-aql-stat"><span>@T("InspectionQC.SampleSize")</span><span>@sample</span></div>
                            <div class="qc-aql-stat"><span>@T("InspectionQC.AcceptPoint")</span><span>@accept</span></div>
                            <div class="qc-aql-stat red-stat"><span>@T("InspectionQC.RejectPoint")</span><span>@reject</span></div>
                        </div>
                    }
                </div>
                <div class="qc-section-title" style="margin-top:18px">@T("InspectionQC.RESULT")</div>
                <table class="qc-table">
                    <thead><tr><th>@T("InspectionQC.DetailsOfDefectFound")</th><th>@T("Common.Critical")</th><th>@T("Common.Major")</th><th>@T("Common.Minor")</th></tr></thead>
                    <tbody>
                        <tr>
                            <td>@T("InspectionQC.TotalFound")</td>
                            <td><input class="qc-cell-input num qc-cell-auto" type="number"
                                       value="@_data.Aql.CriticalFound" readonly tabindex="-1" /></td>
                            <td><input class="qc-cell-input num qc-cell-auto" type="number"
                                       value="@_data.Aql.MajorFound"    readonly tabindex="-1" /></td>
                            <td><input class="qc-cell-input num qc-cell-auto" type="number"
                                       value="@_data.Aql.MinorFound"    readonly tabindex="-1" /></td>
                        </tr>
                        <tr>
                            <td>@T("Common.Status")</td>
                            <td class="@(_data.Aql.CriticalFound > _data.Aql.CriticalAccept ? "cell-fail" : "cell-pass")">
                                @(_data.Aql.CriticalFound > _data.Aql.CriticalAccept ? "FAIL" : "PASS")</td>
                            <td class="@(_data.Aql.MajorFound > _data.Aql.MajorAccept ? "cell-fail" : "cell-pass")">
                                @(_data.Aql.MajorFound > _data.Aql.MajorAccept ? "FAIL" : "PASS")</td>
                            <td class="@(_data.Aql.MinorFound > _data.Aql.MinorAccept ? "cell-fail" : "cell-pass")">
                                @(_data.Aql.MinorFound > _data.Aql.MinorAccept ? "FAIL" : "PASS")</td>
                        </tr>
                    </tbody>
                </table>
                <div class="qc-info-table" style="margin-top:14px">
                    <div class="qc-info-row">
                        <span class="qc-info-lbl">@T("Common.Result")</span>
                        <select class="qc-info-input" @bind="_data.Aql.Result">
                            <option value="">—</option>
                            <option value="Pass">@T("InspectionQC.Pass")</option>
                            <option value="Fail">@T("InspectionQC.Fail")</option>
                        </select>
                    </div>
                </div>
            </div>
        }

        @* ── F. Details of Defect Found (1 step gộp cả Critical/Major/Minor) ── *@
        else if (_currentStepIdx == 9 + _cartonCount * B_STEPS_PER_CARTON + Math.Max(1, _data.PerformanceTests.Count))
        {
            <div class="qc-card">
                <div class="qc-section-title">@T("InspectionQC.FDetailsOfDefectFound")</div>

                <!-- ── FORM TRÊN: dropdown type + capture + remark + Add ── -->
                <div class="qc-defect-form">
                    <div class="qc-defect-form-row">
                        <div class="qc-defect-field" style="flex:0 0 140px">
                            <label class="qc-defect-lbl">@T("InspectionQC.Type")</label>
                            <select class="qc-select" @bind="_newDefectType">
                                <option value="Critical">@T("Common.Critical")</option>
                                <option value="Major">@T("Common.Major")</option>
                                <option value="Minor">@T("Common.Minor")</option>
                            </select>
                        </div>
                        <div class="qc-defect-field" style="flex:0 0 110px">
                            <label class="qc-defect-lbl">@T("InspectionQC.Capture")</label>
                            <label class="qc-defect-capture-box">
                                @if (!string.IsNullOrEmpty(_uploadingKey) && _uploadingKey == "NewDefect")
                                {
                                    <div class="qc-photo-spinner"><div class="qc-spinner-ring"></div></div>
                                }
                                else if (!string.IsNullOrEmpty(_newDefectPhoto))
                                {
                                    <img src="@GetImageUrl(_newDefectPhoto)" class="qc-photo-img"
                                         style="width:100%;height:100%;object-fit:cover"/>
                                    <button class="qc-defect-capture-clear"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => { _newDefectPhoto = string.Empty; StateHasChanged(); }">✕</button>
                                }
                                else
                                {
                                    <span style="font-size:24px;color:#c0cce0">📷</span>
                                }
                                <InputFile OnChange="HandleNewDefectPhoto"
                                           accept="image/*" capture="environment"
                                           style="display:none;position:absolute;inset:0"/>
                            </label>
                        </div>
                        <div class="qc-defect-field" style="flex:0 0 200px">
                            <label class="qc-defect-lbl">@T("InspectionQC.Defect")</label>
                            <select class="qc-select" @bind="_newDefectCode">
                                <option value="">@T("InspectionQC.SelectDefect")</option>
                                @foreach (var dc in InticooInspection.Client.Shared.DefectCodes.All)
                                { <option value="@dc.Code">@dc.Code @InticooInspection.Client.Shared.DefectCodes.LocalName(dc.Name)</option> }
                            </select>
                        </div>
                        <div class="qc-defect-field" style="flex:1 1 auto;min-width:160px">
                            <label class="qc-defect-lbl">@T("Common.Remark")</label>
                            <input type="text" class="qc-input" placeholder="@T("InspectionQC.DefectRemark")"
                                   @bind="_newDefectRemark" @bind:event="oninput"/>
                        </div>
                        <div class="qc-defect-field" style="flex:0 0 auto;align-self:flex-end">
                            <button class="qc-defect-add-btn" @onclick="AddDefectRow"
                                    disabled="@(string.IsNullOrEmpty(_newDefectPhoto) || string.IsNullOrEmpty(_newDefectCode))">
                                @T("InspectionQC.Add")
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ── BẢNG defects đã thêm ── -->
                @{
                    var allDefects = _data.Defects
                        .Where(d => !string.IsNullOrEmpty(d.Photos.FirstOrDefault()))
                        .ToList();
                }
                @if (allDefects.Any())
                {
                    <table class="qc-defect-table">
                        <thead>
                            <tr>
                                <th style="width:40px">No</th>
                                <th style="width:110px">@T("InspectionQC.AQLSampling")</th>
                                <th style="width:150px">@T("InspectionQC.Defect")</th>
                                <th>@T("InspectionQC.Photos")</th>
                                <th>@T("Common.Remark")</th>
                                <th style="width:60px">@T("Common.Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int idx = 0; idx < allDefects.Count; idx++)
                            {
                                var dRow = allDefects[idx];
                                var rowNo = idx + 1;
                                var typeColor = dRow.Type == "Critical" ? "#e74c3c"
                                              : dRow.Type == "Major"    ? "#e67e22"
                                              : "#3498db";
                                var photoUrl = dRow.Photos.FirstOrDefault() ?? "";
                                var remarkTxt = dRow.Remarks.FirstOrDefault() ?? "";
                                <tr>
                                    <td class="tc">@rowNo</td>
                                    <td>
                                        <span class="qc-defect-type-badge" style="background:@typeColor">
                                            @dRow.Type
                                        </span>
                                    </td>
                                    <td class="qc-defect-row-remark">@InticooInspection.Client.Shared.DefectCodes.Label(dRow.DefectCode)</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(photoUrl))
                                        {
                                            <img src="@GetImageUrl(photoUrl)" class="qc-photo-img qc-defect-row-img"
                                                 alt="@T("InspectionQC.DefectPhoto")"/>
                                        }
                                    </td>
                                    <td class="qc-defect-row-remark">@remarkTxt</td>
                                    <td class="tc">
                                        <button class="qc-defect-row-del" title="@T("InspectionQC.Remove")"
                                                @onclick="() => RemoveDefectRow(dRow)">✕</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="qc-defect-empty">@T("InspectionQC.NoDefectsAddedYetUseForm")</div>
                }
            </div>
        }

        @* ── Step: Inspector Comments & Final Result (bố cục theo mẫu khách) ── *@
        else if (_currentStepIdx == 10 + _cartonCount * B_STEPS_PER_CARTON + Math.Max(1, _data.PerformanceTests.Count))
        {
            <div class="qc-card qx-card">
                <div class="qx-h2">@T("InspectionQC.InspectorComments")</div>
                <div class="qx-ta-wrap">
                    <textarea class="qx-ta" rows="5" maxlength="500" @bind="_data.InspectorComments" @bind:event="oninput"
                              placeholder="@T("InspectionQC.EnterComments")"></textarea>
                    <span class="qx-ta-cnt">@((_data.InspectorComments ?? "").Length) / 500</span>
                </div>

                <div class="qx-sep"></div>

                <div class="qx-h2">@T("InspectionQC.FinalResultTitle")</div>
                <div class="qx-h2-sub">@T("InspectionQC.SelectTheInspectionResult")
                    @if (_finalValidated && string.IsNullOrEmpty(_data.FinalResult))
                    {
                        <span class="qx-err"> · @T("InspectionQC.PleaseSelectResult")</span>
                    }
                </div>
                <div class="qx-final">
                    @foreach (var r in new[]{"PASSED","FAILED","N/A"})
                    {
                        var rr = r;
                        var cls = r == "PASSED" ? "pass" : r == "FAILED" ? "fail" : "na";
                        <button type="button" class="qx-fr @cls @(_data.FinalResult == rr ? "on" : "")" @onclick="() => _data.FinalResult = rr">
                            <span class="qx-fr-radio">@(_data.FinalResult == rr ? "✓" : "")</span>
                            <span class="qx-fr-ico">
                                @if (rr == "PASSED") { <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 12.5l4 4 8-9"/></svg> }
                                else if (rr == "FAILED") { <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M7 7l10 10M17 7L7 17"/></svg> }
                                else { <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round"><path d="M6 12h12"/></svg> }
                            </span>
                            <span class="qx-fr-lbl">@TE("Opt", rr)</span>
                        </button>
                    }
                </div>
            </div>
        }

        @* ── Step: Compliance & Signature ── *@
        else if (_currentStepIdx == 11 + _cartonCount * B_STEPS_PER_CARTON + Math.Max(1, _data.PerformanceTests.Count))
        {
            <div class="qc-card">
                <!-- Logo -->
                <!-- <div class="qc-logo-row" style="margin-bottom:14px">
                    <svg width="28" height="28" viewBox="0 0 32 32" fill="none">
                        <polygon points="16,2 28,9 28,23 16,30 4,23 4,9" fill="#2D7DD2" opacity="0.85"/>
                        <polygon points="16,6 25,11 25,21 16,26 7,21 7,11" fill="#1a5fa8"/>
                        <rect x="13" y="10" width="6" height="12" rx="1" fill="white" opacity="0.9"/>
                        <rect x="10" y="13" width="12" height="6" rx="1" fill="white" opacity="0.6"/>
                    </svg>
                    <span class="qc-logo-text">inticoo</span>
                </div> -->

                <!-- Compliance clause -->
                <div style="margin-bottom:14px;padding:12px;background:#fffbf0;border-left:3px solid #e67e22;border-radius:0 8px 8px 0">
                    <div style="font-size:13px;font-weight:700;color:#e67e22;margin-bottom:6px">@T("InspectionQC.ComplianceIntegrityClause")</div>
                    <p style="font-size:12px;color:#555;line-height:1.6;margin:0;font-style:italic">
                        @T("InspectionQC.AllInspectionsFollowCustomerProtocolAnd")
                    </p>
                </div>

                <!-- Bảng Inspection by / Confirmed by theo mẫu PDF -->
                <table class="qc-table">
                    <tbody>
                        <tr>
                            <td style="width:35%;font-weight:700;color:#1a1a2e;padding:12px 8px;vertical-align:top">@T("InspectionQC.InspectionBy")</td>
                            <td style="padding:10px 8px">
                                <div style="color:#e74c3c;font-size:12px;font-weight:600;margin-bottom:4px">@T("InspectionQC.Auto")</div>
                                <div style="font-size:13px;font-weight:600;color:#1a1a2e">@_inspection.InspectorName</div>
                                @if (!string.IsNullOrEmpty(_inspection.InspectorId))
                                {
                                    <div style="font-size:12px;color:#888;margin-top:2px">ID: @_inspection.InspectorId</div>
                                }
                            </td>
                        </tr>
                        <tr>
                            <td colspan="2" style="padding:10px 8px">
                                <div style="font-weight:700;color:#1a1a2e;margin-bottom:10px">@T("InspectionQC.ConfirmedBy")</div>
                                @if (!string.IsNullOrEmpty(_data.SignatureUrl))
                                {
                                    <img src="@GetImageUrl(_data.SignatureUrl)" style="max-height:120px;object-fit:contain;display:block;width:100%;border:1px dashed #b0c8f0;border-radius:8px;background:#f8faff"/>
                                    <button style="margin-top:8px;background:#fee;color:#e74c3c;border:none;border-radius:5px;padding:6px 14px;font-size:12px;cursor:pointer"
                                            @onclick="() => _data.SignatureUrl = string.Empty">@T("InspectionQC.KLI")</button>
                                }
                                else
                                {
                                    @if (_sigValidated)
                                    {
                                        <div style="color:#e74c3c;font-size:11px;font-weight:600;margin-bottom:6px">@T("InspectionQC.SignatureIsRequired")</div>
                                    }
                                    <div style="color:#e74c3c;font-size:12px;font-weight:600;margin-bottom:8px">@T("InspectionQC.AddSignature")</div>
                                    <!-- Canvas ký tay full width -->
                                    <canvas id="sig-canvas"
                                            style="border:1.5px dashed #b0c8f0;border-radius:10px;background:#f8faff;
                                                   touch-action:none;display:block;width:100%;height:180px;">
                                    </canvas>
                                    <div style="display:flex;gap:8px;margin-top:10px">
                                        <button style="flex:1;background:#2D7DD2;color:#fff;border:none;border-radius:8px;padding:10px 0;font-size:13px;font-weight:600;cursor:pointer"
                                                @onclick="SaveSignature">@T("InspectionQC.SaveSignature")</button>
                                        <button style="background:#f0f3f8;color:#555;border:none;border-radius:8px;padding:10px 18px;font-size:13px;cursor:pointer"
                                                @onclick="ClearCanvas">@T("InspectionQC.Clear")</button>
                                    </div>
                                }
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }

    </div><!-- end qc-body -->

    <!-- BOTTOM NAV BUTTONS -->
    <div class="qc-nav-bar">
        <button class="qc-nav-btn btn-back" @onclick="HandleBack">@T("Common.Back")</button>
        <button class="qc-nav-btn btn-draft @(_savingDraft ? "saving" : "")" @onclick="SaveDraft"
                disabled="@(_saving || _savingDraft)" title="@T("InspectionQC.SaveYourProgressAndContinueLater")">
            @(_savingDraft ? T("InspectionQC.Saving") : T("InspectionQC.SaveDraft"))
        </button>
        @if (CurrentStep.CanSkip)
        {
            <button class="qc-nav-btn btn-skip" @onclick="SkipStep">@T("InspectionQC.Skip")</button>
        }
        @if (_currentStepIdx == _steps.Count - 1)
        {
            <button class="qc-nav-btn btn-review @(_loadingReview ? "saving" : "")"
                    @onclick="OpenReview" disabled="@(_saving || _loadingReview)">
                @(_loadingReview ? T("InspectionQC.Loading") : T("InspectionQC.Review"))
            </button>
            <button class="qc-nav-btn btn-done @(_saving ? "saving" : "")" @onclick="SaveAndDone" disabled="@_saving">
                @(_saving ? T("InspectionQC.Saving") : T("InspectionQC.Done"))
            </button>
        }
        else
        {
            <button class="qc-nav-btn btn-next" @onclick="HandleNext">@T("InspectionQC.Next")</button>
        }
    </div>

    <!-- SAVE STATUS TOAST -->
    @if (!string.IsNullOrEmpty(_saveMsg))
    {
        <div class="qc-toast @(_saveError ? "toast-err" : "toast-ok")">@_saveMsg</div>
    }

    <!-- TEST PROTOCOL POPUP -->
    @if (_showProtocolPopup)
    {
        <div class="proto-backdrop" @onclick="CloseProtocolPopup">
            <div class="proto-modal" @onclick:stopPropagation="true">
                <div class="proto-modal-header">
                    <span class="proto-modal-title">@T("Common.TestProtocol")</span>
                    <button class="proto-close-btn" @onclick="CloseProtocolPopup">✕</button>
                </div>
                <div class="proto-modal-body">
                    @_protocolPopupText
                </div>
                <div class="proto-modal-footer">
                    <button class="proto-ok-btn" @onclick="CloseProtocolPopup">@T("Common.Close")</button>
                </div>
            </div>
        </div>
    }

    <!-- REMARK POPUP -->
    @if (_showRemarkPopup)
    {
        <div class="proto-backdrop" @onclick="CloseRemarkPopup">
            <div class="proto-modal qc-remark-modal" @onclick:stopPropagation="true">
                <div class="proto-modal-header qc-remark-modal-header">
                    <span class="proto-modal-title">@T("Common.Remark")</span>
                    <button class="proto-close-btn" @onclick="CloseRemarkPopup">✕</button>
                </div>
                <div class="proto-modal-body qc-remark-modal-body">
                    @_remarkPopupText
                </div>
                <div class="proto-modal-footer">
                    <button class="proto-ok-btn" @onclick="CloseRemarkPopup">@T("Common.Close")</button>
                </div>
            </div>
        </div>
    }

    <!-- IMAGE VIEWER POPUP (xem hình vừa chụp / đã upload) -->
    @if (_showImagePopup)
    {
        <div class="qc-img-backdrop" @onclick="CloseImagePopup">
            <button class="qc-img-close-btn" @onclick="CloseImagePopup"
                    @onclick:stopPropagation="true" aria-label="@T("Common.Close")">✕</button>
            <img src="@_imagePopupUrl" class="qc-img-preview"
                 @onclick:stopPropagation="true" alt="@T("InspectionQC.Preview")" />
        </div>
    }

    <!-- REVIEW REPORT MODAL — full-screen iframe trỏ đến /inspection-report/{id} -->
    @if (_showReviewModal)
    {
        <div class="qc-review-backdrop">
            <div class="qc-review-toolbar">
                <span class="qc-review-title">@T("InspectionQC.PreviewReportDraft")</span>
                <button class="qc-review-close-btn" @onclick="CloseReview" aria-label="@T("Common.Close")">@T("InspectionQC.Close")</button>
            </div>
            <div class="qc-review-frame-wrap">
                <iframe src="@_reviewUrl" class="qc-review-frame" title="@T("InspectionQC.InspectionReportPreview")"></iframe>
            </div>
        </div>
    }

    <!-- EXIT CONFIRM DIALOG — nhãn nút cố định OK / Cancel -->
    @if (_galOpen && (_inspection?.ProductPhotoUrls?.Count ?? 0) > 0)
    {
        <div class="qc-lb" @onclick="CloseGallery">
            <div class="qc-lb-box" @onclick:stopPropagation="true">
                <div class="qc-lb-head">
                    <span>@T("InspectionQC.ProductPhoto") @(_galIdx + 1) / @_inspection!.ProductPhotoUrls!.Count</span>
                    <button class="qc-lb-x" @onclick="CloseGallery">✕</button>
                </div>
                <div class="qc-lb-body">
                    <img src="@GetImageUrl(_inspection.ProductPhotoUrls[_galIdx])" style="width:@(_galZoom)%"/>
                    @if (_inspection.ProductPhotoUrls.Count > 1)
                    {
                        <button class="qc-lb-nav l" @onclick="() => GalStep(-1)">‹</button>
                        <button class="qc-lb-nav r" @onclick="() => GalStep(1)">›</button>
                    }
                </div>
                <div class="qc-lb-foot">
                    <button @onclick="() => _galZoom = Math.Max(100, _galZoom - 25)">−</button>
                    <input type="range" min="100" max="400" step="25" @bind="_galZoom" @bind:event="oninput"/>
                    <button @onclick="() => _galZoom = Math.Min(400, _galZoom + 25)">+</button>
                    <button @onclick="() => _galZoom = 100">↺</button>
                </div>
            </div>
        </div>
    }

    @if (_showExitConfirm)
    {
        <div class="proto-backdrop" @onclick="CancelExit">
            <div class="proto-modal qc-exit-modal" @onclick:stopPropagation="true">
                <div class="proto-modal-header">
                    <span class="proto-modal-title">@T("InspectionQC.ExitInspection")</span>
                    <button class="proto-close-btn" @onclick="CancelExit">✕</button>
                </div>
                <div class="proto-modal-body">@T("InspectionQC.AreYouSureYouWantTo")</div>
                <div class="proto-modal-footer qc-exit-footer">
                    <button class="proto-cancel-btn" @onclick="CancelExit">@T("Common.Cancel")</button>
                    <button class="proto-ok-btn" @onclick="ConfirmExit">OK</button>
                </div>
            </div>
        </div>
    }
}

<!-- ═══════════════════════ CODE-BEHIND ═══════════════════════ -->
</PageAccessGuard>

@code {
    [Parameter] public int InspectionId { get; set; }

    bool _loading = true;
    bool _saving;
    bool _saveError;
    string _saveMsg = "";
    // Key dạng "section:slot" để hiển thị spinner đúng ô đang upload
    string _uploadingKey = "";
    InspectionDetailDto? _inspection;
    QcFormData _data = new();
    DateTime _inspectionStartTime = DateTime.Now;   // thời điểm bắt đầu kiểm hàng — ghi lại mỗi lần mở màn hình
    DateTime? _inspectionEndTime;                    // chỉ để hiển thị trên màn hình khi bấm Done; giờ kết thúc thực lưu ở cột Inspection.CompletedAt
    int _currentStepIdx = 0;
    int _cartonCount = 1;       // số carton từ DB (CartonNumber)

    // ── Popup TestProtocol ──
    bool   _showProtocolPopup  = false;
    string _protocolPopupText  = "";
    void ShowProtocolPopup(string text) { _protocolPopupText = text; _showProtocolPopup = true; }
    void CloseProtocolPopup()           { _showProtocolPopup = false; }

    // Remark popup (hiển thị toàn bộ nội dung GeneralRemark khi quá dài)
    bool   _showRemarkPopup = false;
    string _remarkPopupText = "";
    void ShowRemarkPopup(string text) { _remarkPopupText = text; _showRemarkPopup = true; }
    void CloseRemarkPopup()           { _showRemarkPopup = false; }

    // ── Image viewer popup ──
    // Click vào bất kỳ ảnh .qc-photo-img nào sẽ mở popup xem ảnh phóng to.
    // Sự kiện click được bắt bằng event delegation trên document (xem signature.js
    // hoặc OnAfterRenderAsync) và gọi tới method OpenImagePopup qua JSInvokable.
    bool   _showImagePopup = false;
    string _imagePopupUrl  = "";
    DotNetObjectReference<InspectionQC>? _dotNetRef;

    [JSInvokable]
    public void OpenImagePopup(string url)
    {
        if (string.IsNullOrEmpty(url)) return;
        _imagePopupUrl  = url;
        _showImagePopup = true;
        StateHasChanged();
    }

    void CloseImagePopup()
    {
        _showImagePopup = false;
        _imagePopupUrl  = "";
    }

    // ── Review modal ──
    bool   _showReviewModal = false;
    bool   _loadingReview   = false;
    string _reviewUrl       = "";

    async Task OpenReview()
    {
        // 1) Validate Final Result + Signature như Done (báo trước nếu thiếu)
        _finalValidated = true;
        if (string.IsNullOrEmpty(_data.FinalResult))
        {
            _saveMsg = T("InspectionQC.PleaseSelectFinalResultBeforeReviewing");
            _saveError = true;
            StateHasChanged();
            return;
        }
        _sigValidated = true;
        if (string.IsNullOrEmpty(_data.SignatureUrl))
        {
            _saveMsg = T("InspectionQC.PleaseAddSignatureBeforeReviewing");
            _saveError = true;
            StateHasChanged();
            return;
        }

        _loadingReview = true;
        _saveMsg = "";
        _saveError = false;
        StateHasChanged();

        try
        {
            // 2) Save DRAFT (không set Completed, không gửi email) để Report load đúng dữ liệu mới nhất
            var payload = BuildSavePayload(draft: true);
            var resp = await Http.PutAsJsonAsync($"api/inspections/{InspectionId}/qc-result/draft", payload);
            if (!resp.IsSuccessStatusCode)
            {
                _saveMsg = T("InspectionQC.CannotSaveDraftForReview", (int)resp.StatusCode);
                _saveError = true;
                _loadingReview = false;
                StateHasChanged();
                return;
            }

            // 3) Mở modal với iframe — thêm timestamp để bypass cache
            _reviewUrl = $"/inspection-report/{InspectionId}?preview={DateTime.UtcNow.Ticks}";
            _showReviewModal = true;
        }
        catch (Exception ex)
        {
            _saveMsg = T("InspectionQC.ReviewError", ex.Message);
            _saveError = true;
        }
        _loadingReview = false;
        StateHasChanged();
    }

    void CloseReview()
    {
        _showReviewModal = false;
        _reviewUrl = "";
    }

    // ── Step definitions ──
    record StepDef(string StepLabel, string Title, bool CanSkip = false);
    List<StepDef> _steps = new();

    StepDef CurrentStep => _steps[_currentStepIdx];
    double ProgressPct => (_currentStepIdx + 1.0) / _steps.Count * 100;

    // ── Helper: build đúng URL ảnh từ API server ──────────────────
    // - Nếu đã là full URL (http/https) hoặc base64 data: → giữ nguyên
    // - Nếu là relative path (uploads/photos/xxx.png) → gắn BaseAddress của API
    string GetImageUrl(string? url)
        => MediaUrl.Resolve(url, Http.BaseAddress?.ToString());

    // Download reference file qua JS interop (tương thích iOS/macOS Safari)
    async Task DownloadReferenceAsync(JobReferenceDto refItem)
    {
        if (string.IsNullOrEmpty(refItem.FileUrl)) return;
        var fullUrl  = GetImageUrl(refItem.FileUrl);
        var fileName = !string.IsNullOrEmpty(refItem.FileName)
            ? refItem.FileName!
            : (string.IsNullOrEmpty(refItem.ReferenceName) ? "reference" : refItem.ReferenceName);

        try
        {
            // Encode 2 tham số bằng JSON để escape an toàn rồi nhúng vào eval
            var urlJson  = System.Text.Json.JsonSerializer.Serialize(fullUrl);
            var nameJson = System.Text.Json.JsonSerializer.Serialize(fileName);

            var script =
                "(async function(){" +
                "var url=" + urlJson + ";" +
                "var fname=" + nameJson + ";" +
                "try{" +
                "var resp=await fetch(url,{credentials:'include'});" +
                "if(!resp.ok)throw new Error('HTTP '+resp.status);" +
                "var blob=await resp.blob();" +
                "var blobUrl=URL.createObjectURL(blob);" +
                "var a=document.createElement('a');" +
                "a.href=blobUrl;a.download=fname;a.style.display='none';" +
                "document.body.appendChild(a);a.click();" +
                "setTimeout(function(){document.body.removeChild(a);URL.revokeObjectURL(blobUrl);},200);" +
                "}catch(e){window.open(url,'_blank');}" +
                "})();";

            await JS.InvokeVoidAsync("eval", script);
        }
        catch
        {
            // im lặng — fallback đã nằm trong JS
        }
    }

    bool _jsReady = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Init image viewer 1 lần ở firstRender — gắn click delegation lên document
        // để mọi <img class="qc-photo-img"> đều mở popup khi click.
        if (firstRender)
        {
            try
            {
                _dotNetRef ??= DotNetObjectReference.Create(this);

                // 1) Setup listener (idempotent — chỉ chạy 1 lần / page load)
                await JS.InvokeVoidAsync("eval", @"
                    (function(){
                        if (window.__qcImgViewerInited) return;
                        window.__qcSetImgViewerRef = function(ref){ window.__qcImgViewerRef = ref; };
                        document.addEventListener('click', function(ev){
                            var t = ev.target;
                            if (!t || t.tagName !== 'IMG') return;
                            if (!t.classList || !t.classList.contains('qc-photo-img')) return;
                            var src = t.getAttribute('src');
                            if (!src) return;
                            // Chặn label phía trên trigger file picker
                            ev.preventDefault();
                            ev.stopPropagation();
                            try {
                                if (window.__qcImgViewerRef) {
                                    window.__qcImgViewerRef.invokeMethodAsync('OpenImagePopup', src);
                                }
                            } catch(e) { /* ignore */ }
                        }, true); // capture phase — chạy trước handler của label
                        window.__qcImgViewerInited = true;
                    })();
                ");

                // 2) Đăng ký dotNetRef hiện tại (mỗi lần component init lại)
                await JS.InvokeVoidAsync("__qcSetImgViewerRef", _dotNetRef);
            }
            catch { /* ignore */ }
        }

        try
        {
            // Sync canvas width với CSS, fill nền trắng, sau đó init signature
            await JS.InvokeVoidAsync("eval", @"
                (function(){
                    var c = document.getElementById('sig-canvas');
                    if(c){
                        c.width  = c.offsetWidth  || 400;
                        c.height = c.offsetHeight || 180;
                        var ctx = c.getContext('2d');
                        ctx.fillStyle = '#ffffff';
                        ctx.fillRect(0, 0, c.width, c.height);
                    }
                })();
            ");
            await JS.InvokeVoidAsync("initSignatureCanvas", "sig-canvas");
        }
        catch { /* canvas chưa có trong DOM — bỏ qua */ }
    }

    protected override void Dispose(bool disposing)
    {
        base.Dispose(disposing);
        try { _dotNetRef?.Dispose(); } catch { }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadInspection();
    }

    async Task LoadInspection()
    {
        _inspectionStartTime = DateTime.Now;   // ghi nhận thời điểm bắt đầu kiểm mỗi lần mở/mở lại màn hình
        _loading  = true;
        _saveMsg  = "";
        _saveError = false;
        _inspection = null;
        StateHasChanged();

        var url = $"api/inspections/{InspectionId}";
        try
        {
            // Dùng GetAsync để đọc được status code & response body khi lỗi
            var resp = await Http.GetAsync(url);

            if (resp.IsSuccessStatusCode)
            {
                try
                {
                    _inspection = await resp.Content.ReadFromJsonAsync<InspectionDetailDto>();
                    if (_inspection == null)
                    {
                        _saveMsg   = T("InspectionQC.ServerReturnedEmptyBodyForInspection", InspectionId);
                        _saveError = true;
                    }
                    else
                    {
                        InitFormData();
                    }
                }
                catch (Exception jx)
                {
                    var raw = "";
                    try { raw = await resp.Content.ReadAsStringAsync(); } catch { }
                    _saveMsg   = T("InspectionQC.JSONParseErrorBody", jx.Message, Truncate(raw, 200));
                    _saveError = true;
                    Console.Error.WriteLine($"[InspectionQC] JSON parse error for {url}: {jx}");
                    Console.Error.WriteLine($"[InspectionQC] Response body: {raw}");
                }
            }
            else
            {
                // Đọc body để hiểu lỗi server-side
                string body = "";
                try { body = await resp.Content.ReadAsStringAsync(); } catch { }
                _saveMsg   = T("InspectionQC.HTTPFor", (int)resp.StatusCode, resp.StatusCode, InspectionId)
                           + (string.IsNullOrWhiteSpace(body) ? "" : $" {Truncate(body, 200)}");
                _saveError = true;
                Console.Error.WriteLine($"[InspectionQC] {url} → {(int)resp.StatusCode} {resp.StatusCode}. Body: {body}");
            }
        }
        catch (HttpRequestException hx)
        {
            _saveMsg   = T("InspectionQC.NetworkError", hx.Message);
            _saveError = true;
            Console.Error.WriteLine($"[InspectionQC] HttpRequestException for {url}: {hx}");
        }
        catch (TaskCanceledException tx)
        {
            _saveMsg   = T("InspectionQC.RequestTimedOut");
            _saveError = true;
            Console.Error.WriteLine($"[InspectionQC] Timeout for {url}: {tx}");
        }
        catch (Exception ex)
        {
            _saveMsg   = T("InspectionQC.LoadError", ex.Message);
            _saveError = true;
            Console.Error.WriteLine($"[InspectionQC] Unexpected error for {url}: {ex}");
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    static string Truncate(string s, int max)
        => string.IsNullOrEmpty(s) ? "" : (s.Length <= max ? s : s.Substring(0, max) + "…");

    void InitFormData()
    {
        if (_inspection == null) return;

        _data.Photo1Url = _inspection.Photo1Url ?? "";
        _data.Photo2Url = _inspection.Photo2Url ?? "";
        _data.InspectionLocation = _inspection.InspectionLocation ?? "";
        // Inspection Reference giữ trong DB nhưng KHÔNG dùng UI nữa — luôn lưu rỗng.
        // Vị trí cũ trong UI giờ hiển thị "AQL Sampling Simulator" (text-only).
        _data.InspectionReference = "";

        _data.OverallConclusions = _inspection.OverallConclusions?.Any() == true
            ? _inspection.OverallConclusions.Select(o => new QcOverallConclusion
            {
                Letter     = o.Letter,
                Label      = o.Label,
                Compliance = (o.Compliance == "None" || o.Compliance == "NA") ? "" : o.Compliance,
                Remark     = o.Remark ?? ""
            }).ToList()
            : new List<QcOverallConclusion>
            {
                new() { Letter = "A", Label = "Quantity Conformity" },
                new() { Letter = "B", Label = "Packaging & Identification" },
                new() { Letter = "C", Label = "Product Specification Compliance" },
                new() { Letter = "D", Label = "Performance Testing" },
                new() { Letter = "E", Label = "Appearance & Craftsmanship" },
                new() { Letter = "F", Label = "Details of Defect Found" },
            };

        // Load Packaging từ DB
        if (_inspection.Packaging != null)
        {
            var p = _inspection.Packaging;
            _data.Packaging.ItemNumber         = p.ItemNumber         ?? "";
            _data.Packaging.CartonNumber       = p.CartonNumber       ?? "";
            _data.Packaging.PackagingType      = p.PackagingType      ?? "";
            _data.Packaging.CartonColor        = p.CartonColor        ?? "";
            _data.Packaging.CardboardType      = p.CardboardType      ?? "";
            _data.Packaging.ShippingMark       = p.ShippingMark       ?? "";
            _data.Packaging.HasBarcode         = p.HasBarcode;
            _data.Packaging.InnerPackingQty    = p.InnerPackingQty    ?? 0;
            _data.Packaging.InnerPackingRemark = p.InnerPackingRemark ?? "";
            _data.Packaging.OuterL             = p.OuterL             ?? 0;
            _data.Packaging.OuterW             = p.OuterW             ?? 0;
            _data.Packaging.OuterH             = p.OuterH             ?? 0;
            _data.Packaging.OuterWeight        = p.OuterWeight        ?? 0;
        }

        // Parse CartonNumber → số carton để lặp B-i đến B-vi
        _cartonCount = 1;
        if (!string.IsNullOrEmpty(_data.Packaging.CartonNumber) &&
            int.TryParse(_data.Packaging.CartonNumber.Trim(), out var parsedCarton) && parsedCarton > 0)
            _cartonCount = parsedCarton;

        // Khởi tạo CartonDataList cho từng carton
        _data.Packaging.CartonDataList = Enumerable.Range(1, _cartonCount)
            .Select(i => new QcCartonData
            {
                CartonIndex  = i,
                SizePhotos         = new List<string> { "", "", "" },
                WeightPhotos       = new List<string> { "", "", "" },
                ShippingMarkPhotos = new List<string> { "", "", "" },
                PkgLabelPhotos     = new List<string> { "", "", "" },
                AssemblyPhotos     = new List<string> { "", "", "" },
                HardwarePhotos     = new List<string> { "", "", "" },
                HangtagPhotos      = new List<string> { "", "", "" },
            }).ToList();

        _data.Aql.Quantity        = _inspection.AqlQuantity > 0 ? _inspection.AqlQuantity : _inspection.TotalShipmentQty;
        _data.Aql.InspectionLevel = _inspection.AqlLevel ?? "II";
        _data.Aql.CriticalAql     = NormalizeAql(_inspection.AqlCritical);
        _data.Aql.MajorAql        = NormalizeAql(_inspection.AqlMajor) is "Not Allowed" ? "2.5" : NormalizeAql(_inspection.AqlMajor);
        _data.Aql.MinorAql        = NormalizeAql(_inspection.AqlMinor) is "Not Allowed" ? "4.0" : NormalizeAql(_inspection.AqlMinor);
        RecalcAql();
        RecalcDefectCounts(); // đếm tự động dựa trên ảnh defect đã load (nếu có)

        if (_inspection.PerformanceTests?.Any() == true)
        {
            _data.PerformanceTests = _inspection.PerformanceTests.Select(pt => new QcPerformanceTest
            {
                TestItem        = pt.TestItem ?? "",
                TestProtocol    = pt.TestProtocol ?? "",
                TestRequirement = pt.TestRequirement ?? "",
                Category        = pt.Category ?? "",
                Photos          = new List<string> { "", "", "", "" }
            }).ToList();
        }
        else
        {
            _data.PerformanceTests = new List<QcPerformanceTest>
            {
                new() { TestItem = "Transportation drop test",
                        TestRequirement = "No critical & major issue found on package/product after 9 times drop. Please refer to ISTA 3A drop test standard.",
                        Photos = new List<string> { "", "", "", "" } }
            };
        }

        // Sinh steps động SAU KHI đã load PerformanceTests (để BuildSteps biết đúng số bước D)
        _perfValidated = new bool[Math.Max(1, _data.PerformanceTests.Count)];
        BuildSteps();

        if (_inspection.ColourSwatches?.Any() == true)
        {
            _data.ProductSpec.ColourSwatches = _inspection.ColourSwatches
                .Select((cs, i) => new QcColourSwatch
                {
                    No       = i + 1,
                    Material = cs?.Material ?? ""
                }).ToList();
        }
        else
        {
            _data.ProductSpec.ColourSwatches = new List<QcColourSwatch>
            {
                new() { No = 1 }, new() { No = 2 }
            };
        }

        for (int i = _data.ProductSpec.SizeRows.Count; i < 3; i++)
            _data.ProductSpec.SizeRows.Add(new QcSizeRow());

        EnsureList(_data.Packaging.CartonSizes, 0);
        EnsurePhotoList(_data.Packaging.Photos, 3);
        EnsurePhotoList(_data.Packaging.ShippingMarkPhotos, 3);
        EnsurePhotoList(_data.Packaging.PkgLabelPhotos, 3);
        EnsurePhotoList(_data.Packaging.AssemblyPhotos, 3);
        EnsurePhotoList(_data.Packaging.HardwarePhotos, 3);
        EnsurePhotoList(_data.ProductSpec.GoldenPhotos, 3);
        EnsurePhotoList(_data.ProductSpec.SwatchPhotos, 3);
        EnsurePhotoList(_data.ProductSpec.ProductWeightPhotos, 2);
        EnsurePhotoList(_data.ProductSpec.SizePhotos, 4);
        EnsurePhotoList(_data.QuantityConformity.Photos, 3);

        RestoreSavedQc();
    }

    void EnsureList<T>(List<T> list, int minCount) where T : new()
    { while (list.Count < minCount) list.Add(new T()); }
    void EnsurePhotoList(List<string> list, int count)
    { while (list.Count < count) list.Add(""); }

    // ── Build steps động theo carton count ──
    // Step layout: [Overview][OverallConclusion][QuantityConformity][PackagingID]
    //              [B-i..B-vi × cartonCount]
    //              [C-i][C-ii][C-iii][D][E][F-Crit][F-Maj][F-Min][Final]
    const int STEP_OVERVIEW    = 0;
    const int STEP_CONCLUSION  = 1;
    const int STEP_QTY         = 2;
    const int STEP_PKG_ID      = 3;
    // B-i=4, B-ii=5, B-iii=6, B-iv=7, B-v=8, B-vi=9  (repeated × cartonCount)
    const int B_STEPS_PER_CARTON = 7; // B-i đến B-vii (B-vii = Hangtag)

    void BuildSteps()
    {
        var list = new List<StepDef>
        {
            new("", T("InspectionQC.ProductOverview"),       false),
            new("", T("InspectionQC.OverallConclusion"),     false),
            new("", T("InspectionQC.QuantityConformity"), false),
            new("", T("InspectionQC.BPackagingID"),      false),
        };

        for (int c = 1; c <= _cartonCount; c++)
        {
            string suffix = _cartonCount > 1 ? T("InspectionQC.Carton", c) : "";
            list.Add(new("", T("InspectionQC.BICartonSize", suffix),          true));
            list.Add(new("", T("InspectionQC.BIiShippingMark", suffix),       true));
            list.Add(new("", T("InspectionQC.BIiiCartonWeight", suffix),      true));
            list.Add(new("", T("InspectionQC.BIvPkgLabel", suffix),         true));
            list.Add(new("", T("InspectionQC.BVAssembly", suffix),             true));
            list.Add(new("", T("InspectionQC.BViHardware", suffix),            true));
            list.Add(new("", T("InspectionQC.BViiHangtag", suffix),            true));
        }

        list.Add(new("", T("InspectionQC.CIProductSize"),         false));
        list.Add(new("", T("InspectionQC.CIiProductWeight"),      true));
        list.Add(new("", T("InspectionQC.CIiGoldenSample"),       true));
        list.Add(new("", T("InspectionQC.CIiiColourSwatch"),      true));
        // D: mỗi performance test = 1 step riêng
        for (int d = 0; d < _data.PerformanceTests.Count; d++)
        {
            var testName = _data.PerformanceTests[d].TestItem;
            var suffix = _data.PerformanceTests.Count > 1 ? $" ({d+1}/{_data.PerformanceTests.Count})" : "";
            list.Add(new("", T("InspectionQC.D", (string.IsNullOrEmpty(testName) ? T("InspectionQC.PerformanceTest") : testName), suffix), true));
        }
        if (!_data.PerformanceTests.Any())
            list.Add(new("", T("InspectionQC.DPerformanceTesting"), true));
        list.Add(new("", T("InspectionQC.EAppearanceAQL"),       false));
        list.Add(new("", T("InspectionQC.FDetailsOfDefectFound"), true));
        list.Add(new("", T("InspectionQC.InspectorComments"),          false));
        list.Add(new("", T("InspectionQC.ComplianceSignature"),        false));

        _steps = list;
        for (int i = 0; i < _steps.Count; i++)
            _steps[i] = _steps[i] with { StepLabel = T("InspectionQC.StepOf", i+1, _steps.Count) };

        // Đảm bảo _perfValidated đủ kích thước
        int perfCount2 = Math.Max(1, _data.PerformanceTests.Count);
        if (_perfValidated.Length != perfCount2)
            _perfValidated = new bool[perfCount2];
    }

    // Lấy carton index hiện tại và sub-step trong B (0=B-i .. 6=B-vii Hangtag)
    // Trả về (-1, -1) nếu không phải bước B
    (int cartonIdx, int bSubStep) GetCurrentCartonStep()
    {
        int idx = _currentStepIdx - (STEP_PKG_ID + 1); // offset sau B. Packaging & ID
        if (idx < 0) return (-1, -1);
        int totalBSteps = _cartonCount * B_STEPS_PER_CARTON;
        if (idx >= totalBSteps) return (-1, -1);
        return (idx / B_STEPS_PER_CARTON, idx % B_STEPS_PER_CARTON);
    }

    // ── Navigation ──
    void HandleBack()
    {
        _saveMsg = ""; _saveError = false;   // không để thông báo lỗi của bước trước dính sang bước mới
        if (_currentStepIdx > 0)
        {
            _currentStepIdx--;
            // Skip ngược lại nếu bước đó bị tắt (Compliance không phải Pass)
            while (_currentStepIdx > 1 && IsStepSkippedByCompliance(_currentStepIdx))
                _currentStepIdx--;
        }
        else
        {
            // Đang ở bước đầu → bấm back là thoát màn hình. Mở dialog xác nhận tùy biến
            // (dùng modal riêng để cố định nhãn nút OK / Cancel, không phụ thuộc ngôn ngữ trình duyệt).
            _showExitConfirm = true;
        }
    }

    // ── Exit confirm dialog (nút OK / Cancel cố định) ──
    bool _showExitConfirm = false;
    void ConfirmExit() { _showExitConfirm = false; GoBack(); }
    void CancelExit()  { _showExitConfirm = false; }
    bool _qtyValidated    = false;
    bool _sizeValidated   = false;
    bool _goldenValidated = false;
    bool _swatchValidated = false;
    bool[] _perfValidated = Array.Empty<bool>();
    int _photoValidatedStep = -1;   // bước vừa bấm Next mà thiếu ảnh → tô đỏ ô ảnh trống

    // ── Giao diện mới (17/11/2026): màu ô Result theo giá trị ──
    static string ResCls(string? v) => v switch
    {
        "Pass" => "pass",
        "Fail" => "fail",
        "N/A"  => "na",
        _      => ""
    };

    /// <summary>Khối ảnh chuẩn cho MỌI bước kiểm (khách chốt 18/11/2026: "2 images each line" + chữ "Add Photo"):
    /// lưới 2 cột ô vuông, tối thiểu 2 ô; ảnh đã chụp và ô "Add Photo" xếp nối tiếp nhau. Khi mọi ô đã có ảnh
    /// thì thêm 1 ô "Add Photo" kế tiếp để chụp thêm (không còn ô "+" riêng).
    /// Danh sách ảnh KHÔNG được sửa trước khi đọc xong file (trước đây ô "+" gọi photos.Add() trước khi upload →
    /// render lại gỡ mất InputFile vừa chọn file → lỗi "_blazorFilesById" trên điện thoại). Khóa upload "{prefix}:{idx}".</summary>
    RenderFragment QxPhotos(List<string> photos, string keyPrefix, int min, bool validated) => @<div class="qx-photos-wrap">
        @{
            var cnt = photos.Count(p => !string.IsNullOrEmpty(p));
            var lacking = validated && cnt < min;
            var slots = Math.Max(photos.Count, 2);
        }
        <div class="qx-photos-h">
            <span class="qx-photos-t">@T("InspectionQC.Photos")</span>
            @if (min > 0)
            {
                <span class="qx-photos-min">@(min == 1 ? T("InspectionQC.Min1Photo") : T("InspectionQC.Min2Photos"))</span>
                <span class="qx-photos-cnt @(cnt >= min ? "ok" : "")">@cnt/@min</span>
            }
        </div>
        <div class="qx-photos">
            @for (int i = 0; i < slots; i++)
            {
                var idx = i;
                var key = $"{keyPrefix}:{idx}";
                var has = idx < photos.Count && !string.IsNullOrEmpty(photos[idx]);
                <label class="qx-ph @(has ? "has" : "") @(lacking && !has ? "req" : "")">
                    <InputFile OnChange="@(e => OnQxPhotoChange(e, photos, key, idx))"
                               accept="image/*" capture="environment" style="display:none"/>
                    @if (_uploadingKey == key) { <div class="qc-photo-spinner"><div class="qc-spinner-ring"></div></div> }
                    else if (has)
                    {
                        <img src="@GetImageUrl(photos[idx])" class="qc-photo-img"/>
                        <button class="qc-photo-del" @onclick:stopPropagation="true" @onclick:preventDefault="true" @onclick="() => SetPhotoInList(photos, idx, string.Empty)">✕</button>
                    }
                    else { <span class="qx-ph-plus">+</span><span class="qx-ph-add">@T("InspectionQC.AddPhoto")</span> }
                </label>
            }
            @{
                // Ô "+" luôn hiện ở cuối (khách yêu cầu 22/11: "Still not show +"). Ảnh chọn ở đây điền vào
                // ô trống đầu tiên, hết ô trống thì thêm ô mới. Danh sách chỉ đổi SAU khi đọc xong file
                // (xem OnQxPhotoChange), nên ô này cùng InputFile của nó vẫn nằm trong DOM suốt lúc đọc file.
                var firstEmpty = Enumerable.Range(0, slots).FirstOrDefault(i => !(i < photos.Count && !string.IsNullOrEmpty(photos[i])), -1);
                var nIdx = firstEmpty >= 0 ? firstEmpty : slots;
                var nKey = $"{keyPrefix}:+";
            }
            <label class="qx-ph qx-ph-more">
                <InputFile OnChange="@(e => OnQxPhotoChange(e, photos, nKey, nIdx))"
                           accept="image/*" capture="environment" style="display:none"/>
                @if (_uploadingKey == nKey) { <div class="qc-photo-spinner"><div class="qc-spinner-ring"></div></div> }
                else { <span class="qx-ph-plus big">+</span> }
            </label>
        </div>
    </div>;

    async Task OnQxPhotoChange(InputFileChangeEventArgs e, List<string> photos, string key, int idx)
    {
        var url = await UploadPhotoWithSpinner(e, key);
        if (!string.IsNullOrEmpty(url)) SetPhotoInList(photos, idx, url);
    }

    void HandleNext()
    {
        // Nếu step hiện tại sẽ bị skip do Overall Conclusion = No/NA → bỏ qua mọi validation
        // (user không cần nhập gì cho step bị skip)
        bool currentStepIsSkipped = IsStepSkippedByCompliance(_currentStepIdx);
        if (currentStepIsSkipped)
        {
            // Clear thông báo lỗi cũ (nếu có) để banner không kẹt khi nhảy qua step skip
            _saveMsg = "";
            _saveError = false;
        }

        // Validate Step 2 — A. Quantity Conformity
        if (_currentStepIdx == 2 && !currentStepIsSkipped)
        {
            _qtyValidated = true;
            var qc = _data.QuantityConformity;
            bool hasPhoto = qc.Photos.Any(p => !string.IsNullOrEmpty(p));
            // Chỉ cần 1 trong 2 (Packed hoặc Not Packed) > 0
            bool presentedOk = (qc.PresentedPacked + qc.PresentedNotPacked) > 0;
            bool cartonsOk   = (qc.CartonsPacked   + qc.CartonsNotPacked)   > 0;
            bool fieldsOk    = presentedOk && cartonsOk;
            if (!fieldsOk || !hasPhoto)
            {
                if (!fieldsOk)
                    _saveMsg = T("InspectionQC.PleaseEnterAtLeastOneValue");
                else
                    _saveMsg = T("InspectionQC.PleaseTakeAtLeast1Photo");
                _saveError = true;
                StateHasChanged();
                return;
            }
            _saveMsg = "";
            _saveError = false;
        }
        // Validate B-vi Hardware / B-vii Hangtag: có chi tiết (Yes) thì bắt buộc tối thiểu 2 hình
        if (!currentStepIsSkipped && GetCurrentCartonStep() is var (vCi, vSub) && vCi >= 0
            && vCi < _data.Packaging.CartonDataList.Count && (vSub == 5 || vSub == 6))
        {
            var vcd = _data.Packaging.CartonDataList[vCi];
            var vYes = vSub == 5 ? vcd.HardwareResult == "Yes" : vcd.HangtagIncluded == "Yes";
            var vPhotos = vSub == 5 ? vcd.HardwarePhotos : vcd.HangtagPhotos;
            if (vYes && vPhotos.Count(p => !string.IsNullOrEmpty(p)) < 2)
            {
                _photoValidatedStep = _currentStepIdx;
                _saveMsg = T("InspectionQC.PleaseTakeAtLeast2PhotosHere");
                _saveError = true;
                StateHasChanged();
                return;
            }
        }
        // Số ảnh tối thiểu hiển thị trên mẫu mới (17/11/2026): B-i Carton Size ≥ 2, B-iii Carton Weight ≥ 1, C-ii Product Weight ≥ 1
        if (!currentStepIsSkipped)
        {
            List<string>? minList = null; int minNeed = 0;
            if (GetCurrentCartonStep() is var (mCi, mSub) && mCi >= 0 && mCi < _data.Packaging.CartonDataList.Count && (mSub == 0 || mSub == 2))
            {
                var mcd = _data.Packaging.CartonDataList[mCi];
                (minList, minNeed) = mSub == 0 ? (mcd.SizePhotos, 2) : (mcd.WeightPhotos, 1);
            }
            else if (_currentStepIdx == 5 + _cartonCount * B_STEPS_PER_CARTON)
                (minList, minNeed) = (_data.ProductSpec.ProductWeightPhotos, 1);
            if (minList != null && minList.Count(p => !string.IsNullOrEmpty(p)) < minNeed)
            {
                _photoValidatedStep = _currentStepIdx;
                _saveMsg = minNeed >= 2 ? T("InspectionQC.PleaseTakeAtLeast2PhotosHere") : T("InspectionQC.PleaseTakeAtLeast1Photo");
                _saveError = true;
                StateHasChanged();
                return;
            }
        }
        // Validate D — Performance Testing: bắt buộc tối thiểu 2 hình
        int dBase = 8 + _cartonCount * B_STEPS_PER_CARTON;
        if (_currentStepIdx >= dBase && _currentStepIdx < dBase + Math.Max(1, _data.PerformanceTests.Count) && !currentStepIsSkipped)
        {
            int dIdx = _currentStepIdx - dBase;
            if (dIdx < _data.PerformanceTests.Count)
            {
                if (_perfValidated.Length > dIdx) _perfValidated[dIdx] = true;
                int perfCount = _data.PerformanceTests[dIdx].Photos.Count(p => !string.IsNullOrEmpty(p));
                if (perfCount < 2)
                {
                    _saveMsg = T("InspectionQC.PleaseTakeAtLeast2Photos4", _data.PerformanceTests[dIdx].TestItem);
                    _saveError = true;
                    StateHasChanged();
                    return;
                }
                _saveMsg = ""; _saveError = false;
            }
        }
        // Validate C-ii — Golden Sample: bắt buộc tối thiểu 2 hình
        if (_currentStepIdx == 6 + _cartonCount * B_STEPS_PER_CARTON && !currentStepIsSkipped)
        {
            _goldenValidated = true;
            int goldenCount = _data.ProductSpec.GoldenPhotos.Count(p => !string.IsNullOrEmpty(p));
            if (goldenCount < 2)
            {
                _saveMsg = T("InspectionQC.PleaseTakeAtLeast2Photos3");
                _saveError = true;
                StateHasChanged();
                return;
            }
            _saveMsg = ""; _saveError = false;
        }
        // Validate C-iii — Colour Swatch: bắt buộc tối thiểu 2 hình
        if (_currentStepIdx == 7 + _cartonCount * B_STEPS_PER_CARTON && !currentStepIsSkipped)
        {
            _swatchValidated = true;
            int swatchCount = _data.ProductSpec.SwatchPhotos.Count(p => !string.IsNullOrEmpty(p));
            if (swatchCount < 2)
            {
                _saveMsg = T("InspectionQC.PleaseTakeAtLeast2Photos2");
                _saveError = true;
                StateHasChanged();
                return;
            }
            _saveMsg = ""; _saveError = false;
        }
        // Validate C-i — Product Size: bắt buộc tối thiểu 2 hình
        if (_currentStepIdx == 4 + _cartonCount * B_STEPS_PER_CARTON && !currentStepIsSkipped)
        {
            _sizeValidated = true;
            int sizeCount = _data.ProductSpec.SizePhotos.Count(p => !string.IsNullOrEmpty(p));
            if (sizeCount < 2)
            {
                _saveMsg = T("InspectionQC.PleaseTakeAtLeast2Photos");
                _saveError = true;
                StateHasChanged();
                return;
            }
            _saveMsg = ""; _saveError = false;
        }

        // Validate Final Result — step 11 + carton*B + max(1,perf)
        int finalResultStep = 10 + _cartonCount * B_STEPS_PER_CARTON + Math.Max(1, _data.PerformanceTests.Count);
        if (_currentStepIdx == finalResultStep)
        {
            _finalValidated = true;
            if (string.IsNullOrEmpty(_data.FinalResult))
            {
                _saveMsg  = T("InspectionQC.PleaseSelectFinalResultPASSEDFAILED2");
                _saveError = true;
                StateHasChanged();
                return;
            }
            _saveMsg = ""; _saveError = false;
        }

        // Validate Signature — step 12 + carton*B + max(1,perf)
        int sigStep = 11 + _cartonCount * B_STEPS_PER_CARTON + Math.Max(1, _data.PerformanceTests.Count);
        if (_currentStepIdx == sigStep)
        {
            _sigValidated = true;
            if (string.IsNullOrEmpty(_data.SignatureUrl))
            {
                _saveMsg  = T("InspectionQC.PleaseAddSignatureBeforeProceeding");
                _saveError = true;
                StateHasChanged();
                return;
            }
            _saveMsg = ""; _saveError = false;
        }

        if (_currentStepIdx < _steps.Count - 1) _currentStepIdx++;
        // Auto-skip step nếu Compliance không phải Pass
        while (_currentStepIdx < _steps.Count - 1 && IsStepSkippedByCompliance(_currentStepIdx))
            _currentStepIdx++;
        // Khi vào F step, đảm bảo có default defect cho mỗi loại
        EnsureDefaultDefects();
    }

    // Trả về true nếu step này cần bỏ qua vì Overall Conclusion của section đó không phải "Pass"
    bool IsStepSkippedByCompliance(int stepIdx)
    {
        int bEnd  = STEP_PKG_ID + _cartonCount * B_STEPS_PER_CARTON;      // last B sub-step index
        int cBase = bEnd + 1;                                               // C-i
        int dBase = cBase + 4;                                              // D start (C-i, C-i weight, C-ii, C-iii = 4 steps)
        int dEnd  = dBase + Math.Max(1, _data.PerformanceTests.Count) - 1; // D last step
        int eStep = dEnd + 1;                                               // E
        int fBase = eStep + 1;                                              // F (Critical/Major/Minor)

        // Lấy compliance theo Letter — chuẩn hoá Letter (trim + uppercase, bỏ ký tự thừa)
        // để khớp dù DB lưu "d", "D.", "D - ..." v.v.
        string GetCompliance(string letter)
        {
            var target = (letter ?? "").Trim().ToUpperInvariant();
            var oc = _data.OverallConclusions.FirstOrDefault(o =>
            {
                var l = (o.Letter ?? "").Trim().ToUpperInvariant();
                if (l == target) return true;
                // Khớp cả "D." hoặc "D - Performance" → bắt đầu bằng "D" rồi non-letter
                if (l.StartsWith(target) && (l.Length == target.Length
                    || !char.IsLetter(l[target.Length]))) return true;
                return false;
            });
            return oc?.Compliance ?? "";
        }

        // SKIP nếu Compliance rõ ràng là "No" / "Fail" / "NA" / "N/A" (case-insensitive).
        // Chuỗi rỗng / null / giá trị lạ → KHÔNG skip (an toàn: vẫn hiển thị để user thấy).
        bool isSkip(string letter)
        {
            var v = (GetCompliance(letter) ?? "").Trim();
            if (string.IsNullOrEmpty(v)) return false;
            return string.Equals(v, "No",   StringComparison.OrdinalIgnoreCase)
                || string.Equals(v, "Fail", StringComparison.OrdinalIgnoreCase)
                || string.Equals(v, "NA",   StringComparison.OrdinalIgnoreCase)
                || string.Equals(v, "N/A",  StringComparison.OrdinalIgnoreCase)
                || string.Equals(v, "None", StringComparison.OrdinalIgnoreCase);
        }

        // DEBUG (chỉ log lần đầu cho mỗi step): hiển thị vì sao skip / không skip
        if (!_skipDebugLogged.Contains(stepIdx))
        {
            _skipDebugLogged.Add(stepIdx);
            try
            {
                var cs = string.Join(", ",
                    _data.OverallConclusions.Select(o => $"{o.Letter}={o.Compliance ?? "null"}"));
                Console.WriteLine($"[QC-Skip] step={stepIdx} bEnd={bEnd} cBase={cBase} dBase={dBase} dEnd={dEnd} eStep={eStep} fBase={fBase} OC=[{cs}]");
            }
            catch { }
        }

        // A — Quantity Conformity (step 2)
        if (stepIdx == STEP_QTY && isSkip("A")) return true;

        // B — Packaging steps (STEP_PKG_ID và các B sub-steps)
        if ((stepIdx == STEP_PKG_ID || (stepIdx > STEP_PKG_ID && stepIdx <= bEnd)) && isSkip("B")) return true;

        // C — Product Specification (C-i, C-ii, C-iii)
        if (stepIdx >= cBase && stepIdx <= cBase + 3 && isSkip("C")) return true;

        // D — Performance Testing
        if (stepIdx >= dBase && stepIdx <= dEnd && isSkip("D")) return true;

        // E — Appearance & Craftsmanship
        if (stepIdx == eStep && isSkip("E")) return true;

        // F — Details of Defect Found (1 step duy nhất, gộp Critical/Major/Minor)
        if (stepIdx == fBase && isSkip("F")) return true;

        return false;
    }
    HashSet<int> _skipDebugLogged = new();

    void EnsureDefaultDefects()
    {
        // F step giờ chỉ có 1 trang duy nhất, user tự bấm Add để thêm row
        // Không cần auto-tạo row mặc định nữa.
    }
    void SkipStep()
    {
        _saveMsg = ""; _saveError = false;   // không để thông báo lỗi của bước trước dính sang bước mới
        if (_currentStepIdx < _steps.Count - 1) _currentStepIdx++;
        // Tiếp tục bỏ qua các step có Compliance = No/Fail/NA
        while (_currentStepIdx < _steps.Count - 1 && IsStepSkippedByCompliance(_currentStepIdx))
            _currentStepIdx++;
        EnsureDefaultDefects();
    }
    void GoBack()     => Navigation.NavigateTo("/inspection-schedule");

    // ── AQL calculation ──
    // Normalize AQL value từ API về đúng format của dropdown
    string NormalizeAql(string? val) => val switch
    {
        null or "" or "0" or "Not Allowed" => "Not Allowed",
        "0.10"  => "0.1",
        "0.40"  => "0.40",
        "0.65"  => "0.65",
        _ => val
    };

    void RecalcAql()
    {
        int qty = _data.Aql.Quantity;
        string level = _data.Aql.InspectionLevel;
        string codeLetterStr = GetAqlCodeLetter(qty, level);

        _data.Aql.CriticalSampleSize = GetSampleSize(codeLetterStr);
        _data.Aql.MajorSampleSize    = GetSampleSize(codeLetterStr);
        _data.Aql.MinorSampleSize    = GetSampleSize(codeLetterStr);

        var (ca, cr) = GetAcceptReject(codeLetterStr, _data.Aql.CriticalAql);
        var (ma, mr) = GetAcceptReject(codeLetterStr, _data.Aql.MajorAql);
        var (na, nr) = GetAcceptReject(codeLetterStr, _data.Aql.MinorAql);

        _data.Aql.CriticalAccept = ca; _data.Aql.CriticalReject = cr;
        _data.Aql.MajorAccept    = ma; _data.Aql.MajorReject    = mr;
        _data.Aql.MinorAccept    = na; _data.Aql.MinorReject    = nr;
        StateHasChanged();
    }

    /// <summary>
    /// Đếm tự động số lỗi Critical/Major/Minor dựa trên số ảnh đã upload trong _data.Defects.
    /// 1 ảnh non-empty = 1 lỗi. Gọi sau mỗi lần upload, xoá ảnh, hoặc remove defect group.
    /// </summary>
    void RecalcDefectCounts()
    {
        int CountPhotosOf(string type) => _data.Defects
            .Where(d => string.Equals(d.Type, type, StringComparison.OrdinalIgnoreCase))
            .Sum(d => d.Photos.Count(p => !string.IsNullOrEmpty(p)));

        _data.Aql.CriticalFound = CountPhotosOf("Critical");
        _data.Aql.MajorFound    = CountPhotosOf("Major");
        _data.Aql.MinorFound    = CountPhotosOf("Minor");
    }

    void SetAql(string defectType, string value)
    {
        if (defectType == "Critical") _data.Aql.CriticalAql = value;
        else if (defectType == "Major") _data.Aql.MajorAql = value;
        else _data.Aql.MinorAql = value;
        RecalcAql();
    }

    string GetAqlCodeLetter(int qty, string level)
    {
        // ISO 2859-1 Sample Size Code Letters
        // Lot Size ranges: 2-8, 9-15, 16-25, 26-50, 51-90, 91-150, 151-280, 281-500,
        //                  501-1200, 1201-3200, 3201-10000, 10001-35000, 35001-150000, 150001-500000, 500001+
        if (level == "I")
        {
            if (qty <=    8) return "A";
            if (qty <=   15) return "A";
            if (qty <=   25) return "B";
            if (qty <=   50) return "C";
            if (qty <=   90) return "C";
            if (qty <=  150) return "D";
            if (qty <=  280) return "E";
            if (qty <=  500) return "F";
            if (qty <= 1200) return "G";
            if (qty <= 3200) return "H";
            if (qty <= 10000) return "J";
            if (qty <= 35000) return "K";
            if (qty <= 150000) return "L";
            if (qty <= 500000) return "M";
            return "N";
        }
        if (level == "III")
        {
            if (qty <=    8) return "B";
            if (qty <=   15) return "C";
            if (qty <=   25) return "D";
            if (qty <=   50) return "E";
            if (qty <=   90) return "F";
            if (qty <=  150) return "G";
            if (qty <=  280) return "H";
            if (qty <=  500) return "J";
            if (qty <= 1200) return "K";
            if (qty <= 3200) return "L";
            if (qty <= 10000) return "M";
            if (qty <= 35000) return "N";
            if (qty <= 150000) return "P";
            if (qty <= 500000) return "Q";
            return "R";
        }
        if (level == "S1")
        {
            if (qty <=   150) return "A";
            if (qty <=  1200) return "B";
            if (qty <= 10000) return "C";
            if (qty <= 150000) return "D";
            return "D";
        }
        if (level == "S2")
        {
            if (qty <=    90) return "A";
            if (qty <=   280) return "B";
            if (qty <=   500) return "B";
            if (qty <=  1200) return "C";
            if (qty <= 10000) return "C";
            if (qty <= 35000) return "D";
            if (qty <= 150000) return "E";
            return "E";
        }
        if (level == "S3")
        {
            if (qty <=    15) return "A";
            if (qty <=   150) return "B";
            if (qty <=  1200) return "C";
            if (qty <= 10000) return "D";
            if (qty <= 35000) return "E";
            if (qty <= 150000) return "F";
            if (qty <= 500000) return "G";
            return "H";
        }
        if (level == "S4")
        {
            if (qty <=     8) return "A";
            if (qty <=    25) return "B";
            if (qty <=    90) return "B";
            if (qty <=   150) return "C";
            if (qty <=   280) return "C";
            if (qty <=  1200) return "D";
            if (qty <=  3200) return "E";
            if (qty <= 10000) return "F";
            if (qty <= 35000) return "G";
            if (qty <= 150000) return "H";
            if (qty <= 500000) return "J";
            return "K";
        }
        // Level II (default) — ISO 2859-1 Table 1
        if (qty <=    8) return "A";
        if (qty <=   15) return "B";
        if (qty <=   25) return "C";
        if (qty <=   50) return "D";
        if (qty <=   90) return "E";
        if (qty <=  150) return "F";
        if (qty <=  280) return "G";
        if (qty <=  500) return "H";
        if (qty <= 1200) return "J";
        if (qty <= 3200) return "K";
        if (qty <= 10000) return "L";
        if (qty <= 35000) return "M";
        if (qty <= 150000) return "N";
        if (qty <= 500000) return "P";
        return "Q";
    }

    int GetSampleSize(string code) => code switch
    {
        "A" => 2, "B" => 3, "C" => 5, "D" => 8, "E" => 13, "F" => 20,
        "G" => 32, "H" => 50, "J" => 80, "K" => 125, "L" => 200,
        "M" => 315, "N" => 500, "P" => 800, "Q" => 1250, "R" => 2000,
        _ => 0
    };

    (int Accept, int Reject) GetAcceptReject(string code, string aql)
    {
        if (aql == "Not Allowed" || aql == "0") return (0, 1);

        // ISO 2859-1 Table B-1 — Single sampling plans for normal inspection
        // Format: (Accept, Reject)
        // Arrow rules: use next plan when arrow applies (already resolved below)
        return (aql, code) switch
        {
            // 0.065
            ("0.065", "L") => (0, 1), ("0.065", "M") => (1, 2), ("0.065", "N") => (1, 2),
            ("0.065", "P") => (2, 3), ("0.065", "Q") => (3, 4), ("0.065", "R") => (5, 6),

            // 0.1
            ("0.1", "K") => (0, 1), ("0.1", "L") => (0, 1), ("0.1", "M") => (1, 2),
            ("0.1", "N") => (2, 3), ("0.1", "P") => (3, 4), ("0.1", "Q") => (5, 6),

            // 0.15
            ("0.15", "J") => (0, 1), ("0.15", "K") => (0, 1), ("0.15", "L") => (1, 2),
            ("0.15", "M") => (1, 2), ("0.15", "N") => (2, 3), ("0.15", "P") => (3, 4),
            ("0.15", "Q") => (5, 6),

            // 0.25
            ("0.25", "H") => (0, 1), ("0.25", "J") => (0, 1), ("0.25", "K") => (1, 2),
            ("0.25", "L") => (2, 3), ("0.25", "M") => (3, 4), ("0.25", "N") => (5, 6),
            ("0.25", "P") => (7, 8), ("0.25", "Q") => (10, 11),

            // 0.40
            ("0.40", "G") => (0, 1), ("0.40", "H") => (0, 1), ("0.40", "J") => (1, 2),
            ("0.40", "K") => (2, 3), ("0.40", "L") => (3, 4), ("0.40", "M") => (5, 6),
            ("0.40", "N") => (7, 8), ("0.40", "P") => (10, 11),

            // 0.65
            ("0.65", "F") => (0, 1), ("0.65", "G") => (1, 2), ("0.65", "H") => (1, 2),
            ("0.65", "J") => (2, 3), ("0.65", "K") => (3, 4), ("0.65", "L") => (5, 6),
            ("0.65", "M") => (7, 8), ("0.65", "N") => (10, 11),

            // 1.0
            ("1.0", "E") => (0, 1), ("1.0", "F") => (0, 1), ("1.0", "G") => (1, 2),
            ("1.0", "H") => (2, 3), ("1.0", "J") => (3, 4), ("1.0", "K") => (5, 6),
            ("1.0", "L") => (7, 8), ("1.0", "M") => (10, 11), ("1.0", "N") => (14, 15),

            // 1.5
            ("1.5", "D") => (0, 1), ("1.5", "E") => (0, 1), ("1.5", "F") => (1, 2),
            ("1.5", "G") => (2, 3), ("1.5", "H") => (3, 4), ("1.5", "J") => (5, 6),
            ("1.5", "K") => (7, 8), ("1.5", "L") => (10, 11), ("1.5", "M") => (14, 15),
