    /// <summary>
    /// Backward compat: data cũ có thể lưu mỗi QcDefect chứa NHIỀU ảnh
    /// (Photos = ["url1","url2",...], Remarks = ["rmk1","rmk2",...]).
    /// UI mới mỗi row = 1 ảnh + 1 remark, nên flatten ra nhiều QcDefect đơn.
    /// Gọi sau khi load _data.Defects từ JSON.
    /// </summary>
    void FlattenDefectsForNewUi()
    {
        var flat = new List<QcDefect>();
        foreach (var d in _data.Defects)
        {
            var photos = d.Photos?.Where(p => !string.IsNullOrEmpty(p)).ToList() ?? new();
            if (photos.Count == 0)
            {
                // Defect không có ảnh — skip (UI mới chỉ hiện row có ảnh)
                continue;
            }
            for (int i = 0; i < photos.Count; i++)
            {
                var rmk = (d.Remarks != null && i < d.Remarks.Count) ? d.Remarks[i] : "";
                flat.Add(new QcDefect
                {
                    Type       = d.Type,
                    DefectCode = d.DefectCode,
                    Photos  = new List<string> { photos[i] },
                    Remarks = new List<string> { rmk ?? "" }
                });
            }
        }
        _data.Defects = flat;
    }

