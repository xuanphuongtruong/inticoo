        transition: border-color .2s, box-shadow .2s;
        max-width: 100px;
    }
    /* Safari macOS/iOS: select & input lệch chiều cao → cố định chiều cao, bỏ giao diện native của select */
    .qc-info-input { box-sizing: border-box; height: 38px; -webkit-appearance: none; appearance: none; }
    select.qc-info-input {
        padding-right: 28px; cursor: pointer;
        background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%231a2d5a' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
