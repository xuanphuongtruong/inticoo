    .red-stat { color: #e74c3c; font-weight: 700; }

    .qc-spec-header-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .qc-spec-col { display: flex; flex-direction: column; gap: 4px; }
    .qc-spec-lbl { font-size: 11px; font-weight: 700; color: #2D7DD2; }

    .qc-perf-block { border: 1px solid #e8eef8; border-radius: 10px;
        padding: 12px; margin-bottom: 12px; background: #fafcff; }
    .qc-perf-title { font-size: 14px; font-weight: 700; color: #1a1a2e; margin-bottom: 10px; }

    .qc-defect-type { font-size: 14px; font-weight: 800; margin-bottom: 12px; }
    .def-critical { color: #e74c3c; }
    .def-major    { color: #e67e22; }
    .def-minor    { color: #3498db; }
    .qc-defect-grid { display: flex; flex-direction: column; gap: 10px; }
    .qc-defect-item {
        display: flex; gap: 10px; align-items: flex-start;
        border: 1px solid #f0f3f8; border-radius: 8px; padding: 10px;
    }
    .qc-defect-photo {
        width: 80px; height: 80px; flex-shrink: 0;
        background: #f0f5ff; border: 2px dashed #b0c8f0; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; overflow: hidden; font-size: 12px; color: #2D7DD2;
    }
    .qc-defect-remark {
        flex: 1; border: 1px solid #dce6f8; border-radius: 7px;
        padding: 7px 9px; font-size: 12px; background: #f8faff;
        outline: none; resize: vertical;
    }

    .qc-logo-row { display: flex; align-items: center; gap: 8px; margin-bottom: 16px; }
    .qc-logo-text { font-size: 18px; font-weight: 800; color: #1a1a2e; letter-spacing: -.01em; }
    .qc-final-result-row {
        display: flex; align-items: center; gap: 16px;
        flex-wrap: wrap; margin: 14px 0;
        padding: 12px; background: #f8faff; border-radius: 10px;
        border: 1px solid #dce6f8;
    }
    .qc-final-lbl { font-size: 13px; font-weight: 700; color: #1a1a2e; }
    .qc-compliance-clause {
        margin: 14px 0; padding: 12px;
        background: #fffbf0; border-left: 3px solid #e67e22;
        border-radius: 0 8px 8px 0; font-size: 12px; color: #555;
    }
    .qc-compliance-clause strong { color: #e67e22; }
    .qc-compliance-clause p { margin: 6px 0 0; line-height: 1.5; }
    .qc-sig-box { flex: 1; min-height: 70px; border: 1px dashed #b0c8f0;
        border-radius: 8px; display: flex; align-items: center; justify-content: center; }
    .qc-add-sig-btn {
        background: #eef4ff; color: #2D7DD2; border: 1px solid #b0c8f0;
        border-radius: 8px; padding: 8px 18px; font-size: 13px; cursor: pointer;
    }
    .qc-sig-img { max-height: 70px; object-fit: contain; }
    .qc-clear-sig { background: #fee; color: #e74c3c; border: none;
        padding: 4px 10px; border-radius: 5px; cursor: pointer; font-size: 11px; }
    .qc-empty-msg { font-size: 13px; color: #aaa; text-align: center; padding: 20px; }

    .qc-nav-bar {
        position: fixed; bottom: 0; left: 0; right: 0;
        display: flex; gap: 8px; padding: 12px 16px;
        background: #fff; border-top: 1px solid #eef1f8;
        box-shadow: 0 -4px 16px rgba(0,0,0,.07);
        z-index: 200;
        max-width: 680px; margin: 0 auto;
    }
    .qc-nav-btn {
        flex: 1; padding: 13px 0; border-radius: 10px;
        font-size: 14px; font-weight: 700; border: none;
        cursor: pointer; transition: all .2s;
    }
    .btn-back { background: #f0f3f8; color: #555; }
    .btn-back:hover { background: #e8eef8; }
    .btn-skip { background: #f8f0ff; color: #7c3aed; flex: 0 0 auto; padding: 13px 20px; }
    .btn-draft { background: #fff7e6; color: #b45309; border: 1.5px solid #fcd34d !important; flex: 0 0 auto; padding: 13px 16px; }
    .btn-draft:hover { background: #fef3c7; }
    .btn-draft.saving, .btn-draft:disabled { opacity: .6; cursor: not-allowed; }
    .qc-draft-banner { max-width: 680px; margin: 10px auto 0; background: #fffbeb; border: 1px solid #fcd34d; color: #92400e;
        border-radius: 10px; padding: 8px 14px; font-size: 12.5px; font-weight: 600; }
    .btn-next { background: #2D7DD2; color: #fff; box-shadow: 0 4px 12px rgba(45,125,210,.3); }
    .btn-next:hover { background: #1a5fa8; }
    .btn-done { background: linear-gradient(135deg, #27ae60, #1e8449); color: #fff;
        box-shadow: 0 4px 12px rgba(39,174,96,.35); }
    .btn-done:hover { box-shadow: 0 6px 18px rgba(39,174,96,.45); }
    .btn-done.saving { opacity: .7; cursor: not-allowed; }
    /* Nút Review — màu tím nhẹ để phân biệt với Done (xanh) và Next (xanh dương) */
    .btn-review {
        background: linear-gradient(135deg, #6366f1, #4f46e5);
        color: #fff;
        flex: 0 0 auto;
        padding: 13px 18px;
        box-shadow: 0 4px 12px rgba(99,102,241,.3);
    }
    .btn-review:hover { box-shadow: 0 6px 18px rgba(99,102,241,.45); }
    .btn-review.saving { opacity: .7; cursor: not-allowed; }
    .btn-review:disabled { opacity: .55; cursor: not-allowed; }

    .qc-toast {
        position: fixed; bottom: 80px; left: 50%; transform: translateX(-50%);
        padding: 10px 24px; border-radius: 30px; font-size: 13px; font-weight: 600;
        box-shadow: 0 4px 14px rgba(0,0,0,.2); z-index: 300; white-space: normal;
        width: max-content; max-width: calc(100vw - 32px); text-align: center; line-height: 1.35; border-radius: 18px;
        animation: fadeIn .3s;
    }
    .toast-ok  { background: #27ae60; color: #fff; }
    .toast-err { background: #e74c3c; color: #fff; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateX(-50%) translateY(10px); } }

    .qc-photo-spinner {
        display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;
        width:100%;height:100%;
    }
    .qc-spinner-ring {
        width:28px;height:28px;border:3px solid #dce6f8;
        border-top-color:#2D7DD2;border-radius:50%;
        animation:qcSpin .8s linear infinite;
    }
    @@keyframes qcSpin { to { transform:rotate(360deg); } }

    .qc-outer-packing-block {
        background: #f8faff; border: 1px solid #dce6f8; border-radius: 10px;
        padding: 12px 14px; margin-bottom: 14px;
    }
    .qc-outer-packing-title {
        font-size: 11px; font-weight: 700; color: #2D7DD2; letter-spacing: .06em;
        text-transform: uppercase; margin-bottom: 10px;
    }
    .qc-outer-packing-row {
        display: flex; gap: 12px;
    }
    .qc-outer-packing-item {
        flex: 1; display: flex; flex-direction: column; gap: 4px;
    }
    .qc-outer-packing-lbl {
        font-size: 10px; font-weight: 700; color: #888; text-transform: uppercase; letter-spacing: .04em;
    }
    .qc-outer-packing-val {
        font-size: 14px; font-weight: 600; color: #1a1a2e;
        background: #fff; border: 1px solid #dce6f8; border-radius: 8px;
        padding: 8px 12px;
    }

    .qc-error { display: flex; flex-direction: column; align-items: center; padding: 60px 20px; gap: 14px; color: #888; }
    .qc-error button { background: #2D7DD2; color: #fff; border: none;
        border-radius: 8px; padding: 10px 24px; cursor: pointer; font-size: 14px; }

    @@media (min-width: 640px) {
        /* căn giữa vùng nội dung (trừ menu dọc bên trái) */
        .qc-nav-bar { left: calc(var(--content-left, 0px) + (100% - var(--content-left, 0px)) / 2); transform: translateX(-50%); right: auto; width: 100%; }
        .qc-info-lbl { min-width: 160px; font-size: 13px; }
    }

    /* ── Test Protocol View Button ── */
    .proto-view-btn {
        display: inline-flex; align-items: center; gap: 5px;
        background: #e8f0fe; color: #1565c0;
        border: 1px solid #c5d8f8; border-radius: 8px;
        padding: 5px 12px; font-size: 12px; font-weight: 600;
        cursor: pointer; white-space: nowrap; flex-shrink: 0;
        transition: all .15s;
    }
    .proto-view-btn:hover { background: #1565c0; color: #fff; border-color: #1565c0; }

    /* ── Test Protocol Popup ── */
    .proto-backdrop {
        position: fixed; inset: 0; background: rgba(0,0,0,.45);
        display: flex; align-items: center; justify-content: center;
        z-index: 2000; padding: 20px;
    }
    .proto-modal {
        background: #fff; border-radius: 16px;
        width: 100%; max-width: 520px;
        box-shadow: 0 20px 60px rgba(0,0,0,.25);
        display: flex; flex-direction: column; max-height: 80vh;
    }
    .proto-modal-header {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 20px 12px;
        border-bottom: 1px solid #eef0f5;
    }
    .proto-modal-title {
        font-size: 15px; font-weight: 700; color: #1a1a2e;
    }
    .proto-close-btn {
        background: none; border: none; font-size: 18px; color: #aaa;
        cursor: pointer; line-height: 1; padding: 2px 6px;
    }
    .proto-close-btn:hover { color: #333; }
    .proto-modal-body {
        padding: 18px 20px; overflow-y: auto; flex: 1;
        font-size: 14px; color: #333; line-height: 1.7;
        white-space: pre-wrap;
    }
    .proto-modal-footer {
        padding: 12px 20px 16px;
        border-top: 1px solid #eef0f5;
        display: flex; justify-content: flex-end;
    }
    .proto-ok-btn {
        background: #2D7DD2; color: #fff; border: none;
        border-radius: 10px; padding: 9px 24px;
        font-size: 14px; font-weight: 600; cursor: pointer;
        transition: background .15s;
    }
    .proto-ok-btn:hover { background: #1565c0; }

    /* ── Exit confirm dialog ── */
    .qc-exit-modal { max-width: 380px; }
    .qc-exit-footer { gap: 10px; }
    .proto-cancel-btn {
        background: #fff; color: #555; border: 1px solid #d5d8e0;
        border-radius: 10px; padding: 9px 24px;
        font-size: 14px; font-weight: 600; cursor: pointer;
        transition: background .15s, border-color .15s;
    }
    .proto-cancel-btn:hover { background: #f3f4f7; border-color: #b9bdc9; }

    /* ── Remark row (preview + View button) ── */
    .qc-remark-row {
        border: 1.5px solid #e53935;
        border-radius: 8px;
        padding: 8px 12px;
        margin-top: 4px;
        background: #fff5f5;
        align-items: flex-start;
    }
    .qc-remark-lbl { color: #e53935; font-weight: 700; }
    .qc-remark-val {
        color: #e53935; font-weight: 500;
        display: inline-flex; align-items: center; gap: 8px;
        flex-wrap: wrap; line-height: 1.5;
    }
    .qc-remark-preview { word-break: break-word; }
    .qc-remark-view-btn {
        display: inline-flex; align-items: center; gap: 4px;
        background: #fff;
        color: #e53935;
        border: 1px solid #e53935;
        border-radius: 7px;
        padding: 3px 10px;
        font-size: 12px; font-weight: 600;
        cursor: pointer; white-space: nowrap; flex-shrink: 0;
        transition: all .15s;
        -webkit-tap-highlight-color: transparent;
    }
    .qc-remark-view-btn:hover {
        background: #e53935; color: #fff;
    }

    /* ── Remark full-width (label trên, nội dung xuống dòng, hiển thị toàn bộ) ── */
    .qc-remark-row-full {
        flex-direction: column;
        align-items: stretch;
        gap: 6px;
        /* Bỏ khung viền và nền — chỉ giữ kiểu chữ đỏ */
        border: none;
        background: transparent;
        padding: 7px 0;
        margin-top: 0;
    }
    .qc-remark-row-full .qc-remark-lbl {
        min-width: 0;
        padding-top: 0;
    }
    .qc-remark-val-full {
        display: block;
        width: 100%;
        white-space: pre-wrap;          /* giữ \n và xuống dòng tự động */
        overflow-wrap: anywhere;        /* break từ siêu dài (Safari OK) */
        word-break: break-word;         /* fallback cho Safari cũ */
        -webkit-hyphens: auto;
        hyphens: auto;
        line-height: 1.6;
        padding-top: 0;
    }

    /* Remark popup tone đỏ để nhất quán với badge */
    .qc-remark-modal-header {
        background: #fff5f5;
        border-bottom-color: #fbd5d5;
    }
    .qc-remark-modal .proto-modal-title { color: #c62828; }
    .qc-remark-modal-body {
        color: #c62828;
        font-weight: 500;
    }

    /* ══════════ Product References list ══════════ */
    .qc-refs-row {
        flex-direction: column;
        align-items: stretch;
        gap: 8px;
    }
    .qc-refs-row .qc-info-lbl {
        min-width: 0;
        padding-top: 0;
    }
    .qc-refs-list {
        display: flex;
        flex-direction: column;
        gap: 6px;
        width: 100%;
    }
    .qc-ref-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 8px 10px;
        background: #f8faff;
        border: 1px solid #e3ecf8;
        border-radius: 8px;
        /* Cho phép wrap khi viewport nhỏ (iPhone SE…) */
        flex-wrap: wrap;
    }
    .qc-ref-info {
        display: flex;
        align-items: center;
        gap: 8px;
        /* min-width:0 — bắt buộc trên Safari để text-overflow trong flex chạy đúng */
        min-width: 0;
        flex: 1 1 200px;
    }
    .qc-ref-no {
        flex-shrink: 0;
        width: 22px; height: 22px;
        display: inline-flex;
        align-items: center; justify-content: center;
        background: #2D7DD2; color: #fff;
        border-radius: 50%;
        font-size: 11px; font-weight: 700;
        font-variant-numeric: tabular-nums;
    }
    .qc-ref-text {
        display: flex; flex-direction: column;
        min-width: 0;        /* Safari fix: cho ellipsis trong flex */
        flex: 1 1 auto;
    }
    .qc-ref-name {
        font-size: 13px; font-weight: 600; color: #1a1a2e;
        line-height: 1.35;
        overflow-wrap: anywhere;
        word-break: break-word;
    }
    .qc-ref-fname {
        font-size: 11px; color: #7a8aa0;
        margin-top: 2px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
    .qc-ref-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-shrink: 0;
    }
    .qc-ref-btn {
        display: inline-flex;
        align-items: center; justify-content: center;
        gap: 4px;
        padding: 5px 10px;
        font-size: 12px; font-weight: 600;
        border-radius: 7px;
        border: 1px solid transparent;
        cursor: pointer;
        white-space: nowrap;
        text-decoration: none;
        line-height: 1;
        transition: background .15s, color .15s, border-color .15s, box-shadow .15s;
        /* iOS Safari: tắt highlight xanh khi tap, tắt callout menu */
        -webkit-tap-highlight-color: transparent;
        -webkit-touch-callout: none;
        /* Reset default button styling cho Safari */
        -webkit-appearance: none;
        appearance: none;
        font-family: inherit;
    }
    .qc-ref-view {
        background: #fff;
        color: #2D7DD2;
        border-color: #2D7DD2;
    }
    .qc-ref-view:hover,
    .qc-ref-view:active {
        background: #2D7DD2; color: #fff;
    }
    .qc-ref-dl {
        background: #2D7DD2;
        color: #fff;
        border-color: #2D7DD2;
    }
    .qc-ref-dl:hover,
    .qc-ref-dl:active {
        background: #1a5fa8; border-color: #1a5fa8;
    }
    .qc-ref-nofile {
        font-size: 11px; color: #bbb; font-style: italic;
    }

    /* Mobile (iPhone) — gọn nút */
    @@media (max-width: 480px) {
        .qc-ref-item { padding: 8px; gap: 8px; }
        .qc-ref-actions { width: 100%; justify-content: flex-end; }
        .qc-ref-btn { padding: 6px 10px; font-size: 12px; }
    }
    /* Tren man hep (duoi 360px): icon-only de khoi tran */
    @@media (max-width: 360px) {
        .qc-ref-btn span { display: none; }
        .qc-ref-btn { padding: 6px 8px; }
    }

    /* ══════════ Image Viewer Popup ══════════ */
    /* Click vào ảnh đã chụp/upload để xem phóng to. */
    .qc-photo-img {
        cursor: zoom-in;
        -webkit-tap-highlight-color: transparent;
    }
    .qc-img-backdrop {
        position: fixed; inset: 0;
        background: rgba(0,0,0,.88);
        z-index: 3000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
        /* fade-in nhẹ */
        animation: qcImgFade .15s ease-out;
        -webkit-tap-highlight-color: transparent;
    }
    @@keyframes qcImgFade {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
    .qc-img-preview {
        max-width: 100%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        border-radius: 8px;
        box-shadow: 0 10px 40px rgba(0,0,0,.5);
        cursor: zoom-out;
        /* iOS Safari: tránh chọn / kéo ảnh */
        -webkit-user-select: none;
        user-select: none;
        -webkit-touch-callout: none;
    }
    .qc-img-close-btn {
        position: fixed;
        top: 16px; right: 16px;
        width: 40px; height: 40px;
        border-radius: 50%;
        background: rgba(255,255,255,.15);
        color: #fff;
        border: 1px solid rgba(255,255,255,.3);
        font-size: 20px;
        font-weight: 600;
        line-height: 1;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: background .15s, transform .15s;
        -webkit-tap-highlight-color: transparent;
        -webkit-appearance: none;
        appearance: none;
        z-index: 3001;
    }
    .qc-img-close-btn:hover,
    .qc-img-close-btn:active {
        background: rgba(255,255,255,.28);
        transform: scale(1.05);
    }
    /* Mobile: nút gần mép trên hơn */
    @@media (max-width: 480px) {
        .qc-img-close-btn { top: 12px; right: 12px; width: 36px; height: 36px; font-size: 18px; }
        .qc-img-backdrop  { padding: 12px; }
    }

    /* ════════════════ Review Report Modal ════════════════ */
    /* Full-screen iframe cho phép inspector xem trước báo cáo trước khi bấm Done */
    .qc-review-backdrop {
        position: fixed; inset: 0;
        background: #f3f6fb;
        z-index: 3500;
        display: flex;
        flex-direction: column;
        animation: qcImgFade .15s ease-out;
    }
    .qc-review-toolbar {
        flex: 0 0 auto;
        height: 52px;
        padding: 0 16px;
        background: #1a5fa8;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 2px 8px rgba(0,0,0,.18);
    }
    .qc-review-title {
        font-size: 14px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }
    .qc-review-close-btn {
        background: rgba(255,255,255,.15);
        color: #fff;
        border: 1px solid rgba(255,255,255,.3);
        border-radius: 6px;
        padding: 7px 14px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s;
        -webkit-appearance: none;
        appearance: none;
    }
    .qc-review-close-btn:hover,
    .qc-review-close-btn:active {
        background: rgba(255,255,255,.28);
    }
    .qc-review-frame-wrap {
        flex: 1 1 auto;
        overflow: hidden;
        background: #f3f6fb;
        position: relative;
    }
    .qc-review-frame {
        width: 100%;
        height: 100%;
        border: none;
        background: #fff;
    }
    @@media (max-width: 480px) {
        .qc-review-toolbar { height: 46px; padding: 0 10px; }
        .qc-review-title   { font-size: 12px; }
        .qc-review-close-btn { padding: 6px 10px; font-size: 12px; }
    }

    /* ════════════════ Defect Form (UI mới) ════════════════ */
    .qc-defect-form {
        background: #fafcff;
        border: 1px solid #e0e8f5;
        border-radius: 10px;
        padding: 14px;
        margin-bottom: 16px;
    }
    .qc-defect-form-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: flex-end;
    }
    .qc-defect-field {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }
    .qc-defect-lbl {
        font-size: 11px;
        font-weight: 700;
        color: #2D7DD2;
        text-transform: uppercase;
        letter-spacing: .04em;
    }
    .qc-input,
    .qc-defect-form .qc-select {
        height: 38px;
        padding: 6px 10px;
        border: 1px solid #dce6f8;
        border-radius: 8px;
        font-size: 13px;
        background: #fff;
        outline: none;
        color: #1a1a2e;
        box-sizing: border-box;
        width: 100%;
    }
    .qc-input:focus,
    .qc-defect-form .qc-select:focus {
        border-color: #2D7DD2;
    }
    .qc-defect-capture-box {
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        height: 80px;
        background: #f0f5ff;
        border: 2px dashed #b0c8f0;
        border-radius: 8px;
        cursor: pointer;
        overflow: hidden;
    }
    .qc-defect-capture-clear {
        position: absolute;
        top: 4px; right: 4px;
        background: rgba(0,0,0,.55);
        color: #fff;
        border: none;
        border-radius: 50%;
        width: 22px; height: 22px;
