    async Task<string> UploadPhoto(InputFileChangeEventArgs e)
    {
        if (e.File == null) return "";
        try
        {
            // Đọc HẾT nội dung file vào bộ nhớ ngay lập tức, trước mọi thao tác khác (gửi mạng chậm ở xưởng).
            // Việc đọc file đi qua thẻ <input> của InputFile; nếu chờ đọc trong lúc gửi HTTP mà trang render lại
            // gỡ thẻ đó khỏi DOM thì JS báo "Cannot read properties of null (reading '_blazorFilesById')".
            var file = await ImageShrink.ShrinkAsync(e.File);   // thu nhỏ trên trình duyệt → upload nhanh
            const long maxSize = 10 * 1024 * 1024; // 10MB
            byte[] bytes;
            await using (var src = file.OpenReadStream(maxSize))
            using (var ms = new MemoryStream())
            {
                await src.CopyToAsync(ms);
                bytes = ms.ToArray();
            }
            using var content2 = new MultipartFormDataContent();
            var bc = new ByteArrayContent(bytes);
            bc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                string.IsNullOrEmpty(file.ContentType) ? "image/jpeg" : file.ContentType);
            content2.Add(bc, "file", file.Name);
            var resp = await Http.PostAsync("api/upload/photo", content2);
            if (!resp.IsSuccessStatusCode)
            {
                _saveMsg = T("InspectionQC.UploadFailed", (int)resp.StatusCode);
                _saveError = true;
                return "";
            }
            var result = await resp.Content.ReadFromJsonAsync<UploadResult>();
            return result?.Url ?? "";
        }
        catch (Exception ex)
        {
            _saveMsg = T("InspectionQC.UploadError", ex.Message);
            _saveError = true;
            return "";
        }
    }

