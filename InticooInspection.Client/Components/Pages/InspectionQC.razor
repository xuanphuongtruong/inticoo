        public string EmailTo    { get; set; } = "";
        public string EmailError { get; set; } = "";
    }
}

<!-- ═══════════════════════ STYLES ═══════════════════════ -->
<style>
    .qc-gal { margin-bottom: 4px; }
    .qc-gal-main { position: relative; background: #f3f5f9; border: 1px solid #dde4ef; border-radius: 12px; height: 240px; display: flex; align-items: center; justify-content: center; cursor: zoom-in; overflow: hidden; }
    .qc-gal-img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .qc-gal-zoom { position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,.55); color: #fff; border-radius: 50%; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; font-size: 14px; }
    .qc-gal-count { position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,.55); color: #fff; border-radius: 10px; padding: 2px 8px; font-size: 12px; }
    .qc-gal-thumbs { display: flex; gap: 8px; margin-top: 8px; overflow-x: auto; }
    .qc-gal-thumb { width: 64px; height: 64px; object-fit: cover; border-radius: 8px; border: 2px solid #dde4ef; cursor: pointer; flex-shrink: 0; }
    .qc-gal-thumb.on { border-color: #1e90d6; }
    .qc-lb { position: fixed; inset: 0; background: rgba(0,0,0,.6); z-index: 3000; display: flex; align-items: center; justify-content: center; padding: 12px; }
    .qc-lb-box { background: #000; border-radius: 14px; width: min(720px, 100%); max-height: 92vh; display: flex; flex-direction: column; overflow: hidden; }
    .qc-lb-head { display: flex; justify-content: space-between; align-items: center; color: #fff; padding: 10px 14px; font-weight: 600; }
    .qc-lb-x { background: none; border: none; color: #fff; font-size: 20px; cursor: pointer; }
    .qc-lb-body { position: relative; flex: 1; overflow: auto; background: #fff; display: flex; align-items: flex-start; min-height: 260px; -webkit-overflow-scrolling: touch; }
    /* mobile.css đặt img { max-width:100% } toàn cục → chặn phóng to; flex-shrink:0 để ảnh không bị co về khung;
       margin:auto thay justify-content:center để khi phóng to vẫn cuộn được sang trái */
    .qc-lb-body img { height: auto; display: block; max-width: none !important; flex-shrink: 0; margin: auto; }
    .qc-lb-nav { position: sticky; top: 45%; align-self: flex-start; width: 40px; height: 40px; border-radius: 50%; border: none; background: rgba(60,60,60,.8); color: #fff; font-size: 24px; cursor: pointer; margin: 0 8px; }
    .qc-lb-nav.l { position: absolute; left: 0; top: calc(50% - 20px); }
    .qc-lb-nav.r { position: absolute; right: 0; top: calc(50% - 20px); }
    .qc-lb-foot { display: flex; align-items: center; gap: 10px; padding: 10px 14px; background: #111; }
    .qc-lb-foot input { flex: 1; }
    .qc-lb-foot button { background: #333; color: #fff; border: none; border-radius: 50%; width: 32px; height: 32px; font-size: 18px; cursor: pointer; }
    .qc-loading {
        display: flex; flex-direction: column; align-items: center;
        justify-content: center; height: 60vh; gap: 14px; color: #666;
    }
    .qc-spinner {
        width: 36px; height: 36px;
        border: 3px solid #e0e8f8;
        border-top-color: #2D7DD2;
        border-radius: 50%;
        animation: spin .7s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }

    .qc-progress-wrap {
        /* Dán dưới .top-navbar (60px) thay vì đè lên menu chính.
           z-index thấp hơn navbar (40) và dropdown (42) để không che menu. */
        position: sticky; top: var(--topbar-h, 0px); z-index: 30;
        height: 4px; background: #e8eef8;
    }
    .qc-progress-bar {
        height: 4px; background: linear-gradient(90deg, #2D7DD2, #27ae60);
        transition: width .4s ease;
    }

    .qc-header {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px 8px;
        background: #fff;
        border-bottom: 1px solid #eef1f8;
        /* Dán ngay dưới qc-progress-wrap (60px navbar + 4px progress = 64px).
           z-index thấp hơn progress (30) để progress luôn nằm trên. */
        position: sticky; top: calc(var(--topbar-h, 0px) + 4px); z-index: 29;
    }
    .qc-back-btn {
        background: none; border: none; cursor: pointer;
        color: #2D7DD2; padding: 4px; line-height: 0;
        border-radius: 6px; transition: background .15s;
    }
    .qc-back-btn:hover { background: #eef4ff; }
    .qc-header-center { flex: 1; }

    /* Khi navbar mobile thu xuống 52px (max-width:480px) → đẩy 2 element sticky theo */
    @@media (max-width: 480px) {
        .qc-progress-wrap { top: var(--topbar-h, 0px); }
        .qc-header        { top: calc(var(--topbar-h, 0px) + 4px); } /* thanh trên mobile + 4 progress */
    }
    .qc-step-label { font-size: 11px; color: #aab; text-transform: uppercase; letter-spacing: .05em; }
    .qc-step-title { font-size: 15px; font-weight: 700; color: #1a1a2e; margin-top: 1px; }
    .qc-step-counter { font-size: 12px; color: #2D7DD2; font-weight: 700;
        background: #eef4ff; padding: 4px 10px; border-radius: 20px; }

    .qc-dots {
        display: flex; gap: 4px; padding: 8px 16px;
        background: #fff; flex-wrap: wrap;
    }
    .qc-dot {
        width: 6px; height: 6px; border-radius: 50%;
        background: #dde4f0; flex-shrink: 0;
        transition: background .2s, transform .2s;
    }
    .qc-dot.dot-active { background: #2D7DD2; transform: scale(1.4); }
    .qc-dot.dot-done   { background: #27ae60; }

    .qc-body {
        padding: 12px 14px 100px;
        max-width: 680px; margin: 0 auto;
    }
    .qc-card {
        background: #fff;
        border-radius: 14px;
        padding: 16px 16px 12px;
        box-shadow: 0 2px 10px rgba(0,0,0,.07);
