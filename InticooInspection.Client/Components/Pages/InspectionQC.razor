    // ── Save to API ──
    async Task SaveAndDone()
    {
        // Bắt buộc chọn Final Result
        _finalValidated = true;
        if (string.IsNullOrEmpty(_data.FinalResult))
        {
            _saveMsg = T("InspectionQC.PleaseSelectFinalResultPASSEDFAILED");
            _saveError = true;
            StateHasChanged();
            return;
        }
        // Bắt buộc có chữ ký
        _sigValidated = true;
        if (string.IsNullOrEmpty(_data.SignatureUrl))
        {
            _saveMsg = T("InspectionQC.PleaseAddSignatureBeforeCompleting");
            _saveError = true;
            StateHasChanged();
            return;
        }
        _saving = true;
        _saveMsg = "";
        _inspectionEndTime = DateTime.Now;   // chốt giờ kết thúc tại thời điểm bấm Done
        try
        {
            var payload = BuildSavePayload();
            var resp = await Http.PutAsJsonAsync($"api/inspections/{InspectionId}/qc-result", payload);
            if (resp.IsSuccessStatusCode)
            {
                // Parse response để lấy trạng thái email
                var json = await resp.Content.ReadAsStringAsync();
                var result = System.Text.Json.JsonSerializer.Deserialize<SaveQcResponse>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                if (result?.EmailSent == true)
                    _saveMsg = T("InspectionQC.SavedNotificationEmailSentTo", result.EmailTo);
                else if (!string.IsNullOrEmpty(result?.EmailError))
                    _saveMsg = T("InspectionQC.SavedEmailNotSent", result.EmailError);
                else
                    _saveMsg = T("InspectionQC.SavedSuccessfully");

                _saveError = false;
                StateHasChanged();
                await Task.Delay(3000);
                Navigation.NavigateTo("/inspection-schedule");
            }
            else
            {
                _saveMsg = T("InspectionQC.SaveFailed", (int)resp.StatusCode, await resp.Content.ReadAsStringAsync());
                _saveError = true;
            }
        }
        catch (Exception ex)
        {
            _saveMsg = ex.Message;
            _saveError = true;
        }
        _saving = false;
        StateHasChanged();
    }

