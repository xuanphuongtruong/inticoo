    // ── Khôi phục dữ liệu QC đã lưu (draft hoặc lần trước) từ QcResultJson ──
    string? _draftRestoredAt;
    void RestoreSavedQc()
    {
        if (_inspection == null || string.IsNullOrWhiteSpace(_inspection.QcResultJson)) return;
        SavedQc? s;
        try
        {
            s = JsonSerializer.Deserialize<SavedQc>(_inspection.QcResultJson,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch { return; }
        if (s == null) return;

        static List<string> Pad(List<string>? src, int n)
        {
            var l = (src ?? new()).Where(x => x != null).ToList();
            while (l.Count < n) l.Add("");
            return l;
        }

        if (s.InspectionStartTime.HasValue) _inspectionStartTime = s.InspectionStartTime.Value.ToLocalTime();
        _data.FinalResult       = _inspection.FinalResult ?? "";
        _data.InspectorComments = _inspection.InspectorComments ?? "";
        _data.SignatureUrl      = _inspection.SignatureUrl;

        foreach (var oc in s.OverallConclusions ?? new())
        {
            var t = _data.OverallConclusions.FirstOrDefault(x => x.Letter == oc.Letter);
            if (t == null) continue;
            t.Compliance = (oc.Compliance is "None" or "NA" or null) ? "" : oc.Compliance;
            t.Remark     = oc.Remark ?? "";
        }

        if (s.QuantityConformity != null)
        {
            var q = s.QuantityConformity;
            q.Photos = Pad(q.Photos, 3);
            _data.QuantityConformity = q;
        }

        if (s.Packaging != null)
        {
            var p = s.Packaging;
            _data.Packaging.CartonSizeResult   = p.CartonSizeResult   ?? "";
            _data.Packaging.ShippingMarkResult = p.ShippingMarkResult ?? "";
            _data.Packaging.CartonWeightResult = p.CartonWeightResult ?? "";
            _data.Packaging.PkgLabelResult     = p.PkgLabelResult     ?? "";
            _data.Packaging.AssemblyResult     = p.AssemblyResult     ?? "";
            _data.Packaging.HardwareResult     = p.HardwareResult     ?? "";
            foreach (var sc in p.CartonDataList ?? new())
            {
                var t = _data.Packaging.CartonDataList.FirstOrDefault(x => x.CartonIndex == sc.CartonIndex);
                if (t == null) continue;
                t.SizeL = sc.SizeL; t.SizeW = sc.SizeW; t.SizeH = sc.SizeH; t.Weight = sc.Weight;
                t.CartonSizeResult   = sc.CartonSizeResult   ?? "";
                t.ShippingMarkResult = sc.ShippingMarkResult ?? "";
                t.CartonWeightResult = sc.CartonWeightResult ?? "";
                t.PkgLabelResult     = sc.PkgLabelResult     ?? "";
                t.AssemblyResult     = sc.AssemblyResult     ?? "";
                t.AssemblyIncluded     = sc.AssemblyIncluded     ?? "";
                t.AssemblyType         = sc.AssemblyType         ?? "";
                t.AssemblyLanguage     = sc.AssemblyLanguage     ?? "";
                t.AssemblyPages        = sc.AssemblyPages        ?? "";
                t.AssemblyPrintQuality = sc.AssemblyPrintQuality ?? "";
                t.AssemblyRemark       = sc.AssemblyRemark       ?? "";
                t.HardwareResult     = sc.HardwareResult     ?? "";
                t.HardwareQuantity   = sc.HardwareQuantity   ?? "";
                t.HardwarePackaging  = sc.HardwarePackaging  ?? "";
                t.HardwareQuality    = sc.HardwareQuality    ?? "";
                t.HardwareRemark     = sc.HardwareRemark     ?? "";
                t.HangtagIncluded     = sc.HangtagIncluded     ?? "";
                t.HangtagType         = sc.HangtagType         ?? "";
                t.HangtagShape        = sc.HangtagShape        ?? "";
                t.HangtagSizeL        = sc.HangtagSizeL        ?? "";
                t.HangtagSizeW        = sc.HangtagSizeW        ?? "";
                t.HangtagMaterial     = sc.HangtagMaterial     ?? "";
                t.HangtagPrintQuality = sc.HangtagPrintQuality ?? "";
                t.HangtagLanguage     = sc.HangtagLanguage     ?? "";
                t.HangtagQuantity     = sc.HangtagQuantity     ?? "";
                t.HangtagRemark       = sc.HangtagRemark       ?? "";
                t.HangtagPhotos       = Pad(sc.HangtagPhotos, 3);
                t.SizePhotos         = Pad(sc.SizePhotos, 3);
                t.ShippingMarkPhotos = Pad(sc.ShippingMarkPhotos, 3);
                t.WeightPhotos       = Pad(sc.WeightPhotos, 3);
                t.PkgLabelPhotos     = Pad(sc.PkgLabelPhotos, 3);
                t.AssemblyPhotos     = Pad(sc.AssemblyPhotos, 3);
                t.HardwarePhotos     = Pad(sc.HardwarePhotos, 3);
            }
        }

        if (s.ProductSpec != null)
        {
            var ps = s.ProductSpec;
            _data.ProductSpec.AdditionalText = ps.AdditionalText ?? "";
            _data.ProductSpec.SizeRemark     = ps.SizeRemark     ?? "";
            _data.ProductSpec.SizeResult     = ps.SizeResult     ?? "";
            _data.ProductSpec.GoldenRemark   = ps.GoldenRemark   ?? "";
            _data.ProductSpec.GoldenResult   = ps.GoldenResult   ?? "";
            _data.ProductSpec.SizePhotos     = Pad(ps.SizePhotos, 4);
            _data.ProductSpec.GoldenPhotos   = Pad(ps.GoldenPhotos, 3);
            _data.ProductSpec.SwatchPhotos   = Pad(ps.SwatchPhotos, 3);
            if (ps.SpecL > 0 || ps.SpecW > 0 || ps.SpecH > 0)
            {
                _data.ProductSpec.SpecL = ps.SpecL; _data.ProductSpec.SpecW = ps.SpecW; _data.ProductSpec.SpecH = ps.SpecH;
            }
            _data.ProductSpec.ProductWeight       = ps.ProductWeight;
            _data.ProductSpec.ProductWeightResult = ps.ProductWeightResult ?? "";
            _data.ProductSpec.ProductWeightPhotos = Pad(ps.ProductWeightPhotos, 2);
            _data.ProductSpec.GoldenQty           = ps.GoldenQty;
            if (ps.SizeRows?.Any() == true)
            {
                _data.ProductSpec.SizeRows = ps.SizeRows;
                while (_data.ProductSpec.SizeRows.Count < 3) _data.ProductSpec.SizeRows.Add(new QcSizeRow());
            }
            foreach (var cs in ps.ColourSwatches ?? new())
            {
                var t = _data.ProductSpec.ColourSwatches.FirstOrDefault(x => x.No == cs.No);
                if (t == null) continue;
                t.Remark = cs.Remark ?? "";
                t.Result = cs.Result ?? "";
            }
        }

        if (s.Aql != null)
        {
            _data.Aql.Result = s.Aql.Result ?? "";
        }

        if (s.PerformanceTests != null)
        {
            for (int i = 0; i < s.PerformanceTests.Count && i < _data.PerformanceTests.Count; i++)
            {
                var src = s.PerformanceTests[i];
                var t   = _data.PerformanceTests[i];
                t.TestQuantity = src.TestQuantity;
                t.Remark       = src.Remark ?? "";
                t.Result       = src.Result ?? "";
                t.Photos       = Pad(src.Photos, 4);
            }
        }

        if (s.Defects != null)
        {
            _data.Defects = s.Defects.Select(d => new QcDefect
            {
                Type       = d.Type ?? "",
                DefectCode = d.DefectCode,
                Photos     = d.Photos ?? new(),
                Remarks    = d.Remarks ?? new()
            }).ToList();
            FlattenDefectsForNewUi();
            RecalcDefectCounts();
        }

        if (s.LastStep is int ls0 && ls0 > 0 && _inspection.Status != "Completed")
        {
            // Bản nháp lưu trước khi tách "Product Weight" thành bước riêng (không có stepSchema):
            // các bước từ sau C-i đã lệch 1 → dịch tới đúng bước.
            int ls = (s.StepSchema ?? 1) < 2 && ls0 >= 5 + _cartonCount * B_STEPS_PER_CARTON ? ls0 + 1 : ls0;
            if (ls >= _steps.Count) ls = _steps.Count - 1;
            _currentStepIdx  = ls;
            _draftRestoredAt = T("InspectionQC.DraftRestoredContinuingAtStep", ls + 1, _steps.Count);
        }
    }

