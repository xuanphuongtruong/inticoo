        cursor: default !important;
        border-style: solid;
        border-color: #dce6f8;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

    .qc-photo3-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin: 10px 0;
    }
    .qc-photo-box3 {
        aspect-ratio: 1/1; background: #f0f5ff;
        border: 2px dashed #b0c8f0; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; overflow: hidden;
        min-height: 80px; transition: border-color .2s;
        position: relative;
        width: 100%;
        min-width: 0;
    }
    .qc-photo-box3.tall { aspect-ratio: 3/4; }
    .qc-photo-box3:hover { border-color: #2D7DD2; }

    /* Mobile nhỏ: vẫn giữ 3 cột nhưng gap nhỏ lại để ảnh không quá bé */
    @@media (max-width: 380px) {
        .qc-photo-row  { gap: 6px; }
        .qc-photo3-row { gap: 5px; }
    }

    .qc-info-table { margin-bottom: 6px; }
    .qc-info-row {
        display: flex; align-items: flex-start; gap: 10px;
        padding: 7px 0;
        border-bottom: 1px solid #f2f5fb;
    }
