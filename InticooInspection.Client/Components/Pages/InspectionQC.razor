        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    .qc-photo-del {
        position: absolute; top: 4px; right: 4px;
        background: rgba(0,0,0,.55); color: #fff;
        border: none; border-radius: 50%;
