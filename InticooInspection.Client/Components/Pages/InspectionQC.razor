    }
    .qc-section-title {
        font-size: 13px; font-weight: 700; color: #2D7DD2;
        text-transform: uppercase; letter-spacing: .05em;
        margin-bottom: 12px; padding-bottom: 6px;
        border-bottom: 2px solid #eef4ff;
    }

    /* ── Photo grids: cố định 3 ảnh/hàng, ảnh thừa tự xuống hàng mới ── */
    .qc-photo-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
        margin-bottom: 14px;
    }
    .qc-photo-box {
        aspect-ratio: 4/3; background: #f0f5ff;
        border: 2px dashed #b0c8f0; border-radius: 10px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; overflow: hidden; transition: border-color .2s;
        position: relative;
        width: 100%;
        min-width: 0;
