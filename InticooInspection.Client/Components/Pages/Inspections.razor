@page "/inspections"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Authorization
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject AuthenticationStateProvider AuthStateProvider
@using InticooInspection.Client.Services
@inject WaitingService Waiting
@inject PageAccessService PageAccess
@inherits LocalizedComponentBase

<PageTitle>@T("Inspections.SummaryInspectionsInticoo")</PageTitle>

<div class="page-container lp">

    <div class="lp-head">
        <div class="title-block">
            <h1 class="page-title">@T("Inspections.SummaryInspections")</h1>
            <span class="page-sub">@T("Inspections.Subtitle")</span>
        </div>
        @if (PageAccess.Can("JobRequest", "Create"))
        {
        <button class="btn-add" @onclick="GoToNew">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M10 4v12M4 10h12" stroke-linecap="round"/>
            </svg>
            @T("Common.NewInspection")
        </button>
        }
    </div>

    <!-- Filters -->
    <div class="top-bar lp-filters @(_fOpen ? "fopen" : "")">
        <div class="search-wrap">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="9" cy="9" r="6"/><path d="M15 15l-3.5-3.5" stroke-linecap="round"/>
            </svg>
            <input class="search-input" type="text" placeholder="@T("Inspections.SearchJobNoCustomerProductInspector")"
                   @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKeyUp" />
        </div>
    <button type="button" class="lp-filter-toggle @(_fOpen ? "on" : "")" @onclick="() => _fOpen = !_fOpen" aria-label="@T("Common.Filters")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></svg></button>
        <div class="lp-dates">
            <select class="filter-select" @bind="_dateField" @bind:after="() => LoadPage(1)" title="@T("Inspections.DateType")">
                <option value="inspection">@T("Common.InspectionDate")</option>
                <option value="receive">@T("Inspections.ReceiveDate")</option>
            </select>
            <DateFilter @bind-Value="_dateFrom" @bind-Value:after="() => LoadPage(1)" Placeholder="@T("Inspections.FromDate")" />
            <span class="lp-arrow">&rarr;</span>
            <DateFilter @bind-Value="_dateTo" @bind-Value:after="() => LoadPage(1)" Placeholder="@T("Inspections.ToDate")" />
            @if (_dateFrom.HasValue || _dateTo.HasValue)
            {
                <button class="btn-clear-date" @onclick="ClearDateRange" title="@T("Inspections.ClearDateFilter")">✕</button>
            }
        </div>
        <div class="lp-selects">
            <select class="filter-select" @bind="_statusFilter" @bind:after="() => LoadPage(1)">
                <option value="">@T("Common.AllStatus")</option>
                <option value="New">@T("Inspections.New")</option>
                <option value="Delay">@T("Inspections.Delay")</option>
                <option value="Completed">@T("Common.Completed")</option>
                <option value="Cancel">@T("Common.Cancel")</option>
                <option value="Draft">@T("Status.Draft")</option>
            </select>
            <select class="filter-select" @bind="_categoryFilter" @bind:after="() => LoadPage(1)">
                <option value="">@T("Common.AllCategories")</option>
                @foreach (var c in Taxonomy.MainCategories) { <option value="@c">@TE("Opt", c)</option> }
            </select>
            <select class="filter-select" @bind="_typeFilter" @bind:after="() => LoadPage(1)">
                <option value="">@T("Inspections.AllTypes")</option>
                @foreach (var ty in new[] { "DPI", "PPT", "PST" }) { <option value="@ty">@TE("Opt", ty)</option> }
            </select>
            @if (!_isCustomer)
            {
            <select class="filter-select" @bind="_customerFilter" @bind:after="() => LoadPage(1)">
                <option value="">@T("Inspections.AllCustomers")</option>
                @foreach (var c in _custOpts) { <option value="@c.Key">@c.Value</option> }
            </select>
            }
            <select class="filter-select" @bind="_vendorFilter" @bind:after="() => LoadPage(1)">
                <option value="">@T("Inspections.AllVendors")</option>
                @foreach (var v in _vendOpts) { <option value="@v.Key">@v.Value</option> }
            </select>
        </div>
        <div class="lp-actions">
            <button type="button" class="lp-btn-reset" @onclick="ResetFilters">@T("Common.Reset")</button>
            <button type="button" class="lp-btn-search" @onclick="() => LoadPage(1)">@T("Common.Search")</button>
        </div>
    </div>

    <div class="m-kpis m-kpis4 lp-kpis">
        <div class="m-kpi"><span class="m-kpi-ico k-blue"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/></svg></span><b>@_cntAll</b><small>@T("Customers.KpiTotal")</small></div>
        <div class="m-kpi"><span class="m-kpi-ico k-green"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg></span><b>@_cntCompleted</b><small>@T("Common.Completed")</small></div>
        <div class="m-kpi"><span class="m-kpi-ico k-blue"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><b>@_cntNew</b><small>@T("Inspections.New")</small></div>
        <div class="m-kpi"><span class="m-kpi-ico k-orange"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12M6 21h12M7 3c0 6 10 6 10 18M17 3c0 6-10 6-10 18"/></svg></span><b class="red">@_cntDelay</b><small>@T("Inspections.Delay")</small></div>
        <div class="m-kpi"><span class="m-kpi-ico k-green"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg></span><b>@_cntPass</b><small>@T("Status.Pass")</small></div>
        <div class="m-kpi"><span class="m-kpi-ico k-red"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg></span><b class="red">@_cntFail</b><small>@T("Status.Fail")</small></div>
    </div>
    <div class="m-chips">
        <button type="button" class="@(_statusFilter == "" ? "on" : "")" @onclick='() => SetStatusChip("")'>@T("Customers.ChipAll") (@_cntAll)</button>
        <button type="button" class="@(_statusFilter == "Completed" ? "on" : "")" @onclick='() => SetStatusChip("Completed")'>@T("Common.Completed") (@_cntCompleted)</button>
        <button type="button" class="@(_statusFilter == "New" ? "on" : "")" @onclick='() => SetStatusChip("New")'>@T("Inspections.New") (@_cntNew)</button>
        <button type="button" class="@(_statusFilter == "Delay" ? "on" : "")" @onclick='() => SetStatusChip("Delay")'>@T("Inspections.Delay") (@_cntDelay)</button>
        <button type="button" class="@(_statusFilter == "Cancel" ? "on" : "")" @onclick='() => SetStatusChip("Cancel")'>@T("Common.Cancel") (@_cntCancel)</button>
    </div>

    @if (!string.IsNullOrEmpty(_pageError))
    {
        <div class="alert-err">⚠ @_pageError</div>
    }

    @if (_loading)
    {
        <div class="loading-state">
            <div class="spinner-lg"></div>
            <span>@T("Common.Loading")</span>
        </div>
    }
    else
    {
        <div class="m-cards">
            @if (_inspections.Count == 0)
            {
                <div class="m-empty">@T("Inspections.NoInspectionsFound")</div>
            }
            @foreach (var mi in _inspections)
            {
                var it = mi;
                var idate = it.InspectionDate ?? it.CreatedAt;
                <div class="m-card">
                    <div class="m-card-top">
                        <div class="m-date">
                            <b>@idate.ToString("dd")</b>
                            <span>@L.Date(idate, "MMM")</span>
                            <small>@idate.ToString("yyyy")</small>
                        </div>
                        <div class="m-card-main">
                            <div class="m-card-head">
                                <div class="m-card-name">@(string.IsNullOrEmpty(it.JobNumber) ? "—" : it.JobNumber)</div>
                                <span class="@GetBadgeClass(it.Status)">@GetStatusLabel(it.Status)</span>
                            </div>
                            <div class="m-card-sub">@(string.IsNullOrEmpty(it.CustomerName) ? "—" : it.CustomerName)</div>
                            <div class="m-card-code">@T("Common.PONumber"): @(string.IsNullOrEmpty(it.PoNumber) ? "—" : it.PoNumber)</div>
                        </div>
                    </div>
                    <div class="m-tags">
                        @if (!string.IsNullOrEmpty(it.ProductCategory)) { <span class="m-cat gray"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>@it.ProductCategory</span> }
                        @if (!string.IsNullOrEmpty(it.InspectionType)) { <span class="m-cat">@TE("Opt", it.InspectionType)</span> }
                    </div>
                    <div class="m-card-rows">
                        @if (!string.IsNullOrEmpty(it.VendorName)) { <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="3" width="14" height="18" rx="1.5"/><path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2"/></svg>@it.VendorName</div> }
                        @if (!string.IsNullOrEmpty(it.VendorCountry)) { <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>@it.VendorCountry</div> }
                        @if (!string.IsNullOrEmpty(it.InspectorName)) { <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>@it.InspectorName</div> }
                    </div>
                    @if (it.Status == "Completed")
                    {
                        <div class="m-card-actions">
                            <button type="button" class="m-btn-outline" @onclick="() => GoToReport(it.Id)">@T("Common.ViewReport")</button>
                        </div>
                    }
                    else if (CanAct && CanEdit(it.Status) && CanEditInsp)
                    {
                        <div class="m-card-actions">
                            <button type="button" class="m-btn-fill" @onclick="() => GoToEdit(it.Id)">@T("Common.Edit")</button>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Table -->
        <div class="table-wrap">
            <table class="ptable">
                <thead>
                    <tr>
                        <th class="th-y">No</th>
                        <th class="th-y">@T("Inspections.ReceiveDate")</th>
                        <th class="th-y">@T("Inspections.JobNo")</th>
                        <th class="th-y">@T("Common.PONumber")</th>
                        <th class="th-y">@T("Common.InspectionDate")</th>
                        <th class="th-y">@T("Common.CustomerName")</th>
                        <th class="th-y">@T("Common.Category")</th>
                        <th class="th-y">@T("Common.InspectionType")</th>
                        <th class="th-y">@T("Common.VendorName")</th>
                        <th class="th-y">@T("Inspections.VendorCountry")</th>
                        <th class="th-y">@T("Common.InspectorName")</th>
                        <th class="th-y">@T("Common.Result")</th>
                        <th class="th-y">@T("Common.Status")</th>
                        <th class="th-y">@T("Common.View")</th>
                        @if (CanAct) { <th class="th-y">@T("Common.Action")</th> }
                    </tr>
                </thead>
                <tbody>
                    @if (_inspections.Count == 0)
                    {
                        <tr><td colspan="@(CanAct ? 15 : 14)" class="td-empty">@T("Inspections.NoInspectionsFound")</td></tr>
                    }
                    else
                    {
                        int rowNo = (_page - 1) * _pageSize;
                        @foreach (var item in _inspections)
                        {
                            rowNo++;
                            var it = item;
                            <tr class="@(rowNo % 2 == 1 ? "" : "tr-alt")">
                                <td class="tc td-no">@rowNo</td>
                                <td class="tc">@it.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="tc mono">@(string.IsNullOrEmpty(it.JobNumber) ? "—" : it.JobNumber)</td>
                                <td class="tc mono">@(string.IsNullOrEmpty(it.PoNumber) ? "—" : it.PoNumber)</td>
                                <td class="tc">@(it.InspectionDate.HasValue ? it.InspectionDate.Value.ToString("dd/MM/yyyy") : "—")</td>
                                <td class="tc fw td-co">@(string.IsNullOrEmpty(it.CustomerName) ? "—" : it.CustomerName)</td>
                                <td class="tc">@(string.IsNullOrEmpty(it.ProductCategory) ? "—" : it.ProductCategory)</td>
                                <td class="tc">
                                    @if (!string.IsNullOrEmpty(it.InspectionType))
                                    {
                                        <span class="type-badge">@TE("Opt", it.InspectionType)</span>
                                    }
                                    else { <span class="dash">—</span> }
                                </td>
                                <td class="tc td-co">@(string.IsNullOrEmpty(it.VendorName) ? "—" : it.VendorName)</td>
                                <td class="tc">@(string.IsNullOrEmpty(it.VendorCountry) ? "—" : it.VendorCountry)</td>
                                <td class="tc">@(string.IsNullOrEmpty(it.InspectorName) ? "—" : it.InspectorName)</td>
                                <td class="tc">
                                    @if (string.Equals(it.FinalResult, "PASSED", StringComparison.OrdinalIgnoreCase)) { <span class="res-pass">✓ @T("Status.Pass")</span> }
                                    else if (string.Equals(it.FinalResult, "FAILED", StringComparison.OrdinalIgnoreCase)) { <span class="res-fail">✕ @T("Status.Fail")</span> }
                                    else { <span class="dash">—</span> }
                                </td>
                                <td class="tc">
                                    <span class="@GetBadgeClass(it.Status)">@GetStatusLabel(it.Status)</span>
                                </td>
                                <td class="tc">
                                    @* Cột View: hiển thị cho mọi user khi inspection đã Completed,
                                       để các user không có quyền Admin (không thấy cột Action) vẫn xem được báo cáo *@
                                    @if (it.Status == "Completed")
                                    {
                                        <button class="bico bview bview-report" @onclick="() => GoToReport(it.Id)" title="@T("Common.ViewReport")">
                                            <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                                                <path d="M2 10s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6z" stroke-linecap="round"/>
                                                <circle cx="10" cy="10" r="2.5"/>
                                            </svg>
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="dash">—</span>
                                    }
                                </td>
                                @if (CanAct)
                                {
                                    <td class="tc">
                                        @* Nếu status là New, Delay → cho phép Edit + Delete *@
                                        @if (CanEdit(it.Status))
                                        {
                                            @if (CanEditInsp)
                                            {
                                            <button class="bico bedit" @onclick="() => GoToEdit(it.Id)" title="@T("Common.Edit")">
                                                <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                                                    <path d="M14 2l4 4-10 10H4v-4L14 2z" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            </button>
                                            }
                                            @if (CanDeleteInsp)
                                            {
                                            <button class="bico bdel" @onclick="() => ConfirmDelete(it)" title="@T("Common.Delete")">
                                                <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                                                    <path d="M4 6h12M8 6V4h4v2M7 6v10h6V6" stroke-linecap="round" stroke-linejoin="round"/>
                                                </svg>
                                            </button>
                                            }
                                            @if (CanEditInsp && it.Status != "Draft")
                                            {
                                            <button class="bico bcancel" @onclick="() => ConfirmCancel(it)" title="@T("Common.Cancel")">
                                                <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2">
                                                    <circle cx="10" cy="10" r="7.5"/>
                                                    <path d="M5.5 5.5l9 9" stroke-linecap="round"/>
                                                </svg>
                                            </button>
                                            }
                                        }
                                        else
                                        {
                                            @* Status khác (Cancel, v.v.) → chỉ còn nút View Detail.
                                               Nút View Report cho Completed đã được chuyển sang cột "View"
                                               (luôn hiển thị, không phụ thuộc quyền Admin). *@
                                            @if (it.Status != "Completed")
                                            {
                                                <button class="bico bview" @onclick="() => GoToDetail(it.Id)" title="@T("Common.View")">
                                                    <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8">
                                                        <path d="M2 10s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6z" stroke-linecap="round"/>
                                                        <circle cx="10" cy="10" r="2.5"/>
                                                    </svg>
                                                </button>
                                            }
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (_total > 0)
        {
            <div class="pagination lp-pager">
                <span class="page-info">@T("Inspections.ShowingRange", (_page - 1) * _pageSize + 1, Math.Min(_page * _pageSize, _total), _total)</span>
                <div class="lp-pager-right">
                    <select class="lp-perpage" value="@_pageSize" @onchange="SetPageSize">
                        @foreach (var n in new[] { 10, 20, 50, 100 }) { <option value="@n">@T("Inspections.PerPage", n)</option> }
                    </select>
                    @if (_total > _pageSize)
                    {
                        <button class="page-btn pg" disabled="@(_page == 1)" @onclick="PrevPage">&lsaquo;</button>
                        @foreach (var n in PageNumbers())
                        {
                            var pn = n;
                            @if (pn == 0) { <span class="pg-dots">…</span> }
                            else { <button class="page-btn pg @(pn == _page ? "on" : "")" @onclick="() => LoadPage(pn)">@pn</button> }
                        }
                        <button class="page-btn pg" disabled="@(_page >= TotalPages())" @onclick="NextPage">&rsaquo;</button>
                    }
                </div>
            </div>
        }
    }
</div>

<!-- Delete Confirmation Modal -->
@if (_deleteTarget != null)
{
    <div class="modal-backdrop" @onclick="CancelDelete">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2">
                    <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </div>
            <h3 class="modal-title">@T("Inspections.DeleteInspection")</h3>
            <p class="modal-msg">
                @T("Inspections.AreYouSureYouWantTo2")
                <strong>@(string.IsNullOrEmpty(_deleteTarget.JobNumber) ? $"#{_deleteTarget.Id}" : _deleteTarget.JobNumber)</strong>@T("Inspections.ThisActionCannotBeUndone")
            </p>
            @if (!string.IsNullOrEmpty(_deleteError))
            {
                <div class="modal-err">@_deleteError</div>
            }
            <div class="modal-actions">
                <button class="btn-cancel-modal" @onclick="CancelDelete" disabled="@_deleting">@T("Common.Cancel")</button>
                <button class="btn-del-confirm" @onclick="ExecuteDelete" disabled="@_deleting">
                    @if (_deleting) { <span>@T("Inspections.Deleting")</span> } else { <span>@T("Common.Delete")</span> }
                </button>
            </div>
        </div>
    </div>
}

<!-- Cancel Confirmation Modal -->
@if (_cancelTarget != null)
{
    <div class="modal-backdrop" @onclick="CancelCancelAction">
        <div class="modal-box" @onclick:stopPropagation="true">
            <div class="modal-icon">
                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#d97706" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M8 8l8 8M16 8l-8 8" stroke-linecap="round"/>
                </svg>
            </div>
            <h3 class="modal-title">@T("Inspections.CancelInspection")</h3>
            <p class="modal-msg">
                @T("Inspections.AreYouSureYouWantTo")
                <strong>@(string.IsNullOrEmpty(_cancelTarget.JobNumber) ? $"#{_cancelTarget.Id}" : _cancelTarget.JobNumber)</strong>@T("Inspections.ThisWillMarkInspectionAs") <strong>@T("Inspections.Cancelled")</strong>.
            </p>
            @if (!string.IsNullOrEmpty(_cancelError))
            {
                <div class="modal-err">@_cancelError</div>
            }
            <div class="modal-actions">
                <button class="btn-cancel-modal" @onclick="CancelCancelAction" disabled="@_cancelling">@T("Common.Back")</button>
                <button class="btn-cancel-confirm" @onclick="ExecuteCancel" disabled="@_cancelling">
                    @if (_cancelling) { <span>@T("Inspections.Cancelling")</span> } else { <span>@T("Inspections.ConfirmCancel")</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _fOpen;
    private List<InspectionRow> _inspections = new();
    private bool   _loading      = true;
    private string _search          = "";
    private string _statusFilter    = "";
    private string _categoryFilter  = "";

    // Date range filter
    private string _dateField = "inspection"; // "inspection" | "receive"
    private DateTime? _dateFrom = null;          // bound to <input type="date">
    private DateTime? _dateTo   = null;          // bound to <input type="date">
    private int    _page         = 1;
    private int    _pageSize     = 20;
    private int    _total        = 0;
    private string _pageError    = "";

    // Role-based filter — set khi init, truyền vào URL
    private string _typeFilter = "", _customerFilter = "", _vendorFilter = "";
    private List<KeyValuePair<string,string>> _custOpts = new(), _vendOpts = new();
    private string _filterInspectorId = "";
    private string _filterCustomerId  = "";
    private bool   _isCustomer        = false;  // dùng để ẩn Action column

    // Quyền theo module (màn Create/Edit User): Edit/Cancel = Job Request Edit; Delete = Job Request hoặc Summary Delete
    private bool CanEditInsp   => PageAccess.Can("JobRequest", "Edit");
    private bool CanDeleteInsp => PageAccess.Can("JobRequest", "Delete") || PageAccess.Can("SummaryInspections", "Delete");
    private bool CanAct        => CanEditInsp || CanDeleteInsp;

    // Delete state
    private InspectionRow? _deleteTarget = null;
    private bool           _deleting     = false;
    private string         _deleteError  = "";

    // Cancel state
    private InspectionRow? _cancelTarget = null;
    private bool           _cancelling   = false;
    private string         _cancelError  = "";

    protected override async Task OnInitializedAsync()
    {
        await PageAccess.EnsureLoadedAsync();
        _ = LoadFilterOptions();

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user      = authState.User;

        if (user.IsInRole("Inspector") || user.IsInRole("Customer"))
        {
            _isCustomer = user.IsInRole("Customer");

            // Lấy username từ claims (tên chuẩn của Identity)
            var username = user.Identity?.Name
                        ?? user.FindFirst("name")?.Value
                        ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                        ?? "";

            Console.WriteLine($"[Inspections] Role filter — username={username}, isCustomer={_isCustomer}");

            if (!string.IsNullOrEmpty(username))
            {
                try
                {
                    var token = await SessionStorage.GetItemAsync<string>("auth_token");
                    if (!string.IsNullOrEmpty(token))
                        Http.DefaultRequestHeaders.Authorization =
                            new AuthenticationHeaderValue("Bearer", token);

                    // Tìm user theo username để lấy InspectorId / CustomerId
                    var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                    var json = await Http.GetStringAsync(
                        $"api/users?search={Uri.EscapeDataString(username)}&pageSize=5");

                    Console.WriteLine($"[Inspections] api/users response: {json}");

                    var result = System.Text.Json.JsonSerializer.Deserialize<UserPageResult>(json, opts);
                    var me = result?.Items?.FirstOrDefault(u =>
                        string.Equals(u.Username, username, StringComparison.OrdinalIgnoreCase));

                    Console.WriteLine($"[Inspections] me={me?.Username}, InspectorId={me?.InspectorId}, CustomerId={me?.CustomerId}");

                    if (me != null)
                    {
                        if (user.IsInRole("Inspector"))
                            _filterInspectorId = me.InspectorId ?? "";
                        else if (user.IsInRole("Customer"))
                            _filterCustomerId = ""; // khách hàng: API lọc theo danh sách KH được phép (PageAccess.CustomerScope)
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"[Inspections] Error resolving user filter: {ex.Message}");
                }
            }
        }
        // Admin: không filter, load hết

        await LoadPage(1);

        // Client-side fallback: lọc lại sau khi load phòng trường hợp backend chưa filter
        if (PageAccess.CustomerScope != null)
        {
            _inspections = _inspections.Where(i => PageAccess.AllowsCustomer(i.CustomerId)).ToList();
            Console.WriteLine($"[Inspections] After client filter by customer scope: {_inspections.Count} rows");
        }
        else if (!string.IsNullOrEmpty(_filterInspectorId))
        {
            _inspections = _inspections.Where(i =>
                !string.IsNullOrEmpty(i.InspectorId) &&
                i.InspectorId.Equals(_filterInspectorId, StringComparison.OrdinalIgnoreCase)
            ).ToList();
            Console.WriteLine($"[Inspections] After client filter inspectorId={_filterInspectorId}: {_inspections.Count} rows");
        }
    }

    private void GoToNew()          => Navigation.NavigateTo("/inspections/new");
    private void GoToEdit(int id)   => Navigation.NavigateTo($"/inspections/{id}/edit");
    private void GoToDetail(int id) => Navigation.NavigateTo($"/inspections/{id}");
    // Điện thoại và máy tính đều mở trang báo cáo web (khách yêu cầu quay lại web view cũ, dễ tải file).
    private void GoToReport(int id)  => Navigation.NavigateTo($"/inspection-report/{id}/from/inspections");
    private async Task PrevPage()   => await LoadPage(_page - 1);
    private async Task NextPage()   => await LoadPage(_page + 1);
    private int TotalPages()        => (_total + _pageSize - 1) / _pageSize;

    // ── Status logic ──────────────────────────────────────────────
    // Status hiển thị: New | Delay | Completed | Cancel
    // Backend tự xác định:
    //   - DB Status=0 (New) + InspectionDate < hôm nay → "Delay"  (quá hạn)
    //   - DB Status=0 (New) + InspectionDate >= hôm nay → "New"   (chưa tới hạn)
    //   - DB Status=2 → "Completed"
    //   - DB Status=3 → "Cancel"
    //   - DB Status=1/4 (legacy OnGoing/Pending) → "Delay"

    /// <summary>Map status string từ API về chuẩn hiển thị.</summary>
    private static string NormalizeStatus(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return "New";
        // Bỏ whitespace + underscore để bắt các biến thể: "On Going", "on_going", "OnGoing "
        var s = raw.Trim().ToLowerInvariant().Replace(" ", "").Replace("_", "");
        return s switch
        {
            "new"       => "New",
            "ongoing"   => "Delay",   // legacy fallback
            "pending"   => "Delay",   // legacy fallback
            "delay"     => "Delay",
            "completed" => "Completed",
            "cancel"    => "Cancel",
            "cancelled" => "Cancel",
            "draft"     => "Draft",
            _           => raw.Trim()
        };
    }

    /// <summary>Cho phép Edit/Delete khi: New, Delay (chưa hoàn tất / chưa cancel).</summary>
    private static bool CanEdit(string status) => status switch
    {
        "New"   => true,
        "Delay" => true,
        "Draft" => true,   // job nháp chưa giao: mở lại để sửa / Assign & Send
        _       => false
    };

    private string GetBadgeClass(string status) => status switch
    {
        "New"       => "badge s-new",
        "Delay"     => "badge s-pending",
        "Completed" => "badge s-active",
        "Cancel"    => "badge s-inactive",
        "Draft"     => "badge s-draft",
        _           => "badge s-new"
    };

    private string GetStatusLabel(string status) => status switch
    {
        "New"       => T("Inspections.New"),
        "Delay"     => T("Inspections.Delay"),
        "Completed" => T("Common.Completed"),
        "Cancel"    => T("Common.Cancel"),
        "Draft"     => T("Status.Draft"),
        _           => status
    };

    // ── Delete ────────────────────────────────────────────────────
    private void ConfirmDelete(InspectionRow item) { _deleteTarget = item; _deleteError = ""; }
    private void CancelDelete()                    { _deleteTarget = null; _deleteError = ""; }

    private async Task ExecuteDelete()
    {
        if (_deleteTarget == null) return;
        _deleting = true; _deleteError = "";
        Waiting.Show(T("Inspections.DeletingInspection"));
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("auth_token");
            if (string.IsNullOrEmpty(token)) { _deleteError = T("Inspections.SessionExpiredPleaseLogInAgain"); return; }
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var resp = await Http.DeleteAsync($"api/inspections/{_deleteTarget.Id}");
            if (resp.IsSuccessStatusCode)          { _deleteTarget = null; await LoadPage(_page); }
            else if ((int)resp.StatusCode == 401)  _deleteError = T("Inspections.UnauthorizedPleaseLogInAgain");
            else if ((int)resp.StatusCode == 403)  _deleteError = T("Inspections.YouDoNotHavePermissionTo2");
            else                                   _deleteError = T("Inspections.DeleteFailed", (int)resp.StatusCode);
        }
        catch (Exception ex) { _deleteError = ex.Message; }
        finally { _deleting = false; Waiting.Hide(); }
    }

    // ── Cancel ────────────────────────────────────────────────────
    private void ConfirmCancel(InspectionRow item) { _cancelTarget = item; _cancelError = ""; }
    private void CancelCancelAction()              { _cancelTarget = null; _cancelError = ""; }

    private async Task ExecuteCancel()
    {
        if (_cancelTarget == null) return;
        _cancelling = true; _cancelError = "";
        Waiting.Show(T("Inspections.CancellingInspection"));
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("auth_token");
            if (string.IsNullOrEmpty(token)) { _cancelError = T("Inspections.SessionExpiredPleaseLogInAgain"); return; }
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            // Backend enum: InspectionStatus.Cancelled
            var body = new { Status = "Cancelled" };
            var resp = await Http.PutAsJsonAsync($"api/inspections/{_cancelTarget.Id}/status", body);

            if (resp.IsSuccessStatusCode)          { _cancelTarget = null; await LoadPage(_page); }
            else if ((int)resp.StatusCode == 401)  _cancelError = T("Inspections.UnauthorizedPleaseLogInAgain");
            else if ((int)resp.StatusCode == 403)  _cancelError = T("Inspections.YouDoNotHavePermissionTo");
            else                                   _cancelError = T("Inspections.CancelFailed", (int)resp.StatusCode);
        }
        catch (Exception ex) { _cancelError = ex.Message; }
        finally { _cancelling = false; Waiting.Hide(); }
    }

    // ── Load ──────────────────────────────────────────────────────
    private int _cntAll, _cntCompleted, _cntNew, _cntDelay, _cntCancel, _cntPass, _cntFail;
    private async Task ResetFilters()
    {
        _search = _statusFilter = _categoryFilter = _typeFilter = _customerFilter = _vendorFilter = "";
        _dateFrom = _dateTo = null;
        await LoadPage(1);
    }

    private async Task LoadFilterOptions()
    {
        try
        {
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var c = System.Text.Json.JsonSerializer.Deserialize<List<DropOpt>>(await Http.GetStringAsync("api/customers/dropdown"), opts) ?? new();
            _custOpts = c.Select(x => new KeyValuePair<string,string>(x.CustomerId ?? "", x.CompanyName ?? "")).ToList();
            var v = System.Text.Json.JsonSerializer.Deserialize<List<DropOpt>>(await Http.GetStringAsync("api/vendors/dropdown"), opts) ?? new();
            _vendOpts = v.Select(x => new KeyValuePair<string,string>(x.Code ?? "", x.Name ?? "")).ToList();
            StateHasChanged();
        }
        catch { }
    }
    private class DropOpt { public string? CustomerId { get; set; } public string? CompanyName { get; set; } public string? Code { get; set; } public string? Name { get; set; } }

    private async Task SetPageSize(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n) && n > 0) { _pageSize = n; await LoadPage(1); }
    }

    private IEnumerable<int> PageNumbers()
    {
        var tp = TotalPages(); var list = new List<int>();
        for (int i = 1; i <= tp; i++)
            if (i == 1 || i == tp || Math.Abs(i - _page) <= 1) list.Add(i);
            else if (list.Count > 0 && list[^1] != 0) list.Add(0);
        return list;
    }

    private async Task SetStatusChip(string v) { _statusFilter = v; await LoadPage(1); }

    private async Task LoadPage(int page)
    {
        _loading = true; _page = page;
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("auth_token");
            if (!string.IsNullOrEmpty(token))
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var url = $"api/inspections?page={page}&pageSize={_pageSize}" +
                      $"&status={Uri.EscapeDataString(_statusFilter)}" +
                      $"&search={Uri.EscapeDataString(_search)}" +
                      $"&category={Uri.EscapeDataString(_categoryFilter)}";

            // Date range filter (gửi lên backend nếu có hỗ trợ; vẫn fallback client-side bên dưới)
            if (_dateFrom.HasValue)
                url += $"&dateFrom={_dateFrom.Value:yyyy-MM-dd}";
            if (_dateTo.HasValue)
                url += $"&dateTo={_dateTo.Value:yyyy-MM-dd}";
            if (_dateFrom.HasValue || _dateTo.HasValue)
                url += $"&dateField={Uri.EscapeDataString(_dateField)}";

            if (!string.IsNullOrEmpty(_typeFilter))     url += $"&inspectionType={Uri.EscapeDataString(_typeFilter)}";
            if (!string.IsNullOrEmpty(_customerFilter)) url += $"&customerId={Uri.EscapeDataString(_customerFilter)}";
            if (!string.IsNullOrEmpty(_vendorFilter))   url += $"&vendorId={Uri.EscapeDataString(_vendorFilter)}";

            // Role-based filter
            if (!string.IsNullOrEmpty(_filterInspectorId))
                url += $"&inspectorId={Uri.EscapeDataString(_filterInspectorId)}";
            else if (!string.IsNullOrEmpty(_filterCustomerId))
                url += $"&customerId={Uri.EscapeDataString(_filterCustomerId)}";
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode) { _pageError = T("Inspections.LoadFailed", (int)resp.StatusCode); return; }

            var json   = await resp.Content.ReadAsStringAsync();
            var result = System.Text.Json.JsonSerializer.Deserialize<PageResult>(json, opts);
            if (result != null)
            {
                // Normalize status cho mỗi item
                foreach (var item in result.Items)
                    item.Status = NormalizeStatus(item.Status);

                // Client-side category filter (backup nếu backend chưa hỗ trợ param category)
                var items = result.Items.AsEnumerable();
                if (!string.IsNullOrEmpty(_categoryFilter))
                    items = items.Where(i =>
                        !string.IsNullOrEmpty(i.ProductCategory) &&
                        i.ProductCategory.Equals(_categoryFilter, StringComparison.OrdinalIgnoreCase));

                // Client-side status filter (backup nếu backend chưa hỗ trợ param status)
                if (!string.IsNullOrEmpty(_statusFilter))
                    items = items.Where(i =>
                        !string.IsNullOrEmpty(i.Status) &&
                        i.Status.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase));

                // Client-side: mở rộng search sang Inspector (Name + ID).
                // Backend hiện search theo job/customer/product. Tại đây ta lọc lại
                // theo cùng query — nhưng bao gồm thêm InspectorName & InspectorId.
                // Lưu ý: vì pagination ở backend, kết quả Inspector chỉ tin cậy
                // trong phạm vi trang đã tải; khi backend được nâng cấp thêm
                // 'inspector' vào search, có thể bỏ block này.
                if (!string.IsNullOrWhiteSpace(_search))
                {
                    var q = _search.Trim();
                    items = items.Where(i =>
                        (i.JobNumber       ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                        (i.PoNumber        ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                        (i.CustomerName    ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                        (i.VendorName      ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                        (i.ProductCategory ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                        (i.ProductType     ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                        (i.InspectorName   ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                        (i.InspectorId     ?? "").Contains(q, StringComparison.OrdinalIgnoreCase)
                    );
                }

                // Client-side date range filter (backup)
                if (_dateFrom.HasValue || _dateTo.HasValue)
                {
                    DateTime? from = _dateFrom?.Date;
                    DateTime? to   = _dateTo?.Date;

                    items = items.Where(i =>
                    {
                        DateTime? d = _dateField == "receive"
                            ? i.CreatedAt.Date
                            : i.InspectionDate?.Date;
                        if (d == null) return false;
                        if (from.HasValue && d.Value < from.Value) return false;
                        if (to.HasValue   && d.Value > to.Value)   return false;
                        return true;
                    });
                }

                _inspections = items.ToList();
                _total       = result.Total;
                _cntAll = result.CntAll; _cntCompleted = result.CntCompleted; _cntNew = result.CntNew; _cntDelay = result.CntDelay; _cntCancel = result.CntCancel; _cntPass = result.CntPass; _cntFail = result.CntFail;
                _pageError   = "";
            }
        }
        catch (Exception ex) { _pageError = ex.Message; }
        finally { _loading = false; }
    }

    private async Task OnSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadPage(1);
    }

    private async Task ClearDateRange()
    {
        _dateFrom = null;
        _dateTo   = null;
        await LoadPage(1);
    }

    // ── DTOs ──────────────────────────────────────────────────────
    private class PageResult
    {
        public int CntAll { get; set; } public int CntCompleted { get; set; } public int CntNew { get; set; } public int CntDelay { get; set; } public int CntCancel { get; set; } public int CntPass { get; set; } public int CntFail { get; set; }
        public int Total { get; set; }
        public List<InspectionRow> Items { get; set; } = new();
    }

    private class InspectionRow
    {
        public int       Id              { get; set; }
        public string    Title           { get; set; } = "";
        public string    Status          { get; set; } = "";
        public DateTime  CreatedAt       { get; set; }
        public string?   CreatedByName   { get; set; }
        public string?   JobNumber       { get; set; }
        public string?   PoNumber        { get; set; }
        public DateTime? InspectionDate  { get; set; }
        public string?   CustomerName    { get; set; }
        public string?   CustomerId      { get; set; }
        public string?   VendorName      { get; set; }
        public string?   VendorId        { get; set; }
        public string?   VendorAddress   { get; set; }
        public string?   VendorCity      { get; set; }
        public string?   VendorCountry   { get; set; }
        public string?   ProductCategory { get; set; }
        public string?   ProductType     { get; set; }
        public string?   InspectionType  { get; set; }
        public string?   InspectorName   { get; set; }
        public string?   InspectorId     { get; set; }
        public string?   FinalResult     { get; set; }
    }

    // DTOs để resolve InspectorId/CustomerId từ api/users
    private class UserPageResult
    {
        public int Total { get; set; }
        public List<CurrentUserDto> Items { get; set; } = new();
    }
    private class CurrentUserDto
    {
        public string  Username    { get; set; } = "";
        public string? InspectorId { get; set; }
        public string? CustomerId  { get; set; }
    }
}

