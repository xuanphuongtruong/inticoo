@page "/inspector-reviews/{InspectorId}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using InticooInspection.Client.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PageAccessService PageAccess
@inherits LocalizedComponentBase

<PageTitle>@T("InspectorReview.InspectorPerformanceInticoo")</PageTitle>

@if (_loading)
{
    <div class="ip-loading"><div class="ip-spinner"></div> @T("Common.Loading")</div>
}
else if (_error != null)
{
    <div class="ip-error">⚠ @_error <button @onclick="Load" style="margin-left:8px;cursor:pointer;">@T("Common.Retry")</button></div>
}
else if (_data != null)
{
<div class="ip-page">

    <!-- ══ HEADER ══ -->
    <div class="ip-header">
        <button class="ip-back no-print" @onclick='() => Navigation.NavigateTo("/inspector-reviews")'>
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 4l-6 6 6 6" stroke-linecap="round"/></svg>
        </button>
        <div class="ip-header-center">
            <h1 class="ip-title">@T("InspectorReview.InspectorPerformanceOverview")</h1>
            <p class="ip-sub">@T("InspectorReview.MonthlyYearlyInspectionMetrics")</p>
        </div>
        <div class="ip-controls">
            <span class="print-only ip-print-period">@MonthName(_month) @_year</span>
            <PrintReportButton />
            <select class="ip-select" value="@_month" @onchange="OnMonthChange">
                @for (int m = 1; m <= 12; m++) { var mn = m;
                    <option value="@mn">@L.MonthName(mn)</option> }
            </select>
            <select class="ip-select" value="@_year" @onchange="OnYearChange">
                @for (int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--) { var yn = y;
                    <option value="@yn">@yn</option> }
            </select>
        </div>
    </div>

    <!-- ══ INFO BAR ══ -->
    <div class="ip-infobar">
        <div class="ip-infobar-f"><span class="ip-lbl">@T("InspectorReview.InspectorName")</span><span class="ip-val">@_inspectorName</span></div>
        <div class="ip-infobar-f"><span class="ip-lbl">@T("InspectorReview.InspectorID")</span><span class="ip-val">@InspectorId</span></div>
    </div>

    <!-- ══ KPI CARDS (năm đang chọn, so với năm trước) ══ -->
    <div class="ip-kpis">
        @KpiCard(T("InspectorReview.TotalInspection"), _data.YearTotal, _data.PrevTotal, "#1d4ed8")
        @KpiCard(T("InspectorReview.PpiInspections"), _data.YearPpt, _data.PrevPpt, "#3b82f6")
        @KpiCard(T("InspectorReview.DpiInspections"), _data.YearDpi, _data.PrevDpi, "#f59e0b")
        @KpiCard(T("InspectorReview.PsiInspections"), _data.YearPst, _data.PrevPst, "#dc2626")
        @KpiCard(T("InspectorReview.ClcInspections"), _data.YearClc, _data.PrevClc, "#8b5cf6")
    </div>

    <!-- ══ MONTHLY BAR CHART ══ -->
    <div class="ip-section-title">@T("InspectorReview.TotalInspectionMonthly", _data.TargetYear)</div>
    <div class="ip-card print-avoid-break">
        <StackedBars Labels="StackedBars.MonthLabels" Height="170"
                     Series="@(new() {
                         new(T("InspectorReview.PreProductionInspection"),    "#1d4ed8", _data.MonthlyData.OrderBy(m => m.Month).Select(m => m.Ppt).ToList()),
                         new(T("InspectorReview.DuringProductionInspection"), "#f59e0b", _data.MonthlyData.OrderBy(m => m.Month).Select(m => m.Dpi).ToList()),
                         new(T("InspectorReview.PreShipmentInspection"),      "#dc2626", _data.MonthlyData.OrderBy(m => m.Month).Select(m => m.Pst).ToList()),
                         new(T("InspectorReview.ContainerLoadingCheck"),      "#8b5cf6", _data.MonthlyData.OrderBy(m => m.Month).Select(m => m.Clc).ToList()) })" />
    </div>

    <!-- ══ YEARLY HORIZONTAL BAR ══ -->
    <div class="ip-section-title">@T("InspectorReview.TotalInspectionForYear", _data.TargetYear) <span class="ip-sub-inline">@T("InspectorReview.Total", _data.YearTotal)</span></div>
    <div class="ip-card print-avoid-break">
        @{ var maxY = Math.Max(1, Math.Max(Math.Max(_data.YearPpt, _data.YearClc), Math.Max(_data.YearDpi, _data.YearPst))); }
        <div class="ip-hbar-row">
            <span class="ip-hbar-lbl">@T("InspectorReview.PreShipmentInspection")</span>
            <div class="ip-hbar-track"><div class="ip-hbar-fill" style="width:@Pc(_data.YearPst, maxY)%;background:#dc2626;"></div></div>
            <span class="ip-hbar-num">@_data.YearPst</span>
        </div>
        <div class="ip-hbar-row">
            <span class="ip-hbar-lbl">@T("InspectorReview.DuringProductionInspection")</span>
            <div class="ip-hbar-track"><div class="ip-hbar-fill" style="width:@Pc(_data.YearDpi, maxY)%;background:#f59e0b;"></div></div>
            <span class="ip-hbar-num">@_data.YearDpi</span>
        </div>
        <div class="ip-hbar-row">
            <span class="ip-hbar-lbl">@T("InspectorReview.PreProductionInspection")</span>
            <div class="ip-hbar-track"><div class="ip-hbar-fill" style="width:@Pc(_data.YearPpt, maxY)%;background:#1d4ed8;"></div></div>
            <span class="ip-hbar-num">@_data.YearPpt</span>
        </div>
        <div class="ip-hbar-row">
            <span class="ip-hbar-lbl">@T("InspectorReview.ContainerLoadingCheck")</span>
            <div class="ip-hbar-track"><div class="ip-hbar-fill" style="width:@Pc(_data.YearClc, maxY)%;background:#8b5cf6;"></div></div>
            <span class="ip-hbar-num">@_data.YearClc</span>
        </div>
    </div>

    <!-- ══ ON-TIME RATE (tháng đang chọn) ══ -->
    <div class="ip-section-title">@T("InspectorReview.OnTimeInspectionRate", MonthName(_data.TargetMonth), _data.TargetYear)</div>
    <div class="ip-card print-avoid-break" style="display:flex;flex-direction:column;gap:16px;">
        @if (_data.OnTimeKnown == 0)
        {
            <div class="ip-empty">@T("InspectorReview.NoCompletedInspectionIn", MonthName(_data.TargetMonth), _data.TargetYear)</div>
        }
        else
        {
            <div class="ip-ontime-row">
                <span class="ip-ontime-lbl" style="color:#1d4ed8;">@T("InspectorReview.OnTime")</span>
                <div class="ip-ontime-track"><div class="ip-ontime-fill" style="width:@Inv(_data.OnTimeRate)%;background:#1d4ed8;"></div></div>
                <span class="ip-ontime-pct">@_data.OnTimeRate% <small>(@_data.OnTimeCount)</small></span>
            </div>
            <div class="ip-ontime-row">
                <span class="ip-ontime-lbl" style="color:#f59e0b;">@T("InspectorReview.Delayed")</span>
                <div class="ip-ontime-track"><div class="ip-ontime-fill" style="width:@Inv(_data.DelayedRate)%;background:#f59e0b;"></div></div>
                <span class="ip-ontime-pct">@_data.DelayedRate% <small>(@_data.DelayedCount)</small></span>
            </div>
        }
        <div class="ip-note">@T("InspectorReview.OnTimeQCReportCompletedWithin", _data.TargetYear) <strong>@(_data.OnTimeYearRate.HasValue ? _data.OnTimeYearRate + "%" : "—")</strong></div>
    </div>

    <!-- ══ PST RESULT THIS YEAR + PST MONTHLY ══ -->
    <div class="ip-row">

        <!-- PST Pass/Fail donut — full year -->
        <div style="flex:1;">
            <div class="ip-section-title">@T("InspectorReview.PreShipmentInspectionResult")<br/><small>@T("InspectorReview.ThisYear", _data.TargetYear)</small></div>
            <div class="ip-card print-avoid-break">
                <div class="ip-pie-wrap">
                    <Donut CssClass="ip-pie" Title="@T("InspectorReview.Passed")" Value="@($"{_data.PstPassRate}%")"
                           Segments="@(new() { new(_data.PstPassed, "#22c55e"), new(_data.PstFailed, "#ef4444") })" />
                    <div class="ip-pie-legend">
                        <div class="ip-leg-row"><span class="ip-dot" style="background:#22c55e;"></span> @T("InspectorReview.PassRate") <strong style="color:#16a34a;">@_data.PstPassRate%</strong> (@_data.PstPassed)</div>
                        <div class="ip-leg-row"><span class="ip-dot" style="background:#ef4444;"></span> @T("InspectorReview.FailRate") <strong style="color:#dc2626;">@_data.PstFailRate%</strong> (@_data.PstFailed)</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PST Monthly horizontal bar (Passed / Failed) -->
        <div style="flex:1.4;">
            <div class="ip-section-title">@T("InspectorReview.PreShipmentInspectionResultMonthly")</div>
            <div class="ip-card print-avoid-break">
                <div class="ip-pst-legend">
                    <span class="ip-leg"><span class="ip-dot" style="background:#1d4ed8;"></span>@T("InspectorReview.Passed")</span>
                    <span class="ip-leg"><span class="ip-dot" style="background:#ef4444;"></span>@T("Common.Failed")</span>
                </div>
                @{
                    var months = new[]{"JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"};
                    var maxPst = Math.Max(1, _data.PstByMonth.Max(m => m.Passed + m.Failed));
                }
                <div class="ip-pst-chart">
                    @foreach (var pm in _data.PstByMonth.OrderByDescending(m => m.Month))
                    {
                        <div class="ip-pst-row">
                            <div class="ip-pst-lbl">@months[pm.Month - 1]</div>
                            <div class="ip-pst-bar-wrap">
                                @if (pm.Passed > 0)
                                {
                                    <div class="ip-pst-bar" style="width:@Pc(pm.Passed, maxPst)%;background:#1d4ed8;"></div>
                                    <span class="ip-pst-bar-val" style="color:#1d4ed8;">@pm.Passed</span>
                                }
                                @if (pm.Failed > 0)
                                {
                                    <div class="ip-pst-bar" style="width:@Pc(pm.Failed, maxPst)%;background:#ef4444;margin-left:2px;"></div>
                                    <span class="ip-pst-bar-val" style="color:#ef4444;">@pm.Failed</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>

    <!-- ══ CLC RESULT THIS YEAR + CLC MONTHLY ══ -->
    <div class="ip-row">
        <div style="flex:1;">
            <div class="ip-section-title">@T("InspectorReview.ContainerLoadingCheckResult")<br/><small>@T("InspectorReview.ThisYear", _data.TargetYear)</small></div>
            <div class="ip-card print-avoid-break">
                <div class="ip-pie-wrap">
                    <Donut CssClass="ip-pie" Title="@T("InspectorReview.Passed")" Value="@($"{_data.ClcPassRate}%")"
                           Segments="@(new() { new(_data.ClcPassed, "#22c55e"), new(_data.ClcFailed, "#ef4444"), new(_data.ClcHeld, "#f59e0b") })" />
                    <div class="ip-pie-legend">
                        <div class="ip-leg-row"><span class="ip-dot" style="background:#22c55e;"></span> @T("InspectorReview.PassRate") <strong style="color:#16a34a;">@_data.ClcPassRate%</strong> (@_data.ClcPassed)</div>
                        <div class="ip-leg-row"><span class="ip-dot" style="background:#ef4444;"></span> @T("InspectorReview.FailRate") <strong style="color:#dc2626;">@_data.ClcFailRate%</strong> (@_data.ClcFailed)</div>
                        <div class="ip-leg-row"><span class="ip-dot" style="background:#f59e0b;"></span> @T("InspectorReview.HoldRate") <strong style="color:#d97706;">@_data.ClcHoldRate%</strong> (@_data.ClcHeld)</div>
                    </div>
                </div>
            </div>
        </div>
        <div style="flex:1.4;">
            <div class="ip-section-title">@T("InspectorReview.ContainerLoadingCheckResultMonthly")</div>
            <div class="ip-card print-avoid-break">
                <div class="ip-pst-legend">
                    <span class="ip-leg"><span class="ip-dot" style="background:#1d4ed8;"></span>@T("InspectorReview.Passed")</span>
                    <span class="ip-leg"><span class="ip-dot" style="background:#ef4444;"></span>@T("Common.Failed")</span>
                    <span class="ip-leg"><span class="ip-dot" style="background:#f59e0b;"></span>@T("InspectorReview.Hold")</span>
                </div>
                @{
                    var clcMonths = new[]{"JAN","FEB","MAR","APR","MAY","JUN","JUL","AUG","SEP","OCT","NOV","DEC"};
                    var maxClc = Math.Max(1, _data.ClcByMonth.Count == 0 ? 0 : _data.ClcByMonth.Max(m => m.Passed + m.Failed + m.Held));
                }
                <div class="ip-pst-chart">
                    @foreach (var pm in _data.ClcByMonth.OrderByDescending(m => m.Month))
                    {
                        <div class="ip-pst-row">
                            <div class="ip-pst-lbl">@clcMonths[pm.Month - 1]</div>
                            <div class="ip-pst-bar-wrap">
                                @if (pm.Passed > 0)
                                {
                                    <div class="ip-pst-bar" style="width:@Pc(pm.Passed, maxClc)%;background:#1d4ed8;"></div>
                                    <span class="ip-pst-bar-val" style="color:#1d4ed8;">@pm.Passed</span>
                                }
                                @if (pm.Failed > 0)
                                {
                                    <div class="ip-pst-bar" style="width:@Pc(pm.Failed, maxClc)%;background:#ef4444;margin-left:2px;"></div>
                                    <span class="ip-pst-bar-val" style="color:#ef4444;">@pm.Failed</span>
                                }
                                @if (pm.Held > 0)
                                {
                                    <div class="ip-pst-bar" style="width:@Pc(pm.Held, maxClc)%;background:#f59e0b;margin-left:2px;"></div>
                                    <span class="ip-pst-bar-val" style="color:#d97706;">@pm.Held</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- ══ LATEST INSPECTIONS ══ -->
    <div class="ip-section-title">@T("InspectorReview.LatestInspections")</div>
    <div class="ip-card print-avoid-break" style="overflow-x:auto;">
        <table class="ip-kpi">
            <thead><tr><th>@T("Common.Date")</th><th>@T("Dashboard.Stage")</th><th>@T("Common.Customer")</th><th>@T("Common.Vendor")</th><th>@T("Common.Result")</th></tr></thead>
            <tbody>
                @foreach (var l in _data.Latest)
                {
                    var row = l;
                    <tr style="cursor:pointer" @onclick="() => OpenLatest(row)">
                        <td>@L.Date(row.Date, "yyyy-MM-dd")</td>
                        <td><span class="ip-stage ip-stage-@row.Type.ToLower()">@row.Type</span></td>
                        <td>@row.Customer</td><td>@row.Vendor</td>
                        <td><span class="ip-res ip-res-@row.Result.ToLower()">@LatestResult(row.Result)</span></td>
                    </tr>
                }
                @if (_data.Latest.Count == 0) { <tr><td colspan="5" style="text-align:center;color:#94a3b8">—</td></tr> }
            </tbody>
        </table>
    </div>

    <!-- ══ ANNUAL INSPECTION PERFORMANCE ══ -->
    <div class="ip-section-title">@T("InspectorReview.AnnualInspectionPerformance")</div>
    <div class="ip-card print-avoid-break" style="overflow-x:auto;">
        <table class="ip-kpi">
            <thead>
                <tr>
                    <th>@T("InspectorReview.KPI")</th>
                    @foreach (var a in _data.Annual) { <th>@a.Year</th> }
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>@T("InspectorReview.TotalInspection")</td>
                    @foreach (var a in _data.Annual) { <td>@(a.TotalInspection > 0 ? a.TotalInspection.ToString("N0") : "—")</td> }
                </tr>
                <tr>
                    <td>@T("InspectorReview.PpiInspections")</td>
                    @foreach (var a in _data.Annual) { <td>@(a.Ppi > 0 ? a.Ppi.ToString("N0") : "—")</td> }
                </tr>
                <tr>
                    <td>@T("InspectorReview.DpiInspections")</td>
                    @foreach (var a in _data.Annual) { <td>@(a.Dpi > 0 ? a.Dpi.ToString("N0") : "—")</td> }
                </tr>
                <tr>
                    <td>@T("InspectorReview.PsiInspections")</td>
                    @foreach (var a in _data.Annual) { <td>@(a.Psi > 0 ? a.Psi.ToString("N0") : "—")</td> }
                </tr>
                <tr>
                    <td>@T("InspectorReview.ClcInspections")</td>
                    @foreach (var a in _data.Annual) { <td>@(a.Clc > 0 ? a.Clc.ToString("N0") : "—")</td> }
                </tr>
                <tr>
                    <td>@T("InspectorReview.TotalDefectDetectionRate")</td>
                    @foreach (var a in _data.Annual) { <td>@(a.DefectDetectionRate.HasValue ? $"{a.DefectDetectionRate:0.##}%" : "—")</td> }
                </tr>
                <tr>
                    <td>@T("InspectorReview.AnnualOnTimeInspectionAchievement")</td>
                    @foreach (var a in _data.Annual) { <td>@(a.OnTimeRate.HasValue ? $"{a.OnTimeRate:0.#}%" : "—")</td> }
                </tr>
            </tbody>
        </table>
        <div class="ip-note">@T("InspectorReview.DefectDetectionRateTotalDefectsFound")</div>
    </div>

</div>
}

@code {
    [Parameter] public string InspectorId { get; set; } = "";

    InspectorReviewDto? _data;
    string _inspectorName = "";
    bool   _loading = true;
    string? _error;
    int _year  = DateTime.Now.Year;
    int _month = DateTime.Now.Month;

    protected override async Task OnParametersSetAsync()
    {
        await PageAccess.EnsureLoadedAsync();
        if (!PageAccess.HasAccess("PerformanceReview"))
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }
        await Load();
    }

    async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            // Load inspector info
            var info = await Http.GetFromJsonAsync<InspectorInfoDto>(
                $"api/users/{InspectorId}/review?year={_year}&month={_month}",
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
            _inspectorName = info?.InspectorName ?? InspectorId;

            // Load performance data
            _data = await Http.GetFromJsonAsync<InspectorReviewDto>(
                $"api/inspections/inspector-review/{InspectorId}?year={_year}&month={_month}",
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch (Exception ex) { _error = ex.Message; }
        _loading = false;
    }

    async Task OnMonthChange(ChangeEventArgs e) { if (int.TryParse(e.Value?.ToString(), out int m)) _month = m; await Load(); }
    async Task OnYearChange(ChangeEventArgs e)  { if (int.TryParse(e.Value?.ToString(), out int y)) _year  = y; await Load(); }

    class InspectorInfoDto
    {
        public string? InspectorName { get; set; }
        public string? InspectorId  { get; set; }
    }

    class InspectorReviewDto
    {
        public string InspectorId    { get; set; } = "";
        public int    TargetYear     { get; set; }
        public int    TargetMonth    { get; set; }
        public int    YearTotal      { get; set; }
        public int    MonthTotal     { get; set; }
        public int    YearPpt        { get; set; }
        public int    YearDpi        { get; set; }
        public int    YearPst        { get; set; }
        public int    YearClc        { get; set; }
        public int    ClcPassed      { get; set; }
        public int    ClcFailed      { get; set; }
        public double ClcPassRate    { get; set; }
        public double ClcFailRate    { get; set; }
        public double ClcHoldRate    { get; set; }
        public int    ClcHeld        { get; set; }
        public int    PrevTotal      { get; set; }
        public int    PrevPpt        { get; set; }
        public int    PrevDpi        { get; set; }
        public int    PrevPst        { get; set; }
        public int    PrevClc        { get; set; }
        public List<LatestDto> Latest { get; set; } = new();
        public List<PstMonthDto> ClcByMonth { get; set; } = new();
        public int    PstPassed      { get; set; }
        public int    PstFailed      { get; set; }
        public double PstPassRate    { get; set; }
        public double PstFailRate    { get; set; }
        public int    OnTimeCount    { get; set; }
        public int    DelayedCount   { get; set; }
        public int    OnTimeKnown    { get; set; }
        public double OnTimeRate     { get; set; }
        public double DelayedRate    { get; set; }
        public double? OnTimeYearRate { get; set; }
        public List<MonthTypeDto>  MonthlyData { get; set; } = new();
        public List<PstMonthDto>   PstByMonth  { get; set; } = new();
        public List<AnnualDto>     Annual      { get; set; } = new();
    }

    class AnnualDto
    {
        public int     Year                { get; set; }
        public int     TotalInspection     { get; set; }
        public int     Ppi                 { get; set; }
        public int     Dpi                 { get; set; }
        public int     Psi                 { get; set; }
        public int     Clc                 { get; set; }
        public double? DefectDetectionRate { get; set; }
        public double? OnTimeRate          { get; set; }
    }

    static string Pc(double v, double max) => (max > 0 ? v / max * 100 : 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    static string Inv(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string MonthName(int m) => L.MonthName(m);

    class MonthTypeDto
    {
        public int Month { get; set; }
        public int Ppt   { get; set; }
        public int Dpi   { get; set; }
        public int Pst   { get; set; }
        public int Clc   { get; set; }
    }

    class LatestDto
    {
        public int? ClcId { get; set; } public DateTime Date { get; set; } public string Type { get; set; } = "";
        public string Customer { get; set; } = ""; public string Vendor { get; set; } = "";
        public string? JobNumber { get; set; } public string Result { get; set; } = "";
    }

    void OpenLatest(LatestDto l)
    {
        if (l.ClcId.HasValue) Navigation.NavigateTo($"/clc/{l.ClcId}/report");
        else if (!string.IsNullOrEmpty(l.JobNumber)) Navigation.NavigateTo("/inspection-report/" + l.JobNumber);
    }

    string LatestResult(string r) => r switch
    {
        "PASS" => T("Clc.Pass"), "FAIL" => T("Clc.Fail"), "HOLD" => T("Clc.Hold"), "PENDING" => T("Clc.StatusPending"), _ => r
    };

    RenderFragment KpiCard(string label, int value, int prev, string color) => @<text>
        <div class="ip-kpi-card" style="border-top:3px solid @color">
            <div class="ip-kpi-lbl">@label</div>
            <div class="ip-kpi-val">@value.ToString("N0")</div>
            <div class="ip-kpi-delta">@KpiDelta(value, prev)</div>
        </div>
    </text>;

    string KpiDelta(int value, int prev) =>
        prev <= 0 ? (value > 0 ? T("InspectorReview.NewThisYear") : "—")
                  : $"{(value >= prev ? "▲" : "▼")} {Math.Abs((value - prev) * 100.0 / prev):0}% {T("InspectorReview.VsLastYear", _data!.TargetYear - 1)}";

    class PstMonthDto
    {
        public int Month  { get; set; }
        public int Passed { get; set; }
        public int Failed { get; set; }
        public int Held   { get; set; }
    }
}

<style>
    .ip-kpis { display:grid; grid-template-columns:repeat(5, minmax(0,1fr)); gap:10px; margin:12px 0; }
    .ip-kpi-card { background:#fff; border-radius:12px; padding:10px 14px; color:#1a2d5a; box-shadow:0 2px 10px rgba(0,0,0,.1); }
    .ip-kpi-lbl { font-size:12px; font-weight:700; color:#51638a; } .ip-kpi-val { font-size:26px; font-weight:800; line-height:1.2; }
    .ip-kpi-delta { font-size:11.5px; color:#6b7c9c; }
    .ip-stage { display:inline-block; padding:2px 9px; border-radius:6px; font-size:11.5px; font-weight:800; background:#e5e7eb; color:#374151; }
    .ip-stage-ppi { background:#dbeafe; color:#1e40af; } .ip-stage-dpi { background:#fef3c7; color:#92400e; } .ip-stage-psi { background:#fee2e2; color:#b91c1c; } .ip-stage-clc { background:#ede9fe; color:#5b21b6; }
    .ip-res { display:inline-block; padding:2px 10px; border-radius:99px; font-size:11.5px; font-weight:800; background:#e5e7eb; color:#374151; }
    .ip-res-pass { background:#dcfce7; color:#15803d; } .ip-res-fail { background:#fee2e2; color:#b91c1c; } .ip-res-hold { background:#fef3c7; color:#92400e; }
    @@media (max-width:760px) { .ip-kpis { grid-template-columns:repeat(2, minmax(0,1fr)); } }
    .ip-page { max-width: 100%; margin: 0 auto; font-family: "DM Sans", sans-serif; color: #1a2d5a; }
    .ip-loading { display:flex;align-items:center;gap:10px;padding:60px;justify-content:center;color:#ffffff; }
    .ip-spinner { width:22px;height:22px;border:3px solid rgba(255,255,255,0.3);border-top-color:#ffffff;border-radius:50%;animation:ipspin .7s linear infinite; }
    @@keyframes ipspin { to { transform:rotate(360deg); } }
    .ip-error { background:#fff5f5;border:1px solid #fecaca;border-radius:12px;padding:16px 20px;color:#dc2626;margin:20px 0; }

    /* Header */
    .ip-header { display:flex;align-items:center;gap:16px;margin-bottom:16px; }
    .ip-back { background:#f3f4f6;border:none;border-radius:8px;width:34px;height:34px;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#1a2d5a;flex-shrink:0;transition:background .15s; }
    .ip-back:hover { background:#e5e7eb; }
    .ip-header-center { flex:1;text-align:center; }
    .ip-title { font-size:22px;font-weight:800;color:#ffffff;margin:0; }
    .ip-sub   { font-size:12px;color:rgba(255,255,255,0.7);margin:2px 0 0; }
    .ip-controls { display:flex;gap:8px;flex-shrink:0; }
    .ip-select { border:1px solid #e5e7eb;border-radius:8px;padding:6px 10px;font-size:13px;font-family:inherit;color:#1a2d5a;background:#fff;cursor:pointer;outline:none; }
    .ip-select:focus { border-color:#1d4ed8; }

    /* Info bar */
    .ip-infobar { display:flex;gap:10px;background:#fff;border:1px solid #e5e7eb;border-radius:10px;padding:12px 20px;margin-bottom:20px;flex-wrap:wrap; }
    .ip-infobar-f { display:flex;align-items:center;gap:6px; }
    .ip-lbl { font-size:13px;color:#6b7280; }
    .ip-val { font-size:13px;font-weight:600;color:#1a2d5a; }

    /* Section */
    .ip-section-title { font-size:14px;font-weight:700;color:#ffffff;margin:16px 0 10px;line-height:1.3; }
    .ip-card { background:#fff;border:1px solid #e5e7eb;border-radius:14px;padding:20px;min-width: 360px; }
    .ip-row  { display:flex;gap:16px;margin-bottom:16px;align-items:flex-start; }

    /* Legend */
    .ip-legend-row { display:flex;gap:16px;margin-bottom:14px;flex-wrap:wrap; }
    .ip-leg { display:flex;align-items:center;gap:6px;font-size:12px;color:#6b7280; }
    .ip-dot { width:10px;height:10px;border-radius:3px;flex-shrink:0;display:inline-block; }

    /* Monthly bar chart */
    .ip-barchart { display:flex;align-items:flex-end;gap:5px;height:180px; }
    .ip-bar-col  { display:flex;flex-direction:column;align-items:center;flex:1;height:100%;justify-content:flex-end; }
    .ip-bar-val  { font-size:9.5px;color:#6b7280;font-weight:600;margin-bottom:3px; }
    .ip-bar-stack { width:100%;max-width:26px;display:flex;flex-direction:column-reverse;border-radius:4px 4px 0 0;overflow:hidden;min-height:4px; }
    .ip-bar-empty { width:100%;max-width:26px;height:4px;background:#e5e7eb;border-radius:4px; }
    .ip-bar-lbl  { font-size:8.5px;color:#9ca3af;margin-top:5px;font-weight:600;letter-spacing:.03em; }

    /* Yearly horizontal bar */
    .ip-hbar-row  { display:flex;align-items:center;gap:12px;margin-bottom:14px; }
    .ip-hbar-lbl  { width:200px;font-size:12px;color:#374151;flex-shrink:0;text-align:right; }
    .ip-hbar-track { flex:1;height:24px;background:#f3f4f6;border-radius:4px;overflow:hidden; }
    .ip-hbar-fill  { height:100%;border-radius:4px;transition:width .4s ease; }
    .ip-hbar-num  { width:32px;font-size:13px;font-weight:700;color:#1a2d5a;flex-shrink:0; }

    /* Avg duration bar chart */
    .ip-dur-label { font-size:11px;color:#9ca3af;margin-bottom:8px;font-weight:600; }
    .ip-dur-chart { display:flex;align-items:flex-end;gap:20px;height:160px;padding-bottom:0; }
    .ip-dur-col   { display:flex;flex-direction:column;align-items:center;flex:1; }
    .ip-dur-val   { font-size:14px;font-weight:700;color:#1a2d5a;margin-bottom:6px; }
    .ip-dur-bar   { width:50px;border-radius:6px 6px 0 0;min-height:4px;transition:height .4s; }
    .ip-dur-lbl   { font-size:10px;color:#6b7280;margin-top:8px;text-align:center;font-weight:500; }

    /* On-time rate */
    .ip-ontime-row  { display:flex;align-items:center;gap:12px; }
    .ip-ontime-lbl  { width:80px;font-size:14px;font-weight:600;flex-shrink:0; }
    .ip-ontime-track { flex:1;height:32px;background:#f3f4f6;border-radius:8px;overflow:hidden;position:relative; }
    .ip-ontime-fill  { height:100%;border-radius:8px;transition:width .4s; }
    .ip-ontime-pct   { width:48px;font-size:14px;font-weight:700;color:#1a2d5a;flex-shrink:0;text-align:right; }

    /* Pie chart */
    .ip-pie-wrap   { display:flex;align-items:center;gap:20px;flex-wrap:wrap;justify-content:center; }
    .ip-pie        { width:140px;height:140px;flex-shrink:0; }
    .ip-pie-legend { display:flex;flex-direction:column;gap:8px; }
    .ip-leg-row    { display:flex;align-items:center;gap:6px;font-size:13px;color:#374151; }

    /* PST monthly bar chart */
    .ip-pst-legend { display:flex;gap:16px;margin-bottom:12px; }
    .ip-pst-chart  { display:flex;flex-direction:column;gap:6px; }
    .ip-pst-row    { display:flex;align-items:center;gap:8px; }
    .ip-pst-lbl    { width:30px;font-size:10px;font-weight:600;color:#6b7280;flex-shrink:0;text-align:right; }
    .ip-pst-bar-wrap { flex:1;display:flex;align-items:center;gap:2px; }
    .ip-pst-bar    { height:16px;border-radius:3px;min-width:4px;transition:width .3s; }
    .ip-pst-bar-val { font-size:10px;font-weight:600; }

    @@media (max-width:700px) {
        .ip-row { flex-direction:column; }
        .ip-row > div { width:100%; min-width:0; }
        .ip-hbar-lbl { width:100px;font-size:10.5px; }
        .ip-header { display:grid; grid-template-columns:34px minmax(0,1fr) 34px; gap:8px 10px; }
        .ip-header-center { min-width:0; }
        .ip-title { font-size:18px; line-height:1.25; }
        .ip-sub { font-size:11.5px; }
        .ip-controls { grid-column:1 / -1; display:grid; grid-template-columns:auto minmax(0,1fr) minmax(0,88px); gap:8px; width:100%; }
        .ip-controls .ip-select, .ip-controls .prb-btn { width:100%; min-width:0; height:38px; }
        .ip-select { -webkit-appearance:none; appearance:none; padding-right:26px;
            background:#fff url("data:image/svg+xml;charset=UTF-8,%3Csvg xmlns='http://www.w3.org/2000/svg' width='10' height='6'%3E%3Cpath d='M1 1l4 4 4-4' stroke='%231a2d5a' stroke-width='1.5' fill='none'/%3E%3C/svg%3E") no-repeat right 10px center; }
        .ip-card { min-width:0; padding:16px 12px; }
        .ip-infobar { padding:10px 14px; }
        .ip-val { overflow-wrap:anywhere; }
        .ip-ontime-lbl { width:64px; font-size:13px; }
        .ip-ontime-pct { width:76px; font-size:13px; }
        .ip-kpi { font-size:12px; }
        .ip-kpi th, .ip-kpi td { padding:7px 8px; }
        .ip-kpi td:first-child { min-width:120px; }
    }
    @@media print {
        .ip-card { min-width:0 !important; }
        .ip-row { break-inside:avoid; }
    }

    .ip-sub-inline { font-size:12px; font-weight:500; color:rgba(255,255,255,.75); }
    .ip-empty { font-size:13px; color:#9ca3af; text-align:center; padding:8px; }
    .ip-note  { font-size:11.5px; color:#6b7280; margin-top:6px; }
    .ip-ontime-pct small { font-size:11px; color:#6b7280; font-weight:600; }
    .ip-ontime-pct { width:90px; }
    .ip-print-period { color:#fff; font-weight:700; font-size:13px; align-self:center; }
    .ip-kpi { width:100%; border-collapse:collapse; font-size:13px; }
    .ip-kpi th { background:#1a2d5a; color:#fff; font-weight:700; padding:9px 12px; text-align:center; border:1px solid #1a2d5a; }
    .ip-kpi th:first-child, .ip-kpi td:first-child { text-align:left; }
    .ip-kpi td { padding:9px 12px; border:1px solid #e5e7eb; text-align:center; color:#1a2d5a; font-weight:600; }
    .ip-kpi td:first-child { font-weight:500; color:#374151; }
    .ip-kpi tbody tr:nth-child(even) td { background:#f8fafc; }
</style>
