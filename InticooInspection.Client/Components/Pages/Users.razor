    private record PageAccessOption(string Key, string Label);

    private string[] _departments => new[] { "Purchasing", "Quality Assurance", "Quality Control", "Production", "Merchandising", "Sales", "Management", "Other" };
    // Giữ giá trị cũ không có trong danh sách để không bị mất khi mở sửa
    private IEnumerable<string> DepartmentOptions =>
        string.IsNullOrWhiteSpace(_formDepartment) || _departments.Contains(_formDepartment) ? _departments : _departments.Append(_formDepartment);

    private IEnumerable<CustomerDropdownItem> VisibleCustomers =>
        string.IsNullOrWhiteSpace(_custSearch) ? _customers
        : _customers.Where(c => c.CustomerId.Contains(_custSearch, StringComparison.OrdinalIgnoreCase)
                             || c.CompanyName.Contains(_custSearch, StringComparison.OrdinalIgnoreCase));

    private bool AllVisibleSelected => VisibleCustomers.Any() && VisibleCustomers.All(c => _formCustomerIds.Contains(c.CustomerId, StringComparer.OrdinalIgnoreCase));

    private void ToggleSelectAllCustomers()
    {
        var vis = VisibleCustomers.Select(c => c.CustomerId).ToList();
        if (AllVisibleSelected) _formCustomerIds.RemoveAll(id => vis.Contains(id, StringComparer.OrdinalIgnoreCase));
        else foreach (var id in vis) if (!_formCustomerIds.Contains(id, StringComparer.OrdinalIgnoreCase)) _formCustomerIds.Add(id);
    }

    private void ToggleCustomer(CustomerDropdownItem c, bool on)
    {
        _formCustomerIds.RemoveAll(x => x.Equals(c.CustomerId, StringComparison.OrdinalIgnoreCase));
        if (on)
        {
            _formCustomerIds.Add(c.CustomerId);
            // Tài khoản Customer: chọn khách hàng đầu tiên → điền sẵn thông tin còn trống
            if (_editId == null && _formRoles.Contains("Customer") && _formCustomerIds.Count == 1) FillFromCustomer(c);
        }
    }

    private void SetLevel(ModuleDef d, PermLevel level)
    {
        var p = _formPerms.Get(d.Key);
        var wasBelow = p.Level < (d.FlagsNeedEdit ? PermLevel.Edit : PermLevel.View);
        p.Level = level;
        var enabled = level >= (d.FlagsNeedEdit ? PermLevel.Edit : PermLevel.View);
        // Vừa mở khoá các cờ → bật sẵn tất cả cho tiện; hạ mức → tắt hết
        foreach (var f in d.Flags) p.SetFlag(f, enabled && (wasBelow || p.Flag(f)));
    }

    private string FlagLabel(string f) => f switch
    {
        PermAction.Export   => T("Users.ExportData"),
        PermAction.Download => T("Users.DownloadReports"),
        _ => TE("Opt", f)
    };

    private static string ModuleIcon(string key)
    {
        const string a = "<svg width='20' height='20' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.8' stroke-linecap='round' stroke-linejoin='round'>";
        var body = key switch
        {
            ModuleKeys.Dashboard          => "<path d='M5 20V12M10 20V8M15 20V4M20 20v-9'/>",
            ModuleKeys.JobRequest         => "<path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/><path d='M14 3v5h5M9 13h6M9 17h6'/>",
            ModuleKeys.InspectionSchedule => "<rect x='3' y='4.5' width='18' height='16.5' rx='2'/><path d='M3 9.5h18M8 2.5v4M16 2.5v4M12 12.5v5M9.5 15h5'/>",
            ModuleKeys.DefectManagement   => "<path d='M10.3 3.9L1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z'/><path d='M12 9v4M12 17h.01'/>",
            ModuleKeys.ContainerLoadingCheck => "<rect x='3' y='7' width='18' height='10' rx='1.5'/><path d='M7 7v10M11 7v10M15 7v10M19 7v10'/>",
            ModuleKeys.InspectionSummary  => "<rect x='5' y='4' width='14' height='17' rx='2'/><path d='M9 3h6v3H9zM9 13l2 2 4-4'/>",
            ModuleKeys.PerformanceTest    => "<path d='M9 3h6M10 3v6L5 19a1.5 1.5 0 0 0 1.3 2h11.4a1.5 1.5 0 0 0 1.3-2l-5-10V3M7.5 15h9'/>",
            ModuleKeys.PerformanceReview  => "<path d='M5 20V12M10 20V8M15 20V4M20 20v-9'/>",
            ModuleKeys.Directory          => "<path d='M3 6.5A1.5 1.5 0 0 1 4.5 5h5l2 2h8A1.5 1.5 0 0 1 21 8.5v9a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 17.5z'/>",
            _                             => "<path d='M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z'/><path d='M14 3v5h5M12 11v6M9.5 14.5L12 17l2.5-2.5'/>",
        };
        return a + body + "</svg>";
    }
    private static readonly string[] CUSTOMER_DEFAULT_ACCESS  = new[] { "InspectionSchedule", "SummaryInspections" };
    private static readonly string[] INSPECTOR_DEFAULT_ACCESS = new[] { "JobRequest", "InspectionSchedule", "SummaryInspections", "PerformanceReview" };

    // Dropdowns
    private List<CountryItem> _countries = new();
    private bool              _loadingCountries = true;
    private List<CustomerDropdownItem> _customers = new();
    private bool                       _loadingCustomers = false;

    private UserDto? _deleteUser = null;

    protected override async Task OnInitializedAsync()
    {
        await SetAuthHeader();
        await Task.WhenAll(LoadPage(1), LoadCountries(), LoadCustomers(), LoadPlanUsage());
    }

    private async Task SetAuthHeader()
    {
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("auth_token");
            if (!string.IsNullOrEmpty(token))
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }
        catch { }
    }

    private async Task LoadPage(int page)
    {
        _loading = true; _page = page;
        try
        {
            // Default filter: hiển thị cả Customer và Inspector trong list
            var roleFilter = string.IsNullOrEmpty(_filterRole)
                ? string.Join(",", _roleOptions)
                : _filterRole;
            var extra = (string.IsNullOrEmpty(_filterCountry) ? "" : $"&country={Uri.EscapeDataString(_filterCountry)}");

            // onlyLoginVisible=true: chỉ hiển thị account có cột ShowInLoginAccount được tick.
            var url = $"api/users?page={page}&pageSize={_pageSize}" +
                      $"&search={Uri.EscapeDataString(_search)}" +
                      $"&roles={Uri.EscapeDataString(roleFilter)}" +
                      $"&onlyLoginVisible=true" + extra +
                      (_filterStatus == "active" ? "&isActive=true" : _filterStatus == "inactive" ? "&isActive=false" : "");
            var result = await Http.GetFromJsonAsync<UserPageResult>(url);
            if (result != null) { _users = result.Items; _total = result.Total; }
            await LoadKpis(roleFilter, extra);
        }
        catch { }
        finally { _loading = false; }
    }

    private async Task LoadKpis(string roleFilter, string extra)
    {
        try
        {
            var q = $"api/users?page=1&pageSize=1&roles={Uri.EscapeDataString(roleFilter)}&onlyLoginVisible=true{extra}&search={Uri.EscapeDataString(_search)}";
            var a = await Http.GetFromJsonAsync<UserPageResult>(q + "&isActive=true");
            var i = await Http.GetFromJsonAsync<UserPageResult>(q + "&isActive=false");
            _kpiActive = a?.Total ?? 0; _kpiInactive = i?.Total ?? 0; _kpiTotal = _kpiActive + _kpiInactive;
        }
        catch { }
    }

    private async Task ResetFilters()
    {
        _filterRole = _filterStatus = _filterCountry = _search = "";
        await LoadPage(1);
    }

    private async Task OnSearchKey(KeyboardEventArgs e) { if (e.Key == "Enter") await LoadPage(1); }
    private async Task PrevPage() => await LoadPage(_page - 1);
    private async Task NextPage() => await LoadPage(_page + 1);
    private int TotalPages() => (_total + _pageSize - 1) / _pageSize;

    private async Task LoadCountries()
    {
        try
        {
            var opts = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var json = await Http.GetStringAsync("api/geo/countries");
            _countries = System.Text.Json.JsonSerializer.Deserialize<List<CountryItem>>(json, opts) ?? new();
        }
        catch { }
        finally { _loadingCountries = false; }
    }

    private async Task LoadCustomers()
    {
        _loadingCustomers = true;
        try
        {
            _customers = await Http.GetFromJsonAsync<List<CustomerDropdownItem>>("api/customers/dropdown") ?? new();
        }
        catch { _customers = new(); }
        finally { _loadingCustomers = false; }
    }

    private void ResetForm()
    {
        _formUsername = ""; _formFullName = ""; _formEmail = ""; _formPassword = "";
        _formMobile = ""; _formCountry = ""; _formCustomerId = "";
        _formIsActive = true; _formRoles = new(); _formError = ""; _lockRole = false;
        _formPageAccess = new();
        _formDepartment = ""; _formPosition = "";
        _formPerms = ModulePermissionSet.DefaultFor(null);
        _custAll = false; _formCustomerIds = new(); _custSearch = ""; _showPw = false;
    }

    private async Task OpenCreate()
    {
        _editId = null;
        ResetForm();
        _showModal = true;
        await Task.CompletedTask;
    }

    private async Task OpenEdit(UserDto u)
    {
        _editId        = u.Id;
        _formUsername  = u.Username;
        _formFullName  = u.FullName    ?? "";
        _formEmail     = u.Email       ?? "";
        _formMobile    = u.Mobile      ?? "";
        _formCountry   = u.Country     ?? "";
        _formCustomerId= u.CustomerId  ?? "";
        _formPassword  = "";
        _formIsActive  = u.IsActive;
        _formRoles     = u.Roles.ToList();
        _lockRole      = _formRoles.Count == 1 && _formRoles[0] == "Inspector";   // tài khoản Inspector: không đổi role
        _formPageAccess = string.IsNullOrWhiteSpace(u.PageAccess)
                          ? new()
                          : u.PageAccess.Split(',', StringSplitOptions.RemoveEmptyEntries)
                                        .Select(x => x.Trim())
                                        .Where(x => _pageAccessOptions.Any(o => o.Key == x))
                                        .ToList();
        _formDepartment = u.Department ?? "";
        _formPosition   = u.Position   ?? "";
        // Quyền hiệu lực: JSON nếu đã có, tài khoản cũ suy ra từ PageAccess
        _formPerms = ModulePermissionSet.Effective(u.ModulePermissions, u.PageAccess).Normalize();
        // Customer Access: "*" = tất cả; CSV = chọn riêng; trống = theo CustomerId cũ (Inspector cũ = tất cả)
        _custAll = CustomerAccess.IsAll(u.CustomerIds) || (string.IsNullOrWhiteSpace(u.CustomerIds) && !u.Roles.Contains("Customer"));
        _formCustomerIds = CustomerAccess.Parse(u.CustomerIds);
        if (_formCustomerIds.Count == 0 && !string.IsNullOrWhiteSpace(u.CustomerId)) _formCustomerIds.Add(u.CustomerId);
        _custSearch = ""; _showPw = false;
        _formError     = "";
        _showModal     = true;
        await Task.CompletedTask;
    }

    private void CloseModal() => _showModal = false;

    private void SelectRole(string role)
    {
        _formRoles = string.IsNullOrEmpty(role) ? new List<string>() : new List<string> { role };
        if (role != "Customer") _formCustomerId = "";

        // Mặc định theo role (chỉ khi tạo mới — không đè khi đang sửa)
        if (_editId == null)
        {
            _formPerms = ModulePermissionSet.DefaultFor(role);
            _custAll   = role != "Customer";
        }

        StateHasChanged();
    }

    private void TogglePageAccess(string key, object? checkedValue)
    {
        var isChecked = checkedValue is bool b && b;
        if (isChecked)
        {
            if (!_formPageAccess.Contains(key)) _formPageAccess.Add(key);
        }
        else
        {
            _formPageAccess.Remove(key);
        }
    }

    /// <summary>
    /// Khi chọn Customer từ dropdown → auto fill Full Name (= CompanyName),
    /// Mobile, Email, Country từ thông tin customer.
    /// Chỉ ghi đè field nào có giá trị trong data customer; field trống thì giữ nguyên giá trị hiện tại.
    /// </summary>
    private void FillFromCustomer(CustomerDropdownItem c)
    {
        _formCustomerId = c.CustomerId;

        // Full Name fill từ CompanyName theo yêu cầu
        if (!string.IsNullOrWhiteSpace(c.CompanyName)) _formFullName = c.CompanyName;
        if (!string.IsNullOrWhiteSpace(c.Mobile))      _formMobile   = c.Mobile!;
        if (!string.IsNullOrWhiteSpace(c.Email))       _formEmail    = c.Email!;
        if (!string.IsNullOrWhiteSpace(c.Country))     _formCountry  = c.Country!;
    }

    private async Task SaveUser()
    {
        _formError = "";
        if (string.IsNullOrWhiteSpace(_formUsername))                    { _formError = T("Users.UsernameIsRequired"); return; }
        if (string.IsNullOrWhiteSpace(_formFullName))                    { _formError = T("Users.FullNameIsRequired"); return; }
        if (_editId == null && string.IsNullOrWhiteSpace(_formPassword)) { _formError = T("Users.PasswordIsRequired"); return; }
        if (_formRoles.Count == 0)                                        { _formError = T("Users.PleaseSelectRole"); return; }
        if (_editId == null && string.IsNullOrWhiteSpace(_formEmail))    { _formError = T("Users.EmailIsRequired"); return; }
        if (!_custAll && _formCustomerIds.Count == 0)
        { _formError = T("Users.PleaseSelectAtLeastOneCustomer"); return; }
        if (!_formPerms.Normalize().Modules.Values.Any(m => m.Level > PermLevel.None))
        { _formError = T("Users.PleaseGiveThisUserAccessTo"); return; }

        var customerIds = _custAll ? CustomerAccess.All : string.Join(",", _formCustomerIds);
        // Liên kết khách hàng chính (tương thích cũ): Customer = khách hàng đầu tiên được chọn
        if (_formRoles.Contains("Customer")) _formCustomerId = _custAll ? (_formCustomerIds.FirstOrDefault() ?? _formCustomerId) : _formCustomerIds[0];
        var modulePermissions = _formPerms.ToJson();
        var pageAccessCsv     = _formPerms.ToPageAccessCsv();

        _saving = true;
        Waiting.Show(_editId == null ? T("Users.CreatingAccount") : T("Users.SavingAccount"));
        try
        {
            HttpResponseMessage response;
            if (_editId == null)
            {
                var payload = new {
                    username   = _formUsername,
                    password   = _formPassword,
                    email      = _formEmail,
                    fullName   = _formFullName,
                    mobile     = _formMobile,
                    country    = _formCountry,
                    customerId = _formCustomerId,
                    isActive   = _formIsActive,
                    roles      = _formRoles,
                    pageAccess = pageAccessCsv,
                    department = _formDepartment,
                    position   = _formPosition,
                    customerIds = customerIds,
                    modulePermissions = modulePermissions
                };
                response = await Http.PostAsJsonAsync("api/users", payload);
            }
            else
            {
                var payload = new {
                    username    = _formUsername,
                    newPassword = _formPassword,
                    email       = _formEmail,
                    fullName    = _formFullName,
                    mobile      = _formMobile,
                    country     = _formCountry,
                    customerId  = _formCustomerId,
                    isActive    = _formIsActive,
                    roles       = _formRoles,
                    pageAccess  = pageAccessCsv,
                    department  = _formDepartment,
                    position    = _formPosition,
                    customerIds = customerIds,
                    modulePermissions = modulePermissions
                };
                response = await Http.PutAsJsonAsync($"api/users/{_editId}", payload);
            }

            if (response.IsSuccessStatusCode) { _showModal = false; await LoadPage(_page); await LoadPlanUsage(); }
            else
            {
                var err = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                _formError = TA(err?.Message) ?? T("Users.ErrorOccurred");
            }
        }
        catch { _formError = T("Users.ConnectionError"); }
        finally { _saving = false; Waiting.Hide(); }
    }

    private async Task ToggleActive(UserDto user)
    {
        _listError = null;
        var response = await Http.PutAsJsonAsync($"api/users/{user.Id}/toggle-active", new { });
        if (response.IsSuccessStatusCode) { user.IsActive = !user.IsActive; await LoadPlanUsage(); StateHasChanged(); }
        else
        {
            // vd. vượt hạn mức người dùng của gói (403) → hiện thông báo đã dịch
            try { var err = await response.Content.ReadFromJsonAsync<ErrorResponse>(); _listError = TA(err?.Message) ?? T("Users.ErrorOccurred"); }
            catch { _listError = T("Users.ErrorOccurred"); }
        }
    }

    // ── Hạn mức gói (người dùng / dung lượng) ─────────────────────────────────
    private PlanUsageDto? _plan;
    private string? _listError;
    private async Task LoadPlanUsage()
    {
        try { _plan = await Http.GetFromJsonAsync<PlanUsageDto>("api/me/plan-usage"); }
        catch { _plan = null; }   // API cũ chưa có endpoint / lỗi mạng → không hiện
    }
    private class PlanUsageDto
    {
        public bool Applies { get; set; }
        public bool Enforced { get; set; }
        public string? Plan { get; set; }
        public int MaxUsers { get; set; }
        public int ActiveUsers { get; set; }
        public int StorageGb { get; set; }
        public double UsedGb { get; set; }
        public int WarnPercent { get; set; } = 80;
    }

    private void ConfirmDelete(UserDto user) => _deleteUser = user;

    private async Task DeleteUser()
    {
        if (_deleteUser == null) return;
        _saving = true;
        Waiting.Show(T("Users.DeletingAccount"));
        var response = await Http.DeleteAsync($"api/users/{_deleteUser.Id}");
        _saving = false;
        Waiting.Hide();
        if (response.IsSuccessStatusCode) { _deleteUser = null; await LoadPage(_page); }
    }

    private string GetInitials(string name)
        => string.Concat(name.Split(" ").Take(2).Select(w => w.Length > 0 ? w[0].ToString().ToUpper() : ""));

    // ── DTOs ──────────────────────────────────────────────────────────────────
    private class UserDto
    {
        public string   Id          { get; set; } = "";
        public string   Username    { get; set; } = "";
        public string?  FullName    { get; set; }
        public string?  Email       { get; set; }
        public string?  Mobile      { get; set; }
        public string?  Country     { get; set; }
        public string?  CustomerId  { get; set; }
        public bool     IsActive    { get; set; }
        public List<string> Roles   { get; set; } = new();
        public string?  PageAccess  { get; set; }   // CSV of page keys, e.g. "JobRequest,SummaryInspections"
        public string?  Department  { get; set; }
        public string?  Position    { get; set; }
        public string?  CustomerIds { get; set; }   // "*" hoặc CSV mã KH
        public string?  ModulePermissions { get; set; }
        public DateTime CreatedAt   { get; set; }
    }

    private class CustomerDropdownItem
    {
        public string  CustomerId  { get; set; } = "";
        public string  CompanyName { get; set; } = "";
        // Các field bổ sung để autofill form khi chọn customer (backend cần trả về trong /api/customers/dropdown)
        public string? ContactName { get; set; }
        public string? Mobile      { get; set; }
        public string? Email       { get; set; }
        public string? Country     { get; set; }
    }

    private class CountryItem
    {
        public int    Id     { get; set; }
        public string Name   { get; set; } = "";
        public string Code   { get; set; } = "";
        public string Region { get; set; } = "";
    }

    private class UserPageResult { public int Total { get; set; } public List<UserDto> Items { get; set; } = new(); }
    private class ErrorResponse  { public string? Message { get; set; } }
}

<style>
    @@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Sora:wght@600;700&display=swap");

