    .btn-reset:hover { background:rgba(255,255,255,.22); }
    /* thẻ tài khoản (điện thoại) */
    .u-page { display:flex; flex-direction:column; }
    .u-page > * { order:3; }
    .u-page > .lp-head { order:0; } .u-page > .u-kpis { order:1; } .u-page > .top-bar { order:2; }
    .u-card { position:relative; display:grid; grid-template-columns:30px minmax(0,1fr) auto auto; grid-template-areas:"no main badges act"; gap:6px 10px; align-items:center; }
    .u-card-no { grid-area:no; width:28px; height:28px; border-radius:8px; background:#eef3fb; color:#42557f; font-size:12px; font-weight:700; display:flex; align-items:center; justify-content:center; }
    .u-card-main { grid-area:main; min-width:0; }
    .u-card-badges { grid-area:badges; display:flex; flex-direction:column; gap:6px; align-items:center; }
    .u-card-act { grid-area:act; display:flex; gap:6px; }
    @@media (max-width:760px) {
        .u-kpis { grid-template-columns:repeat(3,minmax(0,1fr)); gap:8px; }
        .u-kpi { display:grid; grid-template-columns:auto 1fr; grid-template-rows:auto auto; column-gap:8px; row-gap:4px; align-items:center; padding:10px; }
        .u-kpi .u-kpi-ico { grid-column:1; grid-row:1; width:34px; height:34px; }
        .u-kpi b { grid-column:2; grid-row:1; font-size:22px; }
        .u-kpi small { grid-column:1 / -1; grid-row:2; font-size:12px; }
        /* ô tìm kiếm + 3 bộ lọc luôn hiện, nút New Account nằm sau bộ lọc (theo thiết kế mẫu) */
        .u-page > .top-bar { background:#fff; border-radius:14px; padding:12px; gap:10px; margin-bottom:12px; display:flex; flex-wrap:wrap; box-shadow:0 1px 6px rgba(15,37,82,.08); }
        .u-page > .top-bar .search-wrap { flex:0 0 100% !important; width:100% !important; }
        .u-page > .top-bar .lp-filter-toggle, .u-page > .top-bar .total-count { display:none !important; }
        .u-page > .top-bar .filter-select { display:block !important; flex:0 0 calc((100% - 20px) / 3) !important; min-width:0 !important; width:calc((100% - 20px) / 3) !important; font-size:12px; padding:8px 18px 8px 8px; background-position:right 6px center !important; text-overflow:ellipsis; }
        .u-card { gap:6px 8px; padding:12px 10px; }
        .u-card .role-badge { font-size:9.5px; padding:2px 8px; white-space:nowrap; }
        .u-card .status-toggle { font-size:10px; padding:2px 10px; }
