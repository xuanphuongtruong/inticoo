@page "/users"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using InticooInspection.Domain.Security
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject NavigationManager Navigation
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@using InticooInspection.Client.Services
@inject WaitingService Waiting
@inherits LocalizedComponentBase

<PageTitle>@T("Users.LoginAccountsInticoo")</PageTitle>

<div class="u-page">
<div class="lp-head">
    <div class="title-block">
        <h1 class="page-title">@T("Common.LoginAccount")</h1>
        <span class="page-sub">@T("Users.ManageCustomerAndInspectorAccounts")</span>
    </div>
    @if (_plan?.Applies == true)
    {
        @* Hạn mức gói của công ty (số liệu từ api/me/plan-usage — Super Admin quản lý gói) *@
        var uPct = _plan.MaxUsers > 0 ? _plan.ActiveUsers * 100.0 / _plan.MaxUsers : 0;
        var sPct = _plan.StorageGb > 0 ? _plan.UsedGb * 100.0 / _plan.StorageGb : 0;
        var over = uPct >= 100 || sPct >= 100; var near = !over && (uPct >= _plan.WarnPercent || sPct >= _plan.WarnPercent);
        <div style="display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;font-size:.82rem;padding:8px 12px;border-radius:10px;background:@(over ? "#fef2f2" : near ? "#fffbeb" : "#f3f7fe");border:1px solid @(over ? "#fecaca" : near ? "#fde68a" : "#dbe6f7")">
            @if (!string.IsNullOrEmpty(_plan.Plan)) { <span>@T("Users.PlanLabel"): <b>@_plan.Plan</b></span> }
            @if (_plan.MaxUsers > 0) { <span>@T("Users.PlanActiveUsers"): <b style="color:@(uPct >= 100 ? "#b91c1c" : "inherit")">@_plan.ActiveUsers / @_plan.MaxUsers</b></span> }
            @if (_plan.StorageGb > 0) { <span>@T("Users.PlanStorage"): <b style="color:@(sPct >= 100 ? "#b91c1c" : "inherit")">@($"{_plan.UsedGb:0.##} / {_plan.StorageGb} GB")</b></span> }
            @if (over && _plan.Enforced) { <span style="flex-basis:100%;color:#991b1b">@T("Users.PlanLimitReached")</span> }
            else if (near) { <span style="flex-basis:100%;color:#92400e">@T("Users.PlanLimitNear")</span> }
        </div>
    }
</div>
@if (!string.IsNullOrEmpty(_listError)) { <div style="margin:8px 0;padding:10px 14px;border-radius:8px;background:#fef2f2;border:1px solid #fecaca;color:#991b1b;font-size:.88rem">@_listError</div> }
<div class="top-bar lp-filters @(_fOpen ? "fopen" : "")">
    <div class="search-wrap">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
            <circle cx="9" cy="9" r="5.5"/><path d="M15 15l-2.5-2.5" stroke-linecap="round"/>
        </svg>
        <input class="search-input" type="text" placeholder="@T("Users.SearchByNameUsernameEmailMobile")"
               @bind="_search" @bind:event="oninput" @onkeyup="OnSearchKey" />
    </div>
    <button type="button" class="lp-filter-toggle @(_fOpen ? "on" : "")" @onclick="() => _fOpen = !_fOpen" aria-label="@T("Common.Filters")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></svg></button>
    <select class="filter-select" @bind="_filterRole" @bind:after="() => LoadPage(1)">
        <option value="">@T("Users.AllRoles")</option>
        @foreach (var r in _roleOptions) { <option value="@r">@TE("Opt", r)</option> }
    </select>
    <select class="filter-select" @bind="_filterStatus" @bind:after="() => LoadPage(1)">
        <option value="">@T("Common.AllStatus")</option>
        <option value="active">@T("Common.Active")</option>
        <option value="inactive">@T("Common.Inactive")</option>
    </select>
    <select class="filter-select" @bind="_filterCountry" @bind:after="() => LoadPage(1)">
        <option value="">@T("Users.AllCountries")</option>
        @foreach (var c in _countries) { <option value="@c.Name">@c.Name</option> }
    </select>
    @if (_filterRole != "" || _filterStatus != "" || _filterCountry != "" || _search != "")
    {
        <button class="btn-reset" @onclick="ResetFilters">@T("Users.Reset")</button>
    }
    <span class="total-count">@T("Users.Accounts", _total)</span>
    <button class="btn-new" @onclick="async () => await OpenCreate()">
        <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="M10 4v12M4 10h12"/></svg>
        @T("Users.NewAccount")
    </button>
</div>

<div class="u-kpis">
    <div class="u-kpi"><span class="u-kpi-ico k-blue"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span><b>@_kpiTotal</b><small>@T("Users.TotalAccounts")</small></div>
    <div class="u-kpi"><span class="u-kpi-ico k-green"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg></span><b class="green">@_kpiActive</b><small>@T("Common.Active")</small></div>
    <div class="u-kpi"><span class="u-kpi-ico k-orange"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/></svg></span><b class="red">@_kpiInactive</b><small>@T("Common.Inactive")</small></div>
</div>

@if (_loading)
{
    <div class="loading-wrap"><div class="spinner"></div><span>@T("Common.Loading")</span></div>
}
else if (_users.Count == 0)
{
    <div class="empty-state"><p>@T("Users.NoAccountsFound")</p></div>
}
else
{
    @* Điện thoại: danh sách dạng thẻ (bảng 10 cột bị cắt chữ); bảng chỉ hiện trên máy tính *@
    <div class="m-cards u-cards">
        @{ int cardNo = (_page - 1) * _pageSize; }
        @foreach (var cu in _users)
        {
            var u = cu;
            cardNo++;
            <div class="m-card u-card">
                <span class="u-card-no">@cardNo</span>
                <div class="u-card-main">
                    <div class="m-card-name">@(string.IsNullOrEmpty(u.FullName) ? u.Username : u.FullName)</div>
                    <div class="m-card-rows">
                        <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>@u.Username</div>
                        @if (!string.IsNullOrEmpty(u.Country))
                        {
                            <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 21s7-6 7-11a7 7 0 0 0-14 0c0 5 7 11 7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>@u.Country</div>
                        }
                    </div>
                </div>
                <div class="u-card-badges">
                    @foreach (var r in u.Roles)
                    {
                        <span class="role-badge role-@r.ToLower()">@TE("Opt", r)</span>
                    }
                    <button class="status-toggle @(u.IsActive ? "s-active" : "s-inactive")" @onclick="() => ToggleActive(u)">
                        @(u.IsActive ? T("Common.Active") : T("Common.Inactive"))
                    </button>
                </div>
                <div class="u-card-act">
                    <button class="bico bedit" @onclick="async () => await OpenEdit(u)" title="@T("Common.Edit")">
                        <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2l4 4-10 10H4v-4L14 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <button class="bico bdel" @onclick="() => ConfirmDelete(u)" title="@T("Common.Delete")">
                        <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h14M8 6V4h4v2M5 6l1 11h8l1-11" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="table-wrap">
        <table class="ptable">
            <thead>
                <tr class="thead-top">
                    <th class="th-c th-chk"><input type="checkbox" checked="@(_users.Count > 0 && _users.All(x => _sel.Contains(x.Id)))" @onchange="e => ToggleAll((bool)(e.Value ?? false))" /></th>
                    <th class="th-c th-no">No</th>
                    <th class="tc">@T("Users.Name")</th>
                    <!-- <th class="tc">ID</th> -->
                    <th class="tc">@T("Common.Mobile")</th>
                    <th class="tc">Email</th>
                    <th class="tc">@T("Common.Country")</th>
                    <th class="tc">@T("Users.Username")</th>
                    <th class="tc">@T("Users.Role")</th>
                    <th class="tc">@T("Common.Status")</th>
                    <th class="th-c th-act">@T("Common.Actions")</th>
                </tr>
            </thead>
            <tbody>
                @{ int rowNo = (_page - 1) * _pageSize; }
                @foreach (var user in _users)
                {
                    var u = user;
                    rowNo++;
                    <tr class="table-row @(rowNo % 2 == 0 ? "tr-alt" : "")">
                        <td class="td-c"><input type="checkbox" checked="@_sel.Contains(u.Id)" @onchange="e => ToggleOne(u.Id, (bool)(e.Value ?? false))" /></td>
                        <td class="td-c td-no">@rowNo</td>
                        <td>
                            <div class="user-cell">
                                <span class="user-fullname">@(string.IsNullOrEmpty(u.FullName) ? u.Username : u.FullName)</span>
                            </div>
                        </td>
                        <!-- <td class="td-c mono-sm">@(string.IsNullOrEmpty(u.CustomerId) ? "—" : u.CustomerId)</td> -->
                        <td class="dim sm">@(string.IsNullOrEmpty(u.Mobile) ? "—" : u.Mobile)</td>
                        <td class="dim sm">@(string.IsNullOrEmpty(u.Email)  ? "—" : u.Email)</td>
                        <td class="dim sm tc">@(string.IsNullOrEmpty(u.Country) ? "—" : u.Country)</td>
                        <td class="mono-sm tc">@u.Username</td>
                        <td class="tc">
                            @foreach (var r in u.Roles)
                            {
                                <span class="role-badge role-@r.ToLower()">@TE("Opt", r)</span>
                            }
                        </td>
                        <td class="tc">
                            <button class="status-toggle @(u.IsActive ? "s-active" : "s-inactive")"
                                    @onclick="() => ToggleActive(u)">
                                @(u.IsActive ? T("Common.Active") : T("Common.Inactive"))
                            </button>
                        </td>
                        <td class="tc">
                            <div class="action-btns">
                                <button class="bico bedit" @onclick="async () => await OpenEdit(u)" title="@T("Common.Edit")">
                                    <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2l4 4-10 10H4v-4L14 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                                <button class="bico bdel" @onclick="() => ConfirmDelete(u)" title="@T("Common.Delete")">
                                    <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h14M8 6V4h4v2M5 6l1 11h8l1-11" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <ListPager Total="_total" Page="_page" PageSize="_pageSize" Noun="@T("Pager.Accounts")" OnPage="LoadPage" OnPageSize="SetPageSize" />
}

</div>

@* ── Create / Edit User (popup theo mẫu: thông tin, khách hàng, quyền module) ── *@
@if (_showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card uf-card" @onclick:stopPropagation="true">
            <div class="uf-head">
                <div>
                    <h2 class="uf-title">@(_editId == null ? T("Users.CreateNewUser") : T("Users.EditUser"))</h2>
                    <div class="uf-sub">@T("Users.SetUserInformationCustomerAccessAnd")</div>
                </div>
                <button class="modal-close" @onclick="CloseModal" title="@T("Common.Close")">&#x2715;</button>
            </div>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="error-alert">@_formError</div>
            }

            <div class="uf-grid">
                <!-- ════ Cột trái ════ -->
                <div class="uf-col">
                    <!-- User Information -->
                    <section class="uf-box">
                        <h3 class="uf-box-t">@T("Users.UserInformation")</h3>
                        <div class="uf-row2">
                            <div class="uf-f">
                                <label>@T("Users.FullName") <i>*</i></label>
                                <input class="uf-in" type="text" placeholder="@T("Users.EnterFullName")" @bind="_formFullName" @bind:event="oninput" />
                            </div>
                            <div class="uf-f">
                                <label>@T("Users.Role") <i>*</i></label>
                                <select class="uf-in uf-role @(_formRoles.FirstOrDefault()?.ToLower())" value="@(_formRoles.FirstOrDefault() ?? "")" disabled="@_lockRole" @onchange="e => SelectRole(e.Value?.ToString() ?? string.Empty)">
                                    <option value="">@T("Users.SelectRole")</option>
                                    @foreach (var r in _roleOptions) { <option value="@r">@TE("Opt", r)</option> }
                                </select>
                            </div>
                            <div class="uf-f">
                                <label>Email <i>*</i></label>
                                <input class="uf-in" type="email" placeholder="@T("Users.EnterEmail")" @bind="_formEmail" @bind:event="oninput" />
                            </div>
                            <div class="uf-f">
                                <label>@T("Common.Mobile")</label>
                                <input class="uf-in" type="tel" placeholder="@T("Common.EnterMobileNumber")" @bind="_formMobile" @bind:event="oninput" />
                            </div>
                            <div class="uf-f">
                                <label>@T("Users.Username") @if (_editId == null) { <i>*</i> }</label>
                                @if (_editId == null)
                                {
                                    <input class="uf-in" type="text" placeholder="@T("Users.EnterUsername")" autocomplete="off" @bind="_formUsername" @bind:event="oninput" />
                                }
                                else
                                {
                                    <input class="uf-in" type="text" readonly value="@_formUsername" />
                                }
                            </div>
                            <div class="uf-f">
                                <label>@(_editId == null ? T("Users.Password") : T("Users.NewPassword")) @if (_editId == null) { <i>*</i> }</label>
                                <div class="uf-pw">
                                    <input class="uf-in" type="@(_showPw ? "text" : "password")" autocomplete="new-password"
                                           placeholder="@(_editId == null ? T("Users.EnterPassword") : T("Users.LeaveBlankToKeepCurrent"))"
                                           @bind="_formPassword" @bind:event="oninput" />
                                    <button type="button" class="uf-eye" @onclick="() => _showPw = !_showPw" title="@(_showPw ? T("Users.Hide") : T("Users.Show")) password">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>@if (_showPw) { <path d="M4 4l16 16"/> }</svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                        @if (_editId != null) { <div class="uf-hint">@T("Users.UsernameCannotBeChangedAfterCreation")</div> }
                    </section>

                    <!-- Customer Access -->
                    <section class="uf-box">
                        <h3 class="uf-box-t">@T("Users.CustomerAccess")</h3>
                        <p class="uf-desc">@T("Users.SelectWhichCustomerSThisUser")</p>
                        <div class="uf-radios">
                            <label class="uf-radio"><input type="radio" name="uf-cust" checked="@(!_custAll)" @onchange="() => _custAll = false" /><span>@T("Users.SpecificCustomerS")</span></label>
                            <label class="uf-radio"><input type="radio" name="uf-cust" checked="@_custAll" @onchange="() => _custAll = true" /><span>@T("Users.AllCustomers")</span></label>
                        </div>
                        @if (!_custAll)
                        {
                            <div class="uf-cust-tools">
                                <div class="uf-search">
                                    <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="9" cy="9" r="6"/><path d="M15 15l3 3" stroke-linecap="round"/></svg>
                                    <input placeholder="@T("Users.SearchCustomer")" @bind="_custSearch" @bind:event="oninput" />
                                </div>
                                <button type="button" class="uf-link" @onclick="ToggleSelectAllCustomers">@(AllVisibleSelected ? T("Users.ClearAll") : T("Users.SelectAll"))</button>
                            </div>
                            <div class="uf-cust-list">
                                @if (_loadingCustomers) { <div class="uf-muted">@T("Users.LoadingCustomers")</div> }
                                @foreach (var c in VisibleCustomers)
                                {
                                    var cc = c;
                                    var on = _formCustomerIds.Contains(cc.CustomerId, StringComparer.OrdinalIgnoreCase);
                                    <label class="uf-check @(on ? "on" : "")">
                                        <input type="checkbox" checked="@on" @onchange="e => ToggleCustomer(cc, e.Value is bool b && b)" />
                                        <span>@cc.CustomerId — @cc.CompanyName</span>
                                    </label>
                                }
                                @if (!_loadingCustomers && !VisibleCustomers.Any()) { <div class="uf-muted">@T("Users.NoCustomersFound")</div> }
                            </div>
                            <div class="uf-hint">@T("Users.Selected", _formCustomerIds.Count)</div>
                        }
                    </section>

                    <!-- Additional Information -->
                    <section class="uf-box">
                        <h3 class="uf-box-t">@T("Users.AdditionalInformation")</h3>
                        <div class="uf-row2">
                            <div class="uf-f">
                                <label>@T("Users.Department")</label>
                                <select class="uf-in" @bind="_formDepartment">
                                    <option value="">@T("Common.Select")</option>
                                    @foreach (var d in DepartmentOptions) { <option value="@d">@TE("Opt", d)</option> }
                                </select>
                            </div>
                            <div class="uf-f">
                                <label>@T("Common.Position")</label>
                                <input class="uf-in" type="text" placeholder="@T("Users.EGPurchaser")" @bind="_formPosition" @bind:event="oninput" />
                            </div>
                            <div class="uf-f">
                                <label>@T("Common.Country")</label>
                                @if (_loadingCountries)
                                {
                                    <div class="uf-in uf-muted">@T("Common.Loading")</div>
                                }
                                else
                                {
                                    <select class="uf-in" @bind="_formCountry">
                                        <option value="">@T("Users.SelectCountry")</option>
                                        @foreach (var c in _countries) { <option value="@c.Name">@c.Name</option> }
                                    </select>
                                }
                            </div>
                            <div class="uf-f">
                                <label>@T("Common.Status")</label>
                                <label class="uf-switch">
                                    <input type="checkbox" @bind="_formIsActive" />
                                    <span class="uf-slider"></span>
                                    <b>@(_formIsActive ? T("Common.Active") : T("Common.Inactive"))</b>
                                </label>
                                <div class="uf-hint">@T("Users.InactiveUsersCannotLoginToSystem")</div>
                            </div>
                        </div>
                    </section>
                </div>

                <!-- ════ Cột phải: Module Permissions ════ -->
                <div class="uf-col">
                    <section class="uf-box">
                        <div class="uf-perm-head">
                            <div>
                                <h3 class="uf-box-t">@T("Users.ModulePermissions")</h3>
                                <p class="uf-desc">@T("Users.SetWhatThisUserCanAccess")</p>
                            </div>
                            <div class="uf-legend">
                                <span><i class="lv-none"></i>@T("Users.NoAccess")</span>
                                <span><i class="lv-view"></i>@T("Users.ViewOnly")</span>
                                <span><i class="lv-edit"></i>@T("Users.EditUseModule")</span>
                            </div>
                        </div>
                        <div class="uf-tbl-wrap">
                            <table class="uf-tbl">
                                <thead>
                                    <tr>
                                        <th class="tl">@T("Users.Module")</th>
                                        <th>@T("Users.NoAccess")</th>
                                        <th>@T("Users.ViewOnly")</th>
                                        <th>@T("Common.Edit")<br />@T("Users.UseModule")</th>
                                        <th class="tl">@T("Users.AdditionalSettings")<br /><small>@T("Users.OnlyAvailableWhenEditIsSelected")</small></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var def in ModulePermissionSet.Catalog)
                                    {
                                        var d = def;
                                        var p = _formPerms.Get(d.Key);
                                        <tr>
                                            <td class="tl">
                                                <div class="uf-mod">
                                                    <span class="uf-mod-ico">@((MarkupString)ModuleIcon(d.Key))</span>
                                                    <b>@TE("Opt", d.Label)</b>
                                                </div>
                                            </td>
                                            @foreach (var lv in new[] { PermLevel.None, PermLevel.View, PermLevel.Edit })
                                            {
                                                var l = lv;
                                                var disabled = l > d.MaxLevel;
                                                <td class="tc">
                                                    <label class="uf-lv lv-@l.ToString().ToLower() @(p.Level == l ? "on" : "") @(disabled ? "dis" : "")">
                                                        <input type="radio" name="@($"lv-{d.Key}")" checked="@(p.Level == l)" disabled="@disabled"
                                                               @onchange="() => SetLevel(d, l)" />
                                                        <span></span>
                                                    </label>
                                                </td>
                                            }
                                            <td class="tl">
                                                @if (d.Flags.Length == 0 || (d.FlagsNeedEdit && d.MaxLevel < PermLevel.Edit))
                                                {
                                                    @if (d.MaxLevel < PermLevel.Edit) { <div class="uf-note">@T("Users.OnlyNoAccessOrViewOnly")</div> }
                                                }
                                                else
                                                {
                                                    var enabled = p.Level >= (d.FlagsNeedEdit ? PermLevel.Edit : PermLevel.View);
                                                    <div class="uf-flags @(enabled ? "" : "dis")">
                                                        @foreach (var f in d.Flags)
                                                        {
                                                            var ff = f;
                                                            <label class="uf-flag">
                                                                <input type="checkbox" checked="@(enabled && p.Flag(ff))" disabled="@(!enabled)"
                                                                       @onchange="e => p.SetFlag(ff, e.Value is bool b && b)" />
                                                                <span>@FlagLabel(ff)</span>
                                                            </label>
                                                        }
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="uf-rules">
                            <span class="uf-rules-ico">i</span>
                            <div>
                                <b>@T("Users.PermissionRules")</b>
                                <ul>
                                    <li>@T("Users.CreateEditAndDeletePermissionsAre")</li>
                                    <li>@T("Users.DashboardInspectionSchedulePerformanceReviewAnd")</li>
                                    <li>@T("Users.UsersWillOnlySeeDataFrom")</li>
                                </ul>
                            </div>
                        </div>
                    </section>
                </div>
            </div>

            <div class="uf-foot">
                <button class="uf-btn ghost" @onclick="CloseModal">@T("Common.Cancel")</button>
                <button class="uf-btn primary" @onclick="SaveUser" disabled="@_saving">
                    @if (_saving) { <span class="spinner"></span> }
                    else { <span>@(_editId == null ? T("Users.CreateUser") : T("Users.SaveUser"))</span> }
                </button>
            </div>
        </div>
    </div>
}

@if (_deleteUser != null)
{
    <div class="modal-overlay" @onclick="() => _deleteUser = null">
        <div class="modal-card confirm-card" @onclick:stopPropagation="true">
            <div class="confirm-icon">&#9888;</div>
            <h2>@T("Users.DeleteAccount")</h2>
            <p>@T("Users.AreYouSureYouWantTo") <strong>@_deleteUser.Username</strong>?<br/>@T("Users.ThisActionCannotBeUndone")</p>
            <div class="modal-footer">
                <button class="btn-cancel" @onclick="() => _deleteUser = null">@T("Common.Cancel")</button>
                <button class="btn-delete" @onclick="DeleteUser" disabled="@_saving">
                    @if (_saving) { <span class="spinner"></span> } else { <span>@T("Common.Delete")</span> }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private bool _fOpen;
    // Only roles managed on this page
    private readonly List<string> _roleOptions = new() { "Admin", "Customer", "QAQCManager", "Inspector", "Vendor", "Management", "CustomRole" };

