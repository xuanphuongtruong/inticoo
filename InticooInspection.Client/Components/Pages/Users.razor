    private ModulePermissionSet _formPerms = new();
    private bool    _custAll = false;                       // Customer Access: All customers
    private List<string> _formCustomerIds = new();          // Customer Access: Specific
    private string  _custSearch = "";
    private bool    _showPw = false;
    private string  _formError = "";
    private bool    _saving    = false;

    // Page Access catalogue (key is stable, label is for display)
    private List<PageAccessOption> _pageAccessOptions => new List<PageAccessOption>()
    {
        new("JobRequest",          T("Users.JobRequest")),
        new("InspectionSchedule",  T("Users.InspectionSchedule")),
        new("SummaryInspections",  T("Users.SummaryInspections")),
        new("Directory",           T("Users.Directory")),
        new("PerformanceReview",   T("Users.PerformanceReview")),
        new("DefectManagement",    T("Users.DefectManagement")),
