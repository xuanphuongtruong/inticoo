                                <tr>
                                    <th style="width:48px">No</th>
                                    <th>@T("Common.TestItem")</th>
                                    <th>@T("Common.TestRequirement")</th>
                                    <th style="width:90px">@T("InspectionReport.TestQuantity")</th>
                                    <th style="width:80px">@T("Common.Result")</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="tc">@(dIdx + 1)</td>
                                    <td>@(test.TestItem ?? "—")</td>
                                    <td>@(dTestReq ?? "—")</td>
                                    <td class="tc">@test.TestQuantity</td>
                                    <td class="tc">
                                        @if (!string.IsNullOrEmpty(test.Result))
                                        {
                                            <span class="rpt-compliance-badge comp-@(test.Result.ToLower())">@TE("Status", test.Result)</span>
                                        }
                                        else
                                        { <span>—</span> }
