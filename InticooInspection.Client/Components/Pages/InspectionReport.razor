    public class QcDefectDto
    {
        public string       Type     { get; set; } = "";
        public string?      DefectCode { get; set; }

        /// <summary>Chú thích ảnh lỗi: "mã lỗi" + DefectCaptionSep + "remark" — report tách thành 2 dòng (xem DefectCaption).</summary>
        public string RemarkAt(int i)
        {
            var rmk  = Remarks?.ElementAtOrDefault(i) ?? Remark ?? "";
            var code = InticooInspection.Client.Shared.DefectCodes.Label(DefectCode);
            return $"{code}{DefectCaptionSep}{rmk}";
        }
        public string?      PhotoUrl { get; set; }
        public List<string> Photos   { get; set; } = new();
        public List<string> Remarks  { get; set; } = new();
