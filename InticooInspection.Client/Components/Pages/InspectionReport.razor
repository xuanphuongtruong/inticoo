                        @if (!string.IsNullOrWhiteSpace(dTestProto))
                        {
                            <table class="rpt-perf-table" style="margin-top:6px">
                                <tbody>
                                    <tr>
                                        <td class="rpt-info-label" style="vertical-align:top;width:140px">@T("Common.TestProtocol")</td>
                                        <td class="rpt-info-val" style="white-space:pre-wrap;line-height:1.6">@dTestProto</td>
                                    </tr>
                                </tbody>
                            </table>
                        }
                        <table class="rpt-perf-table" style="margin-top:6px">
                            <tbody>
                                <tr>
                                    <td class="rpt-info-label" style="vertical-align:top;width:140px">@T("Common.Remark")</td>
                                    <td class="rpt-info-val" style="white-space:pre-wrap;line-height:1.6">@(string.IsNullOrWhiteSpace(test.Remark) ? "—" : test.Remark)</td>
                                </tr>
                            </tbody>
                        </table>
                        @{
                            // Trang đầu D có table + protocol → chỉ chứa được ~2 ảnh
                            var _dFirst = dPhotos.Take(2).Cast<string?>().ToList();
                            if (_dFirst.Count > 0 && _dFirst.Count % 2 != 0) _dFirst.Add(null);
                            if (_dFirst.Count == 0) _dFirst = new List<string?> { null, null };
