                    {
                        var _qps = _qcData?.ProductSpec;
                        var _dims = new (string Lbl, double Ref, double? Act)[]
                        {
                            (T("InspectionReport.LengthL"), _data.ProductSpec.SizeL, _qps?.SpecL is > 0 ? _qps.SpecL : _data.ProductSpec.ActualSizeL),
                            (T("InspectionReport.WidthW"),  _data.ProductSpec.SizeW, _qps?.SpecW is > 0 ? _qps.SpecW : _data.ProductSpec.ActualSizeW),
                            (T("InspectionReport.HeightH"), _data.ProductSpec.SizeH, _qps?.SpecH is > 0 ? _qps.SpecH : _data.ProductSpec.ActualSizeH),
                        };
                        <div class="rpt-sub-desc">@T("InspectionReport.ProductSizeDesc")</div>
                        <div class="rpt-size-wrap">
                            <table class="rpt-spec-table rpt-size-table">
                                <thead><tr>
                                    <th style="width:16%">@T("InspectionReport.Dimension")</th>
                                    <th style="width:30%">@T("InspectionReport.MeasurementFromProfile")</th>
                                    <th style="width:30%">@T("InspectionReport.ActualMeasurement")</th>
                                    <th style="width:24%">@T("InspectionReport.Different")</th>
                                </tr></thead>
                                <tbody>
                                    @foreach (var _dm in _dims)
                                    {
                                        double? _dd = _dm.Ref > 0 && _dm.Act is > 0 ? _dm.Act - _dm.Ref : null;
                                        <tr>
                                            <td class="rpt-size-lbl">@_dm.Lbl</td>
                                            <td data-l="@T("InspectionReport.MeasurementFromProfile")">@MmIn(_dm.Ref)</td>
                                            <td data-l="@T("InspectionReport.ActualMeasurement")">@MmIn(_dm.Act)</td>
                                            <td data-l="@T("InspectionReport.Different")">@(_dd.HasValue ? $"{_dd.Value:+0.#;-0.#;0} mm / {_dd.Value / 25.4:+0.0;-0.0;0} in" : "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            <div class="rpt-size-summary @(IsFailVal(_qps?.SizeResult) ? "is-fail" : IsPassVal(_qps?.SizeResult) ? "is-pass" : "")">
                                <div class="rpt-size-summary-title">@T("InspectionReport.Summary")</div>
                                <div>@ResultPill(_qps?.SizeResult)</div>
                                <div class="rpt-size-summary-text">@(string.IsNullOrWhiteSpace(_qps?.SizeRemark) ? "—" : _qps!.SizeRemark)</div>
                            </div>
                        </div>
                    }
                    @if (_spFirst.Count > 0)
                    {
                        <div class="rpt-photo-grid-2">
