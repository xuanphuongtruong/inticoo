                    <div class="rpt-footer">
                        <div class="rpt-footer-inner">
                            <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                            <span class="rpt-footer-page"></span>
                        </div>
                    </div>
                </div>

                @* Trang tiếp theo của i. Carton Size (nếu > 4 ảnh) *@
                @for (int _csPi = 0; _csPi < _csRestPages.Count; _csPi++)
                {
                    var _csPage = _csRestPages[_csPi];
                    var _csIsLast = _csPi == _csRestPages.Count - 1;
                    <div class="rpt-section page-break-after">
                        <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.BPackagingIdentification", cartonSuffix)</div>
                        <div class="rpt-sub-title">@T("InspectionReport.ICartonSize")</div>
                        <div class="rpt-photo-grid-2">
                            @foreach (var _u in _csPage)
                            {
                                <div class="rpt-photo-cell">
                                    @if (!string.IsNullOrEmpty(_u))
                                    { <img src="@NormalizeUrl(_u)" class="rpt-photo" alt="@T("InspectionReport.CartonSize")" loading="eager"/> }
                                </div>
                            }
                        </div>
                        @if (_csIsLast && !string.IsNullOrEmpty(_csResult))
                        {
                            <div style="text-align:right;margin-top:4px">
                                <span class="rpt-compliance-badge comp-@(_csResult.ToLower())">@TE("Status", _csResult)</span>
                            </div>
                        }
                        <div class="rpt-footer">
                            <div class="rpt-footer-inner">
                                <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                            <span class="rpt-footer-page"></span>
                            </div>
                        </div>
                    </div>
                }

                @* ── ii. Shipping Mark + iii. Carton Weight ──
                   Logic: Nếu tổng ảnh ≤ 4 → gộp 1 trang (giữ layout như cũ).
                   Nếu nhiều hơn → mỗi phần 1 trang riêng, mỗi trang ≤ 6 ảnh. *@
                var _shipAll = ((cd?.ShippingMarkPhotos ?? pr?.ShippingMarkPhotos) ?? Enumerable.Empty<string>())
                    .Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
                var _wgtAll = ((cd?.WeightPhotos ?? pr?.WeightPhotos) ?? Enumerable.Empty<string>())
                    .Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
                var _smResult = cd?.ShippingMarkResult ?? pr?.ShippingMarkResult;
                var _cwResult = cd?.CartonWeightResult ?? pr?.CartonWeightResult;
                bool _combineShipWgt = _shipAll.Count + _wgtAll.Count <= 4;

                if (_combineShipWgt)
                {
                    @* Trang gộp ii + iii (≤ 4 ảnh tổng cộng) *@
                    <div class="rpt-section page-break-after">
                        <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.BPackagingIdentification", cartonSuffix)</div>

                        <div>
                            <div class="rpt-sub-title">@T("InspectionReport.IiShippingMarkLabelingBarcode2")</div>
                            @{
                                var _shipPad = _shipAll.Cast<string?>().ToList();
                                if (_shipPad.Count == 0) _shipPad = new List<string?> { null, null };
                                else if (_shipPad.Count % 2 != 0) _shipPad.Add(null);
                            }
                            <div class="rpt-photo-grid-2">
                                @foreach (var _u in _shipPad)
                                {
                                    <div class="rpt-photo-cell">
                                        @if (!string.IsNullOrEmpty(_u))
                                        { <img src="@NormalizeUrl(_u)" class="rpt-photo" alt="@T("InspectionReport.ShippingMark")" loading="eager"/> }
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_smResult))
                            {
                                <div style="text-align:right;margin-top:4px">
                                    <span class="rpt-compliance-badge comp-@(_smResult.ToLower())">@TE("Status", _smResult)</span>
                                </div>
                            }
                        </div>

                        <div style="margin-top:16px;">
                            <div class="rpt-sub-title">@T("InspectionReport.IiiCartonWeight2")</div>
                            <div class="rpt-sub-desc">@T("InspectionReport.CartonWeightDesc")</div>
                            @WeightCompare(_data?.Packaging?.OuterWeight, cd?.Weight, _cwResult)
                            @{
                                var _wgtPad = _wgtAll.Cast<string?>().ToList();
                                if (_wgtPad.Count == 0) _wgtPad = new List<string?> { null, null };
                                else if (_wgtPad.Count % 2 != 0) _wgtPad.Add(null);
                            }
                            <div class="rpt-photo-grid-2">
                                @foreach (var _u in _wgtPad)
                                {
                                    <div class="rpt-photo-cell">
                                        @if (!string.IsNullOrEmpty(_u))
                                        { <img src="@NormalizeUrl(_u)" class="rpt-photo" alt="@T("InspectionReport.CartonWeight")" loading="eager"/> }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="rpt-footer">
                            <div class="rpt-footer-inner">
                                <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                <span class="rpt-footer-page"></span>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    @* Tách: ii thành các trang riêng (max 6 ảnh/trang) *@
                    var _shipPages = ChunkPhotosForPages(_shipAll);
                    @for (int _shipPi = 0; _shipPi < _shipPages.Count; _shipPi++)
                    {
                        var _shipPage = _shipPages[_shipPi];
                        var _shipIsLast = _shipPi == _shipPages.Count - 1;
                        var _shipSuffix = _shipPages.Count > 1 ? "" : "";
                        <div class="rpt-section page-break-after">
                            <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.BPackagingIdentification", cartonSuffix)</div>
                            <div class="rpt-sub-title">@T("InspectionReport.IiShippingMarkLabelingBarcode", _shipPi == 0 ? "" : _shipSuffix)</div>
                            <div class="rpt-photo-grid-2">
                                @foreach (var _u in _shipPage)
                                {
                                    <div class="rpt-photo-cell">
                                        @if (!string.IsNullOrEmpty(_u))
                                        { <img src="@NormalizeUrl(_u)" class="rpt-photo" alt="@T("InspectionReport.ShippingMark")" loading="eager"/> }
                                    </div>
                                }
                            </div>
                            @if (_shipIsLast && !string.IsNullOrEmpty(_smResult))
                            {
                                <div style="text-align:right;margin-top:4px">
                                    <span class="rpt-compliance-badge comp-@(_smResult.ToLower())">@TE("Status", _smResult)</span>
                                </div>
                            }
                            <div class="rpt-footer">
                                <div class="rpt-footer-inner">
                                    <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                <span class="rpt-footer-page"></span>
                                </div>
                            </div>
                        </div>
                    }

                    @* Tách: iii thành các trang riêng (max 6 ảnh/trang) *@
                    var _wgtPages = ChunkPhotosForPages(_wgtAll);
                    @for (int _wgtPi = 0; _wgtPi < _wgtPages.Count; _wgtPi++)
                    {
                        var _wgtPage = _wgtPages[_wgtPi];
                        var _wgtSuffix = _wgtPages.Count > 1 ? "" : "";
                        <div class="rpt-section page-break-after">
                            <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.BPackagingIdentification", cartonSuffix)</div>
                            <div class="rpt-sub-title">@T("InspectionReport.IiiCartonWeight", _wgtPi == 0 ? "" : _wgtSuffix)</div>
                            @if (_wgtPi == 0)
                            {
                                <div class="rpt-sub-desc">@T("InspectionReport.CartonWeightDesc")</div>
                                @WeightCompare(_data?.Packaging?.OuterWeight, cd?.Weight, _cwResult)
                            }
                            <div class="rpt-photo-grid-2">
                                @foreach (var _u in _wgtPage)
                                {
                                    <div class="rpt-photo-cell">
                                        @if (!string.IsNullOrEmpty(_u))
                                        { <img src="@NormalizeUrl(_u)" class="rpt-photo" alt="@T("InspectionReport.CartonWeight")" loading="eager"/> }
                                    </div>
                                }
                            </div>
                            <div class="rpt-footer">
                                <div class="rpt-footer-inner">
                                    <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                <span class="rpt-footer-page"></span>
                                </div>
                            </div>
                        </div>
                    }
                }

                @* ── iv. Packaging & Labeling Specifications (chunked: 6 ảnh/trang) ── *@
                var _plPages = ChunkPhotosForPages(cd?.PkgLabelPhotos ?? pr?.PkgLabelPhotos);
                var _plResult = cd?.PkgLabelResult ?? pr?.PkgLabelResult;
                @for (int _plPi = 0; _plPi < _plPages.Count; _plPi++)
                {
                    var _plPage = _plPages[_plPi];
                    var _plIsLast = _plPi == _plPages.Count - 1;
                    var _plSuffix = _plPages.Count > 1 && _plPi > 0 ? "" : "";
                    <div class="rpt-section page-break-after">
                        <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.BPackagingIdentification", cartonSuffix)</div>
                        <div class="rpt-sub-title">@T("InspectionReport.IvPackagingLabelingSpecifications", _plSuffix)</div>
                        <div class="rpt-photo-grid-2">
                            @foreach (var _u in _plPage)
                            {
                                <div class="rpt-photo-cell">
                                    @if (!string.IsNullOrEmpty(_u))
                                    { <img src="@NormalizeUrl(_u)" class="rpt-photo" alt="@T("InspectionReport.PkgLabel")" loading="eager"/> }
                                </div>
                            }
                        </div>
                        @if (_plIsLast && !string.IsNullOrEmpty(_plResult))
                        {
                            <div style="text-align:right;margin-top:4px">
                                <span class="rpt-compliance-badge comp-@(_plResult.ToLower())">@TE("Status", _plResult)</span>
                            </div>
                        }
                        <div class="rpt-footer">
                            <div class="rpt-footer-inner">
                                <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                <span class="rpt-footer-page"></span>
                            </div>
                        </div>
                    </div>
                }

                @* ── v. Assembly Instruction Specifications (chunked: 6 ảnh/trang) ── *@
                // Có chi tiết (AssemblyIncluded) → bảng thông số ở trang đầu; N/A → mọi ô N/A, không in ảnh.
                var _asInc    = cd?.AssemblyIncluded;
                var _asDetail = !string.IsNullOrEmpty(_asInc);
                var _asNA     = IsNAVal(_asInc);
                var _asPages = _asNA ? new List<List<string?>> { new() }
                             : _asDetail ? ChunkPhotosAfterTable(cd?.AssemblyPhotos)
                             : ChunkPhotosForPages(cd?.AssemblyPhotos ?? pr?.AssemblyPhotos);
                var _asResult = _asDetail ? null : (cd?.AssemblyResult ?? pr?.AssemblyResult);
                @for (int _asPi = 0; _asPi < _asPages.Count; _asPi++)
                {
                    var _asPage = _asPages[_asPi];
                    var _asIsLast = _asPi == _asPages.Count - 1;
                    var _asSuffix = _asPages.Count > 1 && _asPi > 0 ? "" : "";
                    <div class="rpt-section page-break-after">
                        <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.BPackagingIdentification", cartonSuffix)</div>
                        <div class="rpt-sub-title">@T("InspectionReport.VAssemblyInstructionSpecifications", _asSuffix)</div>
                        @if (_asPi == 0 && _asDetail)
                        {
                            string AsVal(string? v) => _asNA ? "N/A" : (string.IsNullOrWhiteSpace(v) ? "—" : v);
                            <table class="rpt-spec-table rpt-kv-table">
                                <tbody>
                                    <tr><th>@T("InspectionReport.AssemblyInstructionIncluded")</th><td>@(_asNA ? "N/A" : T("Common.Yes"))</td></tr>
                                    <tr><th>@T("InspectionReport.InstructionType")</th><td>@(_asNA || string.IsNullOrEmpty(cd!.AssemblyType) ? AsVal(null) : TE("Opt", cd.AssemblyType))</td></tr>
                                    <tr><th>@T("InspectionReport.Language")</th><td>@AsVal(cd!.AssemblyLanguage)</td></tr>
                                    <tr><th>@T("InspectionReport.Pages")</th><td>@AsVal(cd.AssemblyPages)</td></tr>
                                    <tr><th>@T("InspectionReport.PrintingQuality")</th><td>@(_asNA || string.IsNullOrEmpty(cd.AssemblyPrintQuality) ? AsVal(null) : TE("Opt", cd.AssemblyPrintQuality))</td></tr>
                                    <tr><th>@T("Common.Remark")</th><td>@AsVal(cd.AssemblyRemark)</td></tr>
                                </tbody>
                            </table>
                        }
                        <div class="rpt-photo-grid-2">
                            @foreach (var _u in _asPage)
                            {
                                <div class="rpt-photo-cell">
                                    @if (!string.IsNullOrEmpty(_u))
                                    { <img src="@NormalizeUrl(_u)" class="rpt-photo" alt="@T("InspectionReport.Assembly")" loading="eager"/> }
                                </div>
                            }
                        </div>
                        @if (_asIsLast && !string.IsNullOrEmpty(_asResult))
                        {
                            <div style="text-align:right;margin-top:4px">
                                <span class="rpt-compliance-badge comp-@(_asResult.ToLower())">@TE("Status", _asResult)</span>
                            </div>
                        }
                        <div class="rpt-footer">
                            <div class="rpt-footer-inner">
                                <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                <span class="rpt-footer-page"></span>
                            </div>
                        </div>
                    </div>
                }

                @* ── vi. Hardware Specifications (chunked: 6 ảnh/trang) ── *@
                var _hwResult = cd?.HardwareResult ?? pr?.HardwareResult;
                // QC chọn "không có hardware" (HardwareResult = N/A) → 1 trang với khung Not Applicable
                var _hwNA = IsNAVal(_hwResult);
                var _hwYes = _hwResult == "Yes";
                var _hwPages = _hwNA ? new List<List<string?>>()
                             : _hwYes ? ChunkPhotosAfterTable(cd?.HardwarePhotos)
                             : ChunkPhotosForPages(cd?.HardwarePhotos ?? pr?.HardwarePhotos);
                if (_hwResult == "Yes") _hwResult = null;   // "Yes" chỉ là lựa chọn có/không, không phải kết quả
                @if (_hwNA)
                {
                    <div class="rpt-section page-break-after">
                        <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.BPackagingIdentification", cartonSuffix)</div>
                        <div class="rpt-sub-title">@T("InspectionReport.ViHardwareSpecifications", "")</div>
                        @NotApplicableBox(T("InspectionReport.HardwareNotApplicableText"))
                        <div class="rpt-footer">
                            <div class="rpt-footer-inner">
                                <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                <span class="rpt-footer-page"></span>
                            </div>
                        </div>
                    </div>
                }
                @for (int _hwPi = 0; _hwPi < _hwPages.Count; _hwPi++)
                {
                    var _hwPage = _hwPages[_hwPi];
                    var _hwIsLast = _hwPi == _hwPages.Count - 1;
                    var _hwSuffix = _hwPages.Count > 1 && _hwPi > 0 ? "" : "";
                    <div class="rpt-section page-break-after">
                        <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.BPackagingIdentification", cartonSuffix)</div>
                        <div class="rpt-sub-title">@T("InspectionReport.ViHardwareSpecifications", _hwSuffix)</div>
                        @if (_hwPi == 0 && _hwYes)
                        {
                            string HwVal(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;
                            <table class="rpt-spec-table rpt-kv-table">
                                <tbody>
                                    <tr><th>@T("InspectionReport.HardwareIncluded")</th><td>@T("Common.Yes")</td></tr>
                                    <tr><th>@T("InspectionReport.Quantity")</th><td>@HwVal(cd!.HardwareQuantity)</td></tr>
                                    <tr><th>@T("InspectionReport.Packaging")</th><td>@(string.IsNullOrEmpty(cd.HardwarePackaging) ? "—" : TE("Opt", cd.HardwarePackaging))</td></tr>
                                    <tr><th>@T("InspectionReport.QualityOfHardware")</th><td>@(string.IsNullOrEmpty(cd.HardwareQuality) ? "—" : TE("Opt", cd.HardwareQuality))</td></tr>
                                    <tr><th>@T("Common.Remark")</th><td>@HwVal(cd.HardwareRemark)</td></tr>
                                </tbody>
                            </table>
                        }
                        <div class="rpt-photo-grid-2">
                            @foreach (var _u in _hwPage)
                            {
                                <div class="rpt-photo-cell">
                                    @if (!string.IsNullOrEmpty(_u))
                                    { <img src="@NormalizeUrl(_u)" class="rpt-photo" alt="@T("Common.Hardware")" loading="eager"/> }
                                </div>
                            }
                        </div>
                        @if (_hwIsLast && !string.IsNullOrEmpty(_hwResult))
                        {
                            <div style="text-align:right;margin-top:4px">
                                <span class="rpt-compliance-badge comp-@(_hwResult.ToLower())">@TE("Status", _hwResult)</span>
                            </div>
                        }
                        <div class="rpt-footer">
                            <div class="rpt-footer-inner">
                                <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                <span class="rpt-footer-page"></span>
                            </div>
                        </div>
                    </div>
                }

                @* ── vii. Hangtag Specifications (chunked: 6 ảnh/trang) ── *@
                // Có chi tiết (HangtagIncluded) → bảng thông số ở trang đầu; N/A → mọi ô N/A, không in ảnh.
                var _htInc    = cd?.HangtagIncluded;
                var _htNA     = IsNAVal(_htInc);
                var _htDetail = !string.IsNullOrEmpty(_htInc);
                @if (_htDetail)
                {
                    var _htPages = _htNA ? new List<List<string?>> { new() } : ChunkPhotosAfterTable(cd?.HangtagPhotos);
                    @for (int _htPi = 0; _htPi < _htPages.Count; _htPi++)
                    {
                        var _htPage = _htPages[_htPi];
                        <div class="rpt-section page-break-after">
                            <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.BPackagingIdentification", cartonSuffix)</div>
                            <div class="rpt-sub-title">@T("InspectionReport.ViiHangtagSpecifications")</div>
                            @if (_htPi == 0)
                            {
                                string HtVal(string? v) => _htNA ? "N/A" : (string.IsNullOrWhiteSpace(v) ? "—" : v);
                                string HtOpt(string? v) => _htNA ? "N/A" : (string.IsNullOrWhiteSpace(v) ? "—" : TE("Opt", v));
                                var _htSize = _htNA ? "N/A"
                                    : (string.IsNullOrWhiteSpace(cd!.HangtagSizeL) && string.IsNullOrWhiteSpace(cd.HangtagSizeW)) ? "—"
                                    : $"L: {cd.HangtagSizeL}  W: {cd.HangtagSizeW}";
                                <table class="rpt-spec-table rpt-kv-table">
                                    <tbody>
                                        <tr><th>@T("InspectionReport.HangtagIncluded")</th><td>@(_htNA ? "N/A" : T("Common.Yes"))</td></tr>
                                        <tr><th>@T("InspectionReport.HangtagType")</th><td>@HtOpt(cd!.HangtagType)</td></tr>
                                        <tr><th>@T("InspectionReport.SizeMM")</th><td>@_htSize</td></tr>
                                        <tr><th>@T("InspectionReport.Shape")</th><td>@HtOpt(cd.HangtagShape)</td></tr>
                                        <tr><th>@T("InspectionReport.Material")</th><td>@HtVal(cd.HangtagMaterial)</td></tr>
                                        <tr><th>@T("InspectionReport.PrintingQuality")</th><td>@HtOpt(cd.HangtagPrintQuality)</td></tr>
                                        <tr><th>@T("InspectionReport.Language")</th><td>@HtVal(cd.HangtagLanguage)</td></tr>
                                        <tr><th>@T("InspectionReport.Quantity")</th><td>@HtVal(cd.HangtagQuantity)</td></tr>
                                        <tr><th>@T("Common.Remark")</th><td>@HtVal(cd.HangtagRemark)</td></tr>
                                    </tbody>
                                </table>
                            }
                            <div class="rpt-photo-grid-2">
                                @foreach (var _u in _htPage)
                                {
                                    <div class="rpt-photo-cell">
                                        @if (!string.IsNullOrEmpty(_u))
                                        { <img src="@NormalizeUrl(_u)" class="rpt-photo" alt="@T("InspectionReport.Hangtag")" loading="eager"/> }
                                    </div>
                                }
                            </div>
                            <div class="rpt-footer">
                                <div class="rpt-footer-inner">
                                    <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                    <span class="rpt-footer-page"></span>
                                </div>
                            </div>
                        </div>
                    }
                }
            }
            } @* end IsPass("B") *@

            <!-- ══ SECTION C (1/2): Product Specification Compliance — Size + Golden ══ -->
            @if (IsPass("C"))
            {
            @if (_data.ProductSpec != null || _qcData?.ProductSpec != null)
            {
                // Ảnh Product Size: ưu tiên SizePhotos (List<string>) – đây là field màn QC lưu thực tế.
                var _spAll = (_qcData?.ProductSpec?.SizePhotos ?? Enumerable.Empty<string>())
                    .Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
                // Fallback dữ liệu cũ: lấy photoUrl từ SizeRows nếu chưa có SizePhotos.
                if (_spAll.Count == 0 && _qcData?.ProductSpec?.SizeRows != null)
                {
                    _spAll = _qcData.ProductSpec.SizeRows
                        .Select(r => r.TryGetProperty("photoUrl", out var pu) ? pu.GetString() : null)
                        .Where(p => !string.IsNullOrWhiteSpace(p))
                        .Select(p => p!)
                        .ToList();
                }
                // Trang đầu Product Size: bảng spec + tối đa 4 ảnh (phần dư sang trang phụ).
                var _spFirst = _spAll.Take(4).Cast<string?>().ToList();
                if (_spFirst.Count > 0 && _spFirst.Count % 2 != 0) _spFirst.Add(null);

                var _gpAll = (_qcData?.ProductSpec?.GoldenPhotos ?? Enumerable.Empty<string>())
                    .Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
                var _gpFirst = _gpAll.Take(4).Cast<string?>().ToList();
                if (_gpFirst.Count > 0 && _gpFirst.Count % 2 != 0) _gpFirst.Add(null);
                if (_gpFirst.Count == 0) _gpFirst = new List<string?> { null, null };

                @* ── i. Product Size — trang đầu: bảng spec + tối đa 4 ảnh ── *@
                <div class="rpt-section page-break-after">
                    <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.CProductSpecificationCompliance12")</div>
