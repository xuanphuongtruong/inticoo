}

<style>
    /* ══════════════════════════════════════════
       GLOBAL IMG RESET
    ══════════════════════════════════════════ */
    .rpt-paper td, .rpt-paper th, .rpt-paper span, .rpt-paper div {
        color: inherit;
    }
    .rpt-paper {
        color: #1a1a2e;
    }
    .rpt-page img {
        vertical-align: top !important;
        max-width: 100%;
        height: 100%;
        border: none;
        margin: 0;
        padding: 0;
    }
    .rpt-page .rpt-photo-cell img,
    .rpt-page .rpt-photo-cell .rpt-photo {
        width: 100% !important;
        object-position: center !important;
        display: block !important;
        vertical-align: top !important;
        min-height: unset !important;
        max-width: unset !important;
    }
    .rpt-page .rpt-overview-photo-cell img,
    .rpt-page .rpt-overview-photo-cell .rpt-overview-img {
        width: 100% !important;
        height: 350px !important;
        object-fit: contain !important;
        object-position: center !important;
        display: block !important;
        vertical-align: top !important;
        background: #fafbfc !important;
    }

    /* ══════════════════════════════════════════
       BASE
    ══════════════════════════════════════════ */
    :root {
        --brand: #2D7DD2;
        --brand-dark: #1a5fa8;
        --border: #d9e4f0;
        --bg-light: #f7f9fc;
        --text: #1a1a2e;
        --text-muted: #888;
    }

    .rpt-page {
        font-family: 'SF Pro Display', -apple-system, 'Segoe UI', Arial, sans-serif;
        background: #e8edf5;
        min-height: 100vh;
        padding-bottom: 60px;
    }

    /* ══════════════════════════════════════════
       TOOLBAR (screen only)
    ══════════════════════════════════════════ */
    .rpt-print-footer { display: none; }

    .rpt-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px 20px;
        background: white;
        border-bottom: 1px solid var(--border);
        position: sticky;
        /* top = chiều cao .top-navbar (60px) để toolbar dán NGAY DƯỚI navbar khi cuộn,
           không đè lên menu chính. */
        top: var(--topbar-h, 0px);
        /* z-index thấp hơn .top-navbar (40) và .nav-dropdown-menu (42)
           để dropdown menu (Directory) hiển thị đè lên toolbar khi user mở menu. */
        z-index: 30;
        box-shadow: 0 2px 8px rgba(0,0,0,.07);
    }

    .rpt-back-btn {
        display: flex; align-items: center; gap: 4px;
        background: none; border: none;
        font-size: 14px; color: var(--brand); font-weight: 600;
        cursor: pointer; padding: 6px 10px;
        border-radius: 8px;
        transition: background .15s;
    }
    .rpt-back-btn:hover { background: #f0f5ff; }

    .rpt-print-btn {
        display: flex; align-items: center; gap: 6px;
        background: var(--brand); color: white;
        border: none; border-radius: 8px;
        padding: 8px 18px;
        font-size: 13px; font-weight: 600;
        cursor: pointer;
        transition: background .2s;
    }
    .rpt-print-btn:hover { background: var(--brand-dark); }
    .rpt-print-btn:disabled { opacity: .7; cursor: not-allowed; }
    .rpt-print-spinner { animation: rpt-spin 0.8s linear infinite; }
    @@keyframes rpt-spin {
        from { transform: rotate(0deg); }
        to   { transform: rotate(360deg); }
    }

    /* ══════════════════════════════════════════
       PAPER CONTAINER
    ══════════════════════════════════════════ */
    .rpt-paper {
        max-width: 860px;
        margin: 24px auto;
        background: transparent;
        /* ★ Khởi tạo CSS counter cho số trang — dùng cho cả screen và print */
        counter-reset: page-counter;
    }

    .rpt-section {
        background: white;
        border-radius: 10px;
        padding: 28px 32px 80px;
        margin-bottom: 20px;
        box-shadow: 0 2px 12px rgba(0,0,0,.07);
        position: relative;
        min-height: 400px;
        /* ★ Font-size chung cho tất cả các trang report */
        font-size: 12px;
        /* ★ Mỗi section = 1 trang → tăng counter */
        counter-increment: page-counter;
    }

    /* ★ Trang Final (chữ ký) — giữ size mặc định trình duyệt, không bị thu nhỏ */
    .rpt-section.rpt-section-final {
        font-size: 16px;
    }

    /* ══════════════════════════════════════════
       COVER HEADER
    ══════════════════════════════════════════ */
    .rpt-cover-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
        padding-bottom: 20px;
        border-bottom: 2px solid var(--border);
        gap: 20px;
        flex-wrap: nowrap;
    }
    .rpt-logo-wrap .rpt-logo-img {
        height: 48px; width: auto;
        object-fit: contain; display: block;
    }
    .rpt-logo-wrap {
        display: flex; align-items: center; gap: 10px;
        flex: 0 0 auto;
    }
    .rpt-logo-text {
        font-size: 22px; font-weight: 800;
        color: var(--brand); letter-spacing: -0.5px;
    }
    .rpt-title-block {
        text-align: right; flex: 1 1 auto; min-width: 0;
    }
    .rpt-main-title {
        font-size: 26px; font-weight: 800;
        color: var(--text); letter-spacing: .04em; line-height: 1.1;
    }
    .rpt-job-no {
        font-size: 14px; font-weight: 600;
        color: var(--brand); margin-top: 6px;
    }

    /* ══════════════════════════════════════════
       SECTION TITLES
    ══════════════════════════════════════════ */
    .rpt-section-title {
        font-size: 13px; font-weight: 700;
        color: var(--text); text-align: center;
        letter-spacing: .08em; text-transform: uppercase;
        margin: 5px 0 5px;
    }
    .rpt-section-title-lg {
        font-size: 16px; text-align: left;
        padding-bottom: 8px;
        border-bottom: 2px solid var(--brand);
        color: var(--brand-dark); margin-top: 0;
    }
    .rpt-sub-title {
        font-size: 13px; font-weight: 700;
        color: var(--text); margin: 14px 0 6px;
        display: flex; align-items: center; gap: 12px;
    }
    .rpt-result-inline { display: none; }

    /* ══════════════════════════════════════════
       GENERAL INFO TABLE
    ══════════════════════════════════════════ */
    .rpt-info-table {
        width: 100%; border-collapse: collapse;
        font-size: 12px; margin-bottom: 6px;
    }
    .rpt-info-table td { padding: 7px 10px; border: 1px solid var(--border); }
    .rpt-info-label {
        background: #f4f7fc; font-weight: 600;
        color: var(--text); width: 150px; white-space: nowrap;
    }
    .rpt-info-val { color: var(--text); }

    /* ══════════════════════════════════════════
       RESULT TABLE
    ══════════════════════════════════════════ */
    .rpt-result-table {
        width: 100%; border-collapse: collapse;
        font-size: 12px; margin-top: 6px;
    }
    .rpt-result-table th, .rpt-result-table td {
        border: 1px solid var(--border);
        padding: 7px 10px; color: var(--text);
    }
    .rpt-result-table tbody td { color: #1a1a2e; background: white; }
    .rpt-result-table tbody tr:nth-child(even) td { background: #fafbfc; }
    .rpt-result-table thead th {
        background: #1a2a4a; color: white !important;
        font-weight: 700; font-size: 11px;
        text-transform: uppercase; letter-spacing: .04em;
    }
    .rpt-th-label  { width: 38%; }
    .rpt-th-comp   { width: 14%; text-align: center; }
    .rpt-th-remark { width: 48%; }
    .rpt-td-center { text-align: center; }

    /* ══════════════════════════════════════════
       COMPLIANCE BADGE
    ══════════════════════════════════════════ */
    .rpt-compliance-badge {
        display: inline-block;
        font-size: 10px; font-weight: 700;
        padding: 2px 9px; border-radius: 10px;
        text-transform: uppercase; letter-spacing: .04em;
    }
    .comp-passed, .comp-pass   { background: #e8f5e9; color: #2e7d32; }
    .comp-failed, .comp-fail   { background: #fce4ec; color: #c62828; }
    .comp-na, .comp-none, .comp- { background: #f0f0f0; color: #555; }
    .comp-yes                  { background: #e8f5e9; color: #2e7d32; }
    .comp-no                   { background: #fce4ec; color: #c62828; }
    .rpt-compliance-badge      { color: #333; }

    /* ══════════════════════════════════════════
       PHOTO GRID — ★ FIX CHÍNH ★
       Đổi từ display:grid sang flex-wrap. Lý do:
       - Safari KHÔNG honor break-inside:avoid trên grid item
         → ảnh bị cắt giữa trang khi xuất PDF.
       - Chrome khi cell quá cao gặp cuối trang sẽ đẩy 1 ảnh/dòng.
       - Flex item handle break-inside đúng trên cả 2 engine.
    ══════════════════════════════════════════ */
    .rpt-photo-grid-2 {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin: 10px 0;
    }
    .rpt-photo-cell {
        flex: 0 0 calc(50% - 6px);
        max-width: calc(50% - 6px);
        box-sizing: border-box;
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
        background: #fafbfc;
        height: 350px;
        display: block;
        break-inside: avoid;
        page-break-inside: avoid;
        -webkit-column-break-inside: avoid;
    }
    .rpt-photo-cell img.rpt-photo {
        width: 100%;
        height: 100% !important;
        object-fit: contain;
        display: block;
    }
    .rpt-photo {
        width: 100%; height: 350px;
        object-fit: contain; object-position: center;
        display: block; vertical-align: top;
        flex-shrink: 0;
    }

    /* Overview photo */
    .rpt-overview-photo-wrap { margin: 10px 0; }
    .rpt-overview-photo-cell {
        border: 1px solid var(--border);
        border-radius: 8px; overflow: hidden;
        background: #fafbfc; display: block;
    }
    .rpt-overview-img {
        width: 100%; height: 350px;
        object-fit: contain; object-position: center;
        display: block; vertical-align: top;
        background: #fafbfc;
    }
    .rpt-photo-empty-lg {
        height: 350px;
        display: flex; align-items: center; justify-content: center;
        font-size: 13px; color: #bbb;
        background: #fafbfc;
        border-radius: 8px;
        border: 1px dashed #ddd;
    }
    .rpt-photo-label {
        padding: 6px 10px;
        font-size: 11px; color: var(--text-muted);
        background: #f9f9f9;
        border-top: 1px solid var(--border);
    }
    .rpt-photo-remark {
        padding: 6px 10px;
        font-size: 11px; color: #555;
        background: #f9f9f9;
        border-top: 1px solid var(--border);
    }
    .rpt-photo-empty {
        height: 210px;
        display: flex; align-items: center; justify-content: center;
        font-size: 12px; color: #bbb;
        background: #fafbfc;
        border-radius: 6px;
        border: 1px dashed #ddd;
    }
    .rpt-photo-placeholder { background: transparent; border: none; }

    /* ══════════════════════════════════════════
       QTY TABLE & PHOTO GRID (Section A)
    ══════════════════════════════════════════ */
    .rpt-qty-table {
        width: 100%; border-collapse: collapse;
        font-size: 11px; margin-bottom: 14px;
        border: 1px solid #b8c8de;
    }
    .rpt-qty-table th, .rpt-qty-table td {
        border: 1px solid #b8c8de;
        padding: 6px 7px; text-align: center;
        color: #1a1a2e;
    }
    .rpt-qty-table thead th {
        background: white; color: #1a1a2e !important;
        font-weight: 700; font-size: 10px;
        border-bottom: 1px solid #b8c8de;
    }
    .rpt-qty-table tbody td { color: #1a1a2e; background: white; height: 32px; }
    .rpt-qty-data-row td { height: 36px; }
    .rpt-total-row td {
        font-weight: 700; background: white;
        color: #1a1a2e; border-top: 1px solid #b8c8de;
    }
    .rpt-total-label { text-align: right; font-weight: 700; }

    /* ★ Quantity photo grid: cũng dùng flex-wrap ★ */
    .rpt-qty-photo-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-bottom: 12px;
    }
    .rpt-qty-photo-cell {
        flex: 0 0 calc(50% - 6px);
        max-width: calc(50% - 6px);
        box-sizing: border-box;
        border: 1px solid #b8c8de;
        height: 350px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: white;
        overflow: hidden;
        break-inside: avoid;
        page-break-inside: avoid;
        -webkit-column-break-inside: avoid;
    }
    .rpt-qty-photo-img {
        width: 100%; height: 350px;
        object-fit: contain; display: block;
        vertical-align: top;
    }

    /* ══════════════════════════════════════════
       PACKAGING / SPEC / SWATCH / PERF TABLES
    ══════════════════════════════════════════ */
    .rpt-pkg-table { margin-bottom: 16px; }

    .rpt-spec-table {
        width: 100%; border-collapse: collapse;
        font-size: 12px; margin-bottom: 10px;
    }
    .rpt-spec-table th, .rpt-spec-table td {
        border: 1px solid var(--border);
        padding: 7px 10px; text-align: center;
    }
    .rpt-spec-table thead th { background: #f4f7fc; font-weight: 700; color: #1a1a2e; }
    .rpt-spec-table td { color: #1a1a2e; background: white; }

    /* ── Theo yêu cầu khách (2026-10): bảng so sánh, N/A, defect remark, trang cuối ── */
    .rpt-sub-desc { font-size: 11.5px; color: #555; margin: -4px 0 10px; }
    .rpt-cmp-table thead th { color: #1a3a6e; }
    .rpt-cmp-sub { font-size: 10.5px; font-weight: 500; color: #666; }
    .rpt-cmp-big { font-size: 15px; font-weight: 700; color: #12204a !important; }
    .rpt-cmp-diff { font-size: 15px; font-weight: 700; }

    /* Khách yêu cầu: kết quả (pill) căn giữa; hàng Remark nền xanh nhạt */
    .rpt-paper td:has(> .rpt-result-pill), .rpt-paper td:has(> span[style*="color:#bbb"]) { text-align: center !important; }
    .rpt-paper tr:has(> th[colspan]) > th,
    .rpt-paper tr:has(> th[colspan]) + tr > td[colspan] { background: #eaf3fb !important; }
    .rpt-defect-rmk-box { background: #eaf3fb !important; }
    .rpt-result-pill {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 14px; border-radius: 20px; font-weight: 800; font-size: 13px; letter-spacing: .3px;
    }
    .rpt-result-pill .pill-ico {
        width: 18px; height: 18px; border-radius: 50%; color: #fff;
        display: inline-flex; align-items: center; justify-content: center; font-size: 11px;
    }
    .pill-pass { background: #e8f5e9; color: #2e7d32; } .pill-pass .pill-ico { background: #2e7d32; }
    .pill-fail { background: #fdecea; color: #c62828; } .pill-fail .pill-ico { background: #c62828; }
    .pill-na   { background: #f0f0f0; color: #777; }

    .rpt-kv-table th { width: 38%; text-align: left !important; background: #f4f7fc; font-weight: 700; }
    .rpt-kv-table td { text-align: left !important; }

    .rpt-na-box {
        display: flex; gap: 14px; align-items: flex-start;
        border: 1px solid #c9dcf5; background: #f2f7fe; border-radius: 6px; padding: 14px 18px; margin-top: 6px;
    }
    .rpt-na-ico {
        flex: 0 0 26px; height: 26px; border-radius: 50%; background: #2D7DD2; color: #fff;
        font-weight: 800; font-family: Georgia, serif; display: flex; align-items: center; justify-content: center;
    }
    .rpt-na-title { font-size: 15px; font-weight: 700; color: #1a5fa8; margin-bottom: 3px; }
    .rpt-na-text  { font-size: 12px; color: #333; line-height: 1.45; }

    .rpt-size-wrap { display: flex; gap: 12px; align-items: stretch; margin-bottom: 10px; }
    .rpt-size-table { flex: 1 1 auto; margin-bottom: 0; }
    .rpt-size-table thead th { color: #1a3a6e; }
    .rpt-size-lbl { font-weight: 700; background: #f8fafd !important; }
    .rpt-size-summary {
        flex: 0 0 26%; border: 1px solid var(--border); border-radius: 6px; padding: 10px 12px; background: #fafbfc;
        display: flex; flex-direction: column; gap: 8px;
    }
    .rpt-size-summary.is-pass { background: #eef8ef; border-color: #cfe8d1; }
    .rpt-size-summary.is-fail { background: #fdf0ef; border-color: #f3cdc9; }
    .rpt-size-summary-title { font-size: 13px; font-weight: 700; color: #1a5fa8; }
    .rpt-size-summary-text  { font-size: 11.5px; color: #333; line-height: 1.4; }

    .rpt-aql-headline { font-size: 13px; color: #1a1a2e; margin: 2px 0 12px; }
    .rpt-aql-headline strong { font-weight: 800; }
    .rpt-aql-sep { color: #999; margin: 0 10px; }

    .rpt-defect-caption { display: flex; flex-direction: column; }
    .rpt-defect-rmk-box {
        display: flex; margin: 0 8px 8px; border: 1px solid var(--border); border-radius: 4px; font-size: 11px; overflow: hidden;
    }
    .rpt-defect-rmk-lbl { flex: 0 0 auto; padding: 6px 12px; background: #eef4fb; color: #1a5fa8; font-weight: 700; }
    .rpt-defect-rmk-val { padding: 6px 10px; color: #333; min-width: 0; white-space: normal; overflow-wrap: anywhere; line-height: 1.4; }

    .rpt-fin-header {
        display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;
    }
    .rpt-fin-header-title { border-left: 1px solid #ccd; padding-left: 12px; font-size: 11px; color: #555; }
    .rpt-fin-header-title div { font-weight: 800; color: #1a3a6e; letter-spacing: .4px; }
    .rpt-fin-card {
        border: 1px solid #e1e8f2; border-radius: 8px; background: #f7f9fc; padding: 10px 12px 12px; margin-bottom: 12px;
        break-inside: avoid; page-break-inside: avoid;
    }
    .rpt-fin-head { display: flex; align-items: center; gap: 10px; font-size: 13px; font-weight: 700; color: #1a3a6e; margin-bottom: 8px; }
    .rpt-fin-no {
        width: 22px; height: 22px; border-radius: 50%; background: #1a3a6e; color: #fff;
        font-size: 11px; display: inline-flex; align-items: center; justify-content: center;
    }
    .rpt-fin-body { background: #fff; border: 1px solid #e6ecf4; border-radius: 6px; padding: 10px 12px; }
    .rpt-fin-row { display: flex; align-items: center; gap: 14px; }
    .rpt-fin-ico { flex: 0 0 auto; display: flex; }
    .rpt-fin-text { font-size: 11.5px; color: #333; line-height: 1.5; }
    .rpt-fin-boxed { flex: 1; font-size: 12.5px; }
    .rpt-fin-result { display: flex; align-items: center; gap: 16px; }
    .rpt-fin-result.is-pass { background: #eef8ef; border-color: #cfe8d1; }
    .rpt-fin-result.is-fail { background: #fdf0ef; border-color: #f3cdc9; }
    .rpt-fin-result.is-na   { background: #f4f4f4; }
    .rpt-fin-result-ico {
        flex: 0 0 40px; height: 40px; border-radius: 50%; color: #fff; font-size: 22px; font-weight: 800;
        display: flex; align-items: center; justify-content: center; background: #888;
    }
    .is-pass .rpt-fin-result-ico { background: #3aa655; } .is-fail .rpt-fin-result-ico { background: #d64538; }
    .rpt-fin-result-word { font-size: 26px; font-weight: 800; letter-spacing: .5px; color: #555; }
    .is-pass .rpt-fin-result-word { color: #2e8b45; } .is-fail .rpt-fin-result-word { color: #c62828; }
    .rpt-fin-result-text { border-left: 1px solid #c9d6c9; padding-left: 14px; font-size: 11px; color: #333; line-height: 1.5; }
    .rpt-fin-table { width: 100%; border-collapse: collapse; font-size: 11.5px; }
    .rpt-fin-table th, .rpt-fin-table td { border: 1px solid #e6ecf4; padding: 7px 10px; text-align: left; vertical-align: middle; }
    .rpt-fin-table th { width: 20%; background: #f7f9fc; font-weight: 700; color: #1a1a2e; }
    .rpt-fin-table td { width: 30%; color: #333; }
    .rpt-fin-sign .rpt-signature { max-height: 44px; }
    .rpt-fin-header .rpt-logo-img { height: 46px !important; width: auto !important; max-width: 220px; }

    /* .rpt-paper span/div { color: inherit } có specificity cao hơn → đặt lại màu cho các phần tử mới */
    .rpt-paper .rpt-fin-no, .rpt-paper .rpt-fin-result-ico, .rpt-paper .rpt-na-ico,
    .rpt-paper .rpt-result-pill .pill-ico { color: #fff; }
    .rpt-paper .pill-pass { color: #2e7d32; }
    .rpt-paper .pill-fail { color: #c62828; }
    .rpt-paper .pill-na   { color: #777; }
    .rpt-paper .rpt-fin-head { color: #1a3a6e; }
    .rpt-paper .rpt-fin-result-word { color: #555; }
    .rpt-paper .is-pass .rpt-fin-result-word { color: #2e8b45; }
    .rpt-paper .is-fail .rpt-fin-result-word { color: #c62828; }
    .rpt-paper .rpt-na-title, .rpt-paper .rpt-size-summary-title,
    .rpt-paper .rpt-defect-rmk-lbl { color: #1a5fa8; }
    .rpt-paper .rpt-aql-sep { color: #999; }
    .rpt-paper .rpt-cmp-sub { color: #666; }
    .rpt-paper .rpt-fin-header-title div { color: #1a3a6e; }

    .rpt-swatch-table {
        width: 100%; border-collapse: collapse;
        font-size: 12px; margin-bottom: 10px;
    }
    .rpt-swatch-table th, .rpt-swatch-table td {
        border: 1px solid var(--border); padding: 7px 10px;
    }
    .rpt-swatch-table thead th { background: #f4f7fc; font-weight: 700; color: #1a1a2e; }
    .rpt-swatch-table td { color: #1a1a2e; background: white; }

    .rpt-perf-table {
        width: 100%; border-collapse: collapse;
        font-size: 12px; margin-bottom: 14px;
    }
    .rpt-perf-table td {
        border: 1px solid var(--border); padding: 7px 10px;
        color: #1a1a2e; background: white;
    }
    .rpt-perf-table-h th {
        border: 1px solid var(--border);
        padding: 8px 10px;
        font-size: 11px; font-weight: 700;
        color: var(--text); background: #f3f6fb;
        text-align: center; text-transform: uppercase;
        letter-spacing: .3px;
    }
    .rpt-perf-table-h td { vertical-align: middle; }
    .rpt-perf-table .tc { text-align: center; }

    /* ══════════════════════════════════════════
       AQL SECTION
    ══════════════════════════════════════════ */
    .rpt-aql-label {
        font-size: 12px; font-weight: 700;
        color: var(--text); margin-bottom: 8px;
    }
    .rpt-aql-row {
        display: flex; gap: 24px;
        margin-bottom: 12px;
    }
    .rpt-aql-item {
        display: flex; align-items: center; gap: 8px;
        font-size: 12px;
    }
    .rpt-aql-key { font-weight: 600; color: var(--text-muted); }
    .rpt-aql-val { font-weight: 700; color: var(--text); }

    .rpt-aql-grid {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
        margin-bottom: 12px;
    }
    .rpt-aql-box {
        border-radius: 8px;
        padding: 12px;
        font-size: 12px;
        color: #333;
    }
    .aql-critical { background: #fff3f3; border: 1px solid #ffc0c0; }
    .aql-major    { background: #fff8ee; border: 1px solid #ffd99f; }
    .aql-minor    { background: #f0fff4; border: 1px solid #a3e4b7; }

    .rpt-aql-box-title {
        font-size: 11px; font-weight: 800;
        text-transform: uppercase; letter-spacing: .05em;
        margin-bottom: 8px;
    }
    .aql-critical .rpt-aql-box-title { color: #c0392b; }
    .aql-major    .rpt-aql-box-title { color: #e67e22; }
    .aql-minor    .rpt-aql-box-title { color: #27ae60; }

    .rpt-aql-box-row {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: baseline;
        gap: 8px;
        padding: 3px 0;
        border-bottom: 1px solid rgba(0,0,0,.06);
        font-size: 11px;
        color: #333;
    }
    .rpt-aql-box-row > span:last-child {
        font-weight: 700;
        color: #1a1a2e;
        text-align: right;
        white-space: nowrap;
    }
    .rpt-aql-box-row:last-child { border-bottom: none; }

    /* ══════════════════════════════════════════
       DEFECT SECTION — ★ cũng đổi sang flex item ★
    ══════════════════════════════════════════ */
    .rpt-defect-type-title {
        font-size: 13px; font-weight: 800;
        padding: 4px 12px; border-radius: 6px;
        margin: 14px 0 8px;
        display: inline-block;
    }
    .defect-critical { background: #fce4ec; color: #c62828; }
    .defect-major    { background: #fff3e0; color: #e65100; }
    .defect-minor    { background: #e8f5e9; color: #2e7d32; }

    .rpt-defect-cell {
        flex: 0 0 calc(50% - 6px);
        max-width: calc(50% - 6px);
        box-sizing: border-box;
        border: 1px solid var(--border);
        border-radius: 6px;
        overflow: hidden;
        background: #fafbfc;
        display: flex;
        flex-direction: column;
        height: 350px;
        break-inside: avoid;
        page-break-inside: avoid;
        -webkit-column-break-inside: avoid;
    }
    .rpt-defect-photo-wrap {
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        background: #f5f7fb;
        position: relative;
    }
    .rpt-defect-photo {
        width: 100%; height: 100%;
        object-fit: contain; display: block;
        vertical-align: top;
    }
    .rpt-defect-no-photo {
        width: 100%; height: 100%;
        display: flex; align-items: center; justify-content: center;
        font-size: 12px; color: #bbb;
        background: #f5f7fb;
        border: 1px dashed #ddd;
        border-radius: 4px;
        box-sizing: border-box;
    }
    .rpt-defect-empty {
        padding: 14px 16px; margin-bottom: 10px;
        background: #f5f7fb;
        border: 1px dashed #d0d7e2;
        border-radius: 6px;
        font-size: 12px; color: #6b7c93;
        font-style: italic; text-align: center;
    }
    .rpt-no-defects {
        padding: 18px 20px; margin: 8px 0 16px;
        background: #f5f9f5;
        border: 1px dashed #c8d8c8;
        border-radius: 6px;
        font-size: 13px; color: #5a8a5a;
        font-style: italic; text-align: center;
    }
    .rpt-defect-remark {
        padding: 5px 10px;
        font-size: 11px; color: #555;
        background: #f9f9f9;
        border-top: 1px solid var(--border);
        height: 36px;
        flex: 0 0 36px;
        line-height: 26px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        box-sizing: border-box;
    }

    /* ══════════════════════════════════════════
       FINAL RESULT & SIGNATURE
    ══════════════════════════════════════════ */
    .rpt-sign-table {
        width: 100%; border-collapse: collapse;
        font-size: 13px; margin-bottom: 16px;
    }
    .rpt-sign-table td {
        border: 1px solid var(--border); padding: 14px 16px;
        color: #1a1a2e !important; background: white;
    }
    .rpt-sign-label {
        background: #f4f7fc !important; font-weight: 600;
        color: #1a1a2e !important;
        width: 160px; white-space: nowrap;
    }
    .rpt-comments-cell { min-height: 80px; }
    .rpt-sign-cell { height: 90px; vertical-align: middle; }
    .rpt-signature { max-height: 70px; max-width: 200px; object-fit: fill; }
    .rpt-sign-name { font-size: 13px; font-weight: 600; color: #333 !important; display: block; margin-bottom: 4px; }
    .rpt-sign-id   { font-size: 11px; color: #888 !important; display: block; }
    .rpt-sign-placeholder { color: #bbb; font-size: 12px; }

    .rpt-final-result-wrap {
        display: flex; align-items: center; gap: 16px;
        justify-content: flex-end;
        margin: 12px 0 20px;
        font-size: 14px; font-weight: 700; color: var(--text);
    }
    .rpt-final-label { font-size: 13px; color: var(--text-muted); }
    .rpt-final-badge {
        font-size: 14px; font-weight: 800;
        padding: 6px 22px; border-radius: 8px;
        letter-spacing: .06em; text-transform: uppercase;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
        color-adjust: exact !important;
    }
    .final-pass { background: #e8f5e9; color: #2e7d32; border: 2px solid #a5d6a7; }
    .final-fail { background: #fce4ec; color: #c62828; border: 2px solid #ef9a9a; }
    .final-na   { background: #f5f5f5; color: #888;    border: 2px solid #e0e0e0; }

    .rpt-compliance-clause {
        background: #f9f9f9; border-radius: 6px;
        padding: 12px 16px; font-size: 11px; color: #555;
        border-left: 3px solid var(--border);
    }
    .rpt-compliance-clause strong { font-size: 12px; color: var(--text); display: block; margin-bottom: 6px; }

    .rpt-end-line {
        display: flex; align-items: center; gap: 12px;
        margin: 20px 0 4px;
        font-size: 13px; color: var(--text-muted); font-weight: 600;
    }
    .rpt-end-line hr { flex: 1; border: none; border-top: 1px solid var(--border); }

    /* ══════════════════════════════════════════
       FOOTER
    ══════════════════════════════════════════ */
    .rpt-footer {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        padding: 8px 32px 10px;
        border-top: 1px solid #f0f0f0;
        background: white;
    }
    .rpt-footer-inner {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 12px;
    }
    .rpt-footer-text {
        font-size: 9px; color: #bbb;
        line-height: 1.5; flex: 1; text-align: center;
    }
    .rpt-footer-page {
        font-size: 11px; font-weight: 700;
        color: #aaa; white-space: nowrap;
        flex-shrink: 0; align-self: flex-end;
        padding-left: 12px;
        border-left: 1px solid #e0e0e0;
    }

    /* ══════════════════════════════════════════
       EMPTY / ERROR STATES
    ══════════════════════════════════════════ */
    .rpt-no-data {
        font-size: 12px; color: var(--text-muted);
        padding: 16px; background: #fafbfc;
        border-radius: 6px; border: 1px dashed #ddd;
        text-align: center;
    }
    .rpt-loading {
        display: flex; flex-direction: column;
        align-items: center; justify-content: center;
        gap: 14px; min-height: 50vh;
        color: #888; font-size: 14px;
    }
    .rpt-spinner {
        width: 36px; height: 36px;
        border: 3px solid #e0e7ef;
        border-top-color: var(--brand);
        border-radius: 50%;
        animation: spin .8s linear infinite;
    }
    @@keyframes spin { to { transform: rotate(360deg); } }
    .rpt-error {
        display: flex; flex-direction: column;
        align-items: center; gap: 12px;
        padding: 48px 24px;
        font-size: 14px; color: #555;
    }

    /* ══════════════════════════════════════════════════════════════
       PRINT STYLES — ★★★ FIX: 6 ẢNH/TRANG ĐOÁN ĐỊNH ★★★
       ═══════════════════════════════════════════════════════════════
       Chiến lược mới (giải quyết triệt để vấn đề trang trắng):
       - Mỗi sub-section được pre-chunked ở Razor: max 6 ảnh/trang.
       - Trang có table phía trên (A, B-i, C, D) → trang đầu max 4 ảnh.
       - Mỗi chunk = 1 .rpt-section riêng → page-break-after: always vừa khít.
       - Layout đoán định 100%, không phụ thuộc browser.

       Math A4: 297mm cao - 12mm top - 14mm bottom = 271mm vùng print
                Heading lg ~10mm + sub-title ~7mm + 3 hàng ảnh (3 x 68mm + 2 x 6mm gap = 237mm)
                ~ 254mm — vừa đúng 1 trang.
    ══════════════════════════════════════════════════════════════ */
    @@media print {
        /* ★ Lề trang khai báo thật (10mm) thay vì margin:0 — Safari/Firefox áp lề riêng
             khi margin:0 làm vùng in nhỏ hơn A4, nội dung 210mm x 297mm cố định bị cắt phải
             và footer tràn sang trang trắng. Mọi kích thước bên dưới tính theo vùng in
             (190mm x 277mm), không theo khổ giấy. */
        @@page {
            size: A4 portrait;
            margin: 10mm;
        }

        html, body {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
            margin: 0 !important;
            padding: 0 !important;
        }

        .rpt-final-badge,
        .rpt-aql-box,
        .rpt-aql-box-title,
        .rpt-defect-type-title,
        .rpt-section-title,
        .rpt-result-pass,
        .rpt-result-fail,
        .final-pass, .final-fail, .final-na,
        .aql-critical, .aql-major, .aql-minor,
        .defect-critical, .defect-major, .defect-minor {
            -webkit-print-color-adjust: exact !important;
            print-color-adjust: exact !important;
            color-adjust: exact !important;
        }

        .no-print { display: none !important; }
        nav, header, .navbar, .sidebar,
        .top-bar, .main-nav, .nav-bar, .app-nav,
        .top-menu, .side-menu, .menu-bar,
        .bottom-footer,
        [class*="nav"], [class*="header"]:not(.rpt-cover-header):not(.rpt-section-header) {
            display: none !important;
        }

        html, body { background: white !important; }
        .rpt-page {
            background: white !important;
            min-height: 0 !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .rpt-paper {
            max-width: 100% !important;
            width: 100% !important;
            min-width: 0 !important;
            margin: 0 auto !important;
            padding: 0 !important;
            background: white !important;
            box-sizing: border-box !important;
        }

        .rpt-section {
            background: white !important;
            border-radius: 0 !important;
            box-shadow: none !important;
            margin: 0 !important;
            width: 100% !important;
            /* ★ Height bằng đúng 1 trang A4 (297mm) → mỗi section chiếm trọn 1 trang in. */
            height: auto !important;
            min-height: 0 !important;
            max-height: none !important;
            overflow: visible !important;
            /* ★ Không cố định chiều cao theo khổ giấy: chiều cao = nội dung + footer in-flow,
               ngắt trang bằng page-break-after. Lề do @@page đảm nhiệm. */
            padding: 0 !important;
            counter-increment: page-counter;
            position: relative !important;
            box-sizing: border-box !important;
            break-inside: avoid !important;
            page-break-inside: avoid !important;
            display: block !important;  /* override flex từ screen styles */
        }

        .page-break-after {
            break-after: page !important;
            page-break-after: always !important;
        }
        .page-break-after:last-child,
        .page-break-after:last-of-type {
            break-after: auto !important;
            page-break-after: auto !important;
        }
        .rpt-section.page-break-after + .rpt-section-final {
            break-before: page !important;
            page-break-before: always !important;
        }

        .rpt-section-final {
            /* ★ Cũng giữ full 297mm như section thường để footer absolute bottom
               nằm đúng vị trí (đáy trang in), không chạy theo content height. */
            height: auto !important;
            min-height: 0 !important;
            max-height: none !important;
            overflow: visible !important;
            break-before: page !important;
            page-break-before: always !important;
            break-after: avoid !important;
            page-break-after: avoid !important;
            margin-bottom: 0 !important;
            padding: 0 !important;
            display: block !important;
            position: relative !important;
            break-after: avoid !important;
            page-break-after: avoid !important;
        }

        /* Tránh cắt giữa trang.
           ★ KHÔNG đặt break-inside trên .rpt-photo-grid-2 (container)
             — chỉ đặt trên cell. Container break-inside sẽ làm cả grid
             bị đẩy sang trang mới = trang trắng. */
        table, tr,
        .rpt-info-table,
        .rpt-result-table,
        .rpt-perf-table,
        .rpt-aql-grid,
        .rpt-aql-wrap,
        .rpt-aql-section,
        .rpt-photo-cell,
        .rpt-qty-photo-cell,
        .rpt-defect-cell,
        .rpt-defect-item,
        .rpt-sig-row,
        .rpt-keep-together {
            break-inside: avoid !important;
            page-break-inside: avoid !important;
        }
        .rpt-section-title,
        .rpt-section-title-lg,
        .rpt-sub-title {
            break-after: avoid !important;
            page-break-after: avoid !important;
            break-inside: avoid !important;
            page-break-inside: avoid !important;
        }
        /* Heading + element kế tiếp giữ chung 1 trang (ngăn heading mồ côi) */
        .rpt-section-title-lg + *,
        .rpt-sub-title + * {
            break-before: avoid !important;
            page-break-before: avoid !important;
        }
        /* Margin nhỏ hơn khi in để tận dụng trang */
        .rpt-section-title-lg {
            margin-bottom: 6mm !important;
            padding-bottom: 4mm !important;
        }
        .rpt-sub-title {
            margin: 4mm 0 2mm !important;
        }
        img {
            max-width: 100% !important;
            break-inside: avoid !important;
            page-break-inside: avoid !important;
        }

        /* ═══════ OVERRIDE MOBILE RULES khi in ═══════ */
        .rpt-cover-header {
            display: flex !important;
            flex-direction: row !important;
            align-items: center !important;
            justify-content: space-between !important;
            gap: 20px !important;
            flex-wrap: nowrap !important;
        }
        .rpt-logo-wrap   { flex: 0 0 auto !important; width: auto !important; }
        .rpt-title-block { text-align: right !important; flex: 1 1 auto !important; }
        .rpt-main-title  { font-size: 26px !important; }
        .rpt-job-no      { font-size: 14px !important; }
        .rpt-logo-wrap .rpt-logo-img { height: 48px !important; }

        .rpt-info-table {
            display: table !important;
            width: 100% !important;
            border-collapse: collapse !important;
            font-size: 11px !important;
            table-layout: fixed !important;
        }
        .rpt-info-table tbody { display: table-row-group !important; }
        .rpt-info-table tr {
            display: table-row !important;
            grid-template-columns: unset !important;
            border-bottom: none !important;
        }
        .rpt-info-table td {
            display: table-cell !important;
            width: auto !important;
            border: 1px solid var(--border) !important;
            padding: 4px 6px !important;   /* gọn hơn để trang bìa vừa 1 trang cả trên Safari (Mac) */
            white-space: normal !important;
            word-break: normal !important;
            overflow-wrap: break-word !important;
            font-size: 11px !important;
            line-height: 1.4 !important;
            box-sizing: border-box !important;
            vertical-align: middle !important;
        }
        .rpt-info-label {
            background: #f4f7fc !important;
            font-weight: 600 !important;
            color: var(--text) !important;
            width: 19% !important;
            min-width: 0 !important;
            white-space: normal !important;
        }

        .rpt-result-table,
        .rpt-sign-table,
        .rpt-qty-table,
        .rpt-spec-table,
        .rpt-perf-table,
        .rpt-aql-table,
        .rpt-carton-table {
            display: table !important;
            width: 100% !important;
            overflow-x: visible !important;
            font-size: inherit !important;
        }

        /* ═══════════════════════════════════════════
           ★★★ KEY FIX khi in: PHOTO GRID
           - flex-wrap (override mobile direction:column)
           - Dùng đơn vị mm cho ổn định khi in (px khi in không đáng tin)
           - 3 hàng × 56mm = 225mm + heading + padding ≈ vừa 1 trang A4
           - Cell có break-inside:avoid để 1 ảnh không bị cắt đôi
        ═══════════════════════════════════════════ */
        .rpt-photo-grid-2 {
            display: flex !important;
            flex-wrap: wrap !important;
            flex-direction: row !important;
            gap: 6mm !important;
            margin: 4mm 0 !important;
            /* ★ FIX: container KHÔNG được break-inside:avoid
               (sẽ làm cả grid bị đẩy sang trang mới = trang trắng) */
            break-inside: auto !important;
            page-break-inside: auto !important;
        }
        .rpt-photo-cell,
        .rpt-page .rpt-photo-cell {
            flex: 0 0 calc(50% - 3mm) !important;
            max-width: calc(50% - 3mm) !important;
            box-sizing: border-box !important;
            height: 56mm !important;
            max-height: 56mm !important;
            min-height: 0 !important;
            break-inside: avoid !important;
            page-break-inside: avoid !important;
            -webkit-column-break-inside: avoid !important;
        }
        .rpt-photo-cell img,
        .rpt-page .rpt-photo-cell img,
        .rpt-photo-cell img.rpt-photo,
        .rpt-page .rpt-photo-cell .rpt-photo {
            width: 100% !important;
            height: 100% !important;
            max-height: none !important;
            object-fit: contain !important;
            display: block !important;
        }
        .rpt-photo {
            height: 56mm !important;
            max-height: 56mm !important;
            width: 100% !important;
            object-fit: contain !important;
            object-position: center !important;
        }

        .rpt-qty-photo-grid {
            display: flex !important;
            flex-wrap: wrap !important;
            flex-direction: row !important;
            gap: 6mm !important;
            break-inside: auto !important;
            page-break-inside: auto !important;
        }
        .rpt-qty-photo-cell {
            flex: 0 0 calc(50% - 3mm) !important;
            max-width: calc(50% - 3mm) !important;
            box-sizing: border-box !important;
            height: 56mm !important;
            max-height: 56mm !important;
            min-height: 0 !important;
            break-inside: avoid !important;
            page-break-inside: avoid !important;
        }
        .rpt-qty-photo-img {
            height: 100% !important;
            max-height: none !important;
            width: 100% !important;
            object-fit: contain !important;
        }

        .rpt-aql-grid {
            display: grid !important;
            grid-template-columns: 1fr 1fr 1fr !important;
            gap: 10px !important;
        }

        .rpt-overview-photo-wrap,
        .rpt-overview-photo-cell {
            width: 100% !important;
            max-width: 100% !important;
        }
        .rpt-overview-img,
        .rpt-overview-photo-cell .rpt-overview-img,
        .rpt-overview-photo-cell img.rpt-overview-img,
        .rpt-page .rpt-overview-photo-cell img,
        .rpt-page .rpt-overview-photo-cell .rpt-overview-img {
            width: 100% !important;
            height: 52mm !important;
            min-height: 52mm !important;
            max-height: 52mm !important;
            object-fit: contain !important;
            object-position: center !important;
            background: #fafbfc !important;
            display: block !important;
        }
        .rpt-photo-empty-lg { height: 52mm !important; min-height: 52mm !important; }

        .rpt-defect-cell {
            flex: 0 0 calc(50% - 3mm) !important;
            max-width: calc(50% - 3mm) !important;
            box-sizing: border-box !important;
            height: 56mm !important;
            max-height: 56mm !important;
            min-height: 0 !important;
            break-inside: avoid !important;
            page-break-inside: avoid !important;
        }
        .rpt-defect-photo-wrap {
            flex: 1 1 auto !important;
            min-height: 0 !important;
            height: auto !important;
        }
        .rpt-defect-photo {
            width: 100% !important;
            height: 100% !important;
            max-height: none !important;
            object-fit: contain !important;
            display: block !important;
        }
        .rpt-defect-no-photo { height: 100% !important; min-height: unset !important; }

        /* ══════════════════════════════════════════
           FOOTER (in-flow, đẩy xuống đáy section bằng margin-top:auto trên flex container)
        ══════════════════════════════════════════ */
        /* Bỏ rule flex-shrink vì section không còn flex column */
        .rpt-section > .rpt-section-title,
        .rpt-section > .rpt-sub-title,
        .rpt-section > .rpt-photo-grid-2,
        .rpt-section > .rpt-qty-photo-grid,
        .rpt-section > table,
        .rpt-section > .rpt-aql-grid,
        .rpt-section > .rpt-result-table {
            flex-shrink: 0 !important;
        }
        .rpt-footer {
            /* ★ Position absolute trong .rpt-section (relative) → footer LUÔN ở đáy
               trang in, không bị đẩy ra ngoài kể cả khi content tổng > 297mm.
               Đây là khác biệt mấu chốt: trang đầu tiên (Cover) có content dài,
               flex layout sẽ shrink/đẩy footer ra ngoài → footer biến mất.
               Absolute bottom giải quyết triệt để. */
            position: static !important;
            padding: 4px 0 0 !important;
            margin: 4mm 0 0 !important;
            border-top: 1px solid #cfd8e3 !important;
            background: white !important;
            box-sizing: border-box !important;
            min-height: 0 !important;
            max-height: none !important;
            overflow: visible !important;
        }
        .rpt-footer-inner {
            display: flex !important;
            align-items: flex-end !important;
            justify-content: space-between !important;
            gap: 10px !important;
        }
        .rpt-footer-text {
            font-size: 8.5px !important;       /* nhỏ chút để chắc chắn 3 dòng vừa */
            line-height: 1.35 !important;
            color: #333 !important;
            font-weight: 500 !important;
            white-space: normal !important;
            word-wrap: break-word !important;
            flex: 1 1 auto !important;
            text-align: center !important;
        }
        .rpt-footer-page {
            font-size: 11px !important;
            font-weight: 700 !important;
            color: #222 !important;
            flex-shrink: 0 !important;
            white-space: nowrap !important;
            padding-left: 10px !important;
            border-left: 1px solid #ccc !important;
            align-self: center !important;
        }
        /* Ẩn running footer vì position:fixed không reliable trong PDF print */
        .rpt-print-footer { display: none !important; }

        /* ★ Vừa 1 trang cả khi Safari (Mac) in khổ Letter + header/footer (vùng in ~244mm thay vì 277mm của A4):
             bảng gọn hơn, ảnh 56mm, ảnh bìa 52mm. Đo bằng WebKit/Chromium: mọi trang ≤ ~235mm. */
        .rpt-result-table th, .rpt-result-table td,
        .rpt-spec-table th, .rpt-spec-table td,
        .rpt-perf-table th, .rpt-perf-table td,
        .rpt-aql-table th, .rpt-aql-table td,
        .rpt-carton-table th, .rpt-carton-table td,
        .rpt-qty-table th, .rpt-qty-table td {
            padding: 4px 8px !important;
            font-size: 11px !important;
            line-height: 1.35 !important;
        }
        .rpt-section-title { margin-top: 3mm !important; margin-bottom: 2mm !important; }

        /* ★ Footer (www.inticoo.com + miễn trừ + số trang) luôn ở ĐÁY trang khi in/Save PDF (khách 17/11/2026):
             mỗi section = 1 trang, cao gần bằng vùng in, footer đẩy xuống cuối bằng margin-top:auto.
             Chrome/Edge/Puppeteer theo @@page A4 (vùng in 277mm) → 270mm.
             Safari có thể in khổ Letter + header/footer riêng (vùng in ~244mm) → 236mm để không tràn trang.
             Khung layout chung (main-content padding 20px, main-wrap padding-bottom 64px cho menu điện thoại)
             phải bỏ khi in, nếu không trang đầu bị đẩy xuống → tràn trang + trang trắng cuối. */
        .main-content, .main-wrap { padding: 0 !important; margin: 0 !important; }
        .rpt-section, .rpt-section-final {
            display: flex !important;
            flex-direction: column !important;
            min-height: 270mm !important;
        }
        html.rpt-safari .rpt-section, html.rpt-safari .rpt-section-final { min-height: 236mm !important; }
        .rpt-section > * { flex-shrink: 0 !important; }
        .rpt-section > .rpt-footer { margin-top: auto !important; }
    }

    /* ══════════════════════════════════════════
       RESPONSIVE — TABLET & MOBILE
       ★ CRITICAL: dùng `screen and` để KHÔNG apply khi @@media print.
       Lý do: print preview của Chrome đôi khi tính viewport theo kích thước
       trang giấy (210mm ~ 794px) → trigger nhầm max-width:860px,
       làm flex-direction:column thắng print rule → grid 2 cột thành 1 cột.
    ══════════════════════════════════════════ */
    @@media screen and (max-width: 860px) {
        html, body { overflow-x: hidden; }

        /* Mục 4 Inspection Details: 2 cặp nhãn/giá trị → xếp 2 hàng, không tràn ngang */
        .rpt-fin-table, .rpt-fin-table tbody { display: block; width: 100%; }
        .rpt-fin-table tr { display: grid; grid-template-columns: 38% 62%; border-bottom: 1px solid var(--border); }
        .rpt-fin-table th, .rpt-fin-table td { display: block; width: auto !important; min-width: 0; word-break: break-word; overflow-wrap: anywhere; box-sizing: border-box; }
        /* Mục 2 Final Result: chữ PASSED/FAILED và đoạn mô tả xếp xuống dòng, không đè nhau */
        .rpt-fin-result { flex-wrap: wrap; row-gap: 8px; }
        .rpt-fin-result-word { font-size: 22px; }
        .rpt-fin-result-text { flex: 1 1 100%; border-left: none; padding-left: 0; border-top: 1px solid #c9d6c9; padding-top: 8px; }
        /* Footer không đè lên nội dung trên màn hình nhỏ */
        .rpt-footer { position: static; margin-top: 14px; padding: 8px 0 6px; }

        .rpt-page {
            padding-bottom: 40px;
            padding-left: env(safe-area-inset-left, 0);
            padding-right: env(safe-area-inset-right, 0);
        }
        .rpt-paper {
            max-width: 100%;
            margin: 12px 0;
            padding: 0 10px;
            box-sizing: border-box;
        }
        .rpt-toolbar {
            padding: 10px 14px;
            padding-top: calc(10px + env(safe-area-inset-top, 0));
            padding-left: calc(14px + env(safe-area-inset-left, 0));
            padding-right: calc(14px + env(safe-area-inset-right, 0));
            flex-wrap: wrap;
            gap: 8px;
            top: var(--topbar-h, 0px);
        }
        .rpt-print-btn { padding: 8px 14px; font-size: 12px; }
        .rpt-back-btn { font-size: 13px; }
        .rpt-section {
            padding: 18px 14px 18px;
            border-radius: 8px;
            margin-bottom: 14px;
        }
        .rpt-info-table,
        .rpt-info-table tbody,
        .rpt-info-table tr,
        .rpt-info-table td {
            display: block;
            width: 100% !important;
            box-sizing: border-box;
        }
        .rpt-info-table tr {
            display: grid;
            grid-template-columns: 40% 60%;
            border-bottom: 1px solid var(--border);
        }
        .rpt-info-table td {
            border: none !important;
            border-right: 1px solid var(--border) !important;
            padding: 8px 10px !important;
            white-space: normal !important;
            word-break: break-word;
            font-size: 12px;
        }
        .rpt-info-table td:last-child { border-right: none !important; }
        .rpt-info-label {
            width: auto !important;
            white-space: normal !important;
        }
        .rpt-result-table,
        .rpt-sign-table,
        .rpt-qty-table,
        .rpt-spec-table,
        .rpt-perf-table,
        .rpt-aql-table,
        .rpt-carton-table {
            display: block;
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            font-size: 11px;
        }

        /* Các bảng ≤5 cột: vừa khít chiều ngang, chữ xuống dòng — không phải kéo ngang mới thấy hết.
           (Bảng Quantity 10 cột và bảng AQL/Carton/Sign vẫn cuộn ngang.) */
        .rpt-result-table,
        .rpt-spec-table,
        .rpt-perf-table,
        .rpt-swatch-table {
            display: table;
            width: 100%;
            table-layout: auto;
            overflow: visible;
            font-size: 11.5px;
        }
        .rpt-result-table th, .rpt-result-table td,
        .rpt-spec-table th, .rpt-spec-table td,
        .rpt-perf-table th, .rpt-perf-table td,
        .rpt-swatch-table th, .rpt-swatch-table td {
            padding: 6px 5px;
            white-space: normal;
            overflow-wrap: anywhere;
            word-break: break-word;
            min-width: 0;
        }
        .rpt-perf-table th, .rpt-result-table th { width: auto !important; }
        .rpt-perf-table th:first-child, .rpt-perf-table td:first-child { width: 30px; }


        /* A. Quantity Conformity: bỏ dạng bảng 10 cột → danh sách "nhãn … giá trị" gọn, dễ đọc (dòng Total trùng dữ liệu nên ẩn trên điện thoại) */
        .rpt-qty-table, .rpt-qty-table tbody, .rpt-qty-table tr, .rpt-qty-table td { display: block; width: 100%; box-sizing: border-box; }
        .rpt-qty-table { overflow: visible; font-size: 13px; border: none; }
        .rpt-qty-table thead { display: none; }
        .rpt-qty-table .rpt-total-row { display: none; }
        .rpt-qty-table .rpt-qty-data-row { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: #fff; }
        .rpt-qty-table .rpt-qty-data-row td { display: flex; justify-content: space-between; align-items: center; gap: 12px; text-align: right; font-weight: 700; padding: 9px 12px; border: none; border-bottom: 1px solid #eef2f8; min-height: 0; height: auto; }
        .rpt-qty-table .rpt-qty-data-row td:last-child { border-bottom: none; }
        .rpt-qty-table .rpt-qty-data-row td:nth-child(even) { background: #f7fafd; }
        .rpt-qty-table .rpt-qty-data-row td::before { content: attr(data-l); flex: 1 1 45%; text-align: left; font-weight: 600; font-size: 12px; color: #51638a; }
        .rpt-qty-photo-cell:not(:has(img)) { display: none !important; }


        /* Product Size / Weight: mỗi hạng mục là một thẻ "nhãn … giá trị" thay cho bảng 4 cột; khung Summary xuống dưới, rộng hết chiều ngang */
        .rpt-size-wrap { flex-direction: column; gap: 10px; }
        .rpt-size-summary { width: 100%; box-sizing: border-box; }
        .rpt-size-table, .rpt-size-table tbody, .rpt-size-table tr, .rpt-size-table td,
        .rpt-cmp-table, .rpt-cmp-table tbody, .rpt-cmp-table tr, .rpt-cmp-table td { display: block; width: 100% !important; box-sizing: border-box; }
        .rpt-size-table thead, .rpt-cmp-table thead { display: none; }
        .rpt-size-table tr, .rpt-cmp-table tr { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: #fff; margin-bottom: 8px; }
        .rpt-size-table td, .rpt-cmp-table td { display: flex; justify-content: space-between; align-items: center; gap: 12px; text-align: right; font-size: 13px; padding: 8px 12px; border: none; border-bottom: 1px solid #eef2f8; word-break: normal; overflow-wrap: break-word; }
        .rpt-size-table td:last-child, .rpt-cmp-table td:last-child { border-bottom: none; }
        .rpt-size-table td::before, .rpt-cmp-table td::before { content: attr(data-l); flex: 1 1 42%; text-align: left; font-size: 12px; font-weight: 600; color: #51638a; }
        .rpt-size-table td.rpt-size-lbl { display: block; text-align: left; font-size: 14px; background: #eef4fd !important; color: #14275a; }
        .rpt-size-table td.rpt-size-lbl::before { content: none; }
        .rpt-cmp-table .rpt-cmp-big { font-size: 15px; }


        /* Chữ trong nhãn PASSED / FAILED không bị bẻ từng chữ cái */
        .rpt-compliance-badge { white-space: nowrap; word-break: normal; overflow-wrap: normal; }

        /* Overall Conclusion / Colour Swatch: mỗi dòng là một thẻ, nhãn bên trái – giá trị bên phải */
        .rpt-oc-table, .rpt-oc-table tbody, .rpt-oc-table tr, .rpt-oc-table td,
        .rpt-swatch-table, .rpt-swatch-table tbody, .rpt-swatch-table tr, .rpt-swatch-table td { display: block; width: 100% !important; box-sizing: border-box; }
        .rpt-oc-table thead, .rpt-swatch-table thead { display: none; }
        .rpt-oc-table tr, .rpt-swatch-table tr { border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: #fff; margin-bottom: 8px; }
        .rpt-oc-table td, .rpt-swatch-table td { display: flex; justify-content: space-between; align-items: center; gap: 12px; text-align: right; font-size: 13px; padding: 8px 12px; border: none !important; border-bottom: 1px solid #eef2f8 !important; background: transparent !important; word-break: normal; overflow-wrap: break-word; }
        .rpt-oc-table td:last-child, .rpt-swatch-table td:last-child { border-bottom: none !important; }
        .rpt-oc-table td::before, .rpt-swatch-table td::before { content: attr(data-l); flex: 1 1 35%; text-align: left; font-size: 12px; font-weight: 600; color: #51638a; }
        .rpt-oc-table td.rpt-oc-name { display: block; text-align: left; font-weight: 700; font-size: 14px; color: #14275a; background: #eef4fd !important; }
        .rpt-oc-table td.rpt-oc-name::before { content: none; }
        .rpt-oc-table td:empty { display: none; }
        .rpt-swatch-table td:first-child { background: #eef4fd !important; font-weight: 700; color: #14275a; }

        /* Kết quả lỗi: 3 ô số Critical / Major / Minor cạnh nhau, kết quả ở dưới */
        .rpt-def-table, .rpt-def-table tbody, .rpt-def-table tr, .rpt-def-table td { display: block; width: 100% !important; box-sizing: border-box; }
        .rpt-def-table thead { display: none; }
        .rpt-def-table tr { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); border: 1px solid var(--border); border-radius: 10px; overflow: hidden; background: #fff; }
        .rpt-def-table td { padding: 10px 6px; border: none !important; text-align: center; font-size: 20px; font-weight: 800; color: #14275a; background: transparent !important; }
        .rpt-def-table td.rpt-def-name { grid-column: 1 / -1; text-align: left; font-size: 14px; padding: 8px 12px; background: #eef4fd !important; }
        .rpt-def-table td[data-l]:not(:last-child)::before { content: attr(data-l); display: block; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 2px; }
