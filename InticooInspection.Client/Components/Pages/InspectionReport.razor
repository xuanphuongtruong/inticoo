                                <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                <span class="rpt-footer-page"></span>
                            </div>
                        </div>
                    </div>

                    @* Trang Performance Testing tiếp theo (nếu > 2 ảnh) *@
                    @foreach (var _dPage in _dRest)
                    {
                        <div class="rpt-section page-break-after">
                            <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.DPerformanceTesting2", dSuffix)</div>
                            <div class="rpt-photo-grid-2">
                                @foreach (var _du in _dPage)
                                {
                                    <div class="rpt-photo-cell">
                                        @if (!string.IsNullOrEmpty(_du))
                                        { <img src="@NormalizeUrl(_du)" class="rpt-photo" alt="@T("InspectionReport.PerformanceTestPhoto")" loading="eager"/> }
