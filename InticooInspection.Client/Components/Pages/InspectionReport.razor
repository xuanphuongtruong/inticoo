                    </div>
                    <div class="rpt-footer">
                        <div class="rpt-footer-inner">
                            <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                            <span class="rpt-footer-page"></span>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="rpt-section page-break-after">
                    <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.CProductSpecificationCompliance12")</div>
                    <div class="rpt-no-data">@T("InspectionReport.NoProductSpecificationDataRecorded")</div>
                    <div class="rpt-footer">
                        <div class="rpt-footer-inner">
                            <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                            <span class="rpt-footer-page"></span>
                        </div>
                    </div>
                </div>
            }

            @* Trang Golden Sample tiếp theo (nếu > 4 ảnh) *@
            @if (_qcData?.ProductSpec?.GoldenPhotos != null)
            {
                var _gpAllOuter = _qcData.ProductSpec.GoldenPhotos.Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
                if (_gpAllOuter.Count > 4)
                {
                    foreach (var _gpPage in ChunkPhotosForPages(_gpAllOuter.Skip(4)))
                    {
                        <div class="rpt-section page-break-after">
                            <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.CProductSpecificationCompliance12")</div>
                            <div class="rpt-sub-title">@T("InspectionReport.IiiGoldenSampleComparison")</div>
                            <div class="rpt-photo-grid-2">
                                @foreach (var _gu in _gpPage)
                                {
                                    <div class="rpt-photo-cell">
                                        @if (!string.IsNullOrEmpty(_gu))
                                        { <img src="@NormalizeUrl(_gu)" class="rpt-photo" alt="@T("InspectionReport.GoldenSamplePhoto")" loading="eager"/> }
                                    </div>
                                }
                            </div>
                            <div class="rpt-footer">
                                <div class="rpt-footer-inner">
                                    <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                <span class="rpt-footer-page"></span>
                                </div>
                            </div>
                        </div>
                    }
                }
            }

            <!-- ══ SECTION C (2/2): Product Specification Compliance — Colour Swatch ══ -->
            <div class="rpt-section page-break-after">
                <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.CProductSpecificationCompliance22")</div>

                <!-- iii. Colour Swatch Comparison -->
                <div class="rpt-sub-title">@T("InspectionReport.IvColourSwatchComparison")</div>
                <div class="rpt-sub-desc">@T("InspectionReport.ColourSwatchDesc")</div>
                @if (_qcData?.ProductSpec?.ColourSwatches?.Any() == true)
                {
                    <table class="rpt-swatch-table">
                        <thead>
                            <tr>
                                <th style="width:8%">No</th>
                                <th style="width:30%">@T("Common.Material")</th>
                                <th style="width:47%">@T("Common.Remark")</th>
                                <th style="width:15%">@T("Common.Result")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sw in _qcData.ProductSpec.ColourSwatches)
                            {
                                // Material có thể không được lưu trong QcResultJson — fallback từ master data
                                var _swMat = !string.IsNullOrWhiteSpace(sw.Material)
                                    ? sw.Material
                                    : (_data?.ColourSwatches?.ElementAtOrDefault(sw.No - 1)?.Material ?? "");
                                <tr>
                                    <td data-l="No">@sw.No</td>
                                    <td data-l="@T("Common.Material")">@(string.IsNullOrWhiteSpace(_swMat) ? "—" : _swMat)</td>
                                    <td data-l="@T("Common.Remark")">@(string.IsNullOrWhiteSpace(sw.Remark) ? "—" : sw.Remark)</td>
                                    <td data-l="@T("Common.Result")">
                                        @if (!string.IsNullOrEmpty(sw.Result))
                                        {
                                            <span class="rpt-compliance-badge comp-@sw.Result.ToLower()">@TE("Status", sw.Result)</span>
                                        }
                                        else
                                        {
                                            <span style="color:#bbb">@T("InspectionReport.PassedFailedNA")</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                @{
                    var _swAll = (_qcData?.ProductSpec?.SwatchPhotos ?? Enumerable.Empty<string>())
                        .Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
                    var _swFirst = _swAll.Take(4).Cast<string?>().ToList();
                    if (_swFirst.Count > 0 && _swFirst.Count % 2 != 0) _swFirst.Add(null);
                    if (_swFirst.Count == 0) _swFirst = new List<string?> { null, null };
                    var _swRest = _swAll.Count > 4 ? ChunkPhotosForPages(_swAll.Skip(4)) : new List<List<string?>>();
                }
                <div class="rpt-photo-grid-2">
                    @foreach (var _sw in _swFirst)
                    {
                        <div class="rpt-photo-cell">
                            @if (!string.IsNullOrEmpty(_sw))
                            { <img src="@NormalizeUrl(_sw)" class="rpt-photo" alt="@T("InspectionReport.SwatchPhoto")" loading="eager"/> }
                        </div>
                    }
                </div>

                <div class="rpt-footer">
                    <div class="rpt-footer-inner">
                        <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                        <span class="rpt-footer-page"></span>
                    </div>
                </div>
