                            {
                                <div class="rpt-photo-cell">
                                    @if (!string.IsNullOrEmpty(_su))
                                    { <img src="@NormalizeUrl(_su)" class="rpt-photo" alt="@T("InspectionReport.ProductSizePhoto")" loading="eager"/> }
                                </div>
                            }
                        </div>
                    }
                    <div class="rpt-footer">
                        <div class="rpt-footer-inner">
                            <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                            <span class="rpt-footer-page"></span>
                        </div>
                    </div>
                </div>

                @* ── i. Product Size — trang phụ khi > 4 ảnh (6 ảnh/trang) ── *@
                @if (_spAll.Count > 4)
                {
                    foreach (var _spPage in ChunkPhotosForPages(_spAll.Skip(4)))
                    {
                        <div class="rpt-section page-break-after">
                            <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.CProductSpecificationCompliance12")</div>
                            <div class="rpt-sub-title">@T("Common.IProductSize")</div>
                            <div class="rpt-photo-grid-2">
                                @foreach (var _su in _spPage)
                                {
                                    <div class="rpt-photo-cell">
                                        @if (!string.IsNullOrEmpty(_su))
                                        { <img src="@NormalizeUrl(_su)" class="rpt-photo" alt="@T("InspectionReport.ProductSizePhoto")" loading="eager"/> }
                                    </div>
                                }
                            </div>
                            <div class="rpt-footer">
                                <div class="rpt-footer-inner">
                                    <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                    <span class="rpt-footer-page"></span>
                                </div>
                            </div>
                        </div>
                    }
                }

                @* ── ii. Product Weight — cân thực tế so với ProductSpec.Weight của hồ sơ sản phẩm ── *@
                var _pwq = _qcData?.ProductSpec;
                @if (_pwq != null && (_pwq.ProductWeight is > 0 || !string.IsNullOrEmpty(_pwq.ProductWeightResult)
                                      || _pwq.ProductWeightPhotos?.Any(p => !string.IsNullOrWhiteSpace(p)) == true))
                {
                    var _pwPages = ChunkPhotosAfterTable(_pwq.ProductWeightPhotos);
                    @for (int _pwPi = 0; _pwPi < _pwPages.Count; _pwPi++)
                    {
                        <div class="rpt-section page-break-after">
                            <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.CProductSpecificationCompliance12")</div>
                            <div class="rpt-sub-title">@T("InspectionReport.IiProductWeight")</div>
                            @if (_pwPi == 0)
                            {
                                <div class="rpt-sub-desc">@T("InspectionReport.ProductWeightDesc")</div>
                                @WeightCompare(_data.ProductSpec?.Weight, _pwq.ProductWeight, _pwq.ProductWeightResult)
                            }
                            <div class="rpt-photo-grid-2">
                                @foreach (var _u in _pwPages[_pwPi])
                                {
                                    <div class="rpt-photo-cell">
                                        @if (!string.IsNullOrEmpty(_u))
                                        { <img src="@NormalizeUrl(_u)" class="rpt-photo" alt="@T("InspectionReport.ProductWeight")" loading="eager"/> }
                                    </div>
                                }
                            </div>
                            <div class="rpt-footer">
                                <div class="rpt-footer-inner">
                                    <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                    <span class="rpt-footer-page"></span>
                                </div>
                            </div>
                        </div>
                    }
                }

                @* ── iii. Golden Sample — trang đầu: bảng + tối đa 4 ảnh ── *@
                <div class="rpt-section page-break-after">
                    <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.CProductSpecificationCompliance12")</div>
                    <div class="rpt-sub-title">@T("InspectionReport.IiiGoldenSampleComparison")</div>
                    <div class="rpt-sub-desc">@T("InspectionReport.GoldenSampleDesc")</div>
