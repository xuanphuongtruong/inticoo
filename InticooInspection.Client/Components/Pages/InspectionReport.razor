    // ─── Lifecycle ───
    protected override async Task OnInitializedAsync()
    {
        await PageAccess.EnsureLoadedAsync();   // quyền Download Reports cho nút Print
        await LoadData();
        _loading = false;
    }

    /// <summary>
    /// Sau mỗi lần render, đếm chính xác số .rpt-section trên DOM (nguồn sự thật)
    /// và set textContent "N / Total" cho TỪNG .rpt-footer-page.
    /// Dùng JS trực tiếp thay vì CSS counter+attr() vì attr() trong content không
    /// hoạt động ổn định trên print rendering ở 1 số Chrome version.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_loading || _data == null) return;
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                (function(){
                    // Safari (Mac/iOS): có thể in khổ Letter + header/footer riêng → chiều cao trang khi in đặt an toàn hơn (xem CSS html.rpt-safari)
                    if (/^((?!chrome|chromium|crios|fxios|edg|android).)*safari/i.test(navigator.userAgent))
                        document.documentElement.classList.add('rpt-safari');
                    var paper = document.querySelector('#rpt-root .rpt-paper');
                    if (!paper) return;
                    var sections = paper.querySelectorAll('.rpt-section');
                    var total = sections.length;
                    if (total === 0) return;
                    paper.setAttribute('data-total', total);
                    sections.forEach(function(sec, idx){
                        var pn = sec.querySelector('.rpt-footer-page');
                        if (pn) pn.textContent = (idx + 1) + ' / ' + total;
                    });
                })();
            ");
        }
        catch { /* JS interop có thể chưa sẵn sàng trong prerender — bỏ qua */ }
    }

    private async Task LoadData()
    {
        try
        {
            var opts = new JsonSerializerOptions { PropertyNameCaseInsensitive = true };

            // Load inspection detail (General info, Packaging, ProductSpec, etc.)
            _data = await Http.GetFromJsonAsync<InspectionDetailDto>(
                $"api/inspections/{InspectionId}", opts);

            if (_data == null)
            {
                _error = T("InspectionReport.InspectionNotFound");
                return;
            }

            // Parse QcResultJson từ response (không cần endpoint riêng)
            if (!string.IsNullOrWhiteSpace(_data.QcResultJson))
            {
                try
                {
                    _qcData = JsonSerializer.Deserialize<QcResultDto>(
                        _data.QcResultJson, opts);
                }
                catch
                {
                    _qcData = null;
                }
            }
        }
        catch (Exception ex)
        {
            _error = T("InspectionReport.FailedToLoadReport", ex.Message);
        }
    }

