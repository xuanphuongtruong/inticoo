@page "/inspection-report/{InspectionId:int}"
@page "/inspection-report/{InspectionId:int}/from/{Source}"
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject PageAccessService PageAccess
@inherits LocalizedComponentBase

@if (_loading)
{
    <div class="rpt-loading">
        <div class="rpt-spinner"></div>
        <span>@T("InspectionReport.LoadingReport")</span>
    </div>
}
else if (_error != null)
{
    <div class="rpt-error">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#e53e3e" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
        <p>@_error</p>
        <button class="rpt-back-btn" @onclick="GoBack">@T("Common.Back2")</button>
    </div>
}
else if (_data != null)
{
    <div class="rpt-page" id="rpt-root">

        <!-- ══════ TOOLBAR ══════ -->
        <div class="rpt-toolbar no-print">
            <button class="rpt-back-btn" @onclick="GoBack">
                <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 15l-5-5 5-5"/></svg>
                @T("Common.Back")
            </button>
            @if (PageAccess.CanDownload)
            {
            <button class="rpt-print-btn" @onclick="PrintReport" disabled="@_isPrinting">
                @if (_isPrinting)
                {
                    <svg class="rpt-print-spinner" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                        <path d="M12 2a10 10 0 0 1 10 10" />
                    </svg>
                    <span>@T("InspectionReport.Preparing")</span>
                }
                else
                {
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                    <span>@T("InspectionReport.PrintSavePDF")</span>
                }
            </button>
            }
        </div>

        <!-- ══════ REPORT CONTENT ══════ -->
        <div class="rpt-paper" data-total="@TotalPages">

            <!-- PAGE 1: COVER -->
            <div class="rpt-section page-break-after">

                <!-- Header -->
                <div class="rpt-cover-header">
                    <div class="rpt-logo-wrap">
                        <img src="/logo.png" class="rpt-logo-img" alt="@T("InspectionReport.InticooLogo")"/>
                    </div>
                    <div class="rpt-title-block">
                        <div class="rpt-main-title">@T("InspectionReport.INSPECTIONREPORT")</div>
                        <div class="rpt-job-no">@T("InspectionReport.JobNo", _data.JobNumber ?? "—")</div>
                    </div>
                </div>

                <!-- Product Overview photo -->
                <div class="rpt-section-title">@T("InspectionReport.ProductOverview")</div>
                <div class="rpt-overview-photo-wrap">
                    @if (!string.IsNullOrEmpty(_data.Photo1Url))
                    {
                        <div class="rpt-overview-photo-cell">
                            <img src="@NormalizeUrl(_data.Photo1Url)" class="rpt-overview-img" alt="@T("InspectionReport.ProductPhoto")" loading="eager"/>
                        </div>
                    }
                    else
                    {
                        <div class="rpt-overview-photo-cell rpt-photo-empty-lg">@T("InspectionReport.NoPhoto")</div>
                    }
                </div>

                @{
                    // Total Inspected Qty = cỡ mẫu AQL thực kiểm (Major, rồi Critical, rồi Minor) — không phải số lượng cả lô
                    var totalInspectedQty = _data.AqlMajorSampleSize > 0 ? _data.AqlMajorSampleSize
                                          : _data.AqlCriticalSampleSize > 0 ? _data.AqlCriticalSampleSize
                                          : _data.AqlMinorSampleSize > 0 ? _data.AqlMinorSampleSize
                                          : (_qcData?.Aql?.MajorSampleSize ?? 0);
                }
                <!-- General Information -->
                <div class="rpt-section-title">@T("Common.GeneralInformation")</div>
                <table class="rpt-info-table">
                    <tbody>
                        <tr>
                            <td class="rpt-info-label">@T("Common.CustomerName")</td>
                            <td class="rpt-info-val">@(_data.CustomerName ?? "—")</td>
                            <td class="rpt-info-label">@T("Common.CustomerID")</td>
                            <td class="rpt-info-val">@(_data.CustomerId ?? "—")</td>
                        </tr>
                        <tr>
                            <td class="rpt-info-label">@T("Common.VendorName")</td>
                            <td class="rpt-info-val">@(_data.VendorName ?? "—")</td>
                            <td class="rpt-info-label">@T("Common.VendorID")</td>
                            <td class="rpt-info-val">@(_data.VendorId ?? "—")</td>
                        </tr>
                        <tr>
                            <td class="rpt-info-label">@T("Common.InspectionLocation")</td>
                            <td class="rpt-info-val">@(_data.InspectionLocation ?? "—")</td>
                            <td class="rpt-info-label">@T("Common.PONumber")</td>
                            <td class="rpt-info-val">@(_data.PoNumber ?? "—")</td>
                        </tr>
                        <tr>
                            <td class="rpt-info-label">@T("InspectionReport.InspectionDateTime")</td>
                            <td class="rpt-info-val" colspan="3">
                                @{
                                    var inspStart = _qcData?.InspectionStartTime ?? _data.InspectionDate;
                                    var startStr  = inspStart.HasValue ? L.Date(inspStart.Value, "d MMM yyyy hh:mm tt") : "—";
                                    var endStr    = _data.CompletedAt.HasValue ? L.Date(_data.CompletedAt.Value.ToLocalTime(), "d MMM yyyy hh:mm tt") : "—";
                                }
                                <strong>@T("InspectionReport.StartTime")</strong> @startStr &nbsp;&nbsp;|&nbsp;&nbsp; <strong>@T("InspectionReport.EndTime")</strong> @endStr
                            </td>
                        </tr>
                        <tr>
                            <td class="rpt-info-label">@T("Common.ItemNumber")</td>
                            <td class="rpt-info-val">@(_data.ItemNumber ?? "—")</td>
                            <td class="rpt-info-label">@T("Common.InspectionType")</td>
                            <td class="rpt-info-val">@(_data.InspectionType ?? "—")</td>
                        </tr>
                        <tr>
                            <td class="rpt-info-label">@T("Common.ProductName")</td>
                            <td class="rpt-info-val">@(_data.ProductName ?? "—")</td>
                            <td class="rpt-info-label">@T("Common.ProductCategory")</td>
                            <td class="rpt-info-val">@(string.IsNullOrWhiteSpace(_data.ProductCategory) ? "—" : string.Join(", ", _data.ProductCategory.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Select(c => TE("Opt", c))))</td>
                        </tr>
                        <tr>
                            <td class="rpt-info-label">@T("InspectionReport.TotalShipmentQty")</td>
                            <td class="rpt-info-val">@(_data.TotalShipmentQty > 0 ? _data.TotalShipmentQty.ToString() : "—")</td>
                            <td class="rpt-info-label">@T("Common.AQLSamplingSimulator")</td>
                            <td class="rpt-info-val">@T("InspectionReport.InspectionLevelII254")</td>
                        </tr>
                        <tr>
                            <td class="rpt-info-label">@T("Common.TotalCartonBoxes")</td>
                            <td class="rpt-info-val">@(_data.TotalCartonBoxes > 0 ? _data.TotalCartonBoxes.ToString() : "—")</td>
                            <td class="rpt-info-label">@T("InspectionReport.TotalInspectedQty")</td>
                            <td class="rpt-info-val">@(totalInspectedQty > 0 ? totalInspectedQty.ToString("N0") : "—")</td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(_data.GeneralRemark))
                        {
                        <tr>
                            <td class="rpt-info-label">@T("Common.Remark")</td>
                            <td class="rpt-info-val" colspan="3">@_data.GeneralRemark</td>
                        </tr>
                        }
                    </tbody>
                </table>

                <!-- Inspection Results Summary -->
                <div class="rpt-keep-together">
                    <div class="rpt-section-title">@T("Common.InspectionResults")</div>
                    <table class="rpt-result-table rpt-oc-table">
                        <thead>
                            <tr>
                                <th class="rpt-th-label" style="text-align:center">@T("Common.OVERALLCONCLUSION")</th>
                                <th class="rpt-th-comp">@T("Common.COMPLIANCE")</th>
                                <th class="rpt-th-remark" style="text-align:center">@T("Common.REMARK")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (_qcData?.OverallConclusions?.Any() == true)
                            {
                                @foreach (var oc in _qcData!.OverallConclusions)
                                {
                                    <tr>
                                        <td class="rpt-oc-name">@oc.Letter. @TE("Opt", oc.Label)</td>
                                        <td class="rpt-td-center" data-l="@T("Common.COMPLIANCE")">
                                            <span class="rpt-compliance-badge comp-@(oc.Compliance?.ToLower() ?? "na")">
                                                @(oc.Compliance switch { "Pass" => T("Common.Yes"), "Fail" => T("Common.No"), _ => TE("Status", oc.Compliance ?? "NA") })
                                            </span>
                                        </td>
                                        <td data-l="@T("Common.REMARK")">@(oc.Remark ?? "")</td>
                                    </tr>
                                }
                            }
                            else if (_data.OverallConclusions?.Any() == true)
                            {
                                @foreach (var oc in _data.OverallConclusions)
                                {
                                    <tr>
                                        <td class="rpt-oc-name">@oc.Letter. @TE("Opt", oc.Label)</td>
                                        <td class="rpt-td-center" data-l="@T("Common.COMPLIANCE")">
                                            <span class="rpt-compliance-badge comp-@(oc.Compliance?.ToLower() ?? "na")">
                                                @(oc.Compliance switch { "Pass" => T("Common.Yes"), "Fail" => T("Common.No"), _ => TE("Status", oc.Compliance ?? "NA") })
                                            </span>
                                        </td>
                                        <td data-l="@T("Common.REMARK")">@(oc.Remark ?? "")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                string[] defaultRows = { "A. Quantity Conformity", "B. Packaging & Identification",
                                    "C. Product Specification Compliance", "D. Performance Testing",
                                    "E. Appearance & Craftsmanship", "F. Details of Defect Found" };
                                @foreach (var row in defaultRows)
                                {
                                    <tr><td class="rpt-oc-name">@row[..3]@TE("Opt", row[3..])</td><td class="rpt-td-center" data-l="@T("Common.COMPLIANCE")">—</td><td data-l="@T("Common.REMARK")"></td></tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Footer -->
                <div class="rpt-footer">
                    <div class="rpt-footer-inner">
                        <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                        <span class="rpt-footer-page"></span>
                    </div>
                </div>
            </div>

            <!-- ══ SECTION A: Quantity Conformity ══ -->
            @if (IsPass("A"))
            {
            <div class="rpt-section page-break-after">
                <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.QuantityConformity")</div>

                @{
                    var qc = _qcData?.QuantityConformity;
                    // AQL Sample Size — 3 sample (Critical/Major/Minor) thường cùng giá trị,
                    // lấy giá trị đầu tiên có > 0 (ưu tiên Major).
                    int aqlSampleSize = _data.AqlMajorSampleSize > 0 ? _data.AqlMajorSampleSize
                                      : _data.AqlCriticalSampleSize > 0 ? _data.AqlCriticalSampleSize
                                      : _data.AqlMinorSampleSize > 0 ? _data.AqlMinorSampleSize
                                      : (_qcData?.Aql?.MajorSampleSize ?? 0);
                }

                <!-- Bảng luôn hiển thị theo mẫu PDF -->
                <table class="rpt-qty-table">
                    <thead>
                        <tr>
                            <th rowspan="2">@T("InspectionReport.PONo")</th>
                            <th rowspan="2">@T("Common.ItemNumber")</th>
                            <th rowspan="2">@T("InspectionReport.ItemPerCarton")</th>
                            <th rowspan="2">@T("InspectionReport.ShipmentQty")</th>
                            <th rowspan="2">@T("InspectionReport.AQLSampling")</th>
                            <th colspan="2">@T("InspectionReport.PresentedQtyForInspection")</th>
                            <th colspan="2">@T("InspectionReport.NumberOfCartons")</th>
                            <th rowspan="2">@T("InspectionReport.QtyNotFinished")</th>
                        </tr>
                        <tr>
                            <th>@T("InspectionReport.Packed")</th><th>@T("InspectionReport.NotPacked")</th>
                            <th>@T("InspectionReport.Packed")</th><th>@T("InspectionReport.NotPacked")</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="rpt-qty-data-row">
                            <td data-l="@T("InspectionReport.PONo")">@(_data.PoNumber ?? "")</td>
                            <td data-l="@T("Common.ItemNumber")">@(_data.ItemNumber ?? "")</td>
                            <td data-l="@T("InspectionReport.ItemPerCarton")">@(qc?.ItemPerCarton > 0 ? qc.ItemPerCarton.ToString() : "")</td>
                            <td data-l="@T("InspectionReport.ShipmentQty")">@(_data.TotalShipmentQty > 0 ? _data.TotalShipmentQty.ToString() : "")</td>
                            <td data-l="@T("InspectionReport.AQLSampling")">@(aqlSampleSize > 0 ? aqlSampleSize.ToString() : "")</td>
                            <td data-l="@(T("InspectionReport.PresentedQtyForInspection") + " · " + T("InspectionReport.Packed"))">@(qc?.PresentedPacked > 0 ? qc.PresentedPacked.ToString() : "")</td>
                            <td data-l="@(T("InspectionReport.PresentedQtyForInspection") + " · " + T("InspectionReport.NotPacked"))">@(qc?.PresentedNotPacked > 0 ? qc.PresentedNotPacked.ToString() : "")</td>
                            <td data-l="@(T("InspectionReport.NumberOfCartons") + " · " + T("InspectionReport.Packed"))">@(qc?.CartonsPacked > 0 ? qc.CartonsPacked.ToString() : "")</td>
                            <td data-l="@(T("InspectionReport.NumberOfCartons") + " · " + T("InspectionReport.NotPacked"))">@(qc?.CartonsNotPacked > 0 ? qc.CartonsNotPacked.ToString() : "")</td>
                            <td data-l="@T("InspectionReport.QtyNotFinished")">@(qc?.QtyNotFinished > 0 ? qc.QtyNotFinished.ToString() : "")</td>
                        </tr>
                        <tr class="rpt-total-row">
                            <td colspan="3" class="rpt-total-label">@T("Common.Total")</td>
                            <td>@(_data.TotalShipmentQty > 0 ? _data.TotalShipmentQty.ToString() : "")</td>
                            <td>@(aqlSampleSize > 0 ? aqlSampleSize.ToString() : "")</td>
                            <td>@(qc?.PresentedPacked > 0 ? qc.PresentedPacked.ToString() : "")</td>
                            <td>@(qc?.PresentedNotPacked > 0 ? qc.PresentedNotPacked.ToString() : "")</td>
                            <td>@(qc?.CartonsPacked > 0 ? qc.CartonsPacked.ToString() : "")</td>
                            <td>@(qc?.CartonsNotPacked > 0 ? qc.CartonsNotPacked.ToString() : "")</td>
                            <td>@(qc?.QtyNotFinished > 0 ? qc.QtyNotFinished.ToString() : "")</td>
                        </tr>
                    </tbody>
                </table>

                <!-- ★ Photo grid: chia thành chunks. Trang đầu (chung với table)
                     tối đa 4 ảnh; các trang tiếp theo tối đa 6 ảnh.
                     Tránh tràn trang gây ra trang trắng. -->
                @{
                    var aPhotosAll = (qc?.Photos ?? Enumerable.Empty<string>())
                        .Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
                    // Trang đầu (cùng table) tối đa 4 ảnh
                    var aFirstPage = aPhotosAll.Take(4).Cast<string?>().ToList();
                    if (aFirstPage.Count > 0 && aFirstPage.Count % 2 != 0) aFirstPage.Add(null);
                    if (aFirstPage.Count == 0) aFirstPage = new List<string?> { null, null };
                    // Các trang sau (chia 6 ảnh/trang)
                    var aRestPages = ChunkPhotosForPages(aPhotosAll.Skip(4));
                    // ChunkPhotosForPages trả về [[null,null]] khi rỗng — bỏ trường hợp đó
                    if (aPhotosAll.Count <= 4) aRestPages = new List<List<string?>>();
                }
                <div class="rpt-qty-photo-grid">
                    @foreach (var slot in aFirstPage)
                    {
                        <div class="rpt-qty-photo-cell">
                            @if (!string.IsNullOrEmpty(slot))
                            {
                                <img src="@NormalizeUrl(slot)" class="rpt-qty-photo-img" alt="@T("InspectionReport.QuantityPhoto")" loading="eager"/>
                            }
                        </div>
                    }
                </div>

                <div class="rpt-footer">
                    <div class="rpt-footer-inner">
                        <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                        <span class="rpt-footer-page"></span>
                    </div>
                </div>
            </div>

            @* Trang tiếp theo của Section A (nếu > 4 ảnh) *@
            @foreach (var pageSlots in aRestPages)
            {
                <div class="rpt-section page-break-after">
                    <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.QuantityConformity")</div>
                    <div class="rpt-qty-photo-grid">
                        @foreach (var slot in pageSlots)
                        {
                            <div class="rpt-qty-photo-cell">
                                @if (!string.IsNullOrEmpty(slot))
                                {
                                    <img src="@NormalizeUrl(slot)" class="rpt-qty-photo-img" alt="@T("InspectionReport.QuantityPhoto")" loading="eager"/>
                                }
                            </div>
                        }
                    </div>
                    <div class="rpt-footer">
                        <div class="rpt-footer-inner">
                            <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                        <span class="rpt-footer-page"></span>
                        </div>
                    </div>
                </div>
            }
            } @* end IsPass("A") *@

            <!-- ══ SECTION B: Packaging & Identification ══ -->
            @if (IsPass("B"))
            {
            var pr = _qcData?.Packaging;
            var cartonDataList = pr?.CartonDataList;
            int cartonCount = cartonDataList?.Count > 0 ? cartonDataList.Count : 1;

            @for (int ci = 0; ci < cartonCount; ci++)
            {
                var cIdx = ci;
                var cd = cartonDataList != null && cIdx < cartonDataList.Count ? cartonDataList[cIdx] : null;
                var cartonSuffix = cartonCount > 1 ? $" — Carton {cIdx + 1}" : "";

                // ── Trang B: Header + Info table + i. Carton Size ──
                <div class="rpt-section page-break-after">
                    <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.BPackagingIdentification", cartonSuffix)</div>

                    @if (_data.Packaging != null)
                    {
                        var pkg = _data.Packaging;
                        <table class="rpt-info-table rpt-pkg-table">
                            <tbody>
                                <tr>
                                    <td class="rpt-info-label">@T("Common.ItemNumber")</td>
                                    <td class="rpt-info-val">@(pkg.ItemNumber ?? "—")</td>
                                    <td class="rpt-info-label">@T("Common.CartonNumber")</td>
                                    <td class="rpt-info-val">@(cartonCount > 1 ? (cIdx + 1).ToString() : (pkg.CartonNumber ?? "—"))</td>
                                </tr>
                                <tr>
                                    <td class="rpt-info-label">@T("InspectionReport.TypeOfPackaging")</td>
                                    <td class="rpt-info-val">@(string.IsNullOrEmpty(pkg.PackagingType) ? "—" : TE("Opt", pkg.PackagingType))</td>
                                    <td class="rpt-info-label">@T("Common.TypeOfCardboard")</td>
                                    <td class="rpt-info-val">@(string.IsNullOrEmpty(pkg.CardboardType) ? "—" : TE("Opt", pkg.CardboardType))</td>
                                </tr>
                                <tr>
                                    <td class="rpt-info-label">@T("Common.ColorOfCarton")</td>
                                    <td class="rpt-info-val">@(string.IsNullOrEmpty(pkg.CartonColor) ? "—" : TE("Opt", pkg.CartonColor))</td>
                                    <td class="rpt-info-label">@T("Common.ShippingMark")</td>
                                    <td class="rpt-info-val">@(string.IsNullOrEmpty(pkg.ShippingMark) ? "—" : TE("Opt", pkg.ShippingMark))</td>
                                </tr>
                                @{
                                    var _pc = pkg.Cartons?.FirstOrDefault(x => x.CartonIndex == cIdx + 1);
                                }
                                <tr>
                                    <td class="rpt-info-label">@T("Common.CartonVariant")</td>
                                    <td class="rpt-info-val">@(string.IsNullOrWhiteSpace(_pc?.CartonVariant) ? "—" : $"{_pc!.CartonVariant}{(string.IsNullOrWhiteSpace(_pc.Description) ? "" : " · " + _pc.Description)}{(string.IsNullOrWhiteSpace(_pc.PackingQuantity) ? "" : " · " + _pc.PackingQuantity)}")</td>
                                    <td class="rpt-info-label">@T("Common.BurstingTest")</td>
                                    <td class="rpt-info-val">@(pkg.BurstingTest.HasValue ? T("InspectionReport.Lbs", pkg.BurstingTest) : "—")</td>
                                </tr>
                                <tr>
                                    <td class="rpt-info-label">@T("InspectionReport.InnerPacking")</td>
                                    <td class="rpt-info-val">
                                        @{
                                            var _innerRmk = (pkg.InnerPackingRemark ?? "").Trim();
                                        }
                                        Qty: @(_pc?.InnerPackingQty ?? pkg.InnerPackingQty)@(string.IsNullOrEmpty(_innerRmk) ? "" : $" — {_innerRmk}")
                                    </td>
                                    <td class="rpt-info-label">@T("Common.BarcodeQRCode")</td>
                                    <td class="rpt-info-val">@(pkg.HasBarcode ? T("Common.Yes") : "No")</td>
                                </tr>
                                <tr>
                                    <td class="rpt-info-label">@T("InspectionReport.OuterPackingMm")</td>
                                    <td class="rpt-info-val">
                                        @if (cd != null && (cd.SizeL > 0 || cd.SizeW > 0 || cd.SizeH > 0))
                                        { @(T("InspectionReport.LWH", cd.SizeL, cd.SizeW, cd.SizeH)) }
                                        else
                                        { @(T("InspectionReport.LWH", pkg.OuterL, pkg.OuterW, pkg.OuterH)) }
                                    </td>
                                    <td class="rpt-info-label">@T("InspectionReport.GrossWeightKg")</td>
                                    <td class="rpt-info-val">
                                        @if (cd != null && (cd.SizeL > 0 || cd.SizeW > 0 || cd.SizeH > 0))
                                        { @cd.Weight }
                                        else
                                        { @pkg.OuterWeight }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    }

                    <!-- i. Carton Size -->
                    <div class="rpt-sub-title">@T("InspectionReport.ICartonSize")</div>
                    @{
                        var _csAll = ((cd?.SizePhotos ?? pr?.CartonSizePhotos) ?? Enumerable.Empty<string>())
                            .Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
                        // Trang đầu (cùng info table) → tối đa 4 ảnh để vừa A4
                        var _csFirstPage = _csAll.Take(4).Cast<string?>().ToList();
                        if (_csFirstPage.Count > 0 && _csFirstPage.Count % 2 != 0) _csFirstPage.Add(null);
                        if (_csFirstPage.Count == 0) _csFirstPage = new List<string?> { null, null };
                        // Các trang tiếp theo (chia 6 ảnh/trang)
                        var _csRestPages = _csAll.Count > 4
                            ? ChunkPhotosForPages(_csAll.Skip(4))
                            : new List<List<string?>>();
                        var _csResult = cd?.CartonSizeResult ?? pr?.CartonSizeResult;
                    }
                    <div class="rpt-photo-grid-2">
                        @foreach (var _u in _csFirstPage)
                        {
                            <div class="rpt-photo-cell">
