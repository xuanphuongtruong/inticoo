                <div class="rpt-section page-break-after">
                    <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.DPerformanceTesting")</div>
                    <div class="rpt-no-data">@T("InspectionReport.NoPerformanceTestingDataRecorded")</div>
                    <div class="rpt-footer">
                        <div class="rpt-footer-inner">
                            <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                            <span class="rpt-footer-page"></span>
                        </div>
                    </div>
                </div>
            }
            } @* end IsPass("D") *@

            <!-- ══ SECTION E: Appearance & Craftsmanship (AQL) ══ -->
            @if (IsPass("E"))
            {
            <div class="rpt-section page-break-after">
                <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.EAppearanceCraftsmanship")</div>

                @{
                    // DB values cho SampleSize/Accept/Reject (chính xác từ AQL table)
                    var aqlQty     = _data.AqlQuantity > 0 ? _data.AqlQuantity : (_qcData?.Aql?.Quantity ?? 0);
                    var aqlLvl     = _data.AqlLevel    ?? _qcData?.Aql?.InspectionLevel ?? "II";
                    var aqlCritAql = _data.AqlCritical ?? _qcData?.Aql?.CriticalAql ?? "Not Allowed";
                    var aqlMajAql  = _data.AqlMajor    ?? _qcData?.Aql?.MajorAql    ?? "2.5";
                    var aqlMinAql  = _data.AqlMinor    ?? _qcData?.Aql?.MinorAql    ?? "4.0";
                    var critSample = _data.AqlCriticalSampleSize > 0 ? _data.AqlCriticalSampleSize : (_qcData?.Aql?.CriticalSampleSize ?? 0);
                    var critAccept = _data.AqlCriticalAccept     > 0 ? _data.AqlCriticalAccept     : (_qcData?.Aql?.CriticalAccept     ?? 0);
                    var critReject = _data.AqlCriticalReject     > 0 ? _data.AqlCriticalReject     : (_qcData?.Aql?.CriticalReject     ?? 0);
                    var majSample  = _data.AqlMajorSampleSize    > 0 ? _data.AqlMajorSampleSize    : (_qcData?.Aql?.MajorSampleSize    ?? 0);
                    var majAccept  = _data.AqlMajorAccept        > 0 ? _data.AqlMajorAccept        : (_qcData?.Aql?.MajorAccept        ?? 0);
                    var majReject  = _data.AqlMajorReject        > 0 ? _data.AqlMajorReject        : (_qcData?.Aql?.MajorReject        ?? 0);
                    var minSample  = _data.AqlMinorSampleSize    > 0 ? _data.AqlMinorSampleSize    : (_qcData?.Aql?.MinorSampleSize    ?? 0);
                    var minAccept  = _data.AqlMinorAccept        > 0 ? _data.AqlMinorAccept        : (_qcData?.Aql?.MinorAccept        ?? 0);
                    var minReject  = _data.AqlMinorReject        > 0 ? _data.AqlMinorReject        : (_qcData?.Aql?.MinorReject        ?? 0);
                    var critFound  = _qcData?.Aql?.CriticalFound ?? 0;
                    var majFound   = _qcData?.Aql?.MajorFound    ?? 0;
                    var minFound   = _qcData?.Aql?.MinorFound    ?? 0;
                }
                @if (aqlQty > 0 || critSample > 0 || _qcData?.Aql != null)
                {
                    <div class="rpt-aql-label">@T("Common.AQLSamplingSimulator")</div>
                    <div class="rpt-aql-headline">
                        @T("Common.Quantity"): <strong>@aqlQty.ToString("N0")</strong>
                        <span class="rpt-aql-sep">|</span>
                        @T("Common.InspectionLevel"): <strong>@aqlLvl</strong>
                    </div>
                    <div class="rpt-aql-grid">
                        <div class="rpt-aql-box aql-critical">
                            <div class="rpt-aql-box-title">@T("Common.CriticalDefects")</div>
                            <div class="rpt-aql-box-row"><span>@T("Common.SelectAQL")</span><span>@(string.IsNullOrEmpty(aqlCritAql) ? "—" : AqlText(aqlCritAql))</span></div>
                            <div class="rpt-aql-box-row"><span>@T("Common.SampleSize")</span><span>@(critSample > 0 ? critSample.ToString() : "—")</span></div>
                            <div class="rpt-aql-box-row"><span>@T("Common.AcceptPoint")</span><span>@(critAccept >= 0 && critSample > 0 ? critAccept.ToString() : "—")</span></div>
                            <div class="rpt-aql-box-row"><span>@T("Common.RejectPoint")</span><span>@(critReject > 0 ? critReject.ToString() : "—")</span></div>
                        </div>
                        <div class="rpt-aql-box aql-major">
                            <div class="rpt-aql-box-title">@T("Common.MajorDefects")</div>
                            <div class="rpt-aql-box-row"><span>@T("Common.SelectAQL")</span><span>@(string.IsNullOrEmpty(aqlMajAql) ? "—" : AqlText(aqlMajAql))</span></div>
                            <div class="rpt-aql-box-row"><span>@T("Common.SampleSize")</span><span>@(majSample > 0 ? majSample.ToString() : "—")</span></div>
                            <div class="rpt-aql-box-row"><span>@T("Common.AcceptPoint")</span><span>@(majAccept >= 0 && majSample > 0 ? majAccept.ToString() : "—")</span></div>
                            <div class="rpt-aql-box-row"><span>@T("Common.RejectPoint")</span><span>@(majReject > 0 ? majReject.ToString() : "—")</span></div>
                        </div>
                        <div class="rpt-aql-box aql-minor">
                            <div class="rpt-aql-box-title">@T("Common.MinorDefects")</div>
                            <div class="rpt-aql-box-row"><span>@T("Common.SelectAQL")</span><span>@(string.IsNullOrEmpty(aqlMinAql) ? "—" : AqlText(aqlMinAql))</span></div>
                            <div class="rpt-aql-box-row"><span>@T("Common.SampleSize")</span><span>@(minSample > 0 ? minSample.ToString() : "—")</span></div>
                            <div class="rpt-aql-box-row"><span>@T("Common.AcceptPoint")</span><span>@(minAccept >= 0 && minSample > 0 ? minAccept.ToString() : "—")</span></div>
                            <div class="rpt-aql-box-row"><span>@T("Common.RejectPoint")</span><span>@(minReject > 0 ? minReject.ToString() : "—")</span></div>
                        </div>
                    </div>
                    <div class="rpt-aql-label" style="margin-top:16px;">@T("InspectionReport.RESULT")</div>
                    var aqlResult = _qcData?.Aql?.Result;
                    <table class="rpt-result-table rpt-def-table">
                        <thead>
                            <tr>
                                <th class="rpt-th-label">@T("InspectionReport.DetailsOfDefectFound")</th>
                                <th class="rpt-th-comp" style="color:#c0392b">@T("Common.Critical")</th>
                                <th class="rpt-th-comp" style="color:#e67e22">@T("Common.Major")</th>
                                <th class="rpt-th-comp" style="color:#27ae60">@T("Common.Minor")</th>
                                <th class="rpt-th-comp" style="width:90px">@T("Common.Result")</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="rpt-def-name">@T("InspectionReport.TotalFound")</td>
                                <td class="rpt-td-center" data-l="@T("Common.Critical")">@critFound</td>
                                <td class="rpt-td-center" data-l="@T("Common.Major")">@majFound</td>
                                <td class="rpt-td-center" data-l="@T("Common.Minor")">@minFound</td>
                                <td class="rpt-td-center" data-l="@T("Common.Result")">
                                    @if (!string.IsNullOrEmpty(aqlResult))
                                    {
                                        <span class="rpt-compliance-badge comp-@aqlResult.ToLower()">@TE("Status", aqlResult)</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="rpt-no-data">@T("InspectionReport.NoAQLDataRecorded")</div>
                }

                <!-- Critical defects: tách thành các trang riêng, mỗi trang max 6 ảnh.
                     Trang đầu chỉ chứa AQL + Result (đã chiếm gần hết) — Critical
                     header + ảnh đầu tiên đặt ở trang đầu nếu có ≤ 2 defect, ngược
                     lại sang trang sau. -->
                @{
                    var _critDefects = _qcData?.Defects?.Where(d => d.Type == "Critical").ToList() ?? new();
                    var _critItems = _critDefects.SelectMany(def => {
                        var urls = (def.Photos?.Where(p => !string.IsNullOrWhiteSpace(p)).ToList())
                                   ?? (def.PhotoUrl != null ? new List<string> { def.PhotoUrl } : new List<string>());
                        return urls.Select((url, i) => (Url: (string?)url, Remark: def.RemarkAt(i)));
                    }).ToList();
                    // Trang E đã đầy với AQL + Result → critical defects đặt cuối nếu còn chỗ
                    // (chỉ 0 ảnh trên trang E để an toàn)
                    bool _critOnSamePage = _critItems.Count == 0;  // chỉ render heading + 2 khung trống nếu rỗng
                    var _critPagesAll = _critItems.Count > 0
                        ? ChunkDefectsForPages(_critItems)
                        : new List<List<(string? Url, string Remark)>>();
                }
                <!-- Heading F + Critical luôn render ở cuối trang E (chỉ heading + 2 khung trống) -->
                <div class="rpt-section-title rpt-section-title-lg" style="margin-top:20px;">@T("InspectionReport.FDetailsOfDefectFound")</div>
                <div class="rpt-defect-type-title defect-critical">@T("Common.Critical")</div>
                @if (_critOnSamePage)
                {
                    <!-- Không có critical → 2 khung trống cho cân đối -->
                    <div class="rpt-photo-grid-2">
                        <div class="rpt-defect-cell">
                            <div class="rpt-defect-photo-wrap">
                                <div class="rpt-defect-no-photo">@T("InspectionReport.NoPhoto")</div>
                            </div>
                            <div class="rpt-defect-remark">—</div>
                        </div>
                        <div class="rpt-defect-cell">
                            <div class="rpt-defect-photo-wrap">
                                <div class="rpt-defect-no-photo">@T("InspectionReport.NoPhoto")</div>
                            </div>
                            <div class="rpt-defect-remark">—</div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- Có critical defects → ghi chú "see next page" và đặt ảnh ở trang sau -->
                    <div style="text-align:center;color:#888;font-size:11px;padding:12px;">
                        @T("InspectionReport.SeeCriticalDefectPhotosOnFollowing")
                    </div>
                }

                <div class="rpt-footer">
                    <div class="rpt-footer-inner">
                        <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                        <span class="rpt-footer-page"></span>
                    </div>
                </div>
            </div>

            @* Trang riêng cho Critical defects (mỗi trang max 6 ảnh) *@
            @foreach (var _critPage in _critPagesAll)
            {
                <div class="rpt-section page-break-after">
                    <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.FDetailsOfDefectFound")</div>
                    <div class="rpt-defect-type-title defect-critical">@T("Common.Critical")</div>
                    <div class="rpt-photo-grid-2">
                        @foreach (var slot in _critPage)
                        {
                            <div class="rpt-defect-cell">
                                <div class="rpt-defect-photo-wrap">
                                    @if (!string.IsNullOrEmpty(slot.Url))
                                    { <img src="@NormalizeUrl(slot.Url)" class="rpt-defect-photo" alt="@T("InspectionReport.CriticalDefectPhoto")" loading="eager"/> }
                                    else
                                    { <div class="rpt-defect-no-photo">@T("InspectionReport.NoPhoto")</div> }
                                </div>
                                @DefectCaption(slot.Remark)
                            </div>
                        }
                    </div>
                    <div class="rpt-footer">
                        <div class="rpt-footer-inner">
                            <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                        <span class="rpt-footer-page"></span>
                        </div>
                    </div>
                </div>
            }
            } @* end IsPass("E") *@

            <!-- ══ SECTION F: Major + Minor Defects ══ -->
            @if (IsPass("F"))
            {
                @* Major + Minor defects: mỗi defect type chia thành các trang, mỗi trang max 6 ảnh.
                   Major và Minor không gộp chung 1 trang (đảm bảo layout rõ ràng). *@
                @foreach (var defType in new[] { "Major", "Minor" })
                {
                    var typeDefects = _qcData?.Defects?.Where(d => d.Type == defType).ToList() ?? new();
                    var photoItems = typeDefects
                        .SelectMany(def =>
                        {
                            var urls = (def.Photos?.Where(p => !string.IsNullOrWhiteSpace(p)).ToList())
                                       ?? (def.PhotoUrl != null ? new List<string> { def.PhotoUrl } : new List<string>());
                            return urls.Select((url, i) => (
                                Url: (string?)url,
                                Remark: def.RemarkAt(i)
                            ));
                        })
                        .ToList();

                    var defectPages = ChunkDefectsForPages(photoItems);

                    @for (int _dpPi = 0; _dpPi < defectPages.Count; _dpPi++)
                    {
                        var defectPage = defectPages[_dpPi];
                        var defSuffix = defectPages.Count > 1 && _dpPi > 0 ? "" : "";
                        <div class="rpt-section page-break-after">
                            <div class="rpt-section-title rpt-section-title-lg">@T("InspectionReport.FDetailsOfDefectFound")</div>
                            <div class="rpt-defect-type-title defect-@defType.ToLower()">@TE("Status", defType)@(defSuffix)</div>
                            <div class="rpt-photo-grid-2">
                                @foreach (var slot in defectPage)
                                {
                                    <div class="rpt-defect-cell">
                                        <div class="rpt-defect-photo-wrap">
                                            @if (!string.IsNullOrEmpty(slot.Url))
                                            { <img src="@NormalizeUrl(slot.Url)" class="rpt-defect-photo" alt="@defType defect photo" loading="eager"/> }
                                            else
                                            { <div class="rpt-defect-no-photo">@T("InspectionReport.NoPhoto")</div> }
                                        </div>
                                        @DefectCaption(slot.Remark)
                                    </div>
                                }
                            </div>
                            <div class="rpt-footer">
                                <div class="rpt-footer-inner">
                                    <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                                <span class="rpt-footer-page"></span>
                                </div>
                            </div>
                        </div>
                    }
                }
            } @* end IsPass("F") *@

            <!-- ══ FINAL PAGE: Conclusion & Signature ══ -->
            <div class="rpt-section rpt-section-final">
                <div class="rpt-fin-header">
                    <img src="/logo.png" class="rpt-logo-img" alt="@T("InspectionReport.InticooLogo")"/>
                    <div class="rpt-fin-header-title">
                        <div>@T("InspectionReport.INSPECTIONREPORT")</div>
                        <span>@T("InspectionReport.TrustedPartner")</span>
                    </div>
                </div>

                @{
                    var _fr     = _data.FinalResult?.ToUpper();
                    var _frPass = _fr is "PASSED" or "PASS";
                    var _frFail = _fr is "FAILED" or "FAIL";
                }
                <!-- 1. Inspector Comments -->
                <div class="rpt-fin-card">
                    <div class="rpt-fin-head"><span class="rpt-fin-no">1</span>@T("InspectionReport.InspectorComments")</div>
                    <div class="rpt-fin-body rpt-fin-row">
                        <div class="rpt-fin-ico"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#1e3a6e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16v11H9l-5 4z"/></svg></div>
                        <div class="rpt-fin-text rpt-fin-boxed">@(string.IsNullOrWhiteSpace(_data.InspectorComments) ? "—" : _data.InspectorComments)</div>
                    </div>
                </div>

                <!-- 2. Final Result -->
                <div class="rpt-fin-card">
                    <div class="rpt-fin-head"><span class="rpt-fin-no">2</span>@T("InspectionReport.FinalResult")</div>
                    <div class="rpt-fin-body rpt-fin-result @(_frPass ? "is-pass" : _frFail ? "is-fail" : "is-na")">
                        <div class="rpt-fin-result-ico">@(_frPass ? "✓" : _frFail ? "✕" : "i")</div>
                        <div class="rpt-fin-result-word">@(_fr == null ? TE("Status", "NA") : TE("Status", _fr))</div>
                        <div class="rpt-fin-result-text">
                            @(_frPass ? T("InspectionReport.FinalPassedText") : _frFail ? T("InspectionReport.FinalFailedText") : T("InspectionReport.FinalNAText"))
                        </div>
                    </div>
                </div>

                <!-- 3. Compliance & Integrity Clause -->
                <div class="rpt-fin-card">
                    <div class="rpt-fin-head"><span class="rpt-fin-no">3</span>@T("InspectionReport.ComplianceIntegrityClause")</div>
                    <div class="rpt-fin-body rpt-fin-row">
                        <div class="rpt-fin-ico"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#1e3a6e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/></svg></div>
                        <div class="rpt-fin-text">@T("InspectionReport.AllInspectionsFollowCustomerProtocolAnd")</div>
                    </div>
                </div>

                <!-- 4. Inspection Details -->
                <div class="rpt-fin-card">
                    <div class="rpt-fin-head"><span class="rpt-fin-no">4</span>@T("InspectionReport.InspectionDetails")</div>
                    <div class="rpt-fin-body">
                        <table class="rpt-fin-table">
                            <tbody>
                                <tr>
                                    <th>@T("InspectionReport.InspectionDate")</th>
                                    <td>@(_data.InspectionDate.HasValue ? L.Date(_data.InspectionDate.Value, "yyyy-MM-dd") : "—")</td>
                                    <th>@T("InspectionReport.ReportNumber")</th>
                                    <td>@(_data.JobNumber ?? "—")</td>
                                </tr>
                                <tr>
                                    <th>@T("InspectionReport.InspectionLocation")</th>
                                    <td>@(_data.InspectionLocation ?? "—")</td>
                                    <th>@T("InspectionReport.Inspector")</th>
                                    <td>@(_data.InspectorName ?? "—")@(string.IsNullOrEmpty(_data.InspectorId) ? "" : $" (ID: {_data.InspectorId})")</td>
                                </tr>
                                <tr>
                                    <th>@T("InspectionReport.ClientFactory")</th>
                                    <td>@(string.Join(" / ", new[] { _data.CustomerName, _data.VendorName }.Where(x => !string.IsNullOrWhiteSpace(x))) is { Length: > 0 } _cf ? _cf : "N/A")</td>
                                    <th>@T("InspectionReport.ConfirmedBy")</th>
                                    <td class="rpt-fin-sign">
                                        @if (!string.IsNullOrEmpty(_data.SignatureUrl))
                                        {
                                            <img src="@NormalizeUrl(_data.SignatureUrl)" class="rpt-signature" alt="@T("InspectionReport.Signature")" loading="eager"/>
                                        }
                                        else { <span>—</span> }
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- 5. Report Completion -->
                <div class="rpt-fin-card">
                    <div class="rpt-fin-head"><span class="rpt-fin-no">5</span>@T("InspectionReport.ReportCompletion")</div>
                    <div class="rpt-fin-body rpt-fin-row">
                        <div class="rpt-fin-ico"><svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="#1e3a6e" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/><path d="M9 13l2 2 4-4"/></svg></div>
                        <div class="rpt-fin-text">@T("InspectionReport.ReportCompletionText")</div>
                    </div>
                </div>

                <div class="rpt-end-line">
                    <hr/>
                    <span>@T("InspectionReport.End")</span>
                    <hr/>
                </div>

                <div class="rpt-footer">
                    <div class="rpt-footer-inner">
                        <span class="rpt-footer-text">@T("InspectionReport.WwwInticooCom")<br/>@T("InspectionReport.ResultsPresentedHereinReflectFindingsAt")</span>
                        <span class="rpt-footer-page"></span>
                    </div>
                </div>
            </div>

        </div>

        <!-- Print-only running footer: position: fixed trong @@media print
             để xuất hiện ở đáy MỌI trang PDF. Ẩn trên màn hình. -->
        <div class="rpt-print-footer">
            <div class="rpt-print-footer-text">
                @T("InspectionReport.WwwInticooCom")<br/>
                @T("InspectionReport.ResultsPresentedHereinReflectOurFindings2")
            </div>
        </div>
    </div>
}

@code {
    // ── Helper hiển thị: bảng so sánh tham chiếu/thực đo, nhãn kết quả, khung N/A ──
    static bool IsPassVal(string? r) => r is not null &&
        (r.Equals("Pass", StringComparison.OrdinalIgnoreCase) || r.Equals("Passed", StringComparison.OrdinalIgnoreCase));
    static bool IsFailVal(string? r) => r is not null &&
        (r.Equals("Fail", StringComparison.OrdinalIgnoreCase) || r.Equals("Failed", StringComparison.OrdinalIgnoreCase));
    static bool IsNAVal(string? r) => r is not null &&
        (r.Equals("N/A", StringComparison.OrdinalIgnoreCase) || r.Equals("NA", StringComparison.OrdinalIgnoreCase));
    // Mức AQL: số giữ nguyên, "Not Allowed" (không cho phép lỗi) dịch theo ngôn ngữ
    string AqlText(string v) => v.Trim().Equals("Not Allowed", StringComparison.OrdinalIgnoreCase) ? T("Common.NotAllowed") : v;
    static string Kg(double? v) => v is > 0 ? $"{v.Value:0.0} kg" : "—";
    static string MmIn(double? v) => v is > 0 ? $"{v.Value:0.#} mm / {v.Value / 25.4:0.0} in" : "—";

    RenderFragment ResultPill(string? r) =>
        IsPassVal(r) ? @<span class="rpt-result-pill pill-pass"><span class="pill-ico">✓</span>@T("InspectionReport.ResultPassed")</span>
      : IsFailVal(r) ? @<span class="rpt-result-pill pill-fail"><span class="pill-ico">✕</span>@T("InspectionReport.ResultFailed")</span>
      : IsNAVal(r)   ? @<span class="rpt-result-pill pill-na">N/A</span>
      :                @<span style="color:#bbb">—</span>;

    // Bảng Reference (hồ sơ sản phẩm) / Actual (đo) / Difference / Result — dùng cho Carton Weight và Product Weight
    RenderFragment WeightCompare(double? refW, double? actW, string? result)
    {
        double? diff = refW is > 0 && actW is > 0 ? actW - refW : null;
        double? pct  = diff.HasValue ? diff / refW * 100 : null;
        return @<table class="rpt-spec-table rpt-cmp-table">
            <thead><tr>
                <th style="width:27%">@T("InspectionReport.ReferenceWeight")<br/><span class="rpt-cmp-sub">@T("InspectionReport.FromProductProfile")</span></th>
                <th style="width:25%">@T("InspectionReport.ActualWeightCol")<br/><span class="rpt-cmp-sub">@T("InspectionReport.Measured")</span></th>
                <th style="width:23%">@T("InspectionReport.Difference")</th>
                <th style="width:25%">@T("Common.Result")</th>
            </tr></thead>
            <tbody><tr>
                <td class="rpt-cmp-big" data-l="@T("InspectionReport.ReferenceWeight")">@Kg(refW)</td>
                <td class="rpt-cmp-big" data-l="@T("InspectionReport.ActualWeightCol")">@Kg(actW)</td>
                <td data-l="@T("InspectionReport.Difference")">@if (diff.HasValue)
