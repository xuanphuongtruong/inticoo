                            </tr>
                            <tr><th colspan="3" style="text-align:left">@T("Common.Remark")</th></tr>
                            <tr><td colspan="3" style="text-align:left">@(string.IsNullOrWhiteSpace(_qcData?.ProductSpec?.GoldenRemark) ? "—" : _qcData.ProductSpec.GoldenRemark)</td></tr>
                        </tbody>
                    </table>
                    <div class="rpt-photo-grid-2">
                        @foreach (var _gu in _gpFirst)
                        {
                            <div class="rpt-photo-cell">
                                @if (!string.IsNullOrEmpty(_gu))
                                { <img src="@NormalizeUrl(_gu)" class="rpt-photo" alt="@T("InspectionReport.GoldenSamplePhoto")" loading="eager"/> }
                            </div>
