    }

    private string ResultBadge(string? r) => (r ?? "").ToUpper() switch
    {
        "PASSED" or "PASS" or "APPROVED" or "ACCEPTED" => "bg-success",
        "FAILED" or "FAIL" or "REJECTED"               => "bg-danger",
        "NA" or "N/A" or ""                            => "bg-secondary",
        _                                              => "bg-warning text-dark"
    };

