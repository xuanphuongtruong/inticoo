@page "/mail-test"
@using System.Net.Http.Json
@inject HttpClient Http
@inject IJSRuntime JS
@inherits LocalizedComponentBase

<PageTitle>@T("MailTest.MailTestInspectionNotification")</PageTitle>

<div class="container py-4">
    <div class="d-flex align-items-center mb-4">
        <h3 class="mb-0">@T("MailTest.TestMailNotification")</h3>
        <span class="badge bg-info ms-3">@T("MailTest.VendorCustomerWeeklyMail")</span>
    </div>

    @* ════════════════════════════════════════════════════════════ *@
    @* Section 1: Cấu hình SMTP hiện tại *@
    @* ════════════════════════════════════════════════════════════ *@
    <div class="card mb-4">
        <div class="card-header bg-light">
            <strong>@T("MailTest.N1CurrentSMTPSettings")</strong>
            <button class="btn btn-sm btn-outline-secondary float-end" @onclick="LoadSettingsAsync">
                @T("MailTest.Refresh")
            </button>
        </div>
        <div class="card-body">
            @if (settings is null)
            {
                <p class="text-muted mb-0">@T("Common.Loading")</p>
            }
            else
            {
                <div class="row g-2">
                    <div class="col-md-6">
                        <strong>@T("MailTest.SMTPHost")</strong> @settings.SmtpHost:@settings.SmtpPort
                    </div>
                    <div class="col-md-6">
                        <strong>@T("MailTest.Sender")</strong> @settings.SenderName &lt;@settings.SenderEmail&gt;
                    </div>
                    <div class="col-md-6">
                        <strong>@T("MailTest.SSL")</strong> @(settings.UseSsl ? "✅" : "❌")
                    </div>
                    <div class="col-md-6">
                        <strong>@T("MailTest.Password")</strong> @(settings.HasPassword ? T("MailTest.Configured") : T("MailTest.NOPasswordYet"))
                    </div>
                    <div class="col-md-6">
                        <strong>@T("MailTest.Schedule")</strong>
                        @T("MailTest.At00VietnamTime", GetDayName(settings.SendDayOfWeek), settings.SendHour)
                    </div>
                    <div class="col-md-6">
                        <strong>@T("MailTest.Job")</strong>
                        @if (settings.WeeklyJobEnabled)
                        {
                            <span class="badge bg-success">@T("MailTest.ENABLED")</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@T("MailTest.DISABLED")</span>
                        }
                    </div>
                    <div class="col-12">
                        <strong>@T("MailTest.NotifyAhead")</strong> @T("MailTest.Days", settings.LookAheadDays)
                    </div>
                </div>
            }
        </div>
    </div>

    @* ════════════════════════════════════════════════════════════ *@
    @* Section 2: Gửi email test *@
    @* ════════════════════════════════════════════════════════════ *@
    <div class="card mb-4">
        <div class="card-header bg-light">
            <strong>@T("MailTest.N2SendTestEmail")</strong>
        </div>
        <div class="card-body">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label">@T("MailTest.RecipientEmail")</label>
                    <input class="form-control" @bind="testEmail" placeholder="@T("MailTest.YourEmailExampleCom")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">@T("MailTest.TemplateType")</label>
                    <select class="form-select" @bind="testKind">
                        <option value="smtp">@T("MailTest.SMTPCheckEmptyEmail")</option>
                        <option value="vendor">@T("MailTest.VendorTemplateSampleData")</option>
                        <option value="customer">@T("MailTest.CustomerTemplateSampleData")</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">@T("MailTest.SubjectOptionalSMTPCheckOnly")</label>
                    <input class="form-control" @bind="testSubject" placeholder="@T("MailTest.Default")" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-primary w-100" @onclick="SendTestAsync" disabled="@busy1">
                        @(busy1 ? "Sending..." : T("MailTest.SendTest"))
                    </button>
                </div>
            </div>
            <div class="form-text mt-2">
                <strong>@T("MailTest.SMTPCheck")</strong>@T("MailTest.OnlyChecksConfiguration")
                <strong>@T("MailTest.VendorCustomer")</strong>@T("MailTest.SendsRealTemplateWithSampleData")
            </div>
            @if (!string.IsNullOrEmpty(test1Result))
            {
                <div class="alert @(test1Success ? "alert-success" : "alert-danger") mt-3 mb-0">
                    @test1Result
                </div>
            }
        </div>
    </div>

    @* ════════════════════════════════════════════════════════════ *@
    @* Section 3: Preview - vendor sẽ nhận mail kỳ tới *@
    @* ════════════════════════════════════════════════════════════ *@
    <div class="card mb-4">
        <div class="card-header bg-light">
            <strong>@T("MailTest.N3PreviewVendorsReceivingNextEmail")</strong>
            <button class="btn btn-sm btn-outline-secondary float-end" @onclick="LoadPreviewAsync">
                @T("MailTest.Refresh")
            </button>
        </div>
        <div class="card-body">
            @if (preview is null)
            {
                <p class="text-muted mb-0">@T("Common.Loading")</p>
            }
            else if (preview.Vendors is null || preview.Vendors.Count == 0)
            {
                <div class="alert alert-warning mb-0">
                    @T("MailTest.NoInspectionInNextDaysFrom", preview.LookAhead, preview.FromDate.ToString("dd/MM/yyyy"), preview.ToDate.ToString("dd/MM/yyyy"))
                </div>
            }
            else
            {
                <p class="text-muted">
                    @T("Common.Total") <strong>@preview.TotalInspections</strong> @T("MailTest.InspectionsFrom") <strong>@preview.Vendors.Count</strong> @T("MailTest.VendorsInNextDays", preview.LookAhead, preview.FromDate.ToString("dd/MM"), preview.ToDate.ToString("dd/MM"))
                </p>
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>@T("MailTest.VendorCode")</th>
                                <th>@T("Common.VendorName")</th>
                                <th>Email</th>
                                <th class="text-center">@T("MailTest.Inspection2")</th>
                                <th class="text-center">@T("Common.Status")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var v in preview.Vendors)
                            {
                                <tr>
                                    <td><code>@v.VendorCode</code></td>
                                    <td>@v.VendorName</td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(v.ContactEmail))
                                        {
                                            <span>@v.ContactEmail</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@T("MailTest.NoEmailYet")</span>
                                        }
                                    </td>
                                    <td class="text-center">@v.InspectionCount</td>
                                    <td class="text-center">
                                        @if (v.CanSend)
                                        {
                                            <span class="badge bg-success">@T("MailTest.WillSend")</span>
                                        }
                                        else if (!v.IsActive)
                                        {
                                            <span class="badge bg-secondary">@T("Common.Inactive")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@T("MailTest.MissingEmail")</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary"
                                                disabled="@(!v.CanSend || busy2)"
                                                @onclick="() => SendForVendorAsync(v.VendorCode)">
                                            @T("MailTest.Send")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ════════════════════════════════════════════════════════════ *@
    @* Section 4: Preview - customer sẽ nhận mail kỳ tới *@
    @* ════════════════════════════════════════════════════════════ *@
    <div class="card mb-4">
        <div class="card-header bg-light">
            <strong>@T("MailTest.N4PreviewCustomersReceivingNextEmail")</strong>
            <button class="btn btn-sm btn-outline-secondary float-end" @onclick="LoadCustomerPreviewAsync">
                @T("MailTest.Refresh")
            </button>
        </div>
        <div class="card-body">
            @if (customerPreview is null)
            {
                <p class="text-muted mb-0">@T("Common.Loading")</p>
            }
            else if (customerPreview.Customers is null || customerPreview.Customers.Count == 0)
            {
                <div class="alert alert-warning mb-0">
                    @T("MailTest.NoInspectionInNextDaysFrom", customerPreview.LookAhead, customerPreview.FromDate.ToString("dd/MM/yyyy"), customerPreview.ToDate.ToString("dd/MM/yyyy"))
                </div>
            }
            else
            {
                <p class="text-muted">
                    @T("Common.Total") <strong>@customerPreview.TotalInspections</strong> @T("MailTest.InspectionsFrom") <strong>@customerPreview.Customers.Count</strong> @T("MailTest.CustomersInNextDays", customerPreview.LookAhead, customerPreview.FromDate.ToString("dd/MM"), customerPreview.ToDate.ToString("dd/MM"))
                </p>
                <div class="table-responsive">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>@T("Common.CustomerID")</th>
                                <th>@T("Common.CustomerName")</th>
                                <th>@T("MailTest.EmailType")</th>
                                <th>@T("MailTest.Recipients2")</th>
                                <th class="text-center">@T("MailTest.Inspection2")</th>
                                <th class="text-center">@T("Common.Status")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in customerPreview.Customers)
                            {
                                <tr>
                                    <td><code>@c.CustomerId</code></td>
                                    <td>@c.CustomerName</td>
                                    <td>
                                        <span class="badge @(c.ReportEmailType == "Alternate" ? "bg-warning text-dark" : "bg-info")">
                                            @TE("Opt", c.ReportEmailType)
                                        </span>
                                    </td>
                                    <td>
                                        @if (c.Recipients is not null && c.Recipients.Count > 0)
                                        {
                                            @foreach (var r in c.Recipients)
                                            {
                                                <div><small>@r</small></div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-danger">@T("MailTest.NoEmailYet")</span>
                                        }
                                    </td>
                                    <td class="text-center">@c.InspectionCount</td>
                                    <td class="text-center">
                                        @if (c.CanSend)
                                        {
                                            <span class="badge bg-success">@T("MailTest.WillSend")</span>
                                        }
                                        else if (!c.IsActive)
                                        {
                                            <span class="badge bg-secondary">@T("Common.Inactive")</span>
                                        }
                                        else if (!c.ReceiveInspectionReport)
                                        {
                                            <span class="badge bg-secondary">@T("MailTest.ReportEmailsOff")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@T("MailTest.MissingEmail")</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary"
                                                disabled="@(!c.CanSend || busy4)"
                                                @onclick="() => SendForCustomerAsync(c.CustomerId)">
                                            @T("MailTest.Send")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ════════════════════════════════════════════════════════════ *@
    @* Section 5: Gửi report hoàn thành cho TỪNG inspection (giống nút Done) *@
    @* ════════════════════════════════════════════════════════════ *@
    <div class="card mb-4">
        <div class="card-header bg-light">
            <strong>@T("MailTest.N5SendReportEmailPerInspection")</strong>
            <button class="btn btn-sm btn-outline-secondary float-end" @onclick="LoadCompletedInspectionsAsync">
                @T("MailTest.Refresh")
            </button>
        </div>
        <div class="card-body">
            <p class="text-muted">
                @T("MailTest.Resend") <strong>@T("MailTest.InspectionReportCompleted")</strong> @T("MailTest.EmailWithReportDownloadLinkFor")
                <strong>@T("MailTest.Completed")</strong> @T("MailTest.InspectionsExactlyLikeAutomaticEmailWhen") <strong>@T("MailTest.Done")</strong>@T("MailTest.Recipients") <strong>@T("MailTest.To")</strong> @T("MailTest.CustomerEmail")
                <strong>@T("MailTest.CC")</strong> @T("MailTest.AlternateReportEmailExtraCCEmailEnteredBelow")
            </p>

            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-5">
                    <label class="form-label">@T("MailTest.ExtraCCEmailOptionalAppliedWhen")</label>
                    <input class="form-control" @bind="inspExtraCc"
                           placeholder="@T("MailTest.VdCtyComBCtyCom")" />
                </div>
                <div class="col-md-5">
                    <label class="form-label">@T("MailTest.SearchJobCustomerVendorProduct")</label>
                    <input class="form-control" @bind="inspSearch" placeholder="@T("MailTest.EnterKeyword")" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-primary w-100" @onclick="LoadCompletedInspectionsAsync">
                        @T("Common.Search")
                    </button>
                </div>
            </div>

            @if (completedInspections is null)
            {
                <p class="text-muted mb-0">@T("Common.Loading")</p>
            }
            else if (completedInspections.Count == 0)
            {
                <div class="alert alert-warning mb-0">@T("MailTest.NoCompletedInspectionMatches")</div>
            }
            else
            {
                <p class="text-muted">@T("MailTest.Found") <strong>@completedInspections.Count</strong> @T("MailTest.CompletedInspections")</p>
                <div class="table-responsive">
                    <table class="table table-sm table-striped align-middle">
                        <thead>
                            <tr>
                                <th>@T("Common.JobNumber")</th>
                                <th>@T("Common.Completed")</th>
                                <th>@T("Common.Customer")</th>
                                <th>@T("Common.Vendor")</th>
                                <th>@T("Common.Product")</th>
                                <th class="text-center">@T("Common.Result")</th>
                                <th>@T("MailTest.CustomerEmailTo")</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ins in completedInspections)
                            {
                                <tr>
                                    <td><code>@ins.JobNumber</code></td>
                                    <td>@(ins.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</td>
                                    <td>@ins.CustomerName</td>
                                    <td>@ins.VendorName</td>
                                    <td>@ins.ProductName</td>
                                    <td class="text-center">
                                        <span class="badge @ResultBadge(ins.FinalResult)">@(ins.FinalResult ?? "N/A")</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(ins.CustomerEmail))
                                        {
                                            <small>@ins.CustomerEmail</small>
                                        }
                                        else
                                        {
                                            <span class="text-danger">@T("MailTest.NoEmailYet")</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-success"
                                                disabled="@(!ins.CanSend || busy6)"
                                                @onclick="() => SendForInspectionAsync(ins.Id, ins.JobNumber)">
                                            @T("MailTest.Send")
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ════════════════════════════════════════════════════════════ *@
    @* Section 6: Trigger thủ công job hàng tuần *@
    @* ════════════════════════════════════════════════════════════ *@
    <div class="card mb-4 border-warning">
        <div class="card-header bg-warning text-dark">
            <strong>@T("MailTest.N6ManualTriggerBULKEmail")</strong>
        </div>
        <div class="card-body">
            <p class="text-muted">
                @T("MailTest.AutomaticScheduleRuns")
                <strong>@T("MailTest.At00", GetDayName(settings?.SendDayOfWeek ?? 5), settings?.SendHour ?? 18)</strong> @T("MailTest.WeeklyForBothVendorsAndCustomers")
            </p>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-warning" @onclick="RunWeeklyVendorAsync" disabled="@busy3">
                    @if (busy3)
                    {
                        <span><span class="spinner-border spinner-border-sm me-2"></span>@T("MailTest.SendingToVendors")</span>
                    }
                    else
                    {
                        <span>@T("MailTest.RunVENDORJobNow")</span>
                    }
                </button>
                <button class="btn btn-warning" @onclick="RunWeeklyCustomerAsync" disabled="@busy5">
                    @if (busy5)
                    {
                        <span><span class="spinner-border spinner-border-sm me-2"></span>@T("MailTest.SendingToCustomers")</span>
                    }
                    else
                    {
                        <span>@T("MailTest.RunCUSTOMERJobNow")</span>
                    }
                </button>
            </div>

            @if (lastRunResult is not null)
            {
                <div class="alert alert-info mt-3 mb-0">
                    <strong>@T("MailTest.Result", lastRunLabel)</strong>
                    @T("MailTest.Total") <strong>@lastRunResult.VendorsTotal</strong>@T("MailTest.Sent") <strong class="text-success">@lastRunResult.VendorsSent</strong>@T("MailTest.Skipped") <strong class="text-warning">@lastRunResult.VendorsSkipped</strong>@T("MailTest.Failed") <strong class="text-danger">@lastRunResult.VendorsFailed</strong>@T("MailTest.Inspection") <strong>@lastRunResult.InspectionsTotal</strong>
                    @if (lastRunResult.Errors is not null && lastRunResult.Errors.Count > 0)
                    {
                        <div class="mt-2">
                            <strong>@T("MailTest.Errors")</strong>
                            <ul class="mb-0">
                                @foreach (var err in lastRunResult.Errors)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @* ════════════════════════════════════════════════════════════ *@
    @* Section 7: Lịch sử gửi mail *@
    @* ════════════════════════════════════════════════════════════ *@
    <div class="card mb-4">
        <div class="card-header bg-light">
            <strong>@T("MailTest.N7EmailHistoryLatest50")</strong>
            <button class="btn btn-sm btn-outline-secondary float-end" @onclick="LoadLogsAsync">
                @T("MailTest.Refresh")
            </button>
        </div>
        <div class="card-body">
            @if (logs is null)
            {
                <p class="text-muted mb-0">@T("Common.Loading")</p>
            }
            else if (logs.Count == 0)
            {
                <p class="text-muted mb-0">@T("MailTest.NoEmailLogYet")</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>@T("MailTest.Time")</th>
                                <th>@T("MailTest.TypeCode")</th>
                                <th>@T("MailTest.RecipientEmail")</th>
                                <th>@T("MailTest.Subject")</th>
                                <th class="text-center">@T("MailTest.Insp")</th>
                                <th class="text-center">@T("Common.Status")</th>
                                <th>@T("MailTest.Error")</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in logs)
                            {
                                <tr class="@(l.IsSuccess ? "" : "table-danger")">
                                    <td>@l.SentAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @{
                                            var code = l.VendorCode ?? "";
                                            string badge = "bg-secondary";
                                            string label = code;
                                            if (code.StartsWith("CUS:"))      { badge = "bg-info"; label = T("Common.Customer"); }
                                            else if (code.StartsWith("INS:")) { badge = "bg-dark"; label = T("MailTest.ReportDone"); }
                                            else if (code == "TEST-VENDOR")    { badge = "bg-primary"; label = T("MailTest.TestVendor"); }
                                            else if (code == "TEST-CUSTOMER")  { badge = "bg-primary"; label = T("MailTest.TestCustomer"); }
                                            else if (code == "TEST")           { badge = "bg-secondary"; label = T("MailTest.SMTPTest2"); }
                                            else if (!string.IsNullOrEmpty(code)) { badge = "bg-success"; label = T("Common.Vendor"); }
                                        }
                                        <span class="badge @badge">@label</span>
                                        <code class="ms-1"><small>@l.VendorCode</small></code>
                                    </td>
                                    <td><small>@l.ToEmail</small></td>
                                    <td><small>@l.Subject</small></td>
                                    <td class="text-center">@l.InspectionCount</td>
                                    <td class="text-center">
                                        @if (l.IsSuccess)
                                        {
                                            <span class="badge bg-success">@T("MailTest.OK")</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">@T("MailTest.FAIL")</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(l.ErrorMessage))
                                        {
                                            <small class="text-danger">@l.ErrorMessage</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>


@code {
    // Settings
    private MailSettings? settings;

    // Section 2: Send test email
    private string testEmail   = "";
    private string testSubject = "";
    private string testKind    = "smtp"; // smtp | vendor | customer
    private bool   busy1       = false;
    private bool   test1Success = false;
    private string? test1Result;

    // Section 3: Vendor preview
    private UpcomingPreview? preview;
    private bool busy2 = false;

    // Section 4: Customer preview
    private UpcomingCustomerPreview? customerPreview;
    private bool busy4 = false;

    // Section 5: Completed inspections (gửi report giống nút Done)
    private List<CompletedInspectionDto>? completedInspections;
    private bool   busy6       = false;
    private string inspExtraCc = "";
    private string inspSearch  = "";

    // Section 6: Run weekly
    private bool busy3 = false;   // vendor
    private bool busy5 = false;   // customer
    private MailRunResult? lastRunResult;
    private string lastRunLabel = "";

    // Section 7: Logs
    private List<MailLogDto>? logs;

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(
            LoadSettingsAsync(),
            LoadPreviewAsync(),
            LoadCustomerPreviewAsync(),
            LoadCompletedInspectionsAsync(),
            LoadLogsAsync()
        );
    }

    // ─────────────────────────────────────────────────────────
    private async Task LoadSettingsAsync()
    {
        try { settings = await Http.GetFromJsonAsync<MailSettings>("api/mail/settings"); }
        catch (Exception ex) { await JS.InvokeVoidAsync("console.error", ex.Message); }
    }

    private async Task LoadPreviewAsync()
    {
        try { preview = await Http.GetFromJsonAsync<UpcomingPreview>("api/mail/upcoming-vendors"); }
        catch (Exception ex) { await JS.InvokeVoidAsync("console.error", ex.Message); }
    }

    private async Task LoadCustomerPreviewAsync()
    {
        try { customerPreview = await Http.GetFromJsonAsync<UpcomingCustomerPreview>("api/mail/upcoming-customers"); }
        catch (Exception ex) { await JS.InvokeVoidAsync("console.error", ex.Message); }
    }

    private async Task LoadLogsAsync()
    {
        try { logs = await Http.GetFromJsonAsync<List<MailLogDto>>("api/mail/logs?take=50"); }
        catch (Exception ex) { await JS.InvokeVoidAsync("console.error", ex.Message); }
    }

    // ─────────────────────────────────────────────────────────
    private async Task SendTestAsync()
    {
        if (string.IsNullOrWhiteSpace(testEmail))
        {
            test1Result  = T("MailTest.PleaseEnterRecipientEmail");
            test1Success = false;
            return;
        }

        busy1 = true;
        test1Result = null;
        try
        {
            var url = testKind switch
            {
                "vendor"   => "api/mail/send-test-vendor",
                "customer" => "api/mail/send-test-customer",
                _          => "api/mail/send-test"
            };

            var payload = testKind == "smtp"
                ? (object)new { ToEmail = testEmail, Subject = string.IsNullOrWhiteSpace(testSubject) ? null : testSubject }
                : new { ToEmail = testEmail };

            var res = await Http.PostAsJsonAsync(url, payload);

            if (res.IsSuccessStatusCode)
            {
                test1Success = true;
                var label = testKind switch
                {
                    "vendor"   => T("MailTest.TemplateVendor"),
                    "customer" => T("MailTest.TemplateCustomer"),
                    _          => T("MailTest.SMTPTest")
                };
                test1Result = T("MailTest.EmailSentToPleaseCheckYour", label, testEmail);
            }
            else
            {
                test1Success = false;
                var body = await res.Content.ReadAsStringAsync();
                test1Result = T("MailTest.Error2", body);
            }
            await LoadLogsAsync();
        }
        catch (Exception ex)
        {
            test1Success = false;
            test1Result  = T("MailTest.Exception", ex.Message);
        }
        finally { busy1 = false; }
    }

