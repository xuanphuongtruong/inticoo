    // ───────────── Section 5: Completed inspections ─────────────
    private async Task LoadCompletedInspectionsAsync()
    {
        try
        {
            var url = "api/mail/completed-inspections?take=200";
            if (!string.IsNullOrWhiteSpace(inspSearch))
                url += $"&search={Uri.EscapeDataString(inspSearch.Trim())}";

            var res = await Http.GetFromJsonAsync<CompletedInspectionResponse>(url);
            completedInspections = res?.Items ?? new();
        }
        catch (Exception ex) { await JS.InvokeVoidAsync("console.error", ex.Message); }
    }

    private async Task SendForInspectionAsync(int id, string? jobNumber)
    {
        var ccNote = string.IsNullOrWhiteSpace(inspExtraCc) ? "" : T("MailTest.ExtraCC", inspExtraCc);
        if (!await JS.InvokeAsync<bool>("confirm",
            T("MailTest.SendReportEmailForInspection", jobNumber, id, ccNote))) return;

        busy6 = true;
        try
        {
            var res  = await Http.PostAsJsonAsync($"api/mail/send-inspection/{id}",
                new { extraCc = inspExtraCc });
            var json = await res.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert",
                res.IsSuccessStatusCode
                    ? T("MailTest.ReportSentForInspection", jobNumber)
                    : T("MailTest.Error2", json));
            await LoadLogsAsync();
