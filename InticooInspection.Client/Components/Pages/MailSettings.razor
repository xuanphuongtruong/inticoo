@page "/mail-settings"
@using Microsoft.AspNetCore.Authorization
@using System.Net.Http.Json
@using System.Net.Http.Headers
@attribute [Authorize]
@inject HttpClient Http
@inject Blazored.SessionStorage.ISessionStorageService SessionStorage
@inject IJSRuntime JS
@inherits LocalizedComponentBase

<PageTitle>@T("MailSettings.MailSettings2")</PageTitle>

<div class="container py-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="mb-0">@T("MailSettings.MailSettings")</h3>
        @if (model is not null)
        {
            <span class="badge @(model.FromDatabase ? "bg-success" : "bg-warning text-dark")">
                @(model.FromDatabase ? T("MailSettings.FromDatabase") : T("MailSettings.FromEnvironmentVariables"))
            </span>
        }
    </div>

    @if (model is null)
    {
        <div class="card"><div class="card-body">@T("Common.Loading")</div></div>
    }
    else
    {
        <EditForm Model="model" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            @* ═════════════════════ SMTP CONFIG ═════════════════════ *@
            <div class="card mb-3">
                <div class="card-header bg-light"><strong>@T("MailSettings.SMTPServer")</strong></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label">@T("MailSettings.SMTPHost")</label>
                            <input class="form-control" @bind="model.SmtpHost" placeholder="smtp.office365.com" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@T("MailSettings.Port")</label>
                            <input type="number" class="form-control" @bind="model.SmtpPort" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input type="checkbox" class="form-check-input" id="useSsl" @bind="model.UseSsl" />
                                <label class="form-check-label" for="useSsl">@T("MailSettings.UseSSLTLS")</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ═════════════════════ SENDER INFO ═════════════════════ *@
            <div class="card mb-3">
                <div class="card-header bg-light"><strong>@T("MailSettings.SenderInformation")</strong></div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">@T("MailSettings.SenderEmail")</label>
                            <input class="form-control" @bind="model.SenderEmail" placeholder="@T("MailSettings.NoReplyInticooCom")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("MailSettings.SenderNameDisplay")</label>
                            <input class="form-control" @bind="model.SenderName" placeholder="Inticoo Inspection" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("MailSettings.SMTPUsername")</label>
                            <input class="form-control" @bind="model.Username" placeholder="@T("MailSettings.NoReplyInticooCom")" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">@T("MailSettings.Password")</label>
                            <div class="form-control bg-light text-muted">
                                @if (model.HasPassword)
                                {
                                    <span>@T("MailSettings.ConfiguredInAzureEnvironmentVariable")</span>
                                }
                                else
                                {
                                    <span class="text-danger">@T("MailSettings.NOTConfiguredGoToAzureApp")</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ═════════════════════ SCHEDULE ═════════════════════ *@
            <div class="card mb-3">
                <div class="card-header bg-light"><strong>@T("MailSettings.AutomaticSendSchedule")</strong></div>
                <div class="card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="form-label">@T("MailSettings.DayOfWeek")</label>
                            <select class="form-select" @bind="model.SendDayOfWeek">
                                <option value="0">@T("MailSettings.Sunday")</option>
                                <option value="1">@T("MailSettings.Monday")</option>
                                <option value="2">@T("MailSettings.Tuesday")</option>
                                <option value="3">@T("MailSettings.Wednesday")</option>
                                <option value="4">@T("MailSettings.Thursday")</option>
                                <option value="5">@T("MailSettings.Friday")</option>
                                <option value="6">@T("MailSettings.Saturday")</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@T("MailSettings.Hour023")</label>
                            <input type="number" min="0" max="23" class="form-control" @bind="model.SendHour" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@T("MailSettings.Minute059")</label>
                            <input type="number" min="0" max="59" class="form-control" @bind="model.SendMinute" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">@T("MailSettings.NotifyAhead")</label>
                            <div class="input-group">
                                <input type="number" min="1" max="60" class="form-control" @bind="model.LookAheadDays" />
                                <span class="input-group-text">@T("MailSettings.Days")</span>
                            </div>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check form-switch mb-2">
                                <input type="checkbox" class="form-check-input" id="enabled" @bind="model.WeeklyJobEnabled" />
                                <label class="form-check-label" for="enabled">
                                    @if (model.WeeklyJobEnabled)
                                    {
                                        <strong class="text-success">@T("MailSettings.ENABLED")</strong>
                                    }
                                    else
                                    {
                                        <strong class="text-secondary">@T("MailSettings.DISABLED")</strong>
                                    }
                                </label>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-info mt-3 mb-0 small">
                        @T("MailSettings.JobRunsEvery") <strong>@GetDayName(model.SendDayOfWeek) @model.SendHour.ToString("D2"):@model.SendMinute.ToString("D2") @T("MailSettings.VietnamTime")</strong> @T("MailSettings.WeeklyNotifyingInspectionsIn") <strong>@T("MailSettings.NextNDays", model.LookAheadDays)</strong>.
                    </div>
                </div>
            </div>

            @* ═════════════════════ AUDIT INFO ═════════════════════ *@
            @if (model.UpdatedAt.HasValue)
            {
                <div class="alert alert-secondary small mb-3">
                    @T("MailSettings.LastUpdated") <strong>@model.UpdatedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                    @T("MailSettings.By") <strong>@(model.UpdatedBy ?? "system")</strong>
                </div>
            }

            @* ═════════════════════ ACTIONS ═════════════════════ *@
            <div class="d-flex gap-2 flex-wrap mb-4">
                <button type="submit" class="btn btn-primary" disabled="@busy">
                    @if (busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    @T("MailSettings.Save")
                </button>
                <button type="button" class="btn btn-outline-secondary" @onclick="LoadAsync" disabled="@busy">
                    @T("MailSettings.Reload")
                </button>
                <button type="button" class="btn btn-outline-danger ms-auto" @onclick="ResetToEnvAsync" disabled="@busy">
                    @T("MailSettings.ClearDBSettingsUseEnvVar")
                </button>
            </div>

            @if (!string.IsNullOrEmpty(saveResult))
            {
                <div class="alert @(saveSuccess ? "alert-success" : "alert-danger")">
                    @saveResult
                </div>
            }
        </EditForm>

        @* ═════════════════════ TEST SMTP ═════════════════════ *@
        <div class="card mt-4">
            <div class="card-header bg-light"><strong>@T("MailSettings.TestSMTP")</strong></div>
            <div class="card-body">
                <p class="text-muted small">
                    @T("MailSettings.SendTestEmailWithCURRENTSettings")
                </p>
                <div class="row g-2 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">@T("MailSettings.RecipientEmail")</label>
                        <input class="form-control" @bind="testEmail" placeholder="@T("MailSettings.YourEmailGmailCom")" />
                    </div>
                    <div class="col-md-3">
                        <button class="btn btn-warning w-100" @onclick="TestSmtpAsync" disabled="@(busyTest || string.IsNullOrWhiteSpace(testEmail))">
                            @if (busyTest) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            @T("MailSettings.SendTest")
                        </button>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(testResult))
                {
                    <div class="alert @(testSuccess ? "alert-success" : "alert-danger") mt-3 mb-0">
                        @testResult
                    </div>
                }
            </div>
        </div>
    }
</div>


@code {
    private MailSettingsDto? model;
    private bool busy = false;
    private bool saveSuccess = false;
    private string? saveResult;

    private string testEmail = "";
    private bool busyTest = false;
    private bool testSuccess = false;
    private string? testResult;

    protected override async Task OnInitializedAsync()
    {
        await SetAuthHeader();
        await LoadAsync();
    }

    /// <summary>
    /// Đọc JWT từ SessionStorage và gắn vào header. Pattern này được dùng
    /// nhất quán trong các page khác (Vendors.razor, Inspections.razor...).
    /// </summary>
    private async Task SetAuthHeader()
    {
        try
        {
            var token = await SessionStorage.GetItemAsync<string>("auth_token");
            if (!string.IsNullOrEmpty(token))
                Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
        }
        catch { }
    }

    private async Task LoadAsync()
    {
        try
        {
            await SetAuthHeader();
            model = await Http.GetFromJsonAsync<MailSettingsDto>("api/mail-settings");
            saveResult = null;
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", T("MailSettings.FailedToLoadSettings") + ex.Message);
        }
    }

    private async Task SaveAsync()
    {
        if (model is null) return;

        busy = true;
        saveResult = null;
        try
        {
            await SetAuthHeader();
            var res = await Http.PutAsJsonAsync("api/mail-settings", model);
            if (res.IsSuccessStatusCode)
            {
                saveSuccess = true;
                saveResult = T("MailSettings.SettingsSavedEffectiveImmediatelyWorkerReloads");
                await LoadAsync();   // reload để thấy FromDatabase = true
            }
            else
            {
                saveSuccess = false;
                var body = await res.Content.ReadAsStringAsync();
                saveResult = T("MailSettings.Error") + body;
            }
        }
        catch (Exception ex)
        {
            saveSuccess = false;
            saveResult = T("MailSettings.Exception") + ex.Message;
        }
        finally { busy = false; }
    }

    private async Task TestSmtpAsync()
    {
        busyTest = true;
        testResult = null;
        try
        {
            await SetAuthHeader();
            var res = await Http.PostAsJsonAsync("api/mail-settings/test-smtp",
                new { ToEmail = testEmail });

            if (res.IsSuccessStatusCode)
            {
                testSuccess = true;
                testResult = T("MailSettings.TestEmailSentToCheckYour", testEmail);
            }
            else
            {
                testSuccess = false;
                var body = await res.Content.ReadAsStringAsync();
                testResult = T("MailSettings.Error") + body;
            }
        }
        catch (Exception ex)
        {
            testSuccess = false;
            testResult = T("MailSettings.Exception") + ex.Message;
        }
        finally { busyTest = false; }
    }

    private async Task ResetToEnvAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm",
            T("MailSettings.ClearDBSettingsAppWillFall"))) return;

        busy = true;
        try
        {
            await SetAuthHeader();
            var res = await Http.PostAsync("api/mail-settings/reset-to-env", null);
            if (res.IsSuccessStatusCode)
            {
                saveSuccess = true;
                saveResult = T("MailSettings.DBSettingsClearedAppIsNow");
                await LoadAsync();
            }
        }
        catch (Exception ex)
        {
            saveResult = "❌ " + ex.Message;
        }
        finally { busy = false; }
    }

    private string GetDayName(int day) => day switch
    {
        0 => T("MailSettings.Sunday"),
        1 => T("MailSettings.Monday"),
        2 => T("MailSettings.Tuesday"),
        3 => T("MailSettings.Wednesday"),
        4 => T("MailSettings.Thursday"),
        5 => T("MailSettings.Friday"),
        6 => T("MailSettings.Saturday"),
        _ => "?"
    };

    public class MailSettingsDto
    {
        public string SmtpHost    { get; set; } = "";
        public int    SmtpPort    { get; set; } = 587;
        public bool   UseSsl      { get; set; } = true;
        public string SenderEmail { get; set; } = "";
        public string SenderName  { get; set; } = "";
        public string Username    { get; set; } = "";

        public int  LookAheadDays    { get; set; } = 7;
        public int  SendDayOfWeek    { get; set; } = 5;
        public int  SendHour         { get; set; } = 18;
        public int  SendMinute       { get; set; } = 0;
        public bool WeeklyJobEnabled { get; set; } = true;

        public DateTime? UpdatedAt    { get; set; }
        public string?   UpdatedBy    { get; set; }
        public bool      FromDatabase { get; set; }
        public bool      HasPassword  { get; set; }
    }
}
