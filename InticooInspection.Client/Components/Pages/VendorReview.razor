@page "/vendor-reviews/{VendorCode}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using InticooInspection.Client.Services
@inject HttpClient Http
@inject NavigationManager Navigation
@inject PageAccessService PageAccess
@inherits LocalizedComponentBase

<PageTitle>@T("VendorReview.VendorReviewInticoo")</PageTitle>

@if (_loading)
{
    <div class="rv-loading"><div class="rv-spinner"></div> @T("Common.Loading")</div>
}
else if (_error != null)
{
    <div class="rv-error">⚠ @_error <button @onclick="Load">@T("Common.Retry")</button></div>
}
else if (_data != null)
{
<div class="rv-page">

    <!-- ── Header ── -->
    <div class="rv-header">
        <button class="rv-back no-print" @onclick="@(() => Navigation.NavigateTo("/vendor-reviews"))">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 4l-6 6 6 6" stroke-linecap="round"/></svg>
        </button>
        <div class="rv-header-center">
            <h1 class="rv-title">@T("VendorReview.VendorPerformanceOverview")</h1>
            <p class="rv-sub">@T("VendorReview.VendorQualityMetricsInspectionResults")</p>
        </div>
        <div class="rv-controls">
            <span class="print-only rv-print-period">@MonthName(_month) @_year</span>
            <PrintReportButton />
            <select class="rv-select" value="@_month" @onchange="OnMonthChange">
                @for(int m = 1; m <= 12; m++)
                {
                    var mn = m;
                    <option value="@mn">@L.MonthName(mn)</option>
                }
            </select>
            <select class="rv-select" value="@_year" @onchange="OnYearChange">
                @for(int y = DateTime.Now.Year; y >= DateTime.Now.Year - 5; y--)
                {
                    var yn = y;
                    <option value="@yn">@yn</option>
                }
            </select>
        </div>
    </div>

    <!-- ── Vendor Info bar ── -->
    <div class="rv-infobar">
        <!-- <div class="rv-infobar-field"> -->
        <div>
            <span class="rv-infobar-lbl">@T("VendorReview.VendorName")</span>
            <span class="rv-infobar-val">@_data.VendorName</span>
        </div>
        <!-- <div class="rv-infobar-field"> -->
        <div>
            <span class="rv-infobar-lbl">@T("VendorReview.VendorID")</span>
            <span class="rv-infobar-val">@_data.VendorId</span>
        </div>
    </div>

    <!-- ── KPI cards (năm đang chọn) ── -->
    <div class="rv-kpis">
        @foreach (var (lbl, val, col) in new[] {
            (T("InspectorReview.TotalInspection"), _data.Year.Total, "#1d4ed8"),
            (T("InspectorReview.PpiInspections"),  _data.Year.Ppt,   "#3b82f6"),
            (T("InspectorReview.DpiInspections"),  _data.Year.Dpi,   "#f59e0b"),
            (T("InspectorReview.PsiInspections"),  _data.Year.Pst,   "#dc2626"),
            (T("InspectorReview.ClcInspections"),  _data.Year.Clc,   "#8b5cf6") })
        {
            <div class="rv-kpi" style="border-top-color:@col">
                <div class="rv-kpi-l">@lbl</div>
                <div class="rv-kpi-v">@val.ToString("N0")</div>
                <div class="rv-kpi-s">@T("InspectorReview.NewThisYear")</div>
            </div>
        }
    </div>

    <!-- ── Total Shipment Quantity (theo sản phẩm × tháng) ── -->
    <div class="rv-sec print-avoid-break">
    <div class="rv-section-title">@T("Common.TotalShipmentQuantity") <span class="rv-section-sub">@T("VendorReview.YearCompletedPreShipmentInspections", _data.TargetYear)</span></div>
    <div class="rv-card rv-table-card print-avoid-break">
        <table class="rv-tbl rv-tbl-ship">
            <thead>
                <tr>
                    <th>No</th><th class="tl">@T("Common.ProductName")</th><th>@T("Common.ProductCode")</th>
                    @foreach (var mn in StackedBars.MonthLabels) { <th>@mn</th> }
                    <th>@T("Common.Total")</th>
                </tr>
            </thead>
            <tbody>
                @if (!_data.ShipmentByProduct.Any())
                {
                    <tr><td colspan="16" class="rv-empty">@T("VendorReview.NoShipmentIn", _data.TargetYear)</td></tr>
                }
                @for (int i = 0; i < _data.ShipmentByProduct.Count; i++)
                {
                    var r = _data.ShipmentByProduct[i];
                    <tr>
                        <td>@(i + 1)</td>
                        <td class="tl">@r.ProductName</td>
                        <td>@(r.ProductCode ?? "—")</td>
                        @foreach (var q in r.Months) { <td>@(q > 0 ? q.ToString("N0") : "")</td> }
                        <td class="fw">@r.Total.ToString("N0")</td>
                    </tr>
                }
            </tbody>
            @if (_data.ShipmentByProduct.Any())
            {
                <tfoot>
                    <tr>
                        <td colspan="3" class="tl">@T("Common.Total")</td>
                        @foreach (var q in _data.ShipmentMonthTotals) { <td>@(q > 0 ? q.ToString("N0") : "")</td> }
                        <td>@_data.ShipmentTotal.ToString("N0")</td>
                    </tr>
                </tfoot>
            }
        </table>
    </div>
    </div>

    <!-- ── Row 1: Inspection Results + Defect Breakdown (THIS MONTH) ── -->
    <div class="rv-row rv-row-eq print-avoid-break">
        <div style="flex:1;min-width:0;">
            <div class="rv-section-title">@T("Common.InspectionResults") <span class="rv-section-sub">(@MonthName(_data.TargetMonth) @_data.TargetYear)</span></div>
            @ResultCard(_data.Month)
        </div>
        <div style="flex:1;min-width:0;">
            <div class="rv-section-title">@T("VendorReview.DefectBreakdown") <span class="rv-section-sub">(@MonthName(_data.TargetMonth) @_data.TargetYear)</span></div>
            @DefectCard(_data.Month)
        </div>
    </div>

    <!-- ── Monthly Bar Chart ── -->
    <div class="rv-sec print-avoid-break">
    <div class="rv-section-title">@T("VendorReview.TotalInspectionMonthly", _data.TargetYear)</div>
    <div class="rv-card" style="padding:24px 20px;">
        <StackedBars Labels="StackedBars.MonthLabels" Height="170"
                     Series="@(new() {
                         new(T("VendorReview.PreProductionInspection"),    "#1d4ed8", _data.MonthlyData.OrderBy(m => m.Month).Select(m => m.Ppt).ToList()),
                         new(T("VendorReview.DuringProductionInspection"), "#f59e0b", _data.MonthlyData.OrderBy(m => m.Month).Select(m => m.Dpi).ToList()),
                         new(T("VendorReview.PreShipmentInspection"),      "#dc2626", _data.MonthlyData.OrderBy(m => m.Month).Select(m => m.Pst).ToList()),
                         new(T("VendorReview.ContainerLoadingCheck"),      "#8b5cf6", _data.MonthlyData.OrderBy(m => m.Month).Select(m => m.Clc).ToList()) })" />
    </div>
    </div>

    <!-- ── Yearly Horizontal Bar ── -->
    <div class="rv-sec print-avoid-break">
    <div class="rv-section-title">@T("VendorReview.TotalInspectionForYear", _data.TargetYear) <span class="rv-section-sub">@T("VendorReview.Total", _data.Year.Total)</span></div>
    <div class="rv-card print-avoid-break" style="padding:24px 20px;">
        @{ var maxYear = Math.Max(1, Math.Max(Math.Max(_data.Year.Ppt, _data.Year.Clc), Math.Max(_data.Year.Dpi, _data.Year.Pst))); }
        <div class="rv-hbar-row">
            <span class="rv-hbar-lbl">@T("VendorReview.PreShipmentInspection")</span>
            <div class="rv-hbar-track"><div class="rv-hbar-fill" style="width:@Pc(_data.Year.Pst, maxYear)%;background:#dc2626;"></div></div>
            <span class="rv-hbar-val">@_data.Year.Pst</span>
        </div>
        <div class="rv-hbar-row">
            <span class="rv-hbar-lbl">@T("VendorReview.DuringProductionInspection")</span>
            <div class="rv-hbar-track"><div class="rv-hbar-fill" style="width:@Pc(_data.Year.Dpi, maxYear)%;background:#f59e0b;"></div></div>
            <span class="rv-hbar-val">@_data.Year.Dpi</span>
        </div>
        <div class="rv-hbar-row">
            <span class="rv-hbar-lbl">@T("VendorReview.PreProductionInspection")</span>
            <div class="rv-hbar-track"><div class="rv-hbar-fill" style="width:@Pc(_data.Year.Ppt, maxYear)%;background:#1d4ed8;"></div></div>
            <span class="rv-hbar-val">@_data.Year.Ppt</span>
        </div>
        <div class="rv-hbar-row">
            <span class="rv-hbar-lbl">@T("VendorReview.ContainerLoadingCheck")</span>
            <div class="rv-hbar-track"><div class="rv-hbar-fill" style="width:@Pc(_data.Year.Clc, maxYear)%;background:#8b5cf6;"></div></div>
            <span class="rv-hbar-val">@_data.Year.Clc</span>
        </div>
    </div>
    </div>

    <!-- ── Row 2: Year Pass/Fail + Year Defects ── -->
    <div class="rv-row rv-row-eq print-avoid-break">
        <div style="flex:1;min-width:0;">
            <div class="rv-section-title">@T("VendorReview.InspectionResultYear", _data.TargetYear)</div>
            @ResultCard(_data.Year)
        </div>
        <div style="flex:1;min-width:0;">
            <div class="rv-section-title">@T("VendorReview.DefectBreakdownYear", _data.TargetYear)</div>
            @DefectCard(_data.Year)
        </div>
    </div>

    <!-- ── Vendor Monthly Defect Performance ── -->
    <div class="rv-sec print-avoid-break">
    <div class="rv-section-title">@T("VendorReview.VendorMonthlyDefectPerformance", _data.TargetYear)</div>
    <div class="rv-card rv-table-card">
        <table class="rv-tbl">
            <thead>
                <tr><th class="tl">@T("VendorReview.Month")</th><th>@T("VendorReview.ShipmentQuantity")</th><th>@T("VendorReview.AQLQty")</th><th>@T("VendorReview.DefectQty")</th><th>@T("VendorReview.DefectRate2")</th><th class="tl">@T("VendorReview.TopDefect")</th></tr>
            </thead>
            <tbody>
                @foreach (var m in _data.MonthlyDefect)
                {
                    var has = m.Inspections > 0;
                    <tr class="@(has ? "" : "rv-muted-row")">
                        <td class="tl">@StackedBars.MonthLabels[m.Month - 1]</td>
                        <td>@(has ? m.ShipmentQty.ToString("N0") : "—")</td>
                        <td>@(has ? m.AqlQty.ToString("N0") : "—")</td>
                        <td>@(has ? m.DefectQty.ToString("N0") : "—")</td>
                        <td>@(has ? $"{m.DefectRate:0.00}%" : "—")</td>
                        <td class="tl">@(m.TopDefect ?? "—")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                @{
                    var tAql = _data.MonthlyDefect.Sum(x => x.AqlQty);
                    var tDef = _data.MonthlyDefect.Sum(x => x.DefectQty);
                }
                <tr>
                    <td class="tl">@T("Common.Total")</td>
                    <td>@_data.MonthlyDefect.Sum(x => x.ShipmentQty).ToString("N0")</td>
                    <td>@tAql.ToString("N0")</td>
                    <td>@tDef.ToString("N0")</td>
                    <td>@(tAql > 0 ? $"{(double)tDef / tAql * 100:0.00}%" : "—")</td>
                    <td class="tl">@(_data.AnnualDefects.Where(d => d.Qty > 0).OrderByDescending(d => d.Qty).Select(d => $"{d.Code} {d.Name}").FirstOrDefault() ?? "—")</td>
                </tr>
            </tfoot>
        </table>
        <div class="rv-note">@T("VendorReview.DefectRateDefectQtyAQLQty")</div>
    </div>
    </div>

    <div class="rv-row rv-row-annual">
        <!-- ── Annual Defect Breakdown ── -->
        <div class="print-avoid-break" style="flex:1;min-width:0;">
            <div class="rv-section-title">@T("VendorReview.AnnualDefectBreakdown", _data.TargetYear)</div>
            <div class="rv-card rv-table-card print-avoid-break">
                <table class="rv-tbl">
                    <thead><tr><th class="tl">@T("Common.DefectType")</th><th>@T("VendorReview.Qty")</th><th>@T("VendorReview.OfTotalDefects")</th></tr></thead>
                    <tbody>
                        @foreach (var d in _data.AnnualDefects)
                        {
                            <tr class="@(d.Qty > 0 ? "" : "rv-muted-row")">
                                <td class="tl">@(d.Code == "OTH" ? T("VendorReview.Other") : $"{d.Code} {d.Name}")</td>
                                <td>@d.Qty</td>
                                <td>
                                    <div class="rv-pctbar"><div style="width:@Inv(d.Pct)%"></div><span>@d.Pct%</span></div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><td class="tl">@T("Common.Total")</td><td>@_data.AnnualDefectTotal</td><td>@(_data.AnnualDefectTotal > 0 ? "100%" : "—")</td></tr></tfoot>
                </table>
            </div>
        </div>

        <!-- ── Annual Results ── -->
        <div class="print-avoid-break" style="flex:1.3;min-width:0;">
            <div class="rv-section-title">@T("VendorReview.AnnualResults")</div>
            <div class="rv-card rv-table-card print-avoid-break">
                <table class="rv-tbl">
                    <thead>
                        <tr><th class="tl">@T("VendorReview.AnnualResults")</th>@foreach (var a in _data.AnnualResults) { <th>@a.Year</th> }</tr>
                    </thead>
                    <tbody>
                        <tr><td class="tl">@T("Common.TotalShipmentQuantity")</td>@foreach (var a in _data.AnnualResults) { <td>@(a.Inspections > 0 ? a.ShipmentQty.ToString("N0") : "—")</td> }</tr>
                        <tr><td class="tl">@T("VendorReview.TotalInspection")</td>@foreach (var a in _data.AnnualResults) { <td>@(a.Inspections > 0 ? a.Inspections.ToString("N0") : "—")</td> }</tr>
                        <tr><td class="tl">@T("VendorReview.TotalInspectionPassRate")</td>@foreach (var a in _data.AnnualResults) { <td>@(a.PassRate.HasValue ? $"{a.PassRate:0.#}%" : "—")</td> }</tr>
                        <tr><td class="tl">@T("VendorReview.TotalDefectRate")</td>@foreach (var a in _data.AnnualResults) { <td>@(a.DefectRate.HasValue ? $"{a.DefectRate:0.00}%" : "—")</td> }</tr>
                        <tr><td class="tl">@T("VendorReview.TotalCAPAClosureRate")</td>@foreach (var a in _data.AnnualResults) { <td title="@a.CapaIssued CAPA issued">@(a.CapaClosureRate.HasValue ? $"{a.CapaClosureRate:0.#}%" : "—")</td> }</tr>
                        <tr class="rv-score-row"><td class="tl">@T("VendorReview.OverallScore")</td>@foreach (var a in _data.AnnualResults) { <td>@(a.OverallScore.HasValue ? $"{a.OverallScore:0.#}%" : "—")</td> }</tr>
                        <tr><td class="tl">@T("VendorReview.VendorRating")</td>@foreach (var a in _data.AnnualResults) { <td><span class="rv-rating @RatingCss(a.Rating)">@a.Rating</span></td> }</tr>
                    </tbody>
                </table>
                <details class="rv-kpi-help">
                    <summary>@T("VendorReview.KPIFormulaScoring")</summary>
                    <table class="rv-tbl rv-tbl-sm">
                        <thead><tr><th class="tl">@T("VendorReview.KPI")</th><th class="tl">@T("VendorReview.Formula")</th><th>@T("VendorReview.Target")</th><th>@T("VendorReview.Weight")</th></tr></thead>
                        <tbody>
                            <tr><td class="tl">@T("Common.TotalShipmentQuantity")</td><td class="tl">@T("VendorReview.TotalUnitsShippedCompletedPSI")</td><td>@T("VendorReview.TrackOnly")</td><td>—</td></tr>
                            <tr><td class="tl">@T("VendorReview.TotalInspections")</td><td class="tl">@T("VendorReview.TotalInspectionsConducted")</td><td>@T("VendorReview.TrackOnly")</td><td>—</td></tr>
                            <tr><td class="tl">@T("VendorReview.InspectionPassRate")</td><td class="tl">@T("VendorReview.PassedPassedFailed100")</td><td>≥ 95%</td><td>30%</td></tr>
                            <tr><td class="tl">@T("VendorReview.DefectRate")</td><td class="tl">@T("VendorReview.TotalDefectsTotalShipmentQty100")</td><td>≤ 0.50%</td><td>40%</td></tr>
                            <tr><td class="tl">@T("VendorReview.CAPAClosureRate")</td><td class="tl">@T("VendorReview.ClosedCAPAsIssuedCAPAs100")</td><td>≥ 95%</td><td>30%</td></tr>
                        </tbody>
                    </table>
                    <div class="rv-note">@T("VendorReview.EachKPIScores100WhenIts")</div>
                </details>
            </div>
        </div>
    </div>

</div>
}

@code {
    [Parameter] public string VendorCode { get; set; } = "";

    private VendorReviewDto? _data;
    private bool _loading = true;
    private string? _error;
    private int _year  = DateTime.Now.Year;
    private int _month = DateTime.Now.Month;

    protected override async Task OnParametersSetAsync()
    {
        // Page Access guard — chi cho user co quyen "PerformanceReview" (hoac Admin)
        await PageAccess.EnsureLoadedAsync();
        if (!PageAccess.HasAccess("PerformanceReview"))
        {
            Navigation.NavigateTo("/", replace: true);
            return;
        }
        await Load();
    }

    async Task Load()
    {
        _loading = true; _error = null;
        try
        {
            _data = await Http.GetFromJsonAsync<VendorReviewDto>(
                $"api/vendors/{VendorCode}/review?year={_year}&month={_month}",
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch (Exception ex) { _error = ex.Message; }
        _loading = false;
    }

    async Task OnMonthChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int m)) _month = m;
        await Load();
    }
    async Task OnYearChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int y)) _year = y;
        await Load();
    }

    RenderFragment ResultCard(BlockDto b) => __builder =>
    {
        <div class="rv-card print-avoid-break">
            <div class="rv-card-top">@T("VendorReview.TotalInspectionReport") <strong>@b.Reports</strong></div>
            <div class="rv-pie-wrap">
                <Donut CssClass="rv-pie" Title="@(b.Judged > 0 ? T("VendorReview.Passed") : T("VendorReview.NoData"))" Value="@(b.Judged > 0 ? $"{b.PassRate}%" : "")"
                       TitleColor="@(b.Judged > 0 ? "#16a34a" : "#9ca3af")"
                       Segments="@(new() { new(b.Passed, "#22c55e"), new(b.Failed, "#ef4444") })" />
                <div class="rv-pie-legend">
                    <div class="rv-leg-row"><span class="rv-leg-dot" style="background:#22c55e;"></span> @T("VendorReview.PassRate") <strong style="color:#16a34a;">@b.PassRate%</strong> (@b.Passed)</div>
                    <div class="rv-leg-row"><span class="rv-leg-dot" style="background:#ef4444;"></span> @T("VendorReview.FailRate") <strong style="color:#dc2626;">@b.FailRate%</strong> (@b.Failed)</div>
                </div>
            </div>
        </div>
    };

    RenderFragment DefectCard(BlockDto b) => __builder =>
    {
        var t = Math.Max(1, b.DefTotal);
        <div class="rv-card print-avoid-break">
            <div class="rv-card-top">@T("VendorReview.TotalAQLSampling") <strong>@b.AqlSampling.ToString("N0")</strong></div>
            <div class="rv-pie-wrap">
                <Donut CssClass="rv-pie" Title="@T("VendorReview.Defects")" Value="@(b.DefTotal > 0 ? b.DefTotal.ToString() : "0")" TitleColor="#6b7280"
                       Segments="@(new() { new(b.Critical, "#ef4444"), new(b.Major, "#f59e0b"), new(b.Minor, "#3b82f6") })" />
                <div class="rv-def-legend">
                    <div class="rv-def-row critical"><span class="rv-def-icon">▲</span> @T("VendorReview.Critical") <strong>@b.Critical (@(b.DefTotal > 0 ? Math.Round(100.0 * b.Critical / t) : 0)%)</strong></div>
                    <div class="rv-def-row major">   <span class="rv-def-icon">▲</span> @T("VendorReview.Major") <strong>@b.Major (@(b.DefTotal > 0 ? Math.Round(100.0 * b.Major / t) : 0)%)</strong></div>
                    <div class="rv-def-row minor">   <span class="rv-def-icon">▲</span> @T("VendorReview.Minor") <strong>@b.Minor (@(b.DefTotal > 0 ? Math.Round(100.0 * b.Minor / t) : 0)%)</strong></div>
                </div>
            </div>
        </div>
    };

    static string Pc(double v, double max) => (max > 0 ? v / max * 100 : 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    static string Inv(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    string MonthName(int m) => L.MonthName(m);
    static string RatingCss(string? r) => r switch
    {
        "Excellent" => "ex", "Good" => "gd", "Acceptable" => "ac", "Improvement Required" => "ir", _ => ""
    };

    class VendorReviewDto
    {
        public string VendorName   { get; set; } = "";
        public string VendorId     { get; set; } = "";
        public int    TargetYear   { get; set; }
        public int    TargetMonth  { get; set; }
        public BlockDto Month      { get; set; } = new();
        public BlockDto Year       { get; set; } = new();
        public List<MonthTypeDto>      MonthlyData        { get; set; } = new();
        public List<ShipmentRowDto>    ShipmentByProduct  { get; set; } = new();
        public int[]                   ShipmentMonthTotals { get; set; } = new int[12];
        public int                     ShipmentTotal      { get; set; }
        public List<MonthlyDefectDto>  MonthlyDefect      { get; set; } = new();
        public List<AnnualDefectDto>   AnnualDefects      { get; set; } = new();
        public int                     AnnualDefectTotal  { get; set; }
        public List<AnnualResultDto>   AnnualResults      { get; set; } = new();
    }

    class BlockDto
    {
        public int    Total       { get; set; }
        public int    Reports     { get; set; }
        public int    Passed      { get; set; }
        public int    Failed      { get; set; }
        public int    Judged      { get; set; }
        public double PassRate    { get; set; }
        public double FailRate    { get; set; }
        public int    Critical    { get; set; }
        public int    Major       { get; set; }
        public int    Minor       { get; set; }
        public int    DefTotal    { get; set; }
        public int    AqlSampling { get; set; }
        public int    Ppt         { get; set; }
        public int    Dpi         { get; set; }
        public int    Pst         { get; set; }
        public int    Clc         { get; set; }
        public int    ClcPassed   { get; set; }
        public int    ClcFailed   { get; set; }
    }

    class ShipmentRowDto
    {
        public string  ProductName { get; set; } = "";
        public string? ProductCode { get; set; }
        public int[]   Months      { get; set; } = new int[12];
        public int     Total       { get; set; }
    }

    class MonthlyDefectDto
    {
        public int     Month       { get; set; }
        public int     Inspections { get; set; }
        public int     ShipmentQty { get; set; }
        public int     AqlQty      { get; set; }
        public int     DefectQty   { get; set; }
        public double  DefectRate  { get; set; }
        public string? TopDefect   { get; set; }
    }

    class AnnualDefectDto
    {
        public string Code { get; set; } = "";
