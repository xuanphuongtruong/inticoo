@page "/products"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using System.Net.Http.Headers
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using InticooInspection.Client.Services
@inject WaitingService Waiting
@inject PageAccessService PageAccess
@using InticooInspection.Client.Shared
@inherits LocalizedComponentBase

<PageTitle>@T("Products.ProductInformationInticoo")</PageTitle>

<div class="page-container">

    <!-- ── Top bar: title + search + filter + add (single row) ── -->
    <div class="lp-head">
        <div class="title-block">
            <h1 class="page-title">@T("Products.ProductInformation")</h1>
            <span class="page-sub">@T("Products.ManageProductMasterData")</span>
        </div>
    </div>
    <div class="top-bar lp-filters @(_fOpen ? "fopen" : "")">
        <div class="search-wrap">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="9" cy="9" r="6"/><path d="M15 15l3 3" stroke-linecap="round"/>
            </svg>
            <input class="search-input" type="text" placeholder="@T("Products.SearchNameCodeCustomerCategory")"
                   @bind="_search" @bind:event="oninput" @bind:after="ApplyFilter" />
        </div>
    <button type="button" class="lp-filter-toggle @(_fOpen ? "on" : "")" @onclick="() => _fOpen = !_fOpen" aria-label="@T("Common.Filters")"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></svg></button>
        <select class="filter-select" @bind="_filterCat" @bind:after="ApplyFilter">
            <option value="">@T("Common.AllType")</option>
            @foreach (var c in _categories.Where(c => _all.Any(p => p.Category == c.Name)))
            { <option value="@c.Name">@c.Name</option> }
        </select>
        <select class="filter-select" @bind="_filterVendor" @bind:after="ApplyFilter">
            <option value="">@T("Products.AllVendors")</option>
            @foreach (var v in _vends)
            { <option value="@v.Code">@v.Name</option> }
        </select>
        <select class="filter-select" @bind="_filterStatus" @bind:after="ApplyFilter">
            <option value="">@T("Common.AllStatus")</option>
            <option value="valid">@T("Common.Active")</option>
            <option value="invalid">@T("Common.Inactive")</option>
        </select>
        <button type="button" class="lp-btn-reset" @onclick="ClearFilters">@T("Common.Clear")</button>
        @* Directory: thêm/import theo quyền Create (Module Permissions) *@
        @if (DirCreate)
        {
        <ImportExcelButton ApiBase="api/products" OnImported="ApplyFilter" />
        <button class="btn-add" @onclick="async () => await OpenAddModal()">
            <svg width="14" height="14" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                <path d="M10 4v12M4 10h12"/>
            </svg>
            @T("Products.AddProduct")
        </button>
        }
    </div>

    <!-- ── Alerts ── -->
    @if (!string.IsNullOrEmpty(_pageError))
    {
        <div class="alert-box alert-err">@_pageError <button class="alert-x" @onclick="ClearError">✕</button></div>
    }
    @if (!string.IsNullOrEmpty(_pageOk))
    {
        <div class="alert-box alert-ok">@_pageOk <button class="alert-x" @onclick="ClearOk">✕</button></div>
    }

    <div class="m-kpis">
        <div class="m-kpi"><span class="m-kpi-ico k-blue"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 5.5"/></svg></span><b>@(_all.Count)</b><small>@T("Customers.KpiTotal")</small></div>
        <div class="m-kpi"><span class="m-kpi-ico k-green"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg></span><b>@(_all.Count(p => p.IsActive))</b><small>@T("Common.Active")</small></div>
        <div class="m-kpi"><span class="m-kpi-ico k-orange"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/></svg></span><b class="red">@(_all.Count(p => !p.IsActive))</b><small>@T("Common.Inactive")</small></div>
        <div class="m-kpi lp-kpi-extra"><span class="m-kpi-ico k-blue"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M20 12l-8 8-9-9V3h8z"/><circle cx="7.5" cy="7.5" r="1.2"/></svg></span><b>@_all.Where(p => !string.IsNullOrEmpty(p.Category)).Select(p => p.Category).Distinct().Count()</b><small>@T("Vendors.Categories")</small></div>
    </div>
    <div class="m-chips">
        <button type="button" class="@(_filterStatus == "" ? "on" : "")" @onclick='() => SetStatusChip("")'>@T("Customers.ChipAll") (@_all.Count)</button>
        <button type="button" class="@(_filterStatus == "valid" ? "on" : "")" @onclick='() => SetStatusChip("valid")'>@T("Common.Active") (@_all.Count(p => p.IsActive))</button>
        <button type="button" class="@(_filterStatus == "invalid" ? "on" : "")" @onclick='() => SetStatusChip("invalid")'>@T("Common.Inactive") (@_all.Count(p => !p.IsActive))</button>
    </div>

    <!-- ── Table ── -->
    @if (_loading)
    {
        <div class="loading-wrap"><div class="spinner"></div><span>@T("Common.Loading")</span></div>
    }
    else
    {
        <div class="m-cards">
            @foreach (var mp in _filtered)
            {
                var item = mp;
                var thumb = !string.IsNullOrEmpty(item.PhotoUrl) ? item.PhotoUrl : item.PhotoUrls.FirstOrDefault();
                <div class="m-card">
                    <div class="m-card-top">
                        @if (!string.IsNullOrEmpty(thumb))
                        {
                            <img class="m-thumb" src="@MediaUrl.Resolve(thumb, Http.BaseAddress?.ToString())" alt="@item.ProductName" />
                        }
                        else
                        {
                            <div class="m-thumb m-initials"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"><path d="M12 3l8 4.5v9L12 21l-8-4.5v-9z"/><path d="M4 7.5l8 4.5 8-4.5M12 12v9"/></svg></div>
                        }
                        <div class="m-card-main">
                            <div class="m-card-head">
                                <div class="m-card-name">@(string.IsNullOrEmpty(item.ProductCode) ? "—" : item.ProductCode)</div>
                                <span class="m-status @(item.IsActive ? "ok" : "off")">@(item.IsActive ? T("Common.Active") : T("Common.Inactive"))</span>
                            </div>
                            <div class="m-card-sub">@item.ProductName</div>
                            <div class="m-card-code">@(string.IsNullOrEmpty(item.ItemNumber) ? "" : item.ItemNumber + " · ")@item.Category</div>
                        </div>
                    </div>
                    <div class="m-card-rows">
                        @if (!string.IsNullOrEmpty(item.VendorName))
                        {
                            <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>@item.VendorName</div>
                        }
                        <div><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>@(item.EstablishDate.HasValue ? L.Date(item.EstablishDate.Value, "d MMM yyyy") : "—")</div>
                    </div>
                    <div class="m-card-actions">
                        <button type="button" class="m-btn-outline" @onclick="() => OpenDetail(item)">@T("Common.View")</button>
                        @if (DirEdit)
                        {
                            <button type="button" class="m-btn-fill" @onclick="() => OpenEdit(item)">@T("Common.Edit")</button>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="table-wrap">
            <table class="ptable">
                <thead>
                    <tr>
                        <th class="th-y tc th-chk"><input type="checkbox" checked="@(_pageItems.Count > 0 && _pageItems.All(x => _sel.Contains(x.Id)))" @onchange="e => ToggleAll((bool)(e.Value ?? false))" /></th>
                        <th class="th-y tc th-no">No</th>
                        <th class="th-y tc">@T("Products.Photo")</th>
                        <th class="th-y tc">@T("Products.ProductID")</th>
                        <th class="th-y tc">@T("Common.ProductName")</th>
                        <th class="th-y tc">@T("Common.Category")</th>
                        <th class="th-y tc">@T("Common.ProductCode")</th>
                        <th class="th-y tc">@T("Common.VendorName")</th>
                        <th class="th-y tc">@T("Products.EstablishDate")</th>
                        <th class="th-y tc">@T("Common.Status")</th>
                        <th class="th-y tc">@T("Common.Actions")</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!_filtered.Any())
                    {
                        <tr><td colspan="11" class="td-empty">@T("Products.NoProductsFound")</td></tr>
                    }
                    else
                    {
                        @for (int i = 0; i < _pageItems.Count; i++)
                        {
                            var item = _pageItems[i];
                            <tr class="@(i % 2 == 1 ? "tr-alt" : "")">
                                <td class="tc"><input type="checkbox" checked="@_sel.Contains(item.Id)" @onchange="e => ToggleOne(item.Id, (bool)(e.Value ?? false))" /></td>
                                <td class="tc muted">@((_pageIdx - 1) * _pageSz + i + 1)</td>
                                <td class="tc">
                                    @{ var th = !string.IsNullOrEmpty(item.PhotoUrl) ? item.PhotoUrl : item.PhotoUrls.FirstOrDefault(); }
                                    @if (!string.IsNullOrEmpty(th))
                                    { <img class="row-thumb" src="@MediaUrl.Resolve(th, Http.BaseAddress?.ToString())" alt="@item.ProductName" /> }
                                    else { <div class="row-thumb row-thumb-ph"></div> }
                                </td>
                                <td class="tc mono">@(string.IsNullOrEmpty(item.ProductCode) ? "—" : item.ProductCode)</td>
                                <td class="tc fw">@item.ProductName</td>
                                <td class="tc">
                                    @if (!string.IsNullOrEmpty(item.Category))
                                    { <span class="cat-badge">@TE("Opt", item.Category)</span> }
                                    else { <span class="muted">—</span> }
                                </td>
                                <td class="tc mono">@(string.IsNullOrEmpty(item.ItemNumber) ? "—" : item.ItemNumber)</td>
                                <td class="tc">@(string.IsNullOrEmpty(item.VendorName) ? "—" : item.VendorName)</td>
                                <td class="tc muted">@(item.EstablishDate.HasValue ? L.Date(item.EstablishDate.Value, "dd MMM yyyy") : "—")</td>
                                <td class="tc">
                                    <span class="status-badge @(item.IsActive ? "active" : "inactive")">
                                        @(item.IsActive ? T("Common.Active") : T("Common.Inactive"))
                                    </span>
                                </td>
                                <td class="tc">
                                    <div class="action-btns">
                                        <button class="bico bview" @onclick="() => OpenDetail(item)" title="@T("Common.View")">
                                            <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 10s3.5-6 8-6 8 6 8 6-3.5 6-8 6-8-6-8-6Z"/><circle cx="10" cy="10" r="2.5"/></svg>
                                        </button>
                                        @if (DirEdit)
                                        {
                                            <button class="bico bedit" @onclick="() => OpenEdit(item)" title="@T("Common.Edit")">
                                                <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M14 2l4 4-10 10H4v-4L14 2z" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            </button>
                                        }
                                        @if (DirDelete)
                                        {
                                            <button class="bico bdel" @onclick="() => AskDelete(item)" title="@T("Common.Delete")">
                                                <svg width="13" height="13" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h14M8 6V4h4v2M5 6l1 11h8l1-11" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <ListPager Total="_filtered.Count" Page="_pageIdx" PageSize="_pageSz" Noun="@T("Pager.Products")" OnPage="GoPage" OnPageSize="SetPageSz" />
    }
</div>

<!-- ═══ ADD / EDIT MODAL ═══ -->
@if (_showModal)
{
    <div class="modal-overlay" @onclick="CloseModal">
        <div class="modal-card" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@(_isEdit ? T("Products.EditProduct") : T("Products.NewProduct"))</h2>
                <button class="modal-close" @onclick="CloseModal">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(_mErr))
            { <div class="error-alert">@_mErr</div> }

            <div class="pf-cols">
            <div class="pf-card2">
            <!-- Product ID + Establish Date + Status -->
            <div class="form-grid form-grid-3">
                <div class="form-group">
                    <label>@T("Products.ProductID")</label>
                    @if (_isEdit)
                    {
                        <input class="form-input" @bind="_f.ProductCode" />
                    }
                    else
                    {
                        <div class="form-input form-input-disabled" style="background:#e6f1fb;color:#1e90d6;font-weight:700;font-family:monospace;border-color:#b5d4f4;">@_f.ProductCode</div>
                    }
                </div>
                <div class="form-group">
                    <label>@T("Products.EstablishDate")</label>
                    <input class="form-input"
                           type="date"
                           value="@(_f.EstablishDate?.ToString("yyyy-MM-dd"))"
                           @onchange="e => _f.EstablishDate = DateTime.TryParse(e.Value?.ToString(), out var d) ? d : null" />
                </div>
            </div>

            <!-- Customer -->
            <div class="form-section-title">@T("Common.Customer")</div>
            <div class="form-grid">
                <div class="form-group">
                    <label>@T("Common.CustomerID")</label>
                    <select class="form-input" @bind="_f.CustomerId" @bind:after="OnCustChanged">
                        <option value="">@T("Products.SelectCustomer")</option>
                        @foreach (var c in _custs)
                        { <option value="@c.CustomerId">@c.CustomerId — @c.CompanyName</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label>@T("Common.CustomerName")</label>
                    <input class="form-input form-input-disabled" readonly value="@_f.CustomerName" />
                </div>
            </div>

            <!-- Vendor -->
            <div class="form-section-title">@T("Common.Vendor")</div>
            <div class="form-grid">
                <div class="form-group">
                    <label>@T("Common.VendorID")</label>
                    <select class="form-input" @bind="_f.VendorId" @bind:after="OnVendChanged">
                        <option value="">@T("Products.SelectVendor")</option>
                        @foreach (var v in _vends)
                        { <option value="@v.Code">@v.Code — @v.Name</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label>@T("Common.VendorName")</label>
                    <input class="form-input form-input-disabled" readonly value="@_f.VendorName" />
                </div>
            </div>
            <div class="form-section-title">@T("Products.ProductDetails")</div>
            <div class="form-grid">
                <div class="form-group">
                    <label>@T("Common.ProductCategory") <span class="required">*</span></label>
                    <select class="form-input" @bind="_f.Category">
                        <option value="">@T("Products.SelectCategory")</option>
                        @foreach (var c in Taxonomy.MainCategories)
                        { <option value="@c">@TE("Opt", c)</option> }
                    </select>
                </div>
                <div class="form-group">
                    <label>@T("Common.ProductName") <span class="required">*</span></label>
                    <input class="form-input" @bind="_f.ProductName" placeholder="@T("Products.EG55InchOLED")" />
                </div>
                <div class="form-group">
                    <label>@T("Common.ProductCode")</label>
                    <input class="form-input" @bind="_f.ItemNumber" placeholder="@T("Products.EGITM001")" />
                </div>
                <div class="form-group">
                    <label>@T("Products.CartonQuantity")</label>
                    <input class="form-input" @bind="_f.CartonQuantity" type="number" min="0" placeholder="@T("Products.EG2")" />
                </div>
                <div class="form-group full-width">
                    <label>@T("Products.ProductSizeMMInch")</label>
                    <div class="size-grid">
                        <div class="form-group">
                            <label>L</label>
                            <input class="form-input" @bind="_f.SizeL" type="number" min="0" placeholder="0" />
                        </div>
                        <div class="form-group">
                            <label>W</label>
                            <input class="form-input" @bind="_f.SizeW" type="number" min="0" placeholder="0" />
                        </div>
                        <div class="form-group">
                            <label>H</label>
                            <input class="form-input" @bind="_f.SizeH" type="number" min="0" placeholder="0" />
                        </div>
                        <div class="form-group">
                            <label>@T("Products.NetWeightKGS")</label>
                            <input class="form-input" @bind="_f.Weight" type="number" min="0" step="0.01" placeholder="0" />
                        </div>
                    </div>
                </div>
                <div class="form-group full-width">
                    <label>@T("Common.Remark")</label>
                    <textarea class="form-input form-textarea" @bind="_f.Remark" placeholder="@T("Products.OptionalNotes")"></textarea>
                </div>
            </div>

            <!-- Carton Size -->
            <div class="form-section-title">@T("Products.CartonSizeMMInch")</div>
            <div class="ctn-wrap">
                <table class="ctn-table">
                    <thead>
                        <tr>
                            <th rowspan="2">@T("Common.CartonVariant")</th>
                            <th rowspan="2">@T("Common.Description")</th>
                            <th rowspan="2">@T("Products.PackagingQuantity")</th>
                            <th colspan="3">@T("Products.CartonSizeMMInch")</th>
                            <th rowspan="2">@T("Products.WeightKGS")</th>
                            <th rowspan="2"></th>
                        </tr>
                        <tr><th>L</th><th>W</th><th>H</th></tr>
                    </thead>
                    <tbody>
                        @for (int ci = 0; ci < _cartons.Count; ci++)
                        {
                            var cIdx = ci;
                            <tr>
                                <td><input class="form-input" @bind="_cartons[cIdx].CartonVariant" placeholder="@T("Products.Carton")" /></td>
                                <td><input class="form-input" @bind="_cartons[cIdx].Description" placeholder="@T("Products.DiningChair")" /></td>
                                <td><input class="form-input" @bind="_cartons[cIdx].PackagingQuantity" placeholder="2pcs/ctn" /></td>
                                <td><input class="form-input" type="number" min="0" @bind="_cartons[cIdx].SizeL" /></td>
                                <td><input class="form-input" type="number" min="0" @bind="_cartons[cIdx].SizeW" /></td>
                                <td><input class="form-input" type="number" min="0" @bind="_cartons[cIdx].SizeH" /></td>
                                <td><input class="form-input" type="number" min="0" step="0.01" @bind="_cartons[cIdx].Weight" /></td>
                                <td><button class="ctn-del" title="@T("Products.RemoveRow")" @onclick="() => _cartons.RemoveAt(cIdx)">✕</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <div class="ref-addrow">
                    <button class="btn-addrow" @onclick="() => _cartons.Add(new PCartonDto())">@T("Common.AddRow")</button>
                </div>
            </div>

            </div>
            <div class="pf-card2">
            <!-- Product Photo (tối đa 8 ảnh, chọn 1 ảnh dùng trong báo cáo) -->
            <div class="form-section-title">@T("Products.ProductPhoto")</div>
            <div class="pp-sub">@T("Products.UploadProductPhotos")</div>
            <div class="pp-grid">
                @for (int i = 0; i < _f.PhotoUrls.Count; i++)
                {
                    var idx = i; var url = _f.PhotoUrls[i]; var isMain = url == _f.PhotoUrl;
                    <div class="pp-card @(isMain ? "main" : "")">
                        <span class="pp-no">@(idx + 1)</span>
                        <button type="button" class="pp-del" @onclick="() => RemovePhoto(idx)" title="@T("Common.Delete")">✕</button>
                        <img src="@MediaUrl.Resolve(url, Http.BaseAddress?.ToString())" class="pp-img" @onclick="() => _lightbox = MediaUrl.Resolve(url, Http.BaseAddress?.ToString())" />
                        <label class="pp-radio">
                            <input type="radio" name="mainPhoto" checked="@isMain" @onchange="() => _f.PhotoUrl = url" />
                            <span>@(isMain ? T("Products.UseInReportMain") : T("Products.DoNotUseInReport"))</span>
                        </label>
                    </div>
                }
            </div>
            @if (_f.PhotoUrls.Count < 8)
            {
                <label class="upload-zone">
                    <div class="upload-label">
                        @if (_uploading)
                        {
                            <div class="spinner"></div>
                            <span class="upload-text">@T("Common.Uploading2")</span>
                        }
                        else
                        {
                            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="rgba(30,144,214,0.5)" stroke-width="1.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                            <span class="upload-text">@T("Common.ClickToUploadPhoto")</span>
                            <span class="upload-hint">@T("Products.JPGPNGWEBPMax5MB")</span>
                        }
                    </div>
                    <InputFile OnChange="OnPhoto" accept="image/*" multiple style="display:none" />
                </label>
            }
            <div class="pp-info">@T("Products.OnlySelectedPhotoInReport")</div>

            </div>
            </div>

            <div class="pf-cols">
            <div class="pf-card2">
            <!-- Reference -->
            <div class="form-section-title">@T("Common.Reference")</div>
            <div class="ref-table">
                <div class="ref-thead">
                    <span class="ref-col-no">No</span>
                    <span class="ref-col-name">@T("Common.Reference")</span>
                    <span class="ref-col-file">@T("Common.AttachedFile")</span>
                </div>
                @for (int ri = 0; ri < _refs.Count; ri++)
                {
                    var idx = ri;
                    <div class="ref-row">
                        <span class="ref-col-no ref-num">@(idx + 1)</span>
                        <input class="form-input ref-col-name ref-input" @bind="_refs[idx].Name" placeholder="@T("Common.ReferenceName")" />
                        <div class="ref-col-file">
                            @if (_refs[idx].Uploading)
                            { <span class="ref-uploading">@T("Common.Uploading")</span> }
                            else if (!string.IsNullOrEmpty(_refs[idx].FileUrl))
                            { <a class="ref-fname" href="@_refs[idx].FileUrl" target="_blank" title="@_refs[idx].FileName">📎 @_refs[idx].FileName</a> }
                            else if (!string.IsNullOrEmpty(_refs[idx].FileName))
                            { <span class="ref-fname ref-err">❌ @_refs[idx].FileName</span> }
                            <label class="btn-attach">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
                                @(_refs[idx].Uploading ? "..." : T("Products.AttachFile"))
                                <InputFile OnChange="e => OnRefFile(e, idx)" style="display:none" disabled="@_refs[idx].Uploading" />
                            </label>
                        </div>
                    </div>
                }
                <div class="ref-addrow">
                    <button class="btn-addrow" @onclick="AddRefRow">@T("Common.AddRow")</button>
                </div>
            </div>

            </div>
            <div class="pf-card2">
            @* ── Account Status: cùng vị trí (cuối form) ở Customer/Vendor/Inspector/Product ── *@
            <div class="form-section-title" style="margin-top:16px;">@T("Common.AccountStatus")</div>
            <div class="btype-group" style="padding:8px 0 4px;">
                    <label class="btype-label @(_f.IsActive ? "btype-active" : "")" @onclick="() => _f.IsActive = true">@T("Common.Active")</label>
                    <label class="btype-label @(!_f.IsActive ? "btype-active" : "")" @onclick="() => _f.IsActive = false">@T("Common.Inactive")</label>
                    </div>

            </div>
            </div>

            <div class="modal-footer">
                <button class="btn-cancel" @onclick="CloseModal">@T("Common.Cancel")</button>
                <button class="btn-save" @onclick="Save" disabled="@_saving">
                    @if (_saving) { <div class="spinner"></div> }
                    @(_isEdit ? T("Products.UpdateProduct") : T("Products.SaveProduct"))
                </button>
            </div>
        </div>
    </div>
}

<!-- ═══ DETAIL MODAL ═══ -->
@if (_showDetail && _detailItem != null)
{
    var d = _detailItem;
    <div class="modal-overlay" @onclick="() => _showDetail = false">
        <div class="modal-card modal-wide modal-detail" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>@T("Products.ViewTitle")</h2>
                <button class="modal-close" @onclick="() => _showDetail = false">✕</button>
            </div>

            <div class="vc-grid">
                <div class="vc-col">
                    <ViewSection Title="@T("Products.ViewDetails")" Icon="box">
                        <ViewRow Label="@T("Products.ProductID")" Value="@d.ProductCode" />
                        <ViewRow Label="@T("Common.Status")"><span class="vc-badge @(d.IsActive ? "" : "off")">@(d.IsActive ? T("Common.Active") : T("Common.Inactive"))</span></ViewRow>
                        <ViewRow Label="@T("Common.ProductCode")" Value="@d.ItemNumber" />
                        <ViewRow Label="@T("Common.ProductName")" Value="@d.ProductName" />
                        <ViewRow Label="@T("Products.EstablishDate")" Value="@(d.EstablishDate.HasValue ? d.EstablishDate.Value.ToString("dd/MM/yyyy") : null)" />
                    </ViewSection>
                    <ViewSection Title="@T("Products.ViewVendor")" Icon="layers">
                        <ViewRow Label="@T("Common.VendorID")" Value="@d.VendorId" />
                        <ViewRow Label="@T("Common.VendorName")" Value="@d.VendorName" />
                    </ViewSection>
                    <ViewSection Title="@T("Products.ProductSpecifications")" Icon="briefcase">
                        <ViewRow Label="@T("Common.Category")" Value="@d.Category" />
                        <ViewRow Label="@T("Products.ViewSize")" Value="@(d.SizeL.HasValue || d.SizeW.HasValue || d.SizeH.HasValue ? $"{d.SizeL?.ToString("0.##") ?? "—"} × {d.SizeW?.ToString("0.##") ?? "—"} × {d.SizeH?.ToString("0.##") ?? "—"} mm" : null)" />
                        <ViewRow Label="@T("Products.Weight")" Value="@(d.Weight.HasValue ? d.Weight.Value.ToString("0.###") + " kg" : null)" />
                        @if (!string.IsNullOrEmpty(d.Remark))
                        {
                            <ViewRow Label="@T("Common.Remark")" Value="@d.Remark" />
                        }
                    </ViewSection>
                </div>
                <div class="vc-col">
                    @if (d.CartonQuantity.HasValue || d.Cartons.Any())
                    {
                        <ViewSection Title="@T("Products.ViewCarton")" Icon="box">
