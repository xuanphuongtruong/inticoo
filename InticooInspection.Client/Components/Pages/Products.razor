                            {
                                <div class="vc-note" style="padding:6px 0 0;color:#1d6fe0;font-weight:700;">@T("Products.ViewCartonSize", d.CartonQuantity)</div>
                            }
                            @if (d.Cartons.Any())
                            {
                                <div style="overflow-x:auto;">
                                    <table class="vc-table">
                                        <thead>
                                            <tr><th>@T("Common.CartonVariant")</th><th>@T("Products.ViewPackingQty")</th><th>@T("Products.ViewLmm")</th><th>@T("Products.ViewWmm")</th><th>@T("Products.ViewHmm")</th><th>@T("Products.ViewWeightKg")</th></tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in d.Cartons)
                                            {
                                                <tr>
                                                    <td>@c.CartonVariant</td><td>@c.PackagingQuantity</td>
                                                    <td>@c.SizeL?.ToString("0.##")</td><td>@c.SizeW?.ToString("0.##")</td><td>@c.SizeH?.ToString("0.##")</td>
                                                    <td>@c.Weight?.ToString("0.###")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </ViewSection>
                    }

                    @if (d.References.Any(r => !string.IsNullOrEmpty(r.Name)))
                    {
                        <ViewSection Title="@T("Products.ViewDocs")" Icon="doc">
                            <div style="overflow-x:auto;">
                                <table class="vc-table">
                                    <thead><tr><th>@T("Common.No")</th><th>@T("Products.ViewDocument")</th><th>@T("Products.File")</th></tr></thead>
                                    <tbody>
                                        @foreach (var r in d.References.Where(r => !string.IsNullOrEmpty(r.Name)))
                                        {
                                            <tr>
                                                <td>@r.SortOrder</td>
                                                <td class="l">@r.Name</td>
                                                <td class="l">
