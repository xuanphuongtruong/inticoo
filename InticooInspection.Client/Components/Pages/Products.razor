                                                    {
                                                        var fUrl = MediaUrl.Resolve(r.FileUrl, Http.BaseAddress?.ToString());
                                                        <a class="vc-file" href="@fUrl" target="_blank" rel="noopener">📎 @r.FileName</a>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </ViewSection>
                    }

                    @if (d.PhotoUrls.Count > 0 || !string.IsNullOrEmpty(d.PhotoUrl))
                    {
                        var detailPhotos = d.PhotoUrls.Count > 0 ? d.PhotoUrls : new List<string> { d.PhotoUrl };
                        <ViewSection Title="@T("Products.ProductPhoto")" Icon="image">
                            <div class="vc-photos">
                                @foreach (var du in detailPhotos)
                                {
