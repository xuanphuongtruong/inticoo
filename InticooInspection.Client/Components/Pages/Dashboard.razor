    .qd-mtbl th { color:#1d4ed8; font-weight:700; padding:5px 4px; text-align:right; border-bottom:1px solid #e5e7eb; text-decoration:underline; }
    .qd-mtbl th:first-child { text-align:left; text-decoration:none; }
