    // ── DTOs ──────────────────────────────────────────────────────────────────
    class DashboardDto
    {
        public DateTime UpdatedAt { get; set; }
        public int Year  { get; set; }
        public int Month { get; set; }
        public FiltersDto Filters { get; set; } = new();
        public KpiDto     Kpi     { get; set; } = new();
        public List<MonthDto>          Monthly                { get; set; } = new();
        public List<DefectProductDto>  TopDefectProductsMonth { get; set; } = new();
        public List<DefectProductDto>  TopDefectProductsYear  { get; set; } = new();
        public List<ShipmentDto>       TopShipmentsMonth      { get; set; } = new();
        public List<ShipmentDto>       TopShipmentsYear       { get; set; } = new();
        public List<VendorPerfDto>     VendorPerformance      { get; set; } = new();
        public List<RecentDto>         RecentInspections      { get; set; } = new();
        public List<RankDto>           TopCustomers           { get; set; } = new();
        public List<RankDto>           TopInspectors          { get; set; } = new();
        public List<RankDto>           TopVendors             { get; set; } = new();
    }
