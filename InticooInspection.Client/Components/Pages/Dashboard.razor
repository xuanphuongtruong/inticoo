<style>
    .qd-page { width:100%; box-sizing:border-box; font-family:"DM Sans", sans-serif; color:#1a2d5a; }
    .qd-dim { opacity:.55; transition:opacity .2s; pointer-events:none; }

    /* Header */
    .qd-ftoggle { display:none; }   /* chỉ hiện trên điện thoại (xem @@media bên dưới) */
    .qd-header { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin-bottom:18px; flex-wrap:wrap; }
    .qd-title { font-size:28px; font-weight:800; color:#fff; margin:0 0 4px; letter-spacing:-.02em; }
    .qd-subtitle { display:flex; align-items:center; gap:6px; font-size:13px; color:rgba(255,255,255,.78); flex-wrap:wrap; }
    .qd-live-dot { width:8px; height:8px; border-radius:50%; background:#22c55e; animation:qdpulse 2s infinite; }
    @@keyframes qdpulse { 0%,100%{opacity:1} 50%{opacity:.4} }
    .qd-update { color:rgba(255,255,255,.55); }
    .qd-filters { display:flex; gap:10px; align-items:flex-end; flex-wrap:wrap; }
    .qd-filter { display:flex; flex-direction:column; gap:4px; }
    .qd-filter label { font-size:11px; font-weight:600; color:rgba(255,255,255,.8); }
    .qd-filter select { border:1px solid #dbe3ef; border-radius:9px; padding:8px 10px; font-size:13px; font-family:inherit; color:#1a2d5a; background:#fff; min-width:140px; max-width:220px; cursor:pointer; }
    .qd-period { display:flex; gap:4px; }
    .qd-period select { min-width:72px; }
    .qd-refresh { background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.35); border-radius:9px; color:#fff; padding:8px 10px; cursor:pointer; }
    .qd-refresh:hover { background:rgba(255,255,255,.28); }

    .qd-loading { display:flex; align-items:center; gap:12px; padding:60px; justify-content:center; color:#fff; }
    .qd-spinner { width:24px; height:24px; border:3px solid rgba(255,255,255,.3); border-top-color:#fff; border-radius:50%; animation:qdspin .7s linear infinite; }
    @@keyframes qdspin { to { transform:rotate(360deg); } }
    .qd-error { background:#fff5f5; border:1px solid #fecaca; border-radius:12px; padding:16px 20px; color:#dc2626; }

    /* KPI cards */
    .qd-kpis { display:grid; gap:12px; margin-bottom:12px; }
    .qd-kpis-6 { grid-template-columns:repeat(6, minmax(0,1fr)); }
    .qd-kpis-5 { grid-template-columns:repeat(5, minmax(0,1fr)); margin-bottom:16px; }
    .qd-kpi { background:#fff; border-radius:14px; padding:14px 16px; display:flex; gap:12px; align-items:center; border:1px solid #e5e7eb; box-shadow:0 2px 8px rgba(15,40,90,.06); min-width:0; }
    .qd-kpi-ico { width:48px; height:48px; border-radius:50%; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .qd-kpi-body { min-width:0; }
    .qd-kpi-lbl { font-size:12.5px; color:#374151; font-weight:600; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .qd-kpi-val { font-size:26px; font-weight:800; color:#1a2d5a; line-height:1.15; white-space:nowrap; }
    .qd-kpi-delta { font-size:11.5px; font-weight:600; color:#6b7280; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .qd-kpi-delta.good { color:#16a34a; }
    .qd-kpi-delta.bad  { color:#dc2626; }

    /* Cards & grid */
    .qd-card { background:#fff; border-radius:14px; border:1px solid #e5e7eb; padding:14px 16px; box-shadow:0 2px 8px rgba(15,40,90,.06); min-width:0; }
    .qd-card-head { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:10px; flex-wrap:wrap; }
    .qd-card-title { font-size:15px; font-weight:800; color:#1a2d5a; }
    .qd-grid-2 { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:14px; margin-bottom:14px; }
    .qd-grid-3 { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr) minmax(0,1.25fr); gap:14px; margin-bottom:14px; }
    .qd-grid-3eq { display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:14px; margin-bottom:14px; }
    .qd-col { display:flex; flex-direction:column; gap:14px; min-width:0; }
