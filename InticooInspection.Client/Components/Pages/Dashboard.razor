@page "/dashboard"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Net.Http.Json
@using System.Globalization
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inherits LocalizedComponentBase

<PageAccessGuard RequiredPage="Dashboard">
<PageTitle>@T("Dashboard.QualityDashboardInticoo")</PageTitle>

<div class="qd-page">

    <!-- ── Header + Filters ── -->
    <div class="qd-header">
        <div class="qd-title-block">
            <h1 class="qd-title">@T("Dashboard.QualityDashboard")</h1>
            <div class="qd-subtitle">
                <span class="qd-live-dot"></span>
                <span class="qd-hide-m">@T("Dashboard.RealTimeQualityOverviewForYour")</span>
                <span class="qd-show-m">@T("Dashboard.RealTimeQualityOverview")</span>
                @if (_data != null)
                {
                    <span class="qd-update">@T("Dashboard.Updated", _data.UpdatedAt.ToLocalTime().ToString("hh:mm tt"))</span>
                }
            </div>
        </div>
        <button type="button" class="qd-ftoggle @(_fOpen ? "on" : "") @(_vendor != "" || _customer != "" ? "has" : "")" @onclick="() => _fOpen = !_fOpen" aria-label="@T("Common.Filters")">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 5h18l-7 8v6l-4 2v-8z"/></svg>
        </button>
        <div class="qd-filters @(_fOpen ? "qd-fopen" : "")">
            <div class="qd-filter">
                <label>@T("Dashboard.Period")</label>
                <div class="qd-period">
                    <svg class="qd-cal" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
                    <select value="@($"{_year}-{_month:D2}")" @onchange="OnPeriod">
                        @foreach (var (py, pm) in PeriodOptions())
                        { <option value="@($"{py}-{pm:D2}")">@MonthAbbr(pm) @py</option> }
                    </select>
                </div>
            </div>
            <div class="qd-filter">
                <label>@T("Common.Customer")</label>
                <select value="@_customer" @onchange="e => OnFilter(() => _customer = e.Value?.ToString() ?? string.Empty)">
                    <option value="">@T("Dashboard.AllCustomers")</option>
                    @foreach (var c in _data?.Filters.Customers ?? new()) { <option value="@c.Id">@c.Name</option> }
                </select>
            </div>
            <div class="qd-filter">
                <label>@T("Dashboard.SupplierVendor")</label>
                <select value="@_vendor" @onchange="e => OnFilter(() => _vendor = e.Value?.ToString() ?? string.Empty)">
                    <option value="">@T("Dashboard.AllFactories")</option>
                    @foreach (var v in _data?.Filters.Vendors ?? new()) { <option value="@v.Id">@v.Name</option> }
                </select>
            </div>
            <div class="qd-filter qd-hide-m">
                <label>@T("Common.ProductCategory")</label>
                <select value="@_category" @onchange="e => OnFilter(() => _category = e.Value?.ToString() ?? string.Empty)">
                    <option value="">@T("Common.AllCategories")</option>
                    @foreach (var c in _data?.Filters.Categories ?? new()) { <option value="@c">@TE("Opt", c)</option> }
                </select>
            </div>
            <button class="qd-refresh qd-hide-m" @onclick="LoadData" title="@T("Dashboard.Refresh")">
                <svg width="15" height="15" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M4 4a8 8 0 0 1 12 0M16 16a8 8 0 0 1-12 0M4 4v4h4M16 16v-4h-4"/>
                </svg>
            </button>
        </div>
    </div>

    @if (_loading && _data == null)
    {
        <div class="qd-loading"><div class="qd-spinner"></div><span>@T("Dashboard.LoadingDashboard")</span></div>
    }
    else if (_error != null)
    {
        <div class="qd-error">⚠ @_error <button @onclick="LoadData">@T("Common.Retry")</button></div>
    }
    else if (_data != null)
    {
        var k = _data.Kpi;
        <div class="@(_loading ? "qd-dim" : "")">

        <div class="qd-kpi-wrap">
        <!-- ── KPI row 1: Inspection Summary + Defects & CAPA ── -->
        <div class="qd-kgroups-1">
            <div class="qd-kgroup g-insp">
                <div class="qd-kgroup-t">@T("Dashboard.InspectionSummary")</div>
                <div class="qd-kpis qd-kpis-4">
                    @Kpi(T("Dashboard.TotalInspections"), k.TotalInspections.ToString("N0"), Delta(k.TotalInspections, k.TotalInspectionsPrev, false, ""), "#3b82f6", "#eff6ff", IconClipboard)
                    @Kpi(T("Dashboard.AwaitingInspection"), k.Awaiting.ToString("N0"), Delta(k.Awaiting, k.AwaitingPrev, true, ""), "#f59e0b", "#fffbeb", IconClock)
                    @Kpi(T("Dashboard.PassRate"), $"{k.PassRate:0.#}%", Delta(k.PassRate, k.PassRatePrev, false, "%"), "#16a34a", "#ecfdf5", IconCheck)
                    @Kpi(T("Dashboard.FailedInspections"), k.Failed.ToString("N0"), Delta(k.Failed, k.FailedPrev, true, ""), "#ef4444", "#fef2f2", IconX)
                </div>
            </div>
            <div class="qd-kgroup g-def">
                <div class="qd-kgroup-t">@T("Dashboard.DefectsCAPA")</div>
                <div class="qd-kpis qd-kpis-2">
                    @Kpi(T("Dashboard.DefectRate"), $"{k.DefectRate:0.##}%", Delta(k.DefectRate, k.DefectRatePrev, true, "%"), "#e11d48", "#fff1f2", IconPercent)
                    @Kpi(T("Dashboard.OpenCAPA"), k.OpenCapa?.ToString() ?? "0", ((k.OverdueCapa ?? 0) > 0 ? T("Dashboard.Overdue", k.OverdueCapa) : T("Dashboard.NoOverdueCAPA"), (k.OverdueCapa ?? 0) > 0 ? "bad" : "good"), "#dc2626", "#fef2f2", IconDoc)
                </div>
            </div>
        </div>

        <!-- ── KPI row 2: Key Volume & Resources ── -->
        <div class="qd-kgroup g-vol">
            <div class="qd-kgroup-t">@T("Dashboard.KeyVolumeResources")</div>
            <div class="qd-kpis qd-kpis-5">
                @Kpi(T("Dashboard.TotalProducts"), k.Products.ToString("N0"), NewDelta(k.ProductsNew), "#8b5cf6", "#f5f3ff", IconBox)
                @Kpi(T("Dashboard.TotalInspectors"), k.Inspectors.ToString("N0"), NewDelta(k.InspectorsNew), "#2563eb", "#eff6ff", IconInspector)
                @Kpi(T("Dashboard.TotalQuantityShipped"), T("Dashboard.N0N0Pcs", k.ShippedQty), Delta(k.ShippedQty, k.ShippedQtyPrev, false, ""), "#0ea5e9", "#f0f9ff", IconTruck, true)
                @Kpi(T("Dashboard.TotalVendors"), k.Vendors.ToString("N0"), NewDelta(k.VendorsNew), "#7c3aed", "#f5f3ff", IconFactory)
                @Kpi(T("Dashboard.TotalCustomers"), k.Customers.ToString("N0"), NewDelta(k.CustomersNew), "#06b6d4", "#ecfeff", IconUsers)
            </div>
        </div>
        </div>

        <!-- ── Charts row ── -->
        <div class="qd-grid-2">
            <!-- AQL Inspection Quantity & Defects -->
            <div class="qd-card">
                <div class="qd-card-head">
                    <span class="qd-card-title">@T("Dashboard.AQLInspectionQuantityDefectsMonthly")<span class="qd-hide-m"> — @_data.Year</span></span>
                    @VendorMini()
                </div>
                @((MarkupString)AqlChartSvg())
                <div class="qd-legend">
                    <span><i style="background:#2563eb"></i>@T("Dashboard.AQLQuantityPcs")</span>
                    <span><i style="background:#ef4444"></i>@T("Dashboard.CriticalDefect")</span>
                    <span><i style="background:#f59e0b"></i>@T("Dashboard.MajorDefect")</span>
                    <span><i style="background:#facc15"></i>@T("Dashboard.MinorDefect")</span>
                    <span><i class="qd-line-ico"></i>@T("Dashboard.DefectRate2")</span>
                </div>
                <div class="qd-tbl-wrap qd-hide-m">
                    <table class="qd-mtbl">
                        <thead><tr><th></th>@foreach (var mn in StackedBars.MonthLabels) { <th>@mn</th> }</tr></thead>
                        <tbody>
                            <tr><td>@T("Dashboard.AQLQuantityPcs")</td>@foreach (var m in _data.Monthly) { <td>@Num(m.AqlQty)</td> }</tr>
                            <tr class="c-crit"><td>@T("Dashboard.CriticalDefect")</td>@foreach (var m in _data.Monthly) { <td>@Num(m.Critical)</td> }</tr>
                            <tr class="c-maj"><td>@T("Dashboard.MajorDefect")</td>@foreach (var m in _data.Monthly) { <td>@Num(m.Major)</td> }</tr>
                            <tr class="c-min"><td>@T("Dashboard.MinorDefect")</td>@foreach (var m in _data.Monthly) { <td>@Num(m.Minor)</td> }</tr>
                            <tr class="fw"><td>@T("Dashboard.TotalDefects")</td>@foreach (var m in _data.Monthly) { <td>@Num(m.TotalDefects)</td> }</tr>
                            <tr class="c-rate"><td>@T("Dashboard.DefectRate2")</td>@foreach (var m in _data.Monthly) { <td>@(m.AqlQty > 0 ? $"{m.DefectRate:0.0}%" : "")</td> }</tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="qd-col">
                <!-- Monthly Inspections by Stage -->
                <div class="qd-card">
                    <div class="qd-card-head"><span class="qd-card-title">@T("Dashboard.MonthlyInspectionsByStage")<span class="qd-hide-m"> — @_data.Year</span></span>@VendorMini()</div>
                    <StackedBars Labels="StackedBars.MonthLabels" Height="@(_compact ? 110 : 130)" BarWidth="@(_compact ? 22 : 28)" MinSeg="@(_compact ? 13 : 15)"
                                 Series="@(new() {
                                     new(T("Dashboard.PreProductionPPI"),    "#10b981", _data.Monthly.Select(m => m.Ppi).ToList()),
                                     new(T("Dashboard.DuringProductionDPI"), "#3b82f6", _data.Monthly.Select(m => m.Dpi).ToList()),
                                     new(T("Dashboard.PreShipmentPSI"),      "#f59e0b", _data.Monthly.Select(m => m.Psi).ToList()),
                                     new(T("Dashboard.ContainerLoadingCheckCLC"), "#8b5cf6", _data.Monthly.Select(m => m.Clc).ToList()) })" />
                    <div class="qd-tbl-wrap">
                        <table class="qd-mtbl">
                            <thead><tr><th>@T("Dashboard.Stage")</th>@foreach (var mn in StackedBars.MonthLabels) { <th>@mn</th> }</tr></thead>
                            <tbody>
                                <tr><td>@T("Dashboard.PreProductionPPI")</td>@foreach (var m in _data.Monthly) { <td>@Num(m.Ppi)</td> }</tr>
                                <tr><td>@T("Dashboard.DuringProductionDPI")</td>@foreach (var m in _data.Monthly) { <td>@Num(m.Dpi)</td> }</tr>
                                <tr><td>@T("Dashboard.PreShipmentPSI")</td>@foreach (var m in _data.Monthly) { <td>@Num(m.Psi)</td> }</tr>
                                <tr><td>@T("Dashboard.ContainerLoadingCheckCLC")</td>@foreach (var m in _data.Monthly) { <td>@Num(m.Clc)</td> }</tr>
                                <tr class="fw"><td>@T("Dashboard.TotalInspections")</td>@foreach (var m in _data.Monthly) { <td>@Num(m.Total)</td> }</tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Monthly Quantity Shipped -->
                <div class="qd-card">
                    <div class="qd-card-head"><span class="qd-card-title">@T("Dashboard.MonthlyQuantityShippedPcs")<span class="qd-hide-m"> — @_data.Year</span></span>@CustomerMini()</div>
                    @((MarkupString)ShippedChartSvg())
                </div>
            </div>
        </div>

        <!-- ── Recent Inspections + Supplier / Vendor Performance ── -->
        <div class="qd-grid-2eq">
            <div class="qd-card">
                <div class="qd-card-head">
                    <span class="qd-card-title">@T("Dashboard.RecentInspections")</span>
                    <NavLink href="/inspections" class="qd-link">@T("Dashboard.ViewAll")</NavLink>
                </div>
                <div class="qd-tbl-wrap">
                    <table class="qd-ltbl qd-ltbl-sm">
                        <thead><tr><th>@T("Dashboard.InspectionNo")</th><th>@T("Common.Date")</th><th>@T("Common.Vendor")</th><th>@T("Common.Product")</th><th>@T("Dashboard.Stage")</th><th>@T("Common.Result")</th></tr></thead>
                        <tbody>
                            @foreach (var r in _data.RecentInspections)
                            {
                                <tr class="qd-click" @onclick="() => GoReport(r)">
                                    <td class="fw">@(r.JobNumber ?? "—")</td>
                                    <td>@r.Date.ToString("yyyy-MM-dd")</td>
                                    <td class="qd-vname" title="@r.Vendor">@r.Vendor</td>
                                    <td class="qd-vname" title="@r.Product">@r.Product</td>
                                    <td><span class="qd-stage @r.Stage.ToLower()">@r.Stage</span></td>
                                    <td><span class="qd-res @ResultCss(r)">@ResultLabel(r)</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="qd-card">
                <div class="qd-card-head">
                    <span class="qd-card-title">@T("Dashboard.SupplierVendorPerformance")</span>
                    <NavLink href="/vendor-reviews" class="qd-link">@T("Dashboard.ViewAll")</NavLink>
                </div>
                <div class="qd-tbl-wrap">
                <table class="qd-ltbl qd-ltbl-sm qd-vperf">
                    <thead><tr><th>@T("Common.Vendor")</th><th class="tr">@T("Dashboard.Insp")</th><th class="tr">@T("Dashboard.PassRate")</th><th class="tr">@T("Dashboard.DefectRate")</th><th class="tr">@T("Dashboard.CAPAOverdue")</th><th>@T("Dashboard.Trend")</th></tr></thead>
                    <tbody>
                        @if (!_data.VendorPerformance.Any()) { <tr><td colspan="6" class="qd-empty">@T("Dashboard.NoData")</td></tr> }
                        @foreach (var v in _data.VendorPerformance.Take(6))
                        {
                            <tr class="qd-click" @onclick="() => GoVendor(v.VendorId)">
                                <td class="qd-vname" title="@v.VendorName">@v.VendorName</td>
                                <td class="tr">@v.Inspections</td>
                                <td class="tr @(v.PassRate >= 95 ? "ok" : "bad")">@v.PassRate.ToString("0.#")%</td>
                                <td class="tr @(v.DefectRate <= 5 ? "ok" : "bad")">@v.DefectRate.ToString("0.0")%</td>
                                <td class="tr @((v.CapaOverdue ?? 0) > 0 ? "bad" : "")">@(v.CapaOverdue ?? 0)</td>
                                <td class="tc">@(v.Trend == "up" ? "↑" : v.Trend == "down" ? "↓" : "→")</td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>
        </div>

        <!-- ── Top 5 Defect Products + Top 5 Shipment Items ── -->
        <div class="qd-grid-2eq qd-top">
            <!-- Top 5 Defect Products -->
            <div class="qd-card">
                <div class="qd-card-head">
                    <span class="qd-card-title">@T("Dashboard.Top5DefectProductsDefects")</span>
                    <div class="qd-mini-sel">
                        <select @bind="_severity">
                            <option value="All">@T("Dashboard.AllSeverity")</option>
                            <option value="Critical">@T("Common.Critical")</option>
                            <option value="Major">@T("Common.Major")</option>
                            <option value="Minor">@T("Common.Minor")</option>
                        </select>
                        <select @bind="_defScope">
                            <option value="Month">@MonthAbbr(_data.Month) @_data.Year</option>
                            <option value="Year">@T("Dashboard.Year", _data.Year)</option>
                        </select>
                    </div>
                </div>
                @{
                    var src = _defScope == "Year" ? _data.TopDefectProductsYear : _data.TopDefectProductsMonth;
                    var sevTotal = src.Sum(SevValue);
                    var topDef = src.Where(x => SevValue(x) > 0).OrderByDescending(SevValue).Take(5).ToList();
                    var maxDef = Math.Max(1, topDef.Select(SevValue).DefaultIfEmpty(0).Max());
                    var barColors = new[] { "#ef4444", "#f97316", "#facc15", "#3b82f6", "#8b5cf6" };
                }
                <div class="qd-tbl-wrap">
                <table class="qd-ltbl">
                    <thead><tr><th>#</th><th>@T("Common.Product")</th><th>@T("Dashboard.MainDefect")</th><th class="tr">@T("Dashboard.TotalDefects")</th><th>@T("Dashboard.OfTotal")</th></tr></thead>
                    <tbody>
                        @if (!topDef.Any()) { <tr><td colspan="5" class="qd-empty">@T("Dashboard.NoDefectsRecorded")</td></tr> }
                        @for (int i = 0; i < topDef.Count; i++)
                        {
                            var r = topDef[i]; var v = SevValue(r);
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@ProductCell(r.Product, r.ItemNumber, r.PhotoUrl)</td>
                                <td class="qd-sub2">@r.MainDefect</td>
                                <td class="tr fw">@v.ToString("N0")</td>
                                <td><div class="qd-hbar"><div style="width:@Inv(100.0 * v / maxDef)%;background:@barColors[i]"></div><span>@(sevTotal > 0 ? Math.Round(100.0 * v / sevTotal) : 0)%</span></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>

            <!-- Top 5 Shipment Items -->
            <div class="qd-card">
                <div class="qd-card-head">
                    <span class="qd-card-title">@T("Dashboard.Top5ShipmentItemsQuantity")</span>
                    <div class="qd-mini-sel">
                        <select @bind="_shipScope">
                            <option value="Month">@MonthAbbr(_data.Month) @_data.Year</option>
                            <option value="Year">@T("Dashboard.Year", _data.Year)</option>
                        </select>
                    </div>
                </div>
                @{
                    var ships = _shipScope == "Year" ? _data.TopShipmentsYear : _data.TopShipmentsMonth;
                    var maxShip = Math.Max(1, ships.Select(x => x.Qty).DefaultIfEmpty(0).Max());
                }
                <div class="qd-tbl-wrap">
                <table class="qd-ltbl">
                    <thead><tr><th>#</th><th>@T("Common.Product")</th><th class="tr">@T("Dashboard.QtyShipped")</th><th>@T("Dashboard.OfTotal")</th></tr></thead>
                    <tbody>
                        @if (!ships.Any()) { <tr><td colspan="4" class="qd-empty">@T("Dashboard.NoShipmentRecorded")</td></tr> }
                        @for (int i = 0; i < ships.Count; i++)
                        {
                            var r = ships[i];
                            <tr>
                                <td>@(i + 1)</td>
                                <td>@ProductCell(r.Product, r.ItemNumber, r.PhotoUrl)</td>
                                <td class="tr fw">@r.Qty.ToString("N0")</td>
                                <td><div class="qd-hbar"><div style="width:@Inv(100.0 * r.Qty / maxShip)%;background:#3b82f6"></div><span>@r.Pct.ToString("0")%</span></div></td>
                            </tr>
                        }
                    </tbody>
                </table>
                </div>
            </div>

        </div>

        <!-- ── Top Customers / Inspectors / Vendors ── -->
        <div class="qd-grid-3eq">
            @RankCard(T("Dashboard.TopCustomers"), T("Dashboard.MostInspections") + _data.Year, _data.TopCustomers)
            @RankCard(T("Dashboard.TopInspectors"), T("Dashboard.MostJobs") + _data.Year, _data.TopInspectors)
            @RankCard(T("Dashboard.TopVendors"), T("Dashboard.MostInspections") + _data.Year, _data.TopVendors)
        </div>

        </div>
    }

</div>

</PageAccessGuard>

@code {
    DashboardDto? _data;
    bool _loading = true;
    string? _error;
    int _year = DateTime.Now.Year, _month = DateTime.Now.Month;
    bool _fOpen;   // điện thoại: ẩn/hiện khối bộ lọc
    string _vendor = "", _customer = "", _category = "";
    string _severity = "All", _defScope = "Year", _shipScope = "Month";

    bool _compact;
    DotNetObjectReference<Dashboard>? _ref;

    protected override async Task OnInitializedAsync() => await LoadData();

    // Điện thoại: vẽ lại SVG theo bề ngang hẹp để chữ không bị thu nhỏ
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _ref = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("eval", @"window.__qdResize = function(ref){
                var last = null;
                function chk(){ var c = window.innerWidth < 760; if (c !== last){ last = c; ref.invokeMethodAsync('SetCompact', c); } }
                window.__qdResizeFn && window.removeEventListener('resize', window.__qdResizeFn);
                window.__qdResizeFn = chk; window.addEventListener('resize', chk); chk(); };");
            await JS.InvokeVoidAsync("__qdResize", _ref);
        }
        catch { }
    }

    [JSInvokable] public void SetCompact(bool c) { if (_compact != c) { _compact = c; StateHasChanged(); } }

    protected override void Dispose(bool disposing)
    {
        base.Dispose(disposing);
        try { _ = JS.InvokeVoidAsync("eval", "window.__qdResizeFn && window.removeEventListener('resize', window.__qdResizeFn)"); } catch { }
        _ref?.Dispose();
    }

    static IEnumerable<(int, int)> PeriodOptions()
    {
        var end = new DateTime(DateTime.Now.Year, 12, 1);
        for (var d = end; d >= new DateTime(2026, 1, 1); d = d.AddMonths(-1)) yield return (d.Year, d.Month);
    }

    async Task OnPeriod(ChangeEventArgs e)
    {
        var parts = (e.Value?.ToString() ?? "").Split('-');
        if (parts.Length == 2 && int.TryParse(parts[0], out var y) && int.TryParse(parts[1], out var m)) { _year = y; _month = m; }
        await LoadData();
    }

    // Ô sản phẩm: ảnh thu nhỏ + tên + mã
    RenderFragment ProductCell(string name, string? item, string? photo) => __builder =>
    {
        <div class="qd-pcell">
            <div class="qd-pimg">
                @if (!string.IsNullOrEmpty(photo)) { <img src="@MediaUrl.Resolve(photo, Http.BaseAddress?.ToString())" alt="" loading="lazy" /> }
                else { <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">@((MarkupString)IconBox)</svg> }
            </div>
            <div style="min-width:0"><div class="qd-prod">@name</div><div class="qd-sub">@item</div></div>
        </div>
    };

    RenderFragment VendorMini() => __builder =>
    {
        <select class="qd-mini" value="@_vendor" @onchange="e => OnFilter(() => _vendor = e.Value?.ToString() ?? string.Empty)">
            <option value="">@T("Dashboard.AllFactories")</option>
            @foreach (var v in _data?.Filters.Vendors ?? new()) { <option value="@v.Id">@v.Name</option> }
        </select>
    };

    RenderFragment CustomerMini() => __builder =>
    {
        <select class="qd-mini" value="@_customer" @onchange="e => OnFilter(() => _customer = e.Value?.ToString() ?? string.Empty)">
            <option value="">@T("Dashboard.AllCustomers")</option>
            @foreach (var c in _data?.Filters.Customers ?? new()) { <option value="@c.Id">@c.Name</option> }
        </select>
    };

    async Task OnFilter(Action apply) { apply(); await LoadData(); }

    async Task LoadData()
    {
        _loading = true;
        _error = null;
        StateHasChanged();
        try
        {
            var url = $"api/inspections/dashboard?year={_year}&month={_month}"
                    + $"&vendorId={Uri.EscapeDataString(_vendor)}&customerId={Uri.EscapeDataString(_customer)}&category={Uri.EscapeDataString(_category)}";
            _data = await Http.GetFromJsonAsync<DashboardDto>(url,
                new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
        }
        catch (Exception ex) { _error = ex.Message; }
        _loading = false;
    }

    void GoReport(RecentDto r)
    {
        if (r.ClcId.HasValue) Navigation.NavigateTo($"/clc/{r.ClcId}/report");
        else if (!string.IsNullOrEmpty(r.JobNumber)) Navigation.NavigateTo("/inspection-report/" + r.JobNumber);
    }
    void GoVendor(string? vendorId)
    {
        if (!string.IsNullOrEmpty(vendorId)) Navigation.NavigateTo("/vendor-reviews/" + vendorId);
    }

    int SevValue(DefectProductDto x) => _severity switch
    {
        "Critical" => x.Critical, "Major" => x.Major, "Minor" => x.Minor, _ => x.Defects
    };

    // ResultText giữ tiếng Anh vì dùng làm class CSS; hiển thị qua ResultLabel
    static string ResultText(RecentDto r) => r.Status == "Completed"
        ? (r.Result == "PASSED" ? "Passed" : r.Result == "FAILED" ? "Failed" : r.Result == "HOLD" ? "Hold" : r.Result ?? "Done")
        : r.Status == "Cancelled" ? "Cancelled" : "Awaiting";
    static string ResultCss(RecentDto r) => ResultText(r).ToLower();
    string ResultLabel(RecentDto r) => TE("Status", ResultText(r));

    // ── Helpers ───────────────────────────────────────────────────────────────
    static readonly CultureInfo Inv0 = CultureInfo.InvariantCulture;
    static string Inv(double v) => v.ToString("0.##", Inv0);
    string MonthAbbr(int m) => StackedBars.MonthLabels[m - 1];
    static string Num(int v) => v > 0 ? v.ToString("N0") : "";
    static string Short(double v) => v >= 1000 ? (v / 1000).ToString(v >= 10000 ? "0" : "0.#", Inv0) + "K" : v.ToString("0", Inv0);

    /// <summary>(text, dir) — dir: up/down/flat; worseWhenUp đảo màu (vd Failed tăng là xấu).</summary>
    (string Text, string Dir) Delta(double cur, double prev, bool worseWhenUp, string unit)
    {
        var d = Math.Round(cur - prev, 2);
        if (Math.Abs(d) < 0.005) return ("0" + unit + T("Dashboard.VsLastMonth2"), "flat");
        var good = worseWhenUp ? d < 0 : d > 0;
        return (T("Dashboard.VsLastMonth", (d > 0 ? "↑" : "↓"), Math.Abs(d).ToString("0.##", Inv0), unit), good ? "good" : "bad");
    }
    (string Text, string Dir) NewDelta(int n) => n > 0 ? (T("Dashboard.NewThisMonth", n), "good") : (T("Dashboard.N0NewThisMonth"), "flat");

    RenderFragment Kpi(string label, string value, (string Text, string Dir) delta, string color, string bg, string iconPath, bool wide = false) => __builder =>
    {
        var dParts = delta.Text.Split('|');
        <div class="qd-kpi @(wide ? "wide" : "")">
            <div class="qd-kpi-ico" style="background:@bg;color:@color">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">@((MarkupString)iconPath)</svg>
            </div>
            <div class="qd-kpi-body">
                <div class="qd-kpi-lbl">@label</div>
                <div class="qd-kpi-val">@value</div>
                <div class="qd-kpi-delta @delta.Dir"><b>@dParts[0]</b>@if (dParts.Length > 1) { <span>@dParts[1]</span> }</div>
            </div>
        </div>
    };

    RenderFragment RankCard(string title, string sub, List<RankDto> items) => __builder =>
    {
        <div class="qd-card">
            <div class="qd-card-head"><span class="qd-card-title">@title</span><span class="qd-rank-sub">@sub</span></div>
            @if (!items.Any()) { <div class="qd-empty">@T("Dashboard.NoData2")</div> }
            @for (int i = 0; i < items.Count; i++)
            {
                var r = items[i];
                <div class="qd-rank-row">
                    <span class="qd-rank-num">@(i + 1)</span>
                    <div class="qd-rank-info"><div class="qd-rank-name">@r.Name</div><div class="qd-rank-id">@r.Id</div></div>
                    <span class="qd-rank-count">@r.Count</span>
                </div>
            }
        </div>
    };

    // ── SVG charts (dựng chuỗi để tránh giới hạn thẻ <text> của Razor) ────────
    static double NiceMax(double v)
    {
        if (v <= 0) return 1;
        var exp = Math.Pow(10, Math.Floor(Math.Log10(v)));
        foreach (var f in new[] { 1, 2, 2.5, 5, 10 }) if (v <= f * exp) return f * exp;
        return 10 * exp;
    }
    static string X(double v) => v.ToString("0.#", Inv0);

    string AqlChartSvg()
    {
        double W = _compact ? 380 : 640, H = _compact ? 230 : 280, L = _compact ? 40 : 50, Rr = _compact ? 36 : 40, T = 18, B = 26;
        double pw = W - L - Rr, ph = H - T - B, slot = pw / 12, bw = Math.Min(26, slot * 0.62);
        var ms = _data!.Monthly;
        var maxQ = NiceMax(ms.Max(m => (double)(m.AqlQty + m.TotalDefects)));
        var maxR = NiceMax(Math.Max(1, ms.Max(m => m.DefectRate)));
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {W} {H}' class='qd-svg' preserveAspectRatio='xMidYMid meet'>");
        for (int g = 0; g <= 5; g++)
        {
            var y = T + ph - ph * g / 5;
            sb.Append($"<line x1='{L}' x2='{W - Rr}' y1='{X(y)}' y2='{X(y)}' stroke='#eef1f6'/>");
            sb.Append($"<text x='{L - 6}' y='{X(y + 3)}' text-anchor='end' font-size='11' fill='#6b7280'>{Short(maxQ * g / 5)}</text>");
            sb.Append($"<text x='{W - Rr + 6}' y='{X(y + 3)}' font-size='11' fill='#16a34a'>{X(maxR * g / 5)}%</text>");
        }
        var pts = new List<string>();
        for (int i = 0; i < 12; i++)
        {
            var m = ms[i];
            var cx = L + slot * i + slot / 2;
            double y0 = T + ph;
            void Seg(int v, string color, string name)
            {
                if (v <= 0) return;
                var h = ph * v / maxQ;
                y0 -= h;
                sb.Append($"<rect x='{X(cx - bw / 2)}' y='{X(y0)}' width='{X(bw)}' height='{X(Math.Max(h, 0.8))}' fill='{color}'><title>{StackedBars.MonthLabels[i]} · {name}: {v:N0}</title></rect>");
            }
            Seg(m.AqlQty, "#2563eb", this.L.Get("Dashboard.AQLQuantity"));
            Seg(m.Critical, "#ef4444", this.L.Get("Common.Critical"));
            Seg(m.Major, "#f59e0b", this.L.Get("Common.Major"));
            Seg(m.Minor, "#facc15", this.L.Get("Common.Minor"));
            if (m.AqlQty + m.TotalDefects > 0)
                sb.Append($"<text x='{X(cx)}' y='{X(y0 - 4)}' text-anchor='middle' font-size='11.5' font-weight='700' fill='#1a2d5a'>{Short(m.AqlQty)}</text>");
            sb.Append($"<text x='{X(cx)}' y='{H - 8}' text-anchor='middle' font-size='11.5' fill='#6b7280'>{StackedBars.MonthLabels[i]}</text>");
            if (m.AqlQty > 0) pts.Add($"{X(cx)},{X(T + ph - ph * m.DefectRate / maxR)}");
        }
        if (pts.Count > 1) sb.Append($"<polyline points='{string.Join(' ', pts)}' fill='none' stroke='#10b981' stroke-width='2'/>");
        foreach (var p in pts) { var xy = p.Split(','); sb.Append($"<circle cx='{xy[0]}' cy='{xy[1]}' r='3.2' fill='#fff' stroke='#10b981' stroke-width='2'/>"); }
        sb.Append($"<text x='12' y='{X(T + ph / 2)}' font-size='11.5' fill='#2563eb' transform='rotate(-90 12 {X(T + ph / 2)})' text-anchor='middle'>{this.L.Get("Dashboard.QuantityPcs")}</text>");
        sb.Append($"<text x='{W - 6}' y='{X(T + ph / 2)}' font-size='11.5' fill='#16a34a' transform='rotate(90 {W - 6} {X(T + ph / 2)})' text-anchor='middle'>{this.L.Get("Dashboard.DefectRatePct")}</text>");
        sb.Append("</svg>");
        return sb.ToString();
    }

    string ShippedChartSvg()
    {
        double W = _compact ? 380 : 560, H = _compact ? 175 : 190, L = 40, Rr = 8, T = 18, B = 24;
        double pw = W - L - Rr, ph = H - T - B, slot = pw / 12, bw = Math.Min(24, slot * 0.6);
        var ms = _data!.Monthly;
        var maxQ = NiceMax(ms.Max(m => (double)m.ShippedQty));
        var sb = new System.Text.StringBuilder();
        sb.Append($"<svg viewBox='0 0 {W} {H}' class='qd-svg' preserveAspectRatio='xMidYMid meet'>");
        for (int g = 0; g <= 4; g++)
        {
            var y = T + ph - ph * g / 4;
            sb.Append($"<line x1='{L}' x2='{W - Rr}' y1='{X(y)}' y2='{X(y)}' stroke='#eef1f6'/>");
            sb.Append($"<text x='{L - 6}' y='{X(y + 3)}' text-anchor='end' font-size='11' fill='#6b7280'>{Short(maxQ * g / 4)}</text>");
        }
        for (int i = 0; i < 12; i++)
        {
            var v = ms[i].ShippedQty;
            var cx = L + slot * i + slot / 2;
            if (v > 0)
            {
                var h = ph * v / maxQ;
                sb.Append($"<rect x='{X(cx - bw / 2)}' y='{X(T + ph - h)}' width='{X(bw)}' height='{X(h)}' rx='3' fill='#8b5cf6'><title>{StackedBars.MonthLabels[i]}: {v:N0} {this.L.Get("Common.Pcs")}</title></rect>");
                sb.Append($"<text x='{X(cx)}' y='{X(T + ph - h - 4)}' text-anchor='middle' font-size='11.5' font-weight='700' fill='#1a2d5a'>{Short(v)}</text>");
            }
            sb.Append($"<text x='{X(cx)}' y='{H - 6}' text-anchor='middle' font-size='11.5' fill='#6b7280'>{StackedBars.MonthLabels[i]}</text>");
        }
        sb.Append("</svg>");
        return sb.ToString();
    }

