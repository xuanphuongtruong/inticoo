@* Thẻ một mục trong popup "View" (Inspector / Product / Customer / Vendor): icon + tiêu đề + các dòng nhãn–giá trị. *@
<div class="vc-card @Class">
    <div class="vc-head">
        <span class="vc-ico">@IconSvg()</span>
        <span class="vc-title">@Title</span>
    </div>
    <div class="vc-body">@ChildContent</div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    /// <summary>building | user | pin | briefcase | doc | box | layers | image</summary>
    [Parameter] public string Icon { get; set; } = "building";
    [Parameter] public string? Class { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private MarkupString IconSvg()
    {
        const string a = "<svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\">";
        var p = Icon switch
        {
            "user"      => "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/>",
            "pin"       => "<path d=\"M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z\"/><circle cx=\"12\" cy=\"10\" r=\"2.5\"/>",
            "briefcase" => "<rect x=\"3\" y=\"7\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18\"/>",
            "doc"       => "<path d=\"M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z\"/><path d=\"M14 3v5h5M9 13h6M9 17h6\"/>",
            "box"       => "<path d=\"M21 8l-9-5-9 5v8l9 5 9-5z\"/><path d=\"M3 8l9 5 9-5M12 13v8\"/>",
            "layers"    => "<path d=\"M12 3l9 5-9 5-9-5z\"/><path d=\"M3 13l9 5 9-5\"/>",
            "image"     => "<rect x=\"3\" y=\"4\" width=\"18\" height=\"16\" rx=\"2\"/><circle cx=\"9\" cy=\"10\" r=\"1.6\"/><path d=\"M21 16l-5-5-8 8\"/>",
            _           => "<rect x=\"5\" y=\"3\" width=\"14\" height=\"18\" rx=\"1\"/><path d=\"M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2\"/>"
        };
        return new MarkupString(a + p + "</svg>");
    }
}
