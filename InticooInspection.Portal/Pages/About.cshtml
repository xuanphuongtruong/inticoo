@page
@{ ViewData["Title"] = L["About Us"]; }
<section class="hero small">
  <div class="wrap">
    <div>
      <span class="eyebrow">@L["About Us"]</span>
      <h1>@L["A New Approach to Quality Inspection Management"]</h1>
      <p class="lead">@L["Inticoo provides a modern, easy-to-use inspection platform to help businesses manage product quality, suppliers and corrective actions — built on more than 20 years of quality experience supporting US and European quality standards."]</p>
    </div>
  </div>
</section>
<section class="sec">
  <div class="wrap" style="max-width:860px">
    <span class="eyebrow">@L["Our Story"]</span>
    <h2>@L["Founded in February 2026"]</h2>
    <p>@L["Inticoo was established in Kuala Lumpur, Malaysia, with a simple mission — to make quality inspections easier, faster and more effective for businesses across the global supply chain."]</p>
    <p>@L["Building on more than 20 years of experience in quality management for US and European markets, our team understands international quality standards and the real challenges faced by manufacturers, suppliers and buyers. We created Inticoo to bring this experience together in a modern, secure and user-friendly digital platform."]</p>
  </div>
</section>
<section class="sec alt">
  <div class="wrap">
    <div class="grid g3">
      <div class="card"><span class="eyebrow">@L["Our Mission"]</span><h3>@L["Empower Businesses with Better Quality"]</h3><p>@L["To provide practical and innovative digital tools that help companies ensure higher product quality, improve efficiency and build stronger, more reliable supply chains."]</p></div>
      <div class="card"><span class="eyebrow">@L["Our Vision"]</span><h3>@L["A Trusted Global Platform for Quality Management"]</h3><p>@L["To become a leading digital platform for quality inspection and supplier management, trusted by businesses of all sizes in meeting international quality standards."]</p></div>
      <div class="card"><span class="eyebrow">@L["Our Values"]</span><h3>@L["Simplicity. Trust. Results."]</h3>
        <ul class="ticks"><li>@L["Customer Focus"]</li><li>@L["Practical Innovation"]</li><li>@L["Data Security"]</li><li>@L["Integrity and Partnership"]</li><li>@L["Continuous Improvement"]</li></ul></div>
    </div>
  </div>
</section>
<section class="sec">
  <div class="wrap">
    <div class="sec-head"><span class="eyebrow">@L["Our Experience"]</span><h2>@L["More Than 20 Years of Quality Experience"]</h2></div>
    <div class="grid g3">
      <div class="card"><span class="ico">@Icons.Svg("doc")</span><h3>@L["Quality Standards"]</h3><p>@L["In-depth knowledge of US and European quality requirements."]</p></div>
      <div class="card"><span class="ico">@Icons.Svg("settings")</span><h3>@L["Practical Experience"]</h3><p>@L["Real-world experience in manufacturing, inspection and supplier management."]</p></div>
      <div class="card"><span class="ico">@Icons.Svg("globe")</span><h3>@L["Global Perspective"]</h3><p>@L["Understanding of international markets and supply chain challenges."]</p></div>
    </div>
    <div class="center" style="margin-top:32px"><a class="btn lg" href="/register">@L["Get Started"] →</a></div>
  </div>
</section>
