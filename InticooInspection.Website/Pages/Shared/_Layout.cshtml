@inject Microsoft.Extensions.Configuration.IConfiguration Cfg
@{
    var path = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
    string On(string p) => (p == "/" ? path == "/" : path.StartsWith(p)) ? "on" : "";
    var appUrl = Cfg["Portal:AppUrl"] ?? "#";
    string LangUrl(string l)
    {
        var q = Context.Request.Query.Where(kv => kv.Key != "lang").Select(kv => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(kv.Value.ToString())}").ToList();
        q.Add("lang=" + l);
        return Context.Request.Path + "?" + string.Join("&", q);
    }
    var title = ViewData["Title"] is string t && t.Length > 0 ? t + " — Inticoo" : "Inticoo — " + L["Simple Inspections. Better Quality."];
}
<!doctype html>
<html lang="@(L.Lang == "zh" ? "zh-Hans" : L.Lang)">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    <meta name="description" content="@(ViewData["Desc"] ?? L["A powerful inspection platform to manage product inspections, loading container checks, suppliers, CAPA and quality data."])" />
    <link rel="icon" href="/img/favicon.png" />
    <link rel="stylesheet" href="/css/site.css?v=5" />
</head>
<body>
<header class="site-header">
    <div class="wrap">
        <a class="brand" href="/"><b>Inticoo</b><small>QUALITY BEYOND BORDERS</small></a>
        <nav class="nav" id="nav">
            <a href="/" class="@On("/")">@L["Home"]</a>
            <a href="/features" class="@On("/features")">@L["Features"]</a>
            <a href="/pricing" class="@On("/pricing")">@L["Pricing"]</a>
            <details class="dd @On("/resources")">
                <summary>@L["Resources"] @Icons.Svg("chevron", 14)</summary>
                <div class="dd-menu">
                    <a href="/resources">@Icons.Svg("book", 18) @L["All Resources"]</a>
                    <a href="/resources#guides">@Icons.Svg("clipboard", 18) @L["Inspection Guides"]</a>
                    <a href="/resources#standards">@Icons.Svg("doc", 18) @L["AQL Standards"]</a>
                    <a href="/resources#learning">@Icons.Svg("cap", 18) @L["Learning Center"]</a>
                    <a href="/resources#faq">@Icons.Svg("help", 18) @L["FAQs"]</a>
                </div>
            </details>
            <a href="/about" class="@On("/about")">@L["About Us"]</a>
            <a href="/contact" class="@On("/contact")">@L["Contact Us"]</a>
            <a href="@appUrl" class="m-only" rel="noopener">@L["Login"]</a>
            <a href="/register" class="m-only">@L["Register & Subscribe"]</a>
        </nav>
        <div class="hdr-actions">
            <details class="lang">
                <summary>@Icons.Svg("globe", 20) <span>@Ui.Short(L.Lang)</span> @Icons.Svg("chevron", 14)</summary>
                <div class="dd-menu">
                    @foreach (var l in LocalizationStore.Supported)
                    {
                        <a href="@LangUrl(l)" class="@(l == L.Lang ? "on" : "")">@Ui.Flag(l) @LocalizationStore.Meta[l].Native</a>
                    }
                </div>
            </details>
            <a class="btn ghost" href="@appUrl" rel="noopener">@L["Login"]</a>
            <a class="btn" href="/register">@L["Register & Subscribe"]</a>
            <button class="burger" id="burger" aria-label="Menu">☰</button>
        </div>
    </div>
</header>

@RenderBody()

<footer class="site-footer">
    <div class="wrap">
        <div class="cols">
            <div>
                <a class="brand" href="/"><b>Inticoo</b><small>QUALITY BEYOND BORDERS</small></a>
                <div class="soc">
                    <a href="https://www.linkedin.com" rel="noopener" aria-label="LinkedIn">@Icons.Svg("linkedin")</a>
                    <a href="https://www.youtube.com" rel="noopener" aria-label="YouTube">@Icons.Svg("youtube")</a>
                </div>
            </div>
            <div><h4>@L["Product"]</h4><a href="/features">@L["Features"]</a><a href="/pricing">@L["Pricing"]</a><a href="/resources">@L["Resources"]</a><a href="/about">@L["About Us"]</a></div>
            <div><h4>@L["Resources"]</h4><a href="/resources#guides">@L["Inspection Guides"]</a><a href="/resources#standards">@L["AQL Standards"]</a><a href="/resources#guides">@L["Checklists"]</a><a href="/features">@L["Supplier Management"]</a><a href="/resources#learning">@L["Case Studies"]</a></div>
            <div><h4>@L["Support"]</h4><a href="/resources#faq">@L["Help Center"]</a><a href="/resources#faq">@L["FAQs"]</a><a href="/contact">@L["Contact Us"]</a></div>
            <div class="ct">
                <h4>@L["Contact Us"]</h4>
                <div>@Icons.Svg("pin")<span>Suite 8-2, Tower Block,<br />Menara Milenium,<br />No. 8, Jalan Damanlela,<br />Damansara Heights,<br />50490 Kuala Lumpur, Malaysia.</span></div>
                <div>@Icons.Svg("mail")<a href="mailto:info@inticoo.com">info@inticoo.com</a></div>
            </div>
        </div>
        <div class="copy">
            <span>© @DateTime.UtcNow.Year Inticoo Global Services. @L["All rights reserved."]</span>
            <span><a href="/terms">@L["Terms of Service"]</a> · <a href="/privacy">@L["Privacy Policy"]</a></span>
        </div>
    </div>
</footer>
<script src="/js/site.js?v=3"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
