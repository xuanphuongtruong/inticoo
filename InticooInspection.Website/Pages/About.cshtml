@page
@{ ViewData["Title"] = L["About Us"]; }
<section class="hero photo">
  <div class="wrap">
    <div class="txt">
      <span class="eyebrow">@L["About Us"]</span>
      <h1>@L["A New Approach to Quality Inspection Management"]</h1>
      <p class="lead">@L["Inticoo provides a modern, easy-to-use inspection platform to help businesses manage product quality, suppliers and corrective actions — built on more than 20 years of quality experience supporting US and European quality standards."]</p>
      <a class="btn" href="#story">@L["Our Story"] →</a>
    </div>
    <div class="pic"><img src="/img/photos/about-hero.jpg" alt="" /></div>
  </div>
</section>

<section class="sec tight" id="story">
  <div class="wrap story">
    <img src="/img/photos/about-office.jpg" alt="@L["Inticoo office"]" loading="lazy" />
    <div>
      <span class="eyebrow">@L["Our Story"]</span>
      <h2>@L["Founded in February 2026"]</h2>
      <p>@L["Inticoo was established in Kuala Lumpur, Malaysia, with a simple mission — to make quality inspections easier, faster and more effective for businesses across the global supply chain."]</p>
      <p>@L["Building on more than 20 years of experience in quality management for US and European markets, our team understands international quality standards and the real challenges faced by manufacturers, suppliers and buyers. We created Inticoo to bring this experience together in a modern, secure and user-friendly digital platform."]</p>
    </div>
  </div>
</section>

<section class="sec tight" style="padding-top:0">
  <div class="wrap grid g3 mvv">
    <div class="card c1"><div class="hd">@Icons.Svg("mountain")<div><span class="eyebrow">@L["Our Mission"]</span><h3>@L["Empower Businesses with Better Quality"]</h3></div></div>
      <p>@L["To provide practical and innovative digital tools that help companies ensure higher product quality, improve efficiency and build stronger, more reliable supply chains."]</p></div>
    <div class="card c2"><div class="hd">@Icons.Svg("eye")<div><span class="eyebrow">@L["Our Vision"]</span><h3>@L["A Trusted Global Platform for Quality Management"]</h3></div></div>
      <p>@L["To become a leading digital platform for quality inspection and supplier management, trusted by businesses of all sizes in meeting international quality standards."]</p></div>
    <div class="card c3"><div class="hd">@Icons.Svg("diamond")<div><span class="eyebrow">@L["Our Values"]</span><h3>@L["Simplicity. Trust. Results."]</h3></div></div>
      <ul class="vals">
        <li>@Icons.Svg("checkcircle") @L["Customer Focus"]</li><li>@Icons.Svg("users") @L["Practical Innovation"]</li><li>@Icons.Svg("shield") @L["Data Security"]</li>
        <li>@Icons.Svg("handshake") @L["Integrity and Partnership"]</li><li>@Icons.Svg("star") @L["Continuous Improvement"]</li>
      </ul></div>
  </div>
</section>

<section class="sec alt tight">
  <div class="wrap exp">
    <div>
      <span class="eyebrow">@L["Our Experience"]</span>
      <h2>@L["More Than 20 Years of Quality Experience"]</h2>
      <p class="muted">@L["Our team brings together more than 20 years of hands-on experience in manufacturing, quality inspection and supply chain management, with deep understanding of US and European quality standards, product specifications and compliance requirements."]</p>
    </div>
    <div class="grid g3">
      <div class="card pc"><img src="/img/photos/about-exp1.jpg" alt="" loading="lazy" /><div class="b">@Icons.Svg("doc")<h3>@L["Quality Standards"]</h3><p class="muted">@L["In-depth knowledge of US and European quality requirements."]</p></div></div>
      <div class="card pc"><img src="/img/photos/about-exp2.jpg" alt="" loading="lazy" /><div class="b">@Icons.Svg("settings")<h3>@L["Practical Experience"]</h3><p class="muted">@L["Real-world experience in manufacturing, inspection and supplier management."]</p></div></div>
      <div class="card pc"><img src="/img/photos/about-exp3.jpg" alt="" loading="lazy" /><div class="b">@Icons.Svg("globe")<h3>@L["Global Perspective"]</h3><p class="muted">@L["Understanding of international markets and supply chain challenges."]</p></div></div>
    </div>
  </div>
</section>

<section class="commit">
  <img src="/img/photos/about-commit.jpg" alt="" loading="lazy" />
  <div style="padding:36px 20px 36px 0;max-width:560px">
    <span class="eyebrow">@L["Our Commitment"]</span>
    <h2>@L["Continuously Innovating for Better Quality"]</h2>
    <p class="muted">@L["We are committed to continuously improving Inticoo with the latest technology and industry best practices to help our users achieve higher product quality, stronger supplier performance and more efficient operations."]</p>
    <a class="btn lg" href="/register">@L["Get Started"] →</a>
  </div>
</section>
