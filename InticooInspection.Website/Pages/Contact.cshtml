@page
@model ContactModel
@{ ViewData["Title"] = L["Contact Us"]; }
<section class="hero photo">
  <div class="wrap">
    <div class="txt">
      <span class="eyebrow">@L["Contact Us"]</span>
      <h1>@L["Let's Talk About Better Quality"]</h1>
      <p class="lead" style="color:var(--ink);font-size:1.15rem">@L["Have questions, want to book a demo or need more information? Our team is here to help you find the right solution for your business."]</p>
    </div>
    <div class="pic"><img src="/img/photos/contact-hero.jpg" alt="" /></div>
  </div>
</section>
<div class="wrap contact-grid">
  <div class="form-card">
    <h2>@L["Send Us a Message"]</h2>
    <p class="muted">@L["Fill in the form below and our team will get back to you shortly."]</p>
    @if (Model.Sent) { <div class="alert ok">@L["Thank you! Your message has been sent. We will get back to you shortly."]</div> }
    <form method="post" novalidate>
      <div asp-validation-summary="ModelOnly" class="alert err"></div>
      <div class="row2">
        <div class="field"><label class="req" for="FullName">@L["Full Name"]</label><input type="text" id="FullName" asp-for="FullName" maxlength="150" placeholder="@L["Enter your full name"]" required /><span asp-validation-for="FullName" class="err"></span></div>
        <div class="field"><label class="req" for="CompanyName">@L["Company Name"]</label><input type="text" id="CompanyName" asp-for="CompanyName" maxlength="200" placeholder="@L["Enter your company name"]" required /><span asp-validation-for="CompanyName" class="err"></span></div>
      </div>
      <div class="field"><label class="req" for="Email">@L["Email Address"]</label><input type="email" id="Email" asp-for="Email" maxlength="200" placeholder="@L["Enter your email address"]" required /><span asp-validation-for="Email" class="err"></span></div>
      <div class="row2">
        <div class="field"><label class="req" for="Country">@L["Country / Region"]</label>
          <select id="Country" asp-for="Country" required>
            <option value="">@L["Select country / region"]</option>
            @foreach (var c in CountryList.All) { <option value="@c.Name" selected="@(Model.Country == c.Name)">@c.Name</option> }
          </select><span asp-validation-for="Country" class="err"></span></div>
        <div class="field"><label class="req" for="Subject">@L["Subject"]</label>
          <select id="Subject" asp-for="Subject" required>
            <option value="">@L["Select a subject"]</option>
            @foreach (var s in ContactModel.Subjects) { <option value="@s" selected="@(Model.Subject == s)">@L[s]</option> }
          </select><span asp-validation-for="Subject" class="err"></span></div>
      </div>
      <div class="field"><label class="req" for="Message">@L["Message"]</label><textarea id="Message" asp-for="Message" maxlength="500" placeholder="@L["Tell us how we can help you..."]" required></textarea>
        <div class="hint" style="text-align:right" id="msg-count">0/500</div><span asp-validation-for="Message" class="err"></span></div>
      <div class="hp" aria-hidden="true"><input type="text" asp-for="Hp" tabindex="-1" autocomplete="off" /></div>
      <button class="btn lg" type="submit">@L["Send Message"] →</button>
    </form>
  </div>
  <div>
    <div class="form-card" style="margin-bottom:22px">
      <h2>@L["Contact Information"]</h2>
      <p class="muted" style="margin-bottom:6px">@L["You can also reach us through the following:"]</p>
      <div class="ci-row"><span class="circ"><span>@Icons.Svg("mail")</span></span><div><b>@L["Email"]</b><a href="mailto:info@inticoo.com">info@inticoo.com</a></div></div>
      <div class="ci-row"><span class="circ"><span>@Icons.Svg("clock")</span></span><div><b>@L["Business Hours"]</b>@L["Monday – Friday"]<br />9:00 AM – 6:00 PM (MYT)</div></div>
    </div>
    <h2 style="font-size:1.45rem;margin-bottom:.15em">@L["How Can We Help?"]</h2>
    <p class="muted">@L["Choose the option that best fits your needs."]</p>
    <div class="grid g2" style="gap:14px">
      <a class="help-tile" href="/contact?subject=Book a Demo#Subject">@Icons.Svg("calendar")<span><b>@L["Book a Demo"]</b><small>@L["See Inticoo in action"]</small></span>@Icons.Svg("arrow", 18)</a>
      <a class="help-tile" href="/contact?subject=Request a Quote#Subject">@Icons.Svg("doc")<span><b>@L["Request a Quote"]</b><small>@L["Get a custom plan"]</small></span>@Icons.Svg("arrow", 18)</a>
      <a class="help-tile" href="/contact?subject=General Enquiry#Subject">@Icons.Svg("headset")<span><b>@L["General Enquiry"]</b><small>@L["Product and features"]</small></span>@Icons.Svg("arrow", 18)</a>
      <a class="help-tile" href="/contact?subject=Partnership#Subject">@Icons.Svg("handshake")<span><b>@L["Partnership"]</b><small>@L["Let's work together"]</small></span>@Icons.Svg("arrow", 18)</a>
    </div>
  </div>
</div>
<div class="band"><div class="wrap grid g4">
  <div>@Icons.Svg("headset")<p style="margin:0"><b>@L["Fast Response"]</b><br /><span class="muted">@L["Our team will get back to you as soon as possible."]</span></p></div>
  <div>@Icons.Svg("users")<p style="margin:0"><b>@L["Expert Support"]</b><br /><span class="muted">@L["Get answers from our product experts."]</span></p></div>
  <div>@Icons.Svg("shield")<p style="margin:0"><b>@L["Tailored Solutions"]</b><br /><span class="muted">@L["We help you find the right plan for your business."]</span></p></div>
  <div>@Icons.Svg("handshake")<p style="margin:0"><b>@L["Long-term Partnership"]</b><br /><span class="muted">@L["We are committed to supporting your success."]</span></p></div>
</div></div>
