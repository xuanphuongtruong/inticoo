<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- IIS mặc định chặn request > 30 MB; màn Resources cho upload video mp4 tới 200 MB -->
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="230000000" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
